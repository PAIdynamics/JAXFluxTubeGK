module test_mesh_5d_gpu
    !! Contains tests for C++ functionalities of the mesh_5d_t type
    use mpi
    use pfunit
    use logger_m, only: logger_get_debug_channel
    use genex_fortran_env_m, only: GP, GP_EPS
    use, intrinsic :: iso_c_binding, only: C_PTR, C_CHAR, c_loc
    use mesh_5d_m, only: mesh_5d_t, size_neighbor
    use mesh_5d_gpu_m, only: mesh_5d_data_t
    use dcomm_handler_m, only: dcomm_handler_t
    use type_converters_m, only: string_c2f

    use helpers_mesh_5d_gpu_m, only: cbind_mesh_copy_scalar, &
                                     cbind_mesh_copy_array, &
                                     cbind_mesh_copy_magfield, &
                                     cbind_mesh_copy_parcon
    ! Unit test helpers
    use test_params_m, only: setup_test_mesh, setup_test_gpu_offload
    ! From PARALLAX
    use equilibrium_factory_m, only : SLAB
    use csrmat_m, only: csrmat_t, csrmat_data_t

    implicit none

contains

    @test(npes = [8])
    subroutine test_initialize_params_gpu_offload(this)
        !! Initialize the GPU offloading backend to CPU or GPU
        class(MpiTestMethod), intent(inout) :: this
        call setup_test_gpu_offload(this%getMpiCommunicator(), &
                                    this%getProcessRank())
    end subroutine

    @test(npes = [1])
    subroutine test_mesh_cxx_features(this)
        !! The main subroutine for unit testing the data exposure of mesh_5d_t
        !! to C++ and multidimensional array access from C++ class methods
        !! NOTE: The concept of this unit test is to deep copy the class members
        !!       of mesh from the source data structure type (_src) to
        !!       the target data structure type (_tgt) in C++ via each GPU
        !!       offload backends. The source and the target are allocated
        !!       separately, deep copied by each members and each elements
        !!       by values and asserted by pFUnit.

        class(MpiTestMethod), intent(inout) :: this
        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), target :: dcomm_handler
        type(mesh_5d_t), allocatable :: mesh_src
        type(mesh_5d_data_t) :: mesh_data_tgt

        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                      this%getNumProcesses(), 1, 1, 1)
        dcomm_handler_ptr => dcomm_handler
        allocate(mesh_src)
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=SLAB, &
                             spacing_RZ=10.0_GP, &
                             n_points_phi=8, &
                             n_points_vp=4, &
                             n_points_mu=4, &
                             quad_type_vp="trapezoidal", &
                             grid_type_mu="quadratic")
        call mesh_src%initialize(dcomm_handler_ptr)

        call test_mesh_cxx_access(dcomm_handler_ptr, mesh_src, mesh_data_tgt)

        call test_mesh_magfield_cxx_access(mesh_src, mesh_data_tgt)

        call test_mesh_parcon_cxx_access(mesh_src, mesh_data_tgt)

        deallocate(mesh_src)

        ! Enable the feature that swaps member pointers of mesh between
        ! Fortran and C++
        call setup_test_gpu_offload(this%getMpiCommunicator(), &
                                    this%getProcessRank(), &
                                    swap_mesh_members=.true.)

        allocate(mesh_src)
        call mesh_src%initialize(dcomm_handler_ptr)

        call test_mesh_cxx_access(dcomm_handler_ptr, mesh_src, mesh_data_tgt)

        call test_mesh_magfield_cxx_access(mesh_src, mesh_data_tgt)

        call test_mesh_parcon_cxx_access(mesh_src, mesh_data_tgt)

        deallocate(mesh_src)

        ! Reset params_gpu_offload
        call setup_test_gpu_offload(this%getMpiCommunicator(), &
                                    this%getProcessRank(), &
                                    swap_mesh_members=.false.)

    contains

        subroutine test_mesh_cxx_access(dcomm_handler, mesh_src, mesh_data_tgt)
            !! Test the data exposure of mesh_5d_t to C++ including
            !! the multidimensional array access from C++ class methods
            type(dcomm_handler_t), pointer, intent(in) :: dcomm_handler
            type(mesh_5d_t), target, intent(inout) :: mesh_src
            type(mesh_5d_data_t), target, intent(inout) :: mesh_data_tgt

            type(C_PTR), pointer :: mesh_src_cxx_pptr
            character(len=24) :: string_buffer
            character(len=1, kind=C_CHAR), dimension(24) :: &
                grid_type_phi_c, grid_type_vp_c, grid_type_mu_c, &
                quad_type_phi_c, quad_type_vp_c, quad_type_mu_c

            integer, contiguous, pointer, dimension(:,:,:,:) :: neighbors_src
            integer, contiguous, pointer, dimension(:,:) :: buf_zone_src, &
                                                            RZ_indices_src
            real(kind=GP), contiguous, pointer, dimension(:,:) :: &
                not_filler_src, is_compute_src, jacobian_src
            real(kind=GP), contiguous, pointer, dimension(:) :: &
                vp_src, mu_src, sqrt_mu_src, vpw_src, muw_src

            integer, contiguous, pointer, dimension(:,:,:,:) :: neighbors_tgt
            integer, contiguous, pointer, dimension(:,:) :: buf_zone_tgt, &
                                                            RZ_indices_tgt
            real(kind=GP), contiguous, pointer, dimension(:,:) :: &
                not_filler_tgt, is_compute_tgt, jacobian_tgt
            real(kind=GP), contiguous, pointer, dimension(:) :: &
                vp_tgt, mu_tgt, sqrt_mu_tgt, vpw_tgt, muw_tgt

            integer :: size_RZ, size_phi, size_vp, size_mu, size_sp
            integer :: order_RZ_stencil, size_RZ_stencil, lb_phi, ub_phi
            integer :: istatus

            ! Assign the C pointer to the source mesh_5d_t C++ class
            ! instance pointer
            mesh_src_cxx_pptr => mesh_src%get_cxx_pointer()

            ! Assign the shape of mesh grid and other scalars for reference
            size_RZ  = mesh_src%size_RZ()
            size_phi = mesh_src%size_phi()
            size_vp  = mesh_src%size_vp()
            size_mu  = mesh_src%size_mu()
            size_sp  = mesh_src%size_sp()
            order_RZ_stencil = size_neighbor
            size_RZ_stencil  = 2 * order_RZ_stencil + 1
            ! Synchronize both phi bounds with the ones in mesh_5d_s.f90
            lb_phi = 1
            ub_phi = size_phi
            ! NOTE: The value of order_RZ_stencil is hard coded in mesh_5d_t
            ! initialization

            ! Copy the mesh scalar members from the source class
            ! to the target class via C++
            istatus = 0
            istatus = cbind_mesh_copy_scalar(mesh_src_cxx_pptr, mesh_data_tgt, &
                grid_type_phi_c, grid_type_vp_c, grid_type_mu_c, &
                quad_type_phi_c, quad_type_vp_c, quad_type_mu_c)
            @assertEqual(istatus, 0)

            ! Assert grid and quadrature types
            call string_c2f(grid_type_phi_c, string_buffer)
            @assertEqual(mesh_src%grid_type_phi(), string_buffer)
            call string_c2f(grid_type_vp_c, string_buffer)
            @assertEqual(mesh_src%grid_type_vp(), string_buffer)
            call string_c2f(grid_type_mu_c, string_buffer)
            @assertEqual(mesh_src%grid_type_mu(), string_buffer)
            call string_c2f(quad_type_phi_c, string_buffer)
            @assertEqual(mesh_src%quad_type_phi(), string_buffer)
            call string_c2f(quad_type_vp_c, string_buffer)
            @assertEqual(mesh_src%quad_type_vp(), string_buffer)
            call string_c2f(quad_type_mu_c, string_buffer)
            @assertEqual(mesh_src%quad_type_mu(), string_buffer)

            ! Assert the scalar members
            @assertEqual(mesh_data_tgt%size_RZ, size_RZ)
            @assertEqual(mesh_data_tgt%size_phi, size_phi)
            @assertEqual(mesh_data_tgt%size_vp, size_vp)
            @assertEqual(mesh_data_tgt%size_mu, size_mu)
            @assertEqual(mesh_data_tgt%size_sp, size_sp)
            @assertEqual(mesh_data_tgt%order_RZ_stencil, order_RZ_stencil)
            @assertEqual(mesh_data_tgt%lb_phi, lb_phi)
            @assertEqual(mesh_data_tgt%ub_phi, ub_phi)
            @assertEqual(mesh_data_tgt%delta_RZ, mesh_src%delta_RZ())
            @assertEqual(mesh_data_tgt%delta_phi, mesh_src%delta_phi())
            @assertEqual(mesh_data_tgt%delta_vp, mesh_src%delta_vp())
            @assertEqual(mesh_data_tgt%delta_sqrt_mu, mesh_src%delta_sqrt_mu())

            write(logger_get_debug_channel(), "(A)") &
            "Test C++ access of mesh_5d_t class scalar members: OK!"

            ! Assign the pointers of the source mesh array members
            neighbors_src  => mesh_src%get_neighbor_indices_pointer()
            buf_zone_src   => mesh_src%get_buf_zone_pointer()
            RZ_indices_src => mesh_src%get_RZ_indices_pointer()
            not_filler_src => mesh_src%get_not_filler_pointer()
            is_compute_src => mesh_src%get_is_compute_pointer()
            vp_src         => mesh_src%get_vp_pointer()
            mu_src         => mesh_src%get_mu_pointer()
            sqrt_mu_src    => mesh_src%get_sqrt_mu_pointer()
            vpw_src        => mesh_src%get_vpw_pointer()
            muw_src        => mesh_src%get_muw_pointer()
            jacobian_src   => mesh_src%get_jacobian_pointer()

            ! Allocate the target mesh array members
            allocate(neighbors_tgt(-order_RZ_stencil:order_RZ_stencil, &
                                   -order_RZ_stencil:order_RZ_stencil, &
                                   size_RZ, size_phi))
            allocate(buf_zone_tgt(size_RZ, lb_phi:ub_phi))
            allocate(RZ_indices_tgt(size_RZ, lb_phi:ub_phi))
            allocate(not_filler_tgt(size_RZ, lb_phi:ub_phi))
            allocate(is_compute_tgt(size_RZ, lb_phi:ub_phi))
            allocate(vp_tgt(size_vp))
            allocate(mu_tgt(size_mu))
            allocate(sqrt_mu_tgt(size_mu))
            allocate(vpw_tgt(size_vp))
            allocate(muw_tgt(size_mu))
            allocate(jacobian_tgt(size_RZ, lb_phi:ub_phi))

            ! Assign the C pointer to the target mesh array members
            mesh_data_tgt%neighbors_ptr       = c_loc(neighbors_tgt)
            mesh_data_tgt%buf_zone_ptr        = c_loc(buf_zone_tgt)
            mesh_data_tgt%RZ_indices_ptr      = c_loc(RZ_indices_tgt)
            mesh_data_tgt%not_filler_ptr      = c_loc(not_filler_tgt)
            mesh_data_tgt%is_compute_ptr      = c_loc(is_compute_tgt)
            mesh_data_tgt%vp_grid_ptr         = c_loc(vp_tgt)
            mesh_data_tgt%mu_grid_ptr         = c_loc(mu_tgt)
            mesh_data_tgt%sqrt_mu_grid_ptr    = c_loc(sqrt_mu_tgt)
            mesh_data_tgt%vp_weights_ptr      = c_loc(vpw_tgt)
            mesh_data_tgt%mu_weights_ptr      = c_loc(muw_tgt)
            mesh_data_tgt%jacobian_buffer_ptr = c_loc(jacobian_tgt)

            ! Copy the mesh array members from the source class
            ! to the target class via C++
            istatus = 0
            istatus = cbind_mesh_copy_array(mesh_src_cxx_pptr, mesh_data_tgt)
            @assertEqual(istatus, 0)

            ! Assert the array members
            @assertEqual(neighbors_tgt, neighbors_src)
            @assertEqual(buf_zone_tgt, buf_zone_src)
            @assertEqual(RZ_indices_tgt, RZ_indices_src)
            @assertEqual(not_filler_tgt, not_filler_src, GP_EPS)
            @assertEqual(is_compute_tgt, is_compute_src, GP_EPS)
            @assertEqual(vp_tgt, vp_src, GP_EPS)
            @assertEqual(mu_tgt, mu_src, GP_EPS)
            @assertEqual(sqrt_mu_tgt, sqrt_mu_src, GP_EPS)
            @assertEqual(vpw_tgt, vpw_src, GP_EPS)
            @assertEqual(muw_tgt, muw_src, GP_EPS)
            @assertEqual(jacobian_tgt, jacobian_src, GP_EPS)

            write(logger_get_debug_channel(), "(A)") &
            "Test C++ access of mesh_5d_t class array members: OK!"

            ! Deallocate the target mesh array members
            deallocate(neighbors_tgt)
            deallocate(buf_zone_tgt)
            deallocate(RZ_indices_tgt)
            deallocate(not_filler_tgt)
            deallocate(is_compute_tgt)
            deallocate(vp_tgt)
            deallocate(mu_tgt)
            deallocate(sqrt_mu_tgt)
            deallocate(vpw_tgt)
            deallocate(muw_tgt)
            deallocate(jacobian_tgt)

        end subroutine

        subroutine test_mesh_magfield_cxx_access(mesh_src, mesh_data_tgt)
            !! Test the data exposure of mesh_5d_t to C++ realted to the
            !! magnetic field (magfield) including the multidimensional array
            !! access from C++ class methods

            type(mesh_5d_t), target, intent(inout) :: mesh_src
            type(mesh_5d_data_t), target, intent(inout) :: mesh_data_tgt

            type(C_PTR), pointer :: mesh_src_cxx_pptr

            real(kind=GP), contiguous, pointer, dimension(:,:) :: &
                absB_src, normb_R_src, normb_Z_src, curl_normb_y_src, &
                dgyxdy_over_g_src, dgyzdy_over_g_src, &
                dgyxdz_over_g_src, dgyzdx_over_g_src, &
                inv_g_src, dabsBdx_src, dabsBdz_src, dabsBdy_src

            real(kind=GP), contiguous, pointer, dimension(:,:) :: &
                absB_tgt, normb_R_tgt, normb_Z_tgt, curl_normb_y_tgt, &
                dgyxdy_over_g_tgt, dgyzdy_over_g_tgt, &
                dgyxdz_over_g_tgt, dgyzdx_over_g_tgt, &
                inv_g_tgt, dabsBdx_tgt, dabsBdz_tgt, dabsBdy_tgt

            integer :: size_RZ, size_phi
            integer :: istatus
            logical :: equal

            ! Assign the C pointer to the source mesh_5d_t C++ class
            ! instance pointer
            mesh_src_cxx_pptr => mesh_src%get_cxx_pointer()

            ! Assign the shape of mesh grid and other scalars for reference
            size_RZ  = mesh_src%size_RZ()
            size_phi = mesh_src%size_phi()

            ! Assign the pointers of the source mesh array members
            absB_src          => mesh_src%get_absB_pointer()
            normb_R_src       => mesh_src%get_normb_R_pointer()
            normb_Z_src       => mesh_src%get_normb_Z_pointer()
            curl_normb_y_src  => mesh_src%get_curl_normb_y_pointer()
            dgyxdy_over_g_src => mesh_src%get_dgyxdy_over_g_pointer()
            dgyzdy_over_g_src => mesh_src%get_dgyzdy_over_g_pointer()
            dgyxdz_over_g_src => mesh_src%get_dgyxdz_over_g_pointer()
            dgyzdx_over_g_src => mesh_src%get_dgyzdx_over_g_pointer()
            inv_g_src         => mesh_src%get_inv_g_pointer()
            dabsBdx_src       => mesh_src%get_dabsBdx_pointer()
            dabsBdy_src       => mesh_src%get_dabsBdy_pointer()
            dabsBdz_src       => mesh_src%get_dabsBdz_pointer()

            ! Allocate the target mesh array members
            allocate(absB_tgt(size_RZ, size_phi))
            allocate(normb_R_tgt(size_RZ, size_phi))
            allocate(normb_Z_tgt(size_RZ, size_phi))
            allocate(curl_normb_y_tgt(size_RZ, size_phi))
            allocate(dgyxdy_over_g_tgt(size_RZ, size_phi))
            allocate(dgyzdy_over_g_tgt(size_RZ, size_phi))
            allocate(dgyxdz_over_g_tgt(size_RZ, size_phi))
            allocate(dgyzdx_over_g_tgt(size_RZ, size_phi))
            allocate(inv_g_tgt(size_RZ, size_phi))
            allocate(dabsBdx_tgt(size_RZ, size_phi))
            allocate(dabsBdy_tgt(size_RZ, size_phi))
            allocate(dabsBdz_tgt(size_RZ, size_phi))

            ! Assign the C pointer to the target mesh array members
            mesh_data_tgt%absB_buffer_ptr    = c_loc(absB_tgt)
            mesh_data_tgt%normb_R_buffer_ptr = c_loc(normb_R_tgt)
            mesh_data_tgt%normb_Z_buffer_ptr = c_loc(normb_Z_tgt)
            mesh_data_tgt%curl_normb_y_ptr   = c_loc(curl_normb_y_tgt)
            mesh_data_tgt%dgyxdy_over_g_ptr  = c_loc(dgyxdy_over_g_tgt)
            mesh_data_tgt%dgyzdy_over_g_ptr  = c_loc(dgyzdy_over_g_tgt)
            mesh_data_tgt%dgyxdz_over_g_ptr  = c_loc(dgyxdz_over_g_tgt)
            mesh_data_tgt%dgyzdx_over_g_ptr  = c_loc(dgyzdx_over_g_tgt)
            mesh_data_tgt%inv_g_ptr          = c_loc(inv_g_tgt)
            mesh_data_tgt%dabsBdx_ptr        = c_loc(dabsBdx_tgt)
            mesh_data_tgt%dabsBdz_ptr        = c_loc(dabsBdz_tgt)
            mesh_data_tgt%dabsBdy_ptr        = c_loc(dabsBdy_tgt)

            ! Copy the mesh array members from the source class
            ! to the target class via C++
            istatus = 0
            istatus = cbind_mesh_copy_magfield(mesh_src_cxx_pptr, mesh_data_tgt)
            @assertEqual(istatus, 0)

            ! Assert the array members
            @assertEqual(absB_tgt, absB_src, GP_EPS)
            @assertEqual(normb_R_tgt, normb_R_src, GP_EPS)
            @assertEqual(normb_Z_tgt, normb_Z_src, GP_EPS)
            @assertEqual(curl_normb_y_tgt, curl_normb_y_src, GP_EPS)
            @assertEqual(dgyxdy_over_g_tgt, dgyxdy_over_g_src, GP_EPS)
            @assertEqual(dgyzdy_over_g_tgt, dgyzdy_over_g_src, GP_EPS)
            @assertEqual(dgyxdz_over_g_tgt, dgyxdz_over_g_src, GP_EPS)
            @assertEqual(dgyzdx_over_g_tgt, dgyzdx_over_g_src, GP_EPS)
            @assertEqual(inv_g_tgt, inv_g_src, GP_EPS)
            @assertEqual(dabsBdx_tgt, dabsBdx_src, GP_EPS)
            @assertEqual(dabsBdy_tgt, dabsBdy_src, GP_EPS)
            @assertEqual(dabsBdz_tgt, dabsBdz_src, GP_EPS)

            write(logger_get_debug_channel(), "(A)") &
            "Test C++ access of mesh_5d_t class members related to magnetic &
            &field (magfield): OK!"

            ! Deallocate the target mesh array members
            deallocate(absB_tgt)
            deallocate(normb_R_tgt)
            deallocate(normb_Z_tgt)
            deallocate(curl_normb_y_tgt)
            deallocate(dgyxdy_over_g_tgt)
            deallocate(dgyzdy_over_g_tgt)
            deallocate(dgyxdz_over_g_tgt)
            deallocate(dgyzdx_over_g_tgt)
            deallocate(inv_g_tgt)
            deallocate(dabsBdx_tgt)
            deallocate(dabsBdy_tgt)
            deallocate(dabsBdz_tgt)

        end subroutine

        subroutine test_mesh_parcon_cxx_access(mesh_src, mesh_data_tgt)
            !! Test the data exposure of mesh_5d_t to C++ related to the
            !! parallel connection including the multidimensional array access
            !! from C++ class methods

            type(mesh_5d_t), target, intent(inout) :: mesh_src
            type(mesh_5d_data_t), target, intent(inout) :: mesh_data_tgt

            type(C_PTR), pointer :: mesh_src_cxx_pptr

            integer, contiguous, pointer, dimension(:,:) :: &
                not_in_target_src
            real(kind=GP), contiguous, pointer, dimension(:,:) :: fll_p_src
            real(kind=GP), contiguous, pointer, dimension(:,:) :: fll_pp_src
            real(kind=GP), contiguous, pointer, dimension(:,:) :: fll_m_src
            real(kind=GP), contiguous, pointer, dimension(:,:) :: fll_mm_src
            type(csrmat_t), pointer, dimension(:) :: map_pp_src
            type(csrmat_t), pointer, dimension(:) :: map_p_src
            type(csrmat_t), pointer, dimension(:) :: map_m_src
            type(csrmat_t), pointer, dimension(:) :: map_mm_src

            integer, contiguous, pointer, dimension(:,:) :: &
                not_in_target_tgt
            real(kind=GP), contiguous, pointer, dimension(:,:) :: fll_p_tgt
            real(kind=GP), contiguous, pointer, dimension(:,:) :: fll_pp_tgt
            real(kind=GP), contiguous, pointer, dimension(:,:) :: fll_m_tgt
            real(kind=GP), contiguous, pointer, dimension(:,:) :: fll_mm_tgt
            type(csrmat_t), pointer, dimension(:) :: map_pp_tgt
            type(csrmat_t), pointer, dimension(:) :: map_p_tgt
            type(csrmat_t), pointer, dimension(:) :: map_m_tgt
            type(csrmat_t), pointer, dimension(:) :: map_mm_tgt
            type(csrmat_data_t), pointer, dimension(:) :: map_pp_data_tgt
            type(csrmat_data_t), pointer, dimension(:) :: map_p_data_tgt
            type(csrmat_data_t), pointer, dimension(:) :: map_m_data_tgt
            type(csrmat_data_t), pointer, dimension(:) :: map_mm_data_tgt

            integer :: size_RZ, size_phi
            integer :: k, istatus
            logical :: equal

            ! Assign the C pointer to the source mesh_5d_t C++ class
            ! instance pointer
            mesh_src_cxx_pptr => mesh_src%get_cxx_pointer()

            ! Assign the shape of mesh grid
            size_RZ  = mesh_src%size_RZ()
            size_phi = mesh_src%size_phi()

            ! Assign the pointers of the source mesh class members
            not_in_target_src => mesh_src%get_not_in_target_pointer()
            fll_p_src         => mesh_src%get_fll_positive1_pointer()
            fll_pp_src        => mesh_src%get_fll_positive2_pointer()
            fll_m_src         => mesh_src%get_fll_negative1_pointer()
            fll_mm_src        => mesh_src%get_fll_negative2_pointer()
            map_pp_src        => mesh_src%get_map_positive2_pointer()
            map_p_src         => mesh_src%get_map_positive1_pointer()
            map_m_src         => mesh_src%get_map_negative1_pointer()
            map_mm_src        => mesh_src%get_map_negative2_pointer()

            ! Allocate the target mesh class members
            allocate(not_in_target_tgt(size_RZ, size_phi))
            allocate(fll_p_tgt(size_RZ, size_phi))
            allocate(fll_pp_tgt(size_RZ, size_phi))
            allocate(fll_m_tgt(size_RZ, size_phi))
            allocate(fll_mm_tgt(size_RZ, size_phi))
            allocate(map_pp_tgt(size_phi))
            allocate(map_p_tgt(size_phi))
            allocate(map_m_tgt(size_phi))
            allocate(map_mm_tgt(size_phi))

            ! Allocate the type struct of the target map matrices
            allocate(map_pp_data_tgt(size_phi))
            allocate(map_p_data_tgt(size_phi))
            allocate(map_m_data_tgt(size_phi))
            allocate(map_mm_data_tgt(size_phi))

            do k = 1, size_phi
                ! Allocate the array members and initialize the scalar members
                ! of the target map matrices
                map_pp_tgt(k)%ndim = 0
                map_pp_tgt(k)%ncol = 0
                map_pp_tgt(k)%nnz  = 0
                allocate(map_pp_tgt(k)%i(map_pp_src(k)%ndim + 1))
                allocate(map_pp_tgt(k)%j(map_pp_src(k)%nnz))
                allocate(map_pp_tgt(k)%val(map_pp_src(k)%nnz))

                map_p_tgt(k)%ndim = 0
                map_p_tgt(k)%ncol = 0
                map_p_tgt(k)%nnz  = 0
                allocate(map_p_tgt(k)%i(map_p_src(k)%ndim + 1))
                allocate(map_p_tgt(k)%j(map_p_src(k)%nnz))
                allocate(map_p_tgt(k)%val(map_p_src(k)%nnz))

                map_m_tgt(k)%ndim = 0
                map_m_tgt(k)%ncol = 0
                map_m_tgt(k)%nnz  = 0
                allocate(map_m_tgt(k)%i(map_m_src(k)%ndim + 1))
                allocate(map_m_tgt(k)%j(map_m_src(k)%nnz))
                allocate(map_m_tgt(k)%val(map_m_src(k)%nnz))

                map_mm_tgt(k)%ndim = 0
                map_mm_tgt(k)%ncol = 0
                map_mm_tgt(k)%nnz  = 0
                allocate(map_mm_tgt(k)%i(map_mm_src(k)%ndim + 1))
                allocate(map_mm_tgt(k)%j(map_mm_src(k)%nnz))
                allocate(map_mm_tgt(k)%val(map_mm_src(k)%nnz))

                ! Assign the data of target mesh class members to structs
                call map_pp_tgt(k)%expose_data(map_pp_data_tgt(k))
                call map_p_tgt(k)%expose_data(map_p_data_tgt(k))
                call map_m_tgt(k)%expose_data(map_m_data_tgt(k))
                call map_mm_tgt(k)%expose_data(map_mm_data_tgt(k))
            enddo

            ! Assign the C pointer to the target mesh class members
            mesh_data_tgt%not_in_target_ptr = c_loc(not_in_target_tgt)
            mesh_data_tgt%fll_positive1_ptr = c_loc(fll_p_tgt)
            mesh_data_tgt%fll_positive2_ptr = c_loc(fll_pp_tgt)
            mesh_data_tgt%fll_negative1_ptr = c_loc(fll_m_tgt)
            mesh_data_tgt%fll_negative2_ptr = c_loc(fll_mm_tgt)
            mesh_data_tgt%map_positive2_data_ptr = c_loc(map_pp_data_tgt)
            mesh_data_tgt%map_positive1_data_ptr = c_loc(map_p_data_tgt)
            mesh_data_tgt%map_negative1_data_ptr = c_loc(map_m_data_tgt)
            mesh_data_tgt%map_negative2_data_ptr = c_loc(map_mm_data_tgt)

            ! Copy the mesh class members from the source class
            ! to the target class via C++
            istatus = 0
            istatus = cbind_mesh_copy_parcon(mesh_src_cxx_pptr, mesh_data_tgt)
            @assertEqual(istatus, 0)

            ! Assert the array members of mesh
            @assertEqual(not_in_target_tgt, not_in_target_src)
            @assertEqual(fll_p_tgt, fll_p_src, GP_EPS)
            @assertEqual(fll_pp_tgt, fll_pp_src, GP_EPS)
            @assertEqual(fll_m_tgt, fll_m_src, GP_EPS)
            @assertEqual(fll_mm_tgt, fll_mm_src, GP_EPS)

            ! Assert the class members of map matrices
            do k = 1, size_phi
                ! Assert the scalar members of map matrices
                @assertEqual(map_pp_data_tgt(k)%ndim, map_pp_src(k)%ndim)
                @assertEqual(map_pp_data_tgt(k)%ncol, map_pp_src(k)%ncol)
                @assertEqual(map_pp_data_tgt(k)%nnz, map_pp_src(k)%nnz)

                @assertEqual(map_p_data_tgt(k)%ndim, map_p_src(k)%ndim)
                @assertEqual(map_p_data_tgt(k)%ncol, map_p_src(k)%ncol)
                @assertEqual(map_p_data_tgt(k)%nnz, map_p_src(k)%nnz)

                @assertEqual(map_m_data_tgt(k)%ndim, map_m_src(k)%ndim)
                @assertEqual(map_m_data_tgt(k)%ncol, map_m_src(k)%ncol)
                @assertEqual(map_m_data_tgt(k)%nnz, map_m_src(k)%nnz)

                @assertEqual(map_mm_data_tgt(k)%ndim, map_mm_src(k)%ndim)
                @assertEqual(map_mm_data_tgt(k)%ncol, map_mm_src(k)%ncol)
                @assertEqual(map_mm_data_tgt(k)%nnz, map_mm_src(k)%nnz)

                ! Assert the array members of map matrices
                @assertEqual(map_pp_tgt(k)%i, map_pp_src(k)%i)
                @assertEqual(map_pp_tgt(k)%j, map_pp_src(k)%j)
                @assertEqual(map_pp_tgt(k)%val, map_pp_src(k)%val, GP_EPS)

                @assertEqual(map_p_tgt(k)%i, map_p_src(k)%i)
                @assertEqual(map_p_tgt(k)%j, map_p_src(k)%j)
                @assertEqual(map_p_tgt(k)%val, map_p_src(k)%val, GP_EPS)

                @assertEqual(map_m_tgt(k)%i, map_m_src(k)%i)
                @assertEqual(map_m_tgt(k)%j, map_m_src(k)%j)
                @assertEqual(map_m_tgt(k)%val, map_m_src(k)%val, GP_EPS)

                @assertEqual(map_mm_tgt(k)%i, map_mm_src(k)%i)
                @assertEqual(map_mm_tgt(k)%j, map_mm_src(k)%j)
                @assertEqual(map_mm_tgt(k)%val, map_mm_src(k)%val, GP_EPS)
            enddo

            write(logger_get_debug_channel(), "(A)") &
            "Test C++ access of mesh_5d_t class members related to parallel &
            &connection (parcon): OK!"

            ! Deallocate the target map array members
            do k = 1, size_phi
                deallocate(map_pp_tgt(k)%i)
                deallocate(map_pp_tgt(k)%j)
                deallocate(map_pp_tgt(k)%val)

                deallocate(map_p_tgt(k)%i)
                deallocate(map_p_tgt(k)%j)
                deallocate(map_p_tgt(k)%val)

                deallocate(map_m_tgt(k)%i)
                deallocate(map_m_tgt(k)%j)
                deallocate(map_m_tgt(k)%val)

                deallocate(map_mm_tgt(k)%i)
                deallocate(map_mm_tgt(k)%j)
                deallocate(map_mm_tgt(k)%val)
            enddo

            ! Deallocate the target map data
            deallocate(map_pp_data_tgt)
            deallocate(map_p_data_tgt)
            deallocate(map_m_data_tgt)
            deallocate(map_mm_data_tgt)

            ! Deallocate the target maps, mesh member and
            ! the source mesh
            deallocate(map_pp_tgt)
            deallocate(map_p_tgt)
            deallocate(map_m_tgt)
            deallocate(map_mm_tgt)
            deallocate(fll_mm_tgt)
            deallocate(fll_m_tgt)
            deallocate(fll_pp_tgt)
            deallocate(fll_p_tgt)
            deallocate(not_in_target_tgt)

        end subroutine

    end subroutine

end module
