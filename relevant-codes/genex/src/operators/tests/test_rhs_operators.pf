module test_rhs_operators
    ! Contains unit tests for the right hand side operators
!$  use omp_lib
    use mpi
    use pfunit
    use, intrinsic :: iso_fortran_env
    use, intrinsic :: iso_c_binding, only: c_loc
    use ieee_arithmetic
    use math_m, only: PI, almost_equal
    use genex_fortran_env_m, only: GP, GP_EPS, DP
    use logger_m, only: logger_get_debug_channel
    use dcomm_handler_m, only: dcomm_handler_t
    use data_storage_m, only : data_storage_5d_t, data_storage_cpu_5d_t, &
                               data_storage_cpu_2d_t
    use data_array_m, only: data_array_2d_t, data_array_5d_t
    use mesh_5d_m, only: mesh_5d_t
    use profiles_m, only : profile_cbc_cpu_t
    use profile_container_m, only: profile_container_t
    use dist_initial_m, only: dist_initial_maxw_cpu_t
    use dist_initial_container_m, only: dist_initial_container_t
    use params_mesh_m, only: get_n_points_phi, get_n_points_mu, &
                             get_n_points_vp, get_n_points_sp, get_use_bsg
    use params_bsg_m, only: get_num_bsg_blocks, get_bsg_interp_order
    use params_species_m, only: get_charge, get_mass, get_temp_scaling, &
                                n_spec_supported
    use params_profile_cbc_m, only: params_profile_cbc_t, &
                                    get_params_profile_cbc_dens, &
                                    get_params_profile_cbc_temp
    use params_gyrokinetic_system_m, only: get_with_bpar
    use op_set_initial_condition_m, only: op_set_initial_condition_cpu_t
    use op_mom_maxwells_eq_m, only: op_mom_maxwells_eq_cpu_t
    use op_rhs_vlasov_eq_static_m, only: op_rhs_vlasov_eq_static_t, &
                                         op_rhs_vlasov_eq_static_cpu_t
    use op_rhs_vlasov_eq_dynamic_m, only: op_rhs_vlasov_eq_dynamic_t, &
                                          op_rhs_vlasov_eq_dynamic_cpu_t
    use op_set_uniform_m, only: op_set_uniform_cpu_t
    use equilibrium_reference_m, only: equilibrium_reference_t, &
                                       dommaschk_reference_t, &
                                       salpha_reference_t
    use params_gpu_offload_m, only: get_use_gpu_offload
    use bsg_operators_m, only: bsg_operators_t
    use bsg_types_m, only: MAX_BLOCKS

#ifdef ENABLE_GPU
    use op_rhs_vlasov_eq_dynamic_m, only: op_rhs_vlasov_eq_dynamic_gpu_t
    use op_rhs_vlasov_eq_static_m, only: op_rhs_vlasov_eq_static_gpu_t
#endif

    ! Unit test helpers
    use test_params_m
    ! From PARALLAX
    use equilibrium_factory_m, only: SLAB, CIRCULAR, SALPHA, DOMMASCHK

    implicit none

contains

    @before
    subroutine setup(this)
        ! Flush out all the default parameters
        class(MpiTestMethod), intent(inout) :: this
        call setup_test_params(this%getMpiCommunicator(), &
                               this%getProcessRank())
    end subroutine

    @after
    subroutine teardown(this)
        ! Read all the default parameters
        class(MpiTestMethod), intent(inout) :: this
        call teardown_test_params(this%getMpiCommunicator(), &
                                  this%getProcessRank())
    end subroutine

    @test(npes = [8])
    subroutine test_initialize_params_gpu_offload(this)
        !! Initialize the GPU offloading backend to CPU or GPU
        class(MpiTestMethod), intent(inout) :: this
        call setup_test_gpu_offload(this%getMpiCommunicator(), &
                                    this%getProcessRank())
    end subroutine

    subroutine test_op_rhs_vlasov_eq_static_core(dcomm_handler, mesh, &
                                          equilibrium_reference, &
                                          tol, &
                                          num_blocks, interp_order)
        type(dcomm_handler_t), pointer, intent(in) :: dcomm_handler
        type(mesh_5d_t), target, intent(inout) :: mesh
        class(equilibrium_reference_t), intent(in) :: equilibrium_reference
        real(kind=GP), intent(in) :: tol
        integer, intent(in), optional :: num_blocks
        integer, intent(in), optional :: interp_order

        class(op_rhs_vlasov_eq_static_t), allocatable :: op
        class(bsg_operators_t), allocatable :: bsg_op
        type(data_storage_cpu_5d_t), target, allocatable :: &
            ds_f_in, ds_f_out, ds_f_expected
        type(data_storage_cpu_2d_t), target, allocatable :: ds_phi_in, &
            ds_A_par_in, ds_B_par_in
        class(data_array_5d_t), pointer :: da_f_in, da_f_out
        class(data_array_2d_t), pointer :: da_phi_in, da_A_par_in, da_B_par_in

        real(kind=GP), contiguous, pointer, dimension(:,:,:,:,:) :: &
            f_in_ptr, f_expected_ptr, f_out_ptr
        real(kind=GP), contiguous, pointer, dimension(:,:) :: &
            phi_in_ptr, A_par_in_ptr, B_par_in_ptr
        real(kind=GP), contiguous, pointer, dimension(:,:) :: is_compute
        real(kind=GP) :: a, b, c, d, e, f, g, h, aa
        integer, dimension(5) :: lb, ub, lb_stripped, ub_stripped
        integer :: n_rz, n_phi, n_vp, n_mu, n_sp
        integer :: i, k, l, m, n
        logical :: all_fine
        integer :: interp_order_default = 4, num_blocks_default = 2

        if(present(num_blocks)) num_blocks_default = num_blocks
        if(present(interp_order)) interp_order_default = interp_order

        if(get_use_gpu_offload()) then
#ifdef ENABLE_GPU
            allocate(op_rhs_vlasov_eq_static_gpu_t :: op)
#endif
        else
            allocate(op_rhs_vlasov_eq_static_cpu_t :: op)
        endif

        allocate(bsg_operators_t :: bsg_op)
        if (get_use_bsg()) then
            call bsg_op%initialize(mesh, num_blocks_default, &
                                   interp_order_default)
        else
            call bsg_op%initialize(mesh, 1)
        end if
        call op%initialize(mesh, bsg_op)
        allocate(ds_f_in, ds_f_out, ds_f_expected, ds_phi_in, ds_A_par_in, &
                 ds_B_par_in)

        is_compute => mesh%get_is_compute_pointer()

        ! Allocate input data for the operator
        n_rz = mesh%size_RZ()
        n_phi = mesh%size_phi()
        n_vp = mesh%size_vp()
        n_mu = mesh%size_mu()
        n_sp = mesh%size_sp()

        call ds_f_in%initialize(dcomm_handler)
        call ds_phi_in%initialize(dcomm_handler)
        call ds_A_par_in%initialize(dcomm_handler)
        call ds_B_par_in%initialize(dcomm_handler)
        call ds_f_out%initialize(dcomm_handler)
        call ds_f_expected%initialize(dcomm_handler)

        da_f_in     => ds_f_in%get_data_pointer()
        da_f_out    => ds_f_out%get_data_pointer()
        da_phi_in   => ds_phi_in%get_data_pointer()
        da_A_par_in => ds_A_par_in%get_data_pointer()
        da_B_par_in => ds_B_par_in%get_data_pointer()

        f_in_ptr       => da_f_in%get_pointer()
        f_out_ptr      => da_f_out%get_pointer()
        f_expected_ptr => ds_f_expected%get_pointer()
        phi_in_ptr     => da_phi_in%get_pointer()
        A_par_in_ptr   => da_A_par_in%get_pointer()
        B_par_in_ptr   => da_B_par_in%get_pointer()
        lb = da_f_in%get_lbound()
        ub = da_f_in%get_ubound()
        lb_stripped = da_f_in%get_lbound_stripped()
        ub_stripped = da_f_in%get_ubound_stripped()

        a = 1.2_GP ! f
        b = 1.3_GP ! f
        c = 1.4_GP ! phi
        d = 1.5_GP ! phi
        e = 1.6_GP ! f
        f = 0.7_GP ! A
        g = 0.8_GP ! A
        h = 1.2_GP ! Bpar
        aa = 0.9_GP ! Bpar
        ! NOTE: while the values are technically arbitrary, some values can make
        ! the test fail within the chosen tolerances.

        if(get_use_bsg() .or. .not. get_with_bpar()) then
            ! Disable Bpar from test if BSG is on or if Bpar is not used
            ! TODO: implement Bpar in BSG
            h = 0.0_GP
            aa = 0.0_GP
        endif

        call init(lb_stripped, ub_stripped, f_in_ptr, phi_in_ptr, &
                  A_par_in_ptr, B_par_in_ptr, a, b, c, d, e, f, g, h, aa)
        call expected(lb_stripped, ub_stripped, f_expected_ptr, &
                      a, b, c, d, e, f, g, h, aa)

        ! Copy array to GPU. This does nothing if no GPU backend is specified
        call da_f_in%update_device()
        call da_phi_in%update_device()
        call da_A_par_in%update_device()
        call da_B_par_in%update_device()

        call op%apply(da_f_in, da_phi_in, da_A_par_in, da_B_par_in, da_f_out)

        ! Copy array to CPU. This does nothing if no GPU backend is specified
        call da_f_out%update_host()

        block
            integer :: passed, failed, total
            real(kind=GP) :: frac_failed, frac_passed, maxabserr, &
                             maxrelerr, maxrelerr_f_ex, maxrelerr_check, &
                             maxrelerr_thread, maxrelerr_f_ex_thread

            passed = 0
            failed = 0
            maxabserr = 0.0_GP
            maxrelerr = 0.0_GP
            maxrelerr_f_ex = 0.0_GP

            all_fine = .true.
            !$omp parallel default(none) &
            !$omp firstprivate(lb_stripped, ub_stripped) &
            !$omp shared(f_expected_ptr, f_out_ptr, tol, &
            !$omp        failed, passed, maxabserr, maxrelerr, maxrelerr_f_ex, &
            !$omp        is_compute, all_fine) &
            !$omp private(i, k, l, m, n, &
            !$omp         maxrelerr_check, &
            !$omp         maxrelerr_thread, maxrelerr_f_ex_thread)

            maxrelerr_check  = 0.0_GP
            maxrelerr_thread = 0.0_GP
            maxrelerr_f_ex_thread = 0.0_GP

            do n = lb_stripped(5), ub_stripped(5)
            do m = lb_stripped(4), ub_stripped(4)
            do l = lb_stripped(3), ub_stripped(3)
            do k = lb_stripped(2), ub_stripped(2)
            !$omp do schedule(static) &
            !$omp reduction(+:failed, passed) &
            !$omp reduction(max:maxabserr)
            do i = lb_stripped(1), ub_stripped(1)
            if(is_compute(i, k) == 1.0_GP) then
                ! Check max errors

                maxabserr = max(maxabserr, &
                    abs(f_expected_ptr(i,k,l,m,n) - f_out_ptr(i,k,l,m,n)))

                maxrelerr_check = abs(1.0_GP - &
                               f_out_ptr(i,k,l,m,n) / f_expected_ptr(i,k,l,m,n))
                if(maxrelerr_check > maxrelerr_thread) then
                    maxrelerr_thread      = maxrelerr_check
                    maxrelerr_f_ex_thread = f_expected_ptr(i,k,l,m,n)
                endif

                ! Check for violation of tolerance
                ! NOTE: The choice between checking the relative or the
                !       absolute error depends on the magnitude of f_expected.
                !       Since f_expected is typically around 1,
                !       the absolute error criterion will apply in most cases.
                if(abs(f_expected_ptr(i,k,l,m,n)) >= 1.0_GP &
                   .and. almost_equal(1.0_GP, f_out_ptr(i,k,l,m,n) / &
                                      f_expected_ptr(i,k,l,m,n), tol)) then
                    passed = passed + 1

                else if(abs(f_expected_ptr(i,k,l,m,n)) < 1.0_GP &
                        .and. almost_equal(f_expected_ptr(i,k,l,m,n), &
                                           f_out_ptr(i,k,l,m,n), tol)) then
                    passed = passed + 1

                else
                    failed = failed + 1
                endif
            else
                ! Check that non-compute points exactly equal the
                ! expected solution
                if(.not. almost_equal(f_expected_ptr(i,k,l,m,n), &
                                      f_out_ptr(i,k,l,m,n), GP_EPS)) then
                    all_fine = .false.
                endif
            endif
            enddo
            !$omp end do nowait
            enddo
            enddo
            enddo
            enddo
            !$omp critical
            if (maxrelerr_thread > maxrelerr) then
                maxrelerr      = maxrelerr_thread
                maxrelerr_f_ex = maxrelerr_f_ex_thread
            end if
            !$omp end critical
            !$omp end parallel

            total = failed + passed
            frac_failed = real(failed) / real(total)
            frac_passed = real(passed) / real(total)

            ! Log failed and passed tests
            write(logger_get_debug_channel(), *) failed, " / ", total , &
                " failed, (", frac_failed * 100.0_GP, "%)"
            write(logger_get_debug_channel(), *) passed, " / ", total , &
                " passed, (", frac_passed * 100.0_GP, "%)"

            ! Log max error
            write(logger_get_debug_channel(), *) &
                "maximum absolute error = ", maxabserr
            write(logger_get_debug_channel(), *) &
                "maximum relative error = ", maxrelerr
            write(logger_get_debug_channel(), *) &
                "        for f_expected = ", maxrelerr_f_ex

            if(frac_failed > 0.0_GP) all_fine = .false.

        end block
        @assertTrue(all_fine)

        deallocate(ds_B_par_in)
        deallocate(ds_A_par_in)
        deallocate(ds_phi_in)
        deallocate(ds_f_expected)
        deallocate(ds_f_out)
        deallocate(ds_f_in)
        deallocate(op)

    contains

        subroutine init(lb_stripped, ub_stripped, dist_func, es_pot, A_par, &
                        B_par, a, b, c, d, e, f, g, h, aa)
            !! Initialize f(R,Z,vp) = a * R + b * Z + e * vp + const
            !! and phi(R,Z) = c * R + d * Z + const
            !! and A(R,Z) = f * R + g * Z + const
            !! and B_par(R,Z) = h * R + aa * Z + const
            integer, intent(in) :: lb_stripped(5), ub_stripped(5)
            real(kind=GP), intent(inout), contiguous, pointer, &
                dimension(:,:,:,:,:) :: dist_func
            real(kind=GP), intent(inout), contiguous, pointer, &
                dimension(:,:) :: es_pot
            real(kind=GP), intent(inout), contiguous, pointer, &
                dimension(:,:) :: A_par
            real(kind=GP), intent(inout), contiguous, pointer, &
                dimension(:,:) :: B_par
            real(kind=GP), intent(in) :: a, b, c, d, e, f, g, h, aa

            integer :: i, n, k, l ,m, lb(5), ub(5)
            real(kind=GP) :: x, z, phi, delta_vp, vp_min
            real(kind=GP), dimension(:), pointer :: vp_ptr

            lb = lbound(dist_func)
            ub = ubound(dist_func)

            vp_ptr => mesh%get_vp_pointer()
            delta_vp = mesh%delta_vp()
            vp_min = vp_ptr(1) - delta_vp

            !$omp parallel default(none) firstprivate(lb, ub) &
            !$omp shared(dist_func, mesh, a, b, e, vp_min, delta_vp) &
            !$omp private(i, k, l, m, n, x, z, phi)
            do n = lb(5), ub(5)
            do m = lb(4), ub(4)
            do l = lb(3), ub(3)
            do k = lb(2), ub(2)
            !$omp do schedule(static)
            do i = lb(1), ub(1)
                call mesh%RZphi(i, k, x, z, phi)
                ! we calculate the value of vp explicitly to
                ! ensure that vp is also initialized as a
                ! linear function function for the ghost cells
                dist_func(i, k, l, m, n) = a * x + b * z &
                                 + e * (vp_min + l * delta_vp) + 5.29398_GP
            enddo
            !$omp end do nowait
            enddo
            enddo
            enddo
            enddo
            !$omp end parallel

            !$omp parallel default(none) firstprivate(lb, ub) &
            !$omp shared(es_pot, A_par, B_par, mesh, c, d, f, g, h, aa) &
            !$omp private(i, k, x, z, phi)
            do k = lb(2), ub(2)
            !$omp do schedule(static)
            do i = lb(1), ub(1)
                call mesh%RZphi(i, k, x, z, phi)
                es_pot(i, k) = c * x + d * z + 4.98721_GP
                A_par(i, k) = f * x + g * z - 1.23820_GP
                B_par(i, k) = h * x + aa * z + 1.61803_GP
            enddo
            !$omp end do nowait
            enddo
            !$omp end parallel
        end subroutine

        subroutine expected(lb_stripped, ub_stripped, f_out, a, b, c, d, e, &
                            f, g, h, aa)
            use params_species_m, only: get_mass, get_charge
            use params_normalization_m, only: get_L_ref, get_rho_ref

            integer, intent(in) :: lb_stripped(5), ub_stripped(5)
            real(kind=GP), pointer, intent(in), dimension(:,:,:,:,:) :: &
                f_out
            real(kind=GP), intent(in) :: a, b, c, d, e, f, g, h, aa
            integer :: i, n, k, l ,m
            real(kind=GP) :: &
                x, z, phi, &
                charge, mass, temp_scaling, sqrt2m, sqrtT0, rho_ref, L_ref, &
                bps, curl_normb_y, absB, dgyxdz_over_g, dgyzdx_over_g, &
                dgyxdy_over_g, dgyzdy_over_g, dabsBdx, dabsBdz, dabsBdy, &
                dfdR, dfdZ, dfdu, dfdvp, dphidR, dphidZ, dphidu, &
                bR, bZ, bu, pb, curv_f, curv_H, par_f, par_H, vpsq, dAdu, &
                dAdR, dAdZ, flutter_vp, dHdR, dHdu, dHdZ, dbpardu, dbpardR, &
                dbpardZ
            real(kind=GP), contiguous, pointer, dimension(:) :: &
                vp_ptr, mu_ptr

            L_ref = get_L_ref()
            rho_ref = get_rho_ref()
            vp_ptr => mesh%get_vp_pointer()
            mu_ptr => mesh%get_mu_pointer()

            associate(er => equilibrium_reference)
            !$omp parallel default(none) &
            !$omp firstprivate(lb_stripped, ub_stripped) &
            !$omp shared(f_out, mesh, equilibrium_reference, a, b, c, d, e, &
            !$omp        f, g, h, aa, L_ref, rho_ref, vp_ptr, mu_ptr, &
            !$omp        is_compute) &
            !$omp private(i, k, l, m, n, &
            !$omp         charge, mass, temp_scaling, sqrt2m, sqrtT0, &
            !$omp         bR, bZ, bu, &
            !$omp         absB, curl_normb_y, dgyzdx_over_g, dgyxdz_over_g, &
            !$omp         dgyxdy_over_g, dgyzdy_over_g, dabsBdx, &
            !$omp         dabsBdy, dabsBdz, vpsq, dfdR, dfdZ, dfdu, dfdvp, &
            !$omp         dphidR, dphidZ, dphidu, bps, pb, &
            !$omp         curv_f, curv_H, par_f, par_H, dAdu, dAdR, dAdZ, &
            !$omp         x, z, phi, flutter_vp, dHdR, dHdu, dHdZ, dbpardu, &
            !$omp         dbpardR, dbpardZ)
            do n = lb_stripped(5), ub_stripped(5)
                ! precalculate sqrt(2*mass)
                sqrt2m = sqrt(2.0_GP * get_mass(n))
                sqrtT0 = sqrt(get_temp_scaling(n))
                temp_scaling = get_temp_scaling(n)
                charge = get_charge(n)
                mass = get_mass(n)
            do m = lb_stripped(4), ub_stripped(4)
            do l = lb_stripped(3), ub_stripped(3)
                ! precalculate vp^2
                vpsq = vp_ptr(l)**2
            do k = lb_stripped(2), ub_stripped(2)
            !$omp do schedule(static)
            do i = lb_stripped(1), ub_stripped(1)
                call mesh%RZphi(i, k, x, z, phi)

                ! get everything from the equi reference
                absB = er%absB(x, z, phi)
                bR = er%normb_x(x, z, phi)
                bZ = er%normb_z(x, z, phi)
                bu = er%normb_y(x, z, phi)
                curl_normb_y = er%curl_normb_y(x, z, phi)
                dgyzdx_over_g = er%dgyzdx(x, z, phi) / bu
                dgyxdz_over_g = er%dgyxdz(x, z, phi) / bu
                dgyxdy_over_g = er%dgyxdy(x, z, phi) / bu
                dgyzdy_over_g = er%dgyzdy(x, z, phi) / bu
                dabsBdx = er%dabsBdx(x, z, phi)
                dabsBdy = er%dabsBdy(x, z, phi)
                dabsBdz = er%dabsBdz(x, z, phi)

                ! derivatives of f
                dfdR = a
                dfdZ = b
                dfdu = (bR * dfdR + bZ * dfdZ)
                dfdvp = e
                ! derivatives of phi
                dphidR = c
                dphidZ = d
                dphidu = (bR * dphidR + bZ * dphidZ)
                ! derivatives of A_par
                dAdR = f
                dAdZ = g
                dAdu = (bR * dAdR + bZ * dAdZ)
                ! derivatives of B_par
                dbpardR = h
                dbpardZ = aa
                dbpardu = (bR * dbpardR + bZ * dbpardZ)
                ! derivatives of H
                dHdR = temp_scaling * mu_ptr(m) * dabsBdx &
                     + charge * dphidR &
                     + (rho_ref / L_ref)**2 * mass &
                          * (c**2 + d**2) / (absB**3) * dabsBdx &
                     + temp_scaling * mu_ptr(m) * dbpardR
                dHdu = temp_scaling * mu_ptr(m) * dabsBdy &
                     + charge * dphidu &
                     + (rho_ref / L_ref)**2 * mass &
                          * (c**2 + d**2) / (absB**3) * dabsBdy &
                     + temp_scaling * mu_ptr(m) * dbpardU
                dHdZ = temp_scaling * mu_ptr(m) * dabsBdz &
                     + charge * dphidZ &
                     + (rho_ref / L_ref)**2 * mass &
                          * (c**2 + d**2) / (absB**3) * dabsBdz &
                     + temp_scaling * mu_ptr(m) * dbpardZ

                ! calculate b parallel star
                bps = absB + sqrt2m * sqrtT0 * rho_ref / (charge * L_ref) &
                                    * vp_ptr(l) * curl_normb_y

                ! Calculate the Poisson brackets
                ! A.13 (b)
                pb = dfdZ * ( bR * dHdu - dHdR) + &
                     dfdR * (-bZ * dHdu + dHdZ) + &
                     dfdu * (-bR * dHdZ + bZ * dHdR)

                ! Calculate flutter in real space
                ! A.12 (a) 3rd-4th line (flutter terms)
                pb = pb - charge * vp_ptr(l) * 2.0_GP * sqrtT0 / sqrt2m &
                                 * (      (dAdZ * dfdR - dAdR * dfdZ) &
                                   + bR * (dAdu * dfdZ - dAdZ * dfdu) &
                                   + bZ * (dAdR * dfdu - dAdu * dfdR) )

                pb = pb / bu

                ! Contribution of the curvature term
                ! A.12 (a) 2nd line (1st and 2nd term)
                curv_f = 2.0_GP * vpsq * temp_scaling * &
                    (dgyxdy_over_g * dfdZ - dgyzdy_over_g * dfdR)
                ! A.14 (c) 2nd line + 6th line second part + 7th line
                curv_H = -vp_ptr(l) * &
                    (dgyxdy_over_g * dHdZ - dgyzdy_over_g * dHdR) * dfdvp

                ! add orthogonal terms
                f_out(i, k, l, m, n) = rho_ref / L_ref * &
                    (-pb + curv_f + curv_H) / (charge * bps)

                ! Contribution of the electromagnetic flutter
                ! A.14 (c) 3-5th + 8-10th line
                flutter_vp = -rho_ref / (L_ref * bu) * ( &
                        dHdZ * (bR * dAdu -      dAdR) &
                      + dHdu * (bZ * dAdR - bR * dAdz) &
                      + dHdR * (     dAdz - bz * dAdu)) * dfdvp &
                      / (bps * sqrt(2.0_GP * mass * temp_scaling))

                ! calculate the parallel advection
                ! A.12 (a) 1st line + 2nd line (last term)
                par_f = - vp_ptr(l) * dfdu / bps &
                      * ( sqrt(2.0_GP * temp_scaling / mass) * absB &
                        - 2.0_GP * temp_scaling * rho_ref / (charge * L_ref) &
                                 * vp_ptr(l) &
                                 * (dgyzdx_over_g - dgyxdz_over_g) )
                ! calculate the velocity space advection with
                ! A.14 (c) 1st line (1st term)
                !        + 2nd line (last term)
                !        + 7th line (last term)
                par_H = dHdu * dfdvp &
                      / (bps * sqrt(2.0_GP * mass * temp_scaling)) &
                      * (absB &
                        - vp_ptr(l) * rho_ref / (charge * L_ref) &
                                    * sqrt(2.0_GP * mass * temp_scaling) &
                                    * (dgyzdx_over_g - dgyxdz_over_g))

                f_out(i, k, l, m, n) = f_out(i, k, l, m, n) + &
                    par_H + par_f + flutter_vp

                f_out(i, k, l, m, n) = f_out(i, k, l, m, n) * is_compute(i, k)

            enddo
            !$omp end do nowait
            enddo
            enddo
            enddo
            enddo
            !$omp end parallel
            end associate
        end subroutine
    end subroutine

    @test(npes = [8])
    subroutine op_rhs_vlasov_eq_static(this)
        class (MpiTestMethod), intent(inout) :: this
        type(dcomm_handler_t), allocatable, target :: dcomm_handler
        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(mesh_5d_t), target, allocatable :: mesh
        type(salpha_reference_t) :: salpha_reference
        ! type(dommaschk_reference_t) :: dommaschk_reference

        real(kind=GP) :: tol

        ! NOTE: The unit test is currently not run for the SLAB and CIRCULAR
        !       equilibria because the default parameters for these equilibria
        !       are not suitable for the unit test. For SLAB the default box
        !       size is too large resulting in a very fine resolution in RZ. For
        !       CIRCULAR the limiter, and thus sheath boundary conditions,
        !       are enabled by default.
        ! TODO: The unit test needs to be further investigated with Dommaschk.

        if(this%getProcessRank() == 0) then
            write(logger_get_debug_channel(), *) ""
            write(logger_get_debug_channel(), *) &
                "Testing op_rhs_vlasov_eq_static_t"
        end if

        ! SALPHA
        tol = 5e-3_GP

        if(this%getProcessRank() == 0) then
            write(logger_get_debug_channel(), *) &
                "Testing with salpha equilibrium"
            write(logger_get_debug_channel(), *) &
                "    with tolerance = ", tol
        end if

        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=SALPHA, &
                             spacing_RZ=0.02_GP, &
                             n_points_phi=16, &
                             n_points_vp=3, &
                             n_points_mu=2, &
                             quad_type_vp="trapezoidal")

        call setup_test_gyrokinetic_system(this%getMpiCommunicator(), &
                                           this%getProcessRank(), &
                                           with_bpar=.true.)

        allocate(dcomm_handler)
        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                      this%getNumProcesses(), 1, 1, 1)
        dcomm_handler_ptr => dcomm_handler

        allocate(mesh)
        call mesh%initialize(dcomm_handler_ptr)

        call salpha_reference%initialize(q_ref = 0.854_GP, &
                                         shear = 2.184_GP, &
                                         minor_r = 0.365_GP, &
                                         L_ref = 1.0_GP, &
                                         B_ref = 1.0_GP)

        call test_op_rhs_vlasov_eq_static_core(dcomm_handler_ptr, mesh, &
                                               salpha_reference, tol)
        deallocate(mesh)
        deallocate(dcomm_handler)
    end subroutine

    @test(npes = [8])
    subroutine op_rhs_vlasov_eq_static_bsg(this)
        class (MpiTestMethod), intent(inout) :: this
        type(dcomm_handler_t), allocatable, target :: dcomm_handler
        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(mesh_5d_t), target, allocatable :: mesh
        type(salpha_reference_t) :: salpha_reference
        ! type(dommaschk_reference_t) :: dommaschk_reference

        real(kind=GP) :: tol, vp_length
        real(kind=GP), dimension(MAX_BLOCKS) :: vplen_markers, radial_markers

        ! TODO_BSG: Add GPU offload support for BSG to test here
        if(get_use_gpu_offload()) then
            write(logger_get_debug_channel(), "(A)") &
                "Unit testing is skipped because BSG is not supported on C++"
            return
        endif

        ! NOTE: The unit test is currently not run for the SLAB and CIRCULAR
        !       equilibria because the default parameters for these equilibria
        !       are not suitable for the unit test. For SLAB the default box
        !       size is too large resulting in a very fine resolution in RZ. For
        !       CIRCULAR the limiter, and thus sheath boundary conditions,
        !       are enabled by default.
        ! TODO: The unit test needs to be further investigated with Dommaschk.

        if(this%getProcessRank() == 0) then
            write(logger_get_debug_channel(), *) ""
            write(logger_get_debug_channel(), *) &
                "Testing op_rhs_vlasov_eq_static_t with BSG for same vp_grid"
        end if

        ! SALPHA
        tol = 3e-2_GP
        vp_length = 3.0_GP

        if(this%getProcessRank() == 0) then
            write(logger_get_debug_channel(), *) &
                "Testing with salpha equilibrium"
            write(logger_get_debug_channel(), *) &
                "    with tolerance = ", tol
        end if

        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=SALPHA, &
                             spacing_RZ=0.02_GP, &
                             n_points_phi=8, &
                             n_points_vp=5, &
                             length_vp=vp_length, &
                             n_points_mu=2, &
                             quad_type_vp="trapezoidal", &
                             use_bsg=.true.)

        vplen_markers(1:3) = vp_length
        radial_markers(1:2) = [0.2_GP, 0.4_GP]
        call setup_test_bsg(this%getMpiCommunicator(), &
                            this%getProcessRank(), &
                            vplen_markers=vplen_markers, &
                            radial_markers=radial_markers, &
                            num_blocks=3)

        allocate(dcomm_handler)
        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                      this%getNumProcesses(), 1, 1, 1)
        dcomm_handler_ptr => dcomm_handler

        allocate(mesh)
        call mesh%initialize(dcomm_handler_ptr)

        call salpha_reference%initialize(q_ref = 0.854_GP, &
                                         shear = 2.184_GP, &
                                         minor_r = 0.365_GP, &
                                         L_ref = 1.0_GP, &
                                         B_ref = 1.0_GP)

        call test_op_rhs_vlasov_eq_static_core(dcomm_handler_ptr, mesh, &
                                               salpha_reference, tol, &
                                               num_blocks=3)
        deallocate(mesh)
        deallocate(dcomm_handler)
    end subroutine

    subroutine test_op_rhs_vlasov_eq_dynamic_core(dcomm_handler, mesh, &
                                                  tol, &
                                                  num_blocks, interp_order)
        type(dcomm_handler_t), pointer, intent(in) :: dcomm_handler
        type(mesh_5d_t), target, intent(inout) :: mesh
        real(kind=GP), intent(in) :: tol
        integer, intent(in), optional :: num_blocks
        integer, intent(in), optional :: interp_order

        class(op_rhs_vlasov_eq_dynamic_t), allocatable :: op
        class(bsg_operators_t) , allocatable :: bsg_op
        type(data_storage_cpu_5d_t), target, allocatable :: &
            ds_f_in, ds_f_out, ds_f_expected
        type(data_storage_cpu_2d_t), target, allocatable :: ds_E_par_in
        class(data_array_5d_t), pointer :: da_f_in, da_f_out
        class(data_array_2d_t), pointer :: da_E_par_in

        real(kind=GP), contiguous, pointer, dimension(:,:,:,:,:) :: &
            f_in_ptr, f_expected_ptr, f_out_ptr
        real(kind=GP), contiguous, pointer, dimension(:,:) :: E_par_in_ptr
        real(kind=GP), contiguous, pointer, dimension(:,:) :: is_compute
        real(kind=GP) :: a
        integer, dimension(5) :: lb, ub, lb_stripped, ub_stripped
        integer :: n_rz, n_phi, n_vp, n_mu, n_sp
        integer :: i, k, l, m, n
        logical :: all_fine
        integer :: interp_order_default = 4, num_blocks_default = 2

        if(present(num_blocks)) num_blocks_default = num_blocks
        if(present(interp_order)) interp_order_default = interp_order

        if(get_use_gpu_offload()) then
#ifdef ENABLE_GPU
            allocate(op_rhs_vlasov_eq_dynamic_gpu_t :: op)
#endif
        else
            allocate(op_rhs_vlasov_eq_dynamic_cpu_t :: op)
        endif

        allocate(bsg_operators_t :: bsg_op)
        if (get_use_bsg()) then
            call bsg_op%initialize(mesh, num_blocks_default, &
                                   interp_order_default)
        else
            call bsg_op%initialize(mesh, 1)
        end if
        call op%initialize(mesh, bsg_op)
        allocate(ds_f_in, ds_f_out, ds_f_expected, ds_E_par_in)

        is_compute => mesh%get_is_compute_pointer()

        ! Allocate input data for the operator
        n_rz = mesh%size_RZ()
        n_phi = mesh%size_phi()
        n_vp = mesh%size_vp()
        n_mu = mesh%size_mu()
        n_sp = mesh%size_sp()

        call ds_f_in%initialize(dcomm_handler)
        call ds_E_par_in%initialize(dcomm_handler)
        call ds_f_out%initialize(dcomm_handler)
        call ds_f_expected%initialize(dcomm_handler)

        da_f_in     => ds_f_in%get_data_pointer()
        da_f_out    => ds_f_out%get_data_pointer()
        da_E_par_in => ds_E_par_in%get_data_pointer()

        f_in_ptr       => da_f_in%get_pointer()
        f_out_ptr      => da_f_out%get_pointer()
        f_expected_ptr => ds_f_expected%get_pointer()
        E_par_in_ptr   => da_E_par_in%get_pointer()
        lb = da_f_in%get_lbound()
        ub = da_f_in%get_ubound()
        lb_stripped = da_f_in%get_lbound_stripped()
        ub_stripped = da_f_in%get_ubound_stripped()

        a = 1.2_GP

        call init(lb_stripped, ub_stripped, f_in_ptr, E_par_in_ptr, a)
        call expected(lb_stripped, ub_stripped, f_in_ptr, E_par_in_ptr, &
                      f_expected_ptr, a)
        f_out_ptr = f_in_ptr

        ! Copy array to GPU. This does nothing if no GPU backend is specified
        call da_f_in%update_device()
        call da_E_par_in%update_device()
        call da_f_out%update_device()

        call op%apply(da_f_in, da_E_par_in, da_f_out)

        ! Copy array to CPU. This does nothing if no GPU backend is specified
        call da_f_out%update_host()

        block
            integer :: passed, failed, total
            real(kind=GP) :: frac_failed, frac_passed, maxabserr, &
                             maxrelerr, maxrelerr_f_ex, maxrelerr_check, &
                             maxrelerr_thread, maxrelerr_f_ex_thread

            passed = 0
            failed = 0
            maxabserr = 0.0_GP
            maxrelerr = 0.0_GP
            maxrelerr_f_ex = 0.0_GP

            all_fine = .true.
            !$omp parallel default(none) &
            !$omp firstprivate(lb_stripped, ub_stripped) &
            !$omp shared(f_expected_ptr, f_out_ptr, tol, &
            !$omp        failed, passed, maxabserr, maxrelerr, maxrelerr_f_ex, &
            !$omp        is_compute, all_fine) &
            !$omp private(i, k, l, m, n, &
            !$omp         maxrelerr_check, &
            !$omp         maxrelerr_thread, maxrelerr_f_ex_thread)

            maxrelerr_check  = 0.0_GP
            maxrelerr_thread = 0.0_GP
            maxrelerr_f_ex_thread = 0.0_GP

            do n = lb_stripped(5), ub_stripped(5)
            do m = lb_stripped(4), ub_stripped(4)
            do l = lb_stripped(3), ub_stripped(3)
            do k = lb_stripped(2), ub_stripped(2)
            !$omp do schedule(static) &
            !$omp reduction(+:failed, passed) &
            !$omp reduction(max:maxabserr)
            do i = lb_stripped(1), ub_stripped(1)
            if(is_compute(i, k) == 1.0_GP) then
                ! Check max errors

                maxabserr = max(maxabserr, &
                    abs(f_expected_ptr(i,k,l,m,n) - f_out_ptr(i,k,l,m,n)))

                maxrelerr_check = abs(1.0_GP - &
                               f_out_ptr(i,k,l,m,n) / f_expected_ptr(i,k,l,m,n))
                if(maxrelerr_check > maxrelerr_thread) then
                    maxrelerr_thread      = maxrelerr_check
                    maxrelerr_f_ex_thread = f_expected_ptr(i,k,l,m,n)
                endif

                ! Check for violation of tolerance
                if(f_expected_ptr(i,k,l,m,n) >= 1.0 &
                   .and. almost_equal(1.0_GP, f_out_ptr(i,k,l,m,n) / &
                                      f_expected_ptr(i,k,l,m,n), tol)) then
                    passed = passed + 1

                else if(f_expected_ptr(i,k,l,m,n) < 1.0 &
                        .and. almost_equal(f_expected_ptr(i,k,l,m,n), &
                                           f_out_ptr(i,k,l,m,n), tol)) then
                    passed = passed + 1

                else
                    failed = failed + 1
                endif
            else
                ! Check that non-compute points exactly equal the
                ! expected solution
                if(.not. almost_equal(f_expected_ptr(i,k,l,m,n), &
                                      f_out_ptr(i,k,l,m,n), GP_EPS)) then
                    all_fine = .false.
                endif
            endif
            enddo
            !$omp end do nowait
            enddo
            enddo
            enddo
            enddo
            !$omp critical
            if (maxrelerr_thread > maxrelerr) then
                maxrelerr      = maxrelerr_thread
                maxrelerr_f_ex = maxrelerr_f_ex_thread
            end if
            !$omp end critical
            !$omp end parallel

            total = failed + passed
            frac_failed = real(failed) / real(total)
            frac_passed = real(passed) / real(total)

            ! Log failed and passed tests
            write(logger_get_debug_channel(), *) failed, " / ", total , &
                " failed, (", frac_failed * 100.0_GP, "%)"
            write(logger_get_debug_channel(), *) passed, " / ", total , &
                " passed, (", frac_passed * 100.0_GP, "%)"

            ! Log max error
            write(logger_get_debug_channel(), *) &
                "maximum absolute error = ", maxabserr
            write(logger_get_debug_channel(), *) &
                "maximum relative error = ", maxrelerr
            write(logger_get_debug_channel(), *) &
                "        for f_expected = ", maxrelerr_f_ex

            if(frac_failed > 0.0_GP) all_fine = .false.

        end block
        @assertTrue(all_fine)

        deallocate(ds_E_par_in)
        deallocate(ds_f_expected)
        deallocate(ds_f_out)
        deallocate(ds_f_in)
        deallocate(op)

    contains

        subroutine init(lb_stripped, ub_stripped, f, E_par, a)
            !! Initialize f(vp) = a * vp + const
            !! and E_par = random
            integer, intent(in) :: lb_stripped(5), ub_stripped(5)
            real(kind=GP), intent(inout), contiguous, pointer, &
                dimension(:,:,:,:,:) :: f
            real(kind=GP), intent(inout), contiguous, pointer, &
                dimension(:,:) :: E_par
            real(kind=GP), intent(in) :: a

            integer :: i, n, k, l ,m, lb(5), ub(5)
            real(kind=GP) :: delta_vp, vp_min
            real(kind=GP), dimension(:), pointer :: vp_ptr

            lb = lbound(f)
            ub = ubound(f)

            vp_ptr => mesh%get_vp_pointer()
            delta_vp = mesh%delta_vp()
            vp_min = vp_ptr(1) - delta_vp

            !$omp parallel default(none) firstprivate(lb, ub) &
            !$omp shared(f, a, vp_min, delta_vp) &
            !$omp private(i, k, l, m, n)
            do n = lb(5), ub(5)
            do m = lb(4), ub(4)
            do l = lb(3), ub(3)
            do k = lb(2), ub(2)
            !$omp do schedule(static)
            do i = lb(1), ub(1)
                ! we calculate the value of vp explicitly to
                ! ensure that vp is also initialized as a
                ! linear function function for the ghost cells
                f(i, k, l, m, n) = a * (vp_min + l * delta_vp) + 5.29398_GP
            enddo
            !$omp end do nowait
            enddo
            enddo
            enddo
            enddo
            !$omp end parallel

            call random_number(E_par)
        end subroutine

        subroutine expected(lb_stripped, ub_stripped, f_in, E_par_in, f_ex, a)
            use params_species_m, only: get_mass, get_charge
            use params_normalization_m, only: get_L_ref, get_rho_ref

            integer, intent(in) :: lb_stripped(5), ub_stripped(5)
            real(kind=GP), pointer, intent(in), dimension(:,:,:,:,:) :: f_in
            real(kind=GP), pointer, intent(in), dimension(:,:) :: E_par_in
            real(kind=GP), pointer, intent(in), dimension(:,:,:,:,:) :: f_ex
            real(kind=GP), intent(in) :: a
            integer :: i, k, l, m, n

            !$omp parallel default(none) &
            !$omp firstprivate(lb_stripped, ub_stripped, a) &
            !$omp shared(f_in, f_ex, E_par_in, is_compute) &
            !$omp private(i, k, l, m, n)
            do n = lb_stripped(5), ub_stripped(5)
            do m = lb_stripped(4), ub_stripped(4)
            do l = lb_stripped(3), ub_stripped(3)
            do k = lb_stripped(2), ub_stripped(2)
            !$omp do schedule(static)
            do i = lb_stripped(1), ub_stripped(1)
                f_ex(i, k, l, m, n) = f_in(i, k, l, m, n) &
                    + get_charge(n) &
                    / sqrt(2.0_GP * get_mass(n) * get_temp_scaling(n)) &
                    * E_par_in(i, k) * a * is_compute(i, k)
            enddo
            !$omp end do nowait
            enddo
            enddo
            enddo
            enddo
            !$omp end parallel
        end subroutine
    end subroutine

    @test(npes = [4])
    subroutine op_rhs_vlasov_eq_dynamic(this)
        class (MpiTestMethod), intent(inout) :: this
        type(dcomm_handler_t), allocatable, target :: dcomm_handler
        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(mesh_5d_t), target, allocatable :: mesh

        real(kind=GP) :: tol

        tol = sqrt(GP_EPS)

        if(this%getProcessRank() == 0) then
            write(logger_get_debug_channel(), *) ""
            write(logger_get_debug_channel(), *) &
                "Testing op_rhs_vlasov_eq_dynamic_t"
            write(logger_get_debug_channel(), *) &
                "with tolerance = ", tol
        end if

        allocate(mesh)
        ! NOTE: The number of phi and mu points can be set to 1, as the operator
        !       requires derivatives only with respect to vpar.
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=SALPHA, &
                             spacing_RZ=0.02_GP, &
                             n_points_phi=1, &
                             n_points_vp=4, &
                             n_points_mu=1, &
                             quad_type_vp="trapezoidal")

        allocate(dcomm_handler)
        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                      1, this%getNumProcesses(), 1, 1)
        dcomm_handler_ptr => dcomm_handler

        if(dcomm_handler%is_master()) then
            write(logger_get_debug_channel(), *) &
                "Testing with salpha equilibrium"
        end if

        call mesh%initialize(dcomm_handler_ptr)

        ! on salpha test on relative errors is problematic

        call test_op_rhs_vlasov_eq_dynamic_core(dcomm_handler_ptr, &
                                                mesh, tol)
        deallocate(mesh)
        deallocate(dcomm_handler)

        allocate(mesh)
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=DOMMASCHK, &
                             spacing_RZ=0.012_GP, &
                             n_points_phi=1, &
                             n_points_vp=4, &
                             n_points_mu=1, &
                             quad_type_vp="trapezoidal")

        allocate(dcomm_handler)
        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                      1, this%getNumProcesses(), 1, 1)
        dcomm_handler_ptr => dcomm_handler

        if(dcomm_handler%is_master()) then
            write(logger_get_debug_channel(), *) &
            "Testing with Dommaschk equilibrium"
        end if

        call mesh%initialize(dcomm_handler_ptr)

        call test_op_rhs_vlasov_eq_dynamic_core(dcomm_handler_ptr, &
                                                mesh, tol)
        deallocate(mesh)
        deallocate(dcomm_handler)

    end subroutine

end module
