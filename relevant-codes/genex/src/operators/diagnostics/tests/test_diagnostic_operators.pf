module test_diagnostic_operators
    !! Contains tests for the diagnostic operators op_diag_mom_0d_t and
    !! op_diag_mom_2d_t
!$  use omp_lib
    use mpi
    use pfunit
    use, intrinsic :: iso_fortran_env
    use math_m, only: PI
    use genex_fortran_env_m, only: GP, GP_EPS
    use genex_error_handling_m, only: handle_error
    use genex_status_codes_m, only: GENEX_ERR_UTESTS
    use math_m, only: almost_equal
    use dcomm_handler_m, only: dcomm_handler_t
    use mesh_5d_m, only: mesh_5d_t
    use data_storage_m, only: data_storage_5d_t, data_storage_cpu_5d_t, &
                              data_storage_2d_t, data_storage_cpu_2d_t
    use data_array_m, only: data_array_2d_t, data_array_4d_t, &
                            data_array_5d_t
    use profiles_m, only: profile_cbc_cpu_t, profile_uniform_cpu_t
    use profile_container_m, only: profile_container_t
    use dist_initial_m, only: dist_initial_maxw_cpu_t
    use dist_initial_container_m, only: dist_initial_container_t
    use op_diag_mom_0d_m, only: op_diag_mom_0d_cpu_t
    use op_diag_mom_2d_m, only: op_diag_mom_2d_cpu_t
    use op_set_initial_condition_m, only: op_set_initial_condition_cpu_t
    use op_set_uniform_m, only: op_set_uniform_cpu_t
    use params_mesh_m, only: get_n_points_phi, get_n_points_mu, &
                             get_n_points_vp, get_n_points_sp
    use params_normalization_m, only: get_L_ref, get_rho_ref
    use params_species_m, only: get_mass, get_charge, get_temp_scaling, &
                                n_spec_supported
    use params_profile_cbc_m, only: params_profile_cbc_t, &
                                    get_params_profile_cbc_dens, &
                                    get_params_profile_cbc_temp
    use params_mesh_m, only: get_use_bsg
    use params_bsg_m, only: get_num_bsg_blocks, get_bsg_interp_order
    use bsg_operators_m, only: bsg_operators_t

    ! Unit test helpers
    use test_params_m

    ! From PARALLAX
    use equilibrium_m, only: equilibrium_t
    use equilibrium_factory_m, only: create_equilibrium, &
                                     CIRCULAR, CIRCULAR_TOROIDAL
    use csrmat_m, only : csrmat_t, csr_times_vec
    use polar_map_factory_m, only: create_polar_map_matrix
    use mesh_cart_m, only: mesh_cart_t
    use polar_grid_m, only : polar_grid_t

    implicit none

contains

    @before
    subroutine setup(this)
        ! Flush out all the default parameters
        class(MpiTestMethod), intent(inout) :: this
        real(kind=GP), dimension(n_spec_supported) :: temp_scalings

        ! Tests with different temp_scaling
        ! uses temp_scaling <= 1 to avoid error due to velocity cutoff
        temp_scalings  = [0.2_GP, 0.3_GP, 0.4_GP, 0.5_GP, &
                          0.6_GP, 0.7_GP, 0.8_GP, 0.9_GP]

        call setup_test_params(this%getMpiCommunicator(), &
                               this%getProcessRank())
        call setup_test_species(this%getMpiCommunicator(), &
                                this%getProcessRank(), &
                                temp_scalings=temp_scalings)
    end subroutine

    @after
    subroutine teardown(this)
        ! Read all the default parameters
        class(MpiTestMethod), intent(inout) :: this
        call teardown_test_params(this%getMpiCommunicator(), &
                                  this%getProcessRank())
    end subroutine

    @test(npes = [1, 2, 4, 8])
    subroutine op_diag_mom_2d(this)
        !! Tests the diagnostic operators op_diag_mom_2d_cpu_t
        class (MpiTestMethod), intent(inout) :: this
        type(dcomm_handler_t), target :: dcomm_handler
        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(mesh_5d_t), target, allocatable :: mesh

        type(profile_cbc_cpu_t) :: profile_dens, profile_temp
        type(params_profile_cbc_t) :: params
        type(profile_container_t), allocatable :: profile_container(:)
        type(dist_initial_maxw_cpu_t) :: dist_initial
        type(dist_initial_container_t), allocatable :: dist_initial_container(:)

        class(data_storage_5d_t), allocatable :: ds_f
        class(data_array_5d_t), pointer :: da_f
        class(data_array_4d_t), allocatable :: da_mom_2d
        type(op_diag_mom_2d_cpu_t) :: op_2d
        type(op_set_initial_condition_cpu_t) :: op_set_initial_condition
        class(bsg_operators_t), allocatable :: bsg_op

        real(kind=GP), parameter :: tol = 1e-2_GP
        real(kind=GP), pointer, contiguous, dimension(:,:,:,:) :: mom_2d
        real(kind=GP), pointer, contiguous, dimension(:,:,:,:,:) :: f_ptr
        real(kind=GP), pointer, contiguous, dimension(:) :: phi
        real(kind=GP), pointer, dimension(:,:) :: is_compute, rho, theta, absB
        real(kind=GP), pointer, dimension(:,:,:,:,:) :: f_ptr_stripped
        real(kind=GP) :: expected, res, dens, temp
        integer, dimension(5) :: lb_stripped, ub_stripped, lb, ub
        integer :: n_rz, n_phi, n_vp, n_mu, n_sp
        integer :: n, i, k, ierr
        integer :: n_procs, n_procs_phi, n_procs_vp, n_procs_mu, n_procs_sp

        n_procs = this%getNumProcesses()

        select case (n_procs)
        case (1)
            n_procs_phi = 1
            n_procs_vp  = 1
            n_procs_mu  = 1
            n_procs_sp  = 1
        case (2)
            n_procs_phi = 1
            n_procs_vp  = 2
            n_procs_mu  = 1
            n_procs_sp  = 1
        case (4)
            n_procs_phi = 1
            n_procs_vp  = 2
            n_procs_mu  = 2
            n_procs_sp  = 1
        case (8)
            n_procs_phi = 1
            n_procs_vp  = 2
            n_procs_mu  = 2
            n_procs_sp  = 2
        case default
            call handle_error("Unsupported n_procs in unit test!", &
                              GENEX_ERR_UTESTS, __LINE__, __FILE__)
        end select

        ! The result of this test is dominated by the error in the real space
        ! integration. Due to quadrature scheme the convergence is not good and
        ! we have to live with limited precision.

        allocate(mesh)
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=CIRCULAR, &
                             spacing_RZ=0.05_GP, &
                             n_points_phi=2, &
                             n_points_vp=30, &
                             n_points_mu=20, &
                             length_vp=7.0_GP, &
                             length_mu=49.0_GP)

        dcomm_handler_ptr => dcomm_handler
        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                     n_procs_phi, n_procs_vp, n_procs_mu, &
                                     n_procs_sp)

        call mesh%initialize(dcomm_handler_ptr)

        allocate(bsg_operators_t :: bsg_op)
        if (get_use_bsg()) then
            call bsg_op%initialize(mesh, get_num_bsg_blocks(), &
                                   get_bsg_interp_order())
        else
            call bsg_op%initialize(mesh, 1)
        endif

        ! Setup data storage
        n_rz  = mesh%size_RZ()
        n_phi = mesh%size_phi()
        n_vp  = mesh%size_vp()
        n_mu  = mesh%size_mu()
        n_sp  = mesh%size_sp()
        phi => mesh%get_phi_pointer()
        rho => mesh%get_rho_pointer()
        theta => mesh%get_theta_pointer()
        is_compute => mesh%get_is_compute_pointer()
        absB => mesh%get_absB_pointer()

        ! We need to test with a non-uniform real space profile to ensure
        ! the real space independence of the 2d moments

        allocate(profile_container(n_sp))
        do n = 1, n_sp
            params = get_params_profile_cbc_dens(n)
            call profile_dens%initialize(params)
            params = get_params_profile_cbc_temp(n)
            call profile_temp%initialize(params)
            ! Initialize isotropic profile with dens and temp
            call profile_container(n)%initialize(.true., profile_dens, &
                                    profile_temp, profile_temp, profile_temp)
        end do
        allocate(dist_initial_container(n_sp))
        do n = 1, n_sp
            call dist_initial%initialize(profile_container, n)
            call dist_initial_container(n)%initialize(dist_initial)
        end do

        allocate(data_storage_cpu_5d_t :: ds_f)
        call ds_f%initialize(dcomm_handler_ptr)
        da_f => ds_f%get_data_pointer()
        f_ptr => da_f%get_pointer()
        f_ptr_stripped => da_f%get_pointer_stripped()
        lb = da_f%get_lbound()
        ub = da_f%get_ubound()
        lb_stripped = da_f%get_lbound_stripped()
        ub_stripped = da_f%get_ubound_stripped()

        allocate(da_mom_2d)
        call da_mom_2d%initialize(&
            [lb_stripped(1), lb_stripped(2), 1, lb_stripped(5)], &
            [ub_stripped(1), ub_stripped(2), 8, ub_stripped(5)])
        mom_2d => da_mom_2d%get_pointer()

        call op_set_initial_condition%initialize(dcomm_handler_ptr, mesh, &
                                                 dist_initial_container, bsg_op)
        call op_2d%initialize(dcomm_handler_ptr, mesh, bsg_op)

        call op_set_initial_condition%apply(da_f)
        call op_2d%apply(da_f, da_mom_2d)

        ! Check the density integration
        do n = lb_stripped(5), ub_stripped(5)
        do k = lb_stripped(2), ub_stripped(2)
        do i = lb_stripped(1), ub_stripped(1)
        if(is_compute(i, k) == 1.0_GP) then
            call profile_container(n)%eval_dens(rho(i, k), theta(i, k), &
                                                phi(k), dens, ierr)
            call profile_container(n)%eval_temp(rho(i, k), theta(i, k), &
                                                phi(k), temp, ierr)

            ! NOTE: The diagnostics return the moments in laboratory
            !       coordinates. As the profile container initializes a
            !       Maxwellian in gyrocenter coordinates the precision of the
            !       comparison is limited.

            ! n
            expected = mom_2d(i, k, 1, n) / dens
            @assertEqual(expected, 1.0_GP, tol)

            ! u_par
            expected = mom_2d(i, k, 2, n)
            @assertEqual(expected, 0.0_GP, tol)

            ! E_par
            expected = mom_2d(i, k, 3, n) / (0.5_GP * temp * dens)
            @assertEqual(expected, 1.0_GP, tol)

            ! E_perp
            expected = mom_2d(i, k, 4, n) / (temp * dens)
            @assertEqual(expected, 1.0_GP, tol)

            ! Q_par
            expected = mom_2d(i, k, 5, n)
            @assertEqual(expected, 0.0_GP, tol)

            ! Q_perp
            expected = mom_2d(i, k, 6, n)
            @assertEqual(expected, 0.0_GP, tol)

            ! K_par
            expected = 5.0_GP / 2.0_GP &
                     * dens * temp**2.0_GP &
                     / get_charge(n) / absB(i, k) &
                     * get_rho_ref() / get_L_ref()
            res = mom_2d(i, k, 7, n)
            @assertEqual(expected, res, tol)

            ! K_perp
            expected = 5.0_GP * dens / 2.0_GP &
                     * temp**2.0_GP &
                     / get_charge(n) / absB(i, k)**2 &
                     * get_rho_ref() / get_L_ref()
            res = mom_2d(i, k, 8, n)
            @assertEqual(expected, res, tol)

        else
            ! Test that the moments are zeroed out for non-compute points
            @assertTrue(all(almost_equal(mom_2d(i, k, :, n), 0.0_GP, GP_EPS)))
        endif
        enddo
        enddo
        enddo

        deallocate(ds_f, da_mom_2d)
        deallocate(mesh)

    end subroutine

    @test(npes = [1])
    subroutine op_diag_mom_2d_tpc(this)
        !! Tests the diagnostic operators op_diag_mom_2d_cpu_t
        !! with TPC switch on
        class (MpiTestMethod), intent(inout) :: this
        type(dcomm_handler_t), target :: dcomm_handler
        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(mesh_5d_t), target, allocatable :: mesh

        type(profile_cbc_cpu_t) :: profile_dens, profile_temp
        type(params_profile_cbc_t) :: params
        type(profile_container_t), allocatable :: profile_container(:)
        type(dist_initial_maxw_cpu_t) :: dist_initial
        type(dist_initial_container_t), allocatable :: dist_initial_container(:)

        class(data_storage_5d_t), allocatable :: ds_f
        class(data_array_5d_t), pointer :: da_f
        class(data_array_4d_t), allocatable :: da_mom_2d
        class(data_array_4d_t), allocatable :: da_mom_2d_tpc
        type(op_diag_mom_2d_cpu_t), allocatable :: op_2d
        type(op_set_initial_condition_cpu_t), allocatable :: &
                                                        op_set_initial_condition

        class(equilibrium_t), target, allocatable :: equilibrium_instance
        type(csrmat_t), allocatable :: polar_map
        type(mesh_cart_t),  contiguous, pointer, dimension(:) :: mesh_3d_cart
        type(polar_grid_t), contiguous, pointer, dimension(:) :: mesh_3d_polar
        class(bsg_operators_t), allocatable :: bsg_op

        real(kind=GP), parameter :: tol = 1e-2_GP
        real(kind=GP), allocatable, dimension(:,:,:) :: polar_loss_cone, &
                                                        polar_mom_2d,    &
                                                        polar_mom_2d_tpc
        real(kind=GP), allocatable, dimension(:) :: term_1, term_2, term_3
        real(kind=GP), pointer, contiguous, dimension(:,:,:,:) :: mom_2d
        real(kind=GP), pointer, contiguous, dimension(:,:,:,:) :: mom_2d_tpc
        real(kind=GP), pointer, dimension(:,:,:) :: polar_absB
        real(kind=GP), pointer, dimension(:,:)   :: loss_cone
        real(kind=GP) :: expected
        integer, dimension(5) :: lb_stripped, ub_stripped
        integer, parameter :: equilibrium_types(*) = &
                                                   [CIRCULAR, CIRCULAR_TOROIDAL]
        integer, parameter :: polar_intorder = 3
        integer :: eq_type
        integer :: n_sp, n_polar_theta, n_polar_rho
        integer :: n, eq_i, p_j, k
        integer :: n_procs, n_procs_phi, n_procs_vp, n_procs_mu, n_procs_sp
        logical, parameter :: diagnose_tpc_test = .true.

        call setup_test_diagnostics(this%getMpiCommunicator(), &
                                    this%getProcessRank(), &
                                    diagnose_tpc=.true.)

        n_procs = this%getNumProcesses()

        n_procs_phi = 1
        n_procs_vp  = 1
        n_procs_mu  = 1
        n_procs_sp  = 1

        do eq_i = lbound(equilibrium_types, 1), ubound(equilibrium_types, 1)

            eq_type = equilibrium_types(eq_i)

            call create_equilibrium(equilibrium_instance, &
                                    eq_type, &
                                    dbgout = 0)

            allocate(mesh)
            call setup_test_mesh(this%getMpiCommunicator(), &
                                 this%getProcessRank(), &
                                 equilibrium_type = eq_type, &
                                 spacing_RZ       = 0.05_GP, &
                                 n_points_phi     = 2, &
                                 n_points_vp      = 30, &
                                 n_points_mu      = 20, &
                                 length_vp        = 7.0_GP, &
                                 length_mu        = 49.0_GP)

            dcomm_handler_ptr => dcomm_handler
            call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                          n_procs_phi, n_procs_vp, n_procs_mu, &
                                          n_procs_sp)

            call mesh%initialize(dcomm_handler_ptr)

            allocate(bsg_operators_t :: bsg_op)
            if (get_use_bsg()) then
                call bsg_op%initialize(mesh, get_num_bsg_blocks(), &
                                       get_bsg_interp_order())
            else
                call bsg_op%initialize(mesh, 1)
            endif

            ! Setup data storage
            n_sp          =  mesh%size_sp()
            polar_absB    => mesh%get_polar_absB_pointer()
            loss_cone     => mesh%get_loss_cone_pointer()
            mesh_3d_cart  => mesh%get_mesh_3d()
            mesh_3d_polar => mesh%get_mesh_3d_pol()

            allocate(profile_container(n_sp))
            do n = 1, n_sp
                params = get_params_profile_cbc_dens(n)
                call profile_dens%initialize(params)
                params = get_params_profile_cbc_temp(n)
                call profile_temp%initialize(params)
                ! Initialize isotropic profile with dens and temp
                call profile_container(n)%initialize(.true., profile_dens, &
                                       profile_temp, profile_temp, profile_temp)
            end do
            allocate(dist_initial_container(n_sp))
            do n = 1, n_sp
                call dist_initial%initialize(profile_container, n)
                call dist_initial_container(n)%initialize(dist_initial)
            end do

            allocate(data_storage_cpu_5d_t :: ds_f)
            call ds_f%initialize(dcomm_handler_ptr)
            da_f           => ds_f%get_data_pointer()
            lb_stripped    =  da_f%get_lbound_stripped()
            ub_stripped    =  da_f%get_ubound_stripped()

            allocate(da_mom_2d, da_mom_2d_tpc)
            call da_mom_2d%initialize(&
                          [lb_stripped(1), lb_stripped(2), 1, lb_stripped(5)], &
                          [ub_stripped(1), ub_stripped(2), 8, ub_stripped(5)])
            call da_mom_2d_tpc%initialize(&
                          [lb_stripped(1), lb_stripped(2), 1, lb_stripped(5)], &
                          [ub_stripped(1), ub_stripped(2), 8, ub_stripped(5)])
            mom_2d     => da_mom_2d%get_pointer()
            mom_2d_tpc => da_mom_2d_tpc%get_pointer()

            allocate(op_set_initial_condition, op_2d)

            call op_set_initial_condition%initialize(dcomm_handler_ptr, mesh, &
                                                     dist_initial_container, &
                                                     bsg_op)
            call op_2d%initialize(dcomm_handler_ptr, mesh, bsg_op)

            call op_set_initial_condition%apply(da_f)
            call op_2d%apply(da_f, da_mom_2d)
            call op_2d%apply(da_f, da_mom_2d_tpc, diagnose_tpc_test)

            if (abs(eq_type - CIRCULAR) < tol) then

                ! B = B_max in every theta for each rho, phi
                @assertTrue(all(abs(mom_2d_tpc(:, :, 1, :)) < tol))

            else if (abs(eq_type - CIRCULAR_TOROIDAL) < tol) then

                ! The test reproduces doi.org/10.1063/5.0144688 fig. 16
                ! relation: n_trapped/n_total should match sqrt(1-B/B_max)

                do n = lb_stripped(5), ub_stripped(5)
                do k = lb_stripped(2), ub_stripped(2)

                    n_polar_theta = mesh%size_polar_theta(k)
                    n_polar_rho   = mesh%size_polar_rho(k)

                    allocate(polar_loss_cone(n_polar_theta, n_polar_rho, 1))
                    allocate(polar_mom_2d, polar_mom_2d_tpc, &
                             mold=polar_loss_cone)

                    call create_polar_map_matrix(polar_map, &
                                                 equilibrium_instance,  &
                                                 mesh_3d_cart(k), &
                                                 mesh_3d_polar(k), &
                                                 polar_intorder)

                    call csr_times_vec(polar_map, loss_cone(:, k), &
                                                  polar_loss_cone(:, :, 1))
                    call csr_times_vec(polar_map, mom_2d(:, k, 1, n), &
                                                  polar_mom_2d(:, :, 1))
                    call csr_times_vec(polar_map, mom_2d_tpc(:, k, 1, n), &
                                                  polar_mom_2d_tpc(:, :, 1))

                    do p_j = 1, n_polar_rho

                        ! From the condition
                        !   n_trap/n_t = sqrt(1 - B_polar/(B_polar + loss_cone))
                        ! and to avoid dividing by zero, we test instead:
                        !     n_t^2    * (B_polar + loss_cone)   ->   term_1
                        !   - n_t^2    *  B_polar                ->   term_2
                        !   - n_trap^2 * (B_polar + loss_cone)   ->   term_3
                        !   = 0

                        allocate(term_1(n_polar_theta))
                        allocate(term_2, term_3, &
                                 mold=term_1)

                        term_1 = + polar_mom_2d(:, p_j, 1)**2 &
                                   * (polar_absB(:, p_j, k) &
                                      + polar_loss_cone(:, p_j, 1))
                        term_2 = - polar_mom_2d(:, p_j, 1)**2 &
                                   * polar_absB(:, p_j, k)
                        term_3 = - polar_mom_2d_tpc(:, p_j, 1)**2 &
                                   * (polar_absB(:, p_j, k) &
                                      + polar_loss_cone(:, p_j, 1))

                        expected = sqrt( sum((term_1 + term_2 + term_3)**2) ) &
                                   / n_polar_theta

                        @assertEqual(expected, 0.0_GP, tol)

                        deallocate(term_1, term_2, term_3)

                    enddo

                    deallocate(polar_loss_cone, polar_mom_2d, polar_mom_2d_tpc)

                enddo
                enddo

            endif

            deallocate(op_set_initial_condition, op_2d)
            deallocate(ds_f, da_mom_2d, da_mom_2d_tpc)
            deallocate(dist_initial_container, profile_container)
            deallocate(mesh)
            deallocate(bsg_op)

        enddo

    end subroutine

    @test(npes = [1, 2, 4, 8])
    subroutine op_diag_mom_0d(this)
        !! Tests the diagnostic operators op_diag_mom_0d_cpu_t
        class (MpiTestMethod), intent(inout) :: this
        type(dcomm_handler_t), target :: dcomm_handler
        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(mesh_5d_t), target, allocatable :: mesh

        type(profile_cbc_cpu_t) :: profile_dens, profile_temp
        type(params_profile_cbc_t) :: params
        type(profile_container_t), allocatable :: profile_container(:)
        type(dist_initial_maxw_cpu_t) :: dist_initial
        type(dist_initial_container_t), allocatable :: dist_initial_container(:)
        class(bsg_operators_t), allocatable :: bsg_op

        class(data_storage_5d_t), allocatable :: ds_f
        class(data_array_5d_t), pointer :: da_f
        class(data_storage_2d_t), allocatable :: ds_phi
        class(data_array_2d_t), pointer :: da_phi
        class(data_array_2d_t), allocatable :: da_mom_0d
        type(op_diag_mom_0d_cpu_t) :: op_0d
        type(op_set_initial_condition_cpu_t) :: op_set_initial_condition
        type(op_set_uniform_cpu_t) :: op_set_uniform_2d

        real(kind=GP), parameter :: tol = 1e-2_GP
        real(kind=GP), pointer, contiguous, dimension(:,:) :: mom_0d
        real(kind=GP), pointer, contiguous, dimension(:,:,:,:,:) :: f_ptr
        real(kind=GP), pointer, dimension(:,:,:,:,:) :: f_ptr_stripped
        real(kind=GP), pointer, contiguous, dimension(:,:) :: phi_ptr, RZw, &
                                                              jacobian
        real(kind=GP), pointer, contiguous, dimension(:) :: phiw
        real(kind=GP), pointer, dimension(:,:) :: phi_ptr_stripped
        real(kind=GP) :: expected, volume
        integer :: lb_stripped(5), ub_stripped(5), lb(5), ub(5)
        integer :: n_rz, n_phi, n_vp, n_mu, n_sp
        integer :: n, i, k
        integer :: n_procs, n_procs_phi, n_procs_vp, n_procs_mu, n_procs_sp

        n_procs = this%getNumProcesses()

        select case (n_procs)
        case (1)
            n_procs_phi = 1
            n_procs_vp  = 1
            n_procs_mu  = 1
            n_procs_sp  = 1
        case (2)
            n_procs_phi = 1
            n_procs_vp  = 2
            n_procs_mu  = 1
            n_procs_sp  = 1
        case (4)
            n_procs_phi = 1
            n_procs_vp  = 2
            n_procs_mu  = 2
            n_procs_sp  = 1
        case (8)
            n_procs_phi = 2
            n_procs_vp  = 1
            n_procs_mu  = 2
            n_procs_sp  = 2
        case default
            call handle_error("Unsupported n_procs in unit test!", &
                              GENEX_ERR_UTESTS, __LINE__, __FILE__)
        end select

        allocate(mesh)
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=CIRCULAR, &
                             spacing_RZ=0.1_GP, &
                             n_points_phi=2, &
                             n_points_vp=24, &
                             n_points_mu=8, &
                             length_vp=7.0_GP, &
                             length_mu=49.0_GP, &
                             quad_type_vp="simpson", &
                             grid_type_mu="gauss-laguerre")

        dcomm_handler_ptr => dcomm_handler
        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                     n_procs_phi, n_procs_vp, n_procs_mu, &
                                     n_procs_sp)

        call mesh%initialize(dcomm_handler_ptr)

        allocate(bsg_operators_t :: bsg_op)
        if (get_use_bsg()) then
            call bsg_op%initialize(mesh, get_num_bsg_blocks(), &
                                   get_bsg_interp_order())
        else
            call bsg_op%initialize(mesh, 1)
        endif

        ! Setup data storage
        n_rz = mesh%size_RZ()
        n_phi= mesh%size_phi()
        n_vp = mesh%size_vp()
        n_mu = mesh%size_mu()
        n_sp = mesh%size_sp()

        ! We need to test with a non-uniform real space profile to see if the
        ! diagnostic correctly integrates a space dependent function.
        ! NOTE: The parameters of the profiles are chosen such that the
        !       integrals are approximately one. The exact numbers are given
        !       below in the comparison.
        allocate(profile_container(n_sp))
        do n = 1, n_sp
            ! Initialize density profile parameters
            params = get_params_profile_cbc_dens(n)
            params%kappa  = 2.22_GP
            params%prefac = 1.0_GP
            params%delta  = 0.04_GP
            params%center = 0.30485_GP
            call profile_dens%initialize(params)

            ! Initialize temperature profile parameters
            params = get_params_profile_cbc_temp(n)
            params%kappa  = 6.91_GP
            params%prefac = 1.0_GP
            params%delta  = 0.04_GP
            params%center = 0.30485_GP
            call profile_temp%initialize(params)

            ! Initialize isotropic profile with dens and temp
            call profile_container(n)%initialize(.true., profile_dens, &
                                    profile_temp, profile_temp, profile_temp)
        end do
        allocate(dist_initial_container(n_sp))
        do n = 1, n_sp
            call dist_initial%initialize(profile_container, n)
            call dist_initial_container(n)%initialize(dist_initial)
        end do

        allocate(data_storage_cpu_5d_t :: ds_f)
        call ds_f%initialize(dcomm_handler_ptr)
        da_f => ds_f%get_data_pointer()
        allocate(data_storage_cpu_2d_t :: ds_phi)
        call ds_phi%initialize(dcomm_handler_ptr)
        da_phi => ds_phi%get_data_pointer()

        f_ptr => da_f%get_pointer()
        f_ptr_stripped => da_f%get_pointer_stripped()
        phi_ptr => da_phi%get_pointer()
        phi_ptr_stripped => da_phi%get_pointer_stripped()
        lb = da_f%get_lbound()
        ub = da_f%get_ubound()
        lb_stripped = da_f%get_lbound_stripped()
        ub_stripped = da_f%get_ubound_stripped()

        allocate(da_mom_0d)
        call da_mom_0d%initialize([1, lb_stripped(5)], [6, ub_stripped(5)])
        mom_0d => da_mom_0d%get_pointer()

        call op_set_initial_condition%initialize(dcomm_handler_ptr, mesh, &
                                                 dist_initial_container, bsg_op)
        call op_0d%initialize(dcomm_handler_ptr, mesh, bsg_op)

        call op_set_initial_condition%apply(da_f)
        call op_set_uniform_2d%apply(phi_ptr, 2.78_GP)
        call op_0d%apply(da_f, da_phi, da_mom_0d)

        RZw      => mesh%get_RZw_pointer()
        jacobian => mesh%get_jacobian_pointer()
        phiw     => mesh%get_phiw_pointer()

        volume = 0.0_GP
        do k = 1, n_phi
        do i = 1, n_rz
            volume = volume + RZw(i, k) * jacobian(i, k) * phiw(k)
        enddo
        enddo

        ! NOTE: The reference numbers are calculated analytically for a circular
        !       annulus given the profiles above. Since the mesh is generated
        !       with a polygon boundary, the reference values only converge
        !       with first order due to the mesh generation, not the quadrature.
        ! TODO: A second order convergence of the quadrature could be checked
        !       by calculating reference values on the domain created by the
        !       polygon boundaries.
        do n = lb_stripped(5), ub_stripped(5)
            ! n
            expected = mom_0d(1, n) / volume
            @assertEqual(expected, 0.994774_GP, tol)

            ! u_par
            expected = mom_0d(2, n)
            @assertEqual(expected, 0.0_GP, tol)

            ! E_par
            expected = mom_0d(3, n) / (volume * 0.5_GP)
            @assertEqual(expected, 0.999596_GP, tol)

            ! E_perp
            expected = mom_0d(4, n) / volume
            @assertEqual(expected, 0.999596_GP, tol)

            ! E_es
            expected = mom_0d(5, n) &
                       / (0.5_GP * volume * 2.78_GP * get_charge(n))
            @assertEqual(expected, 0.994774_GP, tol)
        enddo

        deallocate(da_mom_0d)
        deallocate(ds_f, ds_phi)
        deallocate(mesh)

    end subroutine

end module
