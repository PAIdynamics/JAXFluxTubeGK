@article{Krychowiak2023,
  title = {First feedback-controlled divertor detachment in {{W7-X}}: {{Experience}} from {{TDU}} operation and prospects for operation with actively cooled divertor},
  author = {Krychowiak, M and K{\"o}nig, R and Barbui, T and Brezinsek, S and Brunner, J and Effenberg, F and Endler, M and Feng, Y and Flom, E and Gao, Y and Gradic, D and Hacker, P and Harris, J and Hirsch, M and H{\"o}fel, U and Jakubowski, M and Kornejew, P and Otte, M and Pandey, A and Pedersen, T and Puig, A and Reimold, F and Schmitz, O and Schr{\"o}der, T and Winters, V and Zhang, D},
