        @assertEqual(lb_ref, lbound(arr_ptr))
        @assertEqual(ub_ref, ubound(arr_ptr))

        ! Assert array properties from data_array_t readonly pointer
        arr_ptr => da%get_readonly_pointer()
        @assertEqual(shp_ref, shape(arr_ptr))
        @assertEqual(lb_ref, lbound(arr_ptr))
        @assertEqual(ub_ref, ubound(arr_ptr))

        arr_ptr => da%get_readonly_pointer_stripped()
        @assertEqual(shp_ref, shape(arr_ptr))
        @assertEqual(lb_ref, lbound(arr_ptr))
        @assertEqual(ub_ref, ubound(arr_ptr))
        deallocate(da)

        ! Test set initial value feature
        allocate(da)
        call da%initialize(lb_ref, ub_ref, val=initial_value)
        call assert_data_array_interface(array_dim, lb_ref, ub_ref, da)
        arr_ptr => da%get_pointer()
        @assertEqual(initial_value, arr_ptr, tolerance=GP_EPS)
        deallocate(da)

        ! Test mold feature
        allocate(da_mold)
        allocate(da)
        call da_mold%initialize(lb_ref, ub_ref, val=initial_value)
        call da%initialize(mold=da_mold, val=initial_value)
        call assert_data_array_interface(array_dim, lb_ref, ub_ref, da_mold)
        arr_ptr => da_mold%get_pointer()
        @assertEqual(initial_value, arr_ptr, tolerance=GP_EPS)
        deallocate(da, da_mold)
    end subroutine

end module
