! Matched W7-X ITG reference for stellarator_gk.
! Generated by scripts/prepare_stella_w7x_reference_run.py.
! Physics provenance: GX ITG_w7x adiabatic-electron input.

&geometry_options
  geometry_option = 'vmec'
/

&geometry_vmec
  alpha0 = 0
  zeta_center = 0.0
  nfield_periods = 34.75236
  torflux = 0.64
  vmec_filename = 'wout_w7x.nc'
/

&gyrokinetic_terms
  include_nonlinear = .false.
/

&diagnostics
  nsave = 100
  nwrite = 10
  save_for_restart = .false.
  write_all_time_traces = .true.
  write_all_spectra_kxkyz = .true.
  write_all_spectra_kxky = .true.
  write_all_velocity_space = .false.
  write_all_potential = .true.
  write_all_omega = .true.
  write_all_distribution = .false.
  write_all_fluxes = .true.
/

&initialise_distribution
  initialise_distribution_option = 'default'
  phiinit = 1.0e-10
/

&initialise_distribution_maxwellian
  width0 = 1.0
/

&species_options
  nspec = 1
/

&species_parameters_1
  z = 1.0
  mass = 1.0
  dens = 1.0
  temp = 1.0
  fprim = 1.0
  tprim = 3.0
  type = 'ion'
/

&adiabatic_electron_response
  adiabatic_option = 'field-line-average-term'
  tite = 1.0
  nine = 1.0
/

&kxky_grid_option
  grid_option = 'range'
/

&kxky_grid_range
  aky_min = 0
  aky_max = 0.3
  nakx = 1
  naky = 4
/

&z_grid
  nperiod = 1
  nzed = 256
  zed_equal_arc = .true.
/

&velocity_grids
  nmu = 8
  nvgrid = 16
/

&time_trace_options
  tend = 200
/

&time_step
  delt = 0.1
/

&dissipation_and_collisions_options
  hyper_dissipation = .false.
  include_collisions = .false.
/

&parallelisation
  lu_option = 'local'
/
