module test_data_array_gpu
    !! Contains tests for C++ functionalities of the data_array_2d_t,
    !! data_array_4d_t, data_array_5d_t types
    use pfunit
    use, intrinsic :: iso_c_binding, only: c_loc, C_INTPTR_T, C_PTR
    use genex_fortran_env_m, only: GP, GP_EPS
    use data_array_m, only: data_array_t, data_array_2d_t, data_array_3d_t, &
                            data_array_4d_t, data_array_5d_t
    use data_array_gpu_m, only: data_array_data_t
    use helpers_data_array_gpu_m, only: cbind_data_array_2d_copy, &
                                        cbind_data_array_3d_copy, &
                                        cbind_data_array_4d_copy, &
                                        cbind_data_array_5d_copy, &
                                        cbind_data_array_2d_add, &
                                        cbind_data_array_3d_add, &
                                        cbind_data_array_4d_add, &
                                        cbind_data_array_5d_add, &
                                        assert_device_pointer, &
                                        cbind_data_array_set_uniform
    ! Unit test helpers
    use test_params_m, only: setup_test_gpu_offload

    implicit none

    real(kind=GP), private, parameter :: init_value = 2.71828_GP
    real(kind=GP), private, parameter :: add_value  = 6.90235_GP
    real(kind=GP), private, parameter :: dev_value  = 1.78395_GP

contains

    @test(npes = [8])
    subroutine test_initialize_params_gpu_offload(this)
        !! Initialize the GPU offloading backend to CPU or GPU
        class(MpiTestMethod), intent(inout) :: this
        call setup_test_gpu_offload(this%getMpiCommunicator(), &
                                    this%getProcessRank())
    end subroutine

    @test
    subroutine test_data_array_2d_gpu()
        !! Tests C++ functionalities of data_array_2d_t
        type(data_array_2d_t), allocatable :: da
        integer, parameter :: array_dim = 2
        integer :: lb_ref(array_dim), ub_ref(array_dim), shp_ref(array_dim)
        real(kind=GP), dimension(:,:), pointer :: arr_ptr

        lb_ref  = [1, 2]
        ub_ref  = [2, 3]

        allocate(da)
        call da%initialize(lb_ref, ub_ref, val=init_value)
        call test_data_array_cxx_access(da)
        deallocate(da)
    end subroutine

    @test
    subroutine test_data_array_3d_gpu()
        !! Tests C++ functionalities of data_array_3d_t
        type(data_array_3d_t), allocatable :: da
        integer, parameter :: array_dim = 3
        integer :: lb_ref(array_dim), ub_ref(array_dim), shp_ref(array_dim)
        real(kind=GP), dimension(:,:,:), pointer :: arr_ptr

        lb_ref  = [1, 2, 3]
        ub_ref  = [2, 3, 4]

        allocate(da)
        call da%initialize(lb_ref, ub_ref, val=init_value)
        call test_data_array_cxx_access(da)
        deallocate(da)
    end subroutine

    @test
    subroutine test_data_array_4d_gpu()
        !! Tests C++ functionalities of data_array_4d_t
        type(data_array_4d_t), allocatable :: da
        integer, parameter :: array_dim = 4
        integer :: lb_ref(array_dim), ub_ref(array_dim), shp_ref(array_dim)
        real(kind=GP), dimension(:,:,:,:), pointer :: arr_ptr

        lb_ref  = [1, 2, 3, 4]
        ub_ref  = [2, 3, 4, 5]

        allocate(da)
        call da%initialize(lb_ref, ub_ref, val=init_value)
        call test_data_array_cxx_access(da)
        deallocate(da)
    end subroutine

    @test
    subroutine test_data_array_5d_gpu()
        !! Tests C++ functionalities of data_array_5d_t
        type(data_array_5d_t), allocatable :: da
        integer, parameter :: array_dim = 5
        integer :: lb_ref(array_dim), ub_ref(array_dim), shp_ref(array_dim)
        real(kind=GP), dimension(:,:,:,:,:), pointer :: arr_ptr

        lb_ref  = [1, 2, 3, 4, 5]
        ub_ref  = [2, 3, 4, 5, 6]

        allocate(da)
        call da%initialize(lb_ref, ub_ref, val=init_value)
        call test_data_array_cxx_access(da)
        deallocate(da)
    end subroutine

    subroutine test_data_array_cxx_access(da_src)
        !! Test the data exposure of data array to C++ including
        !! the multidimensional array access from C++ class methods
        class(data_array_t), intent(inout) :: da_src

        type(data_array_data_t) :: data_tgt
        integer, contiguous, pointer, dimension(:) :: shp_tgt, shp_s_tgt, &
            lb_tgt, ub_tgt, lb_s_tgt, ub_s_tgt
        integer :: ierr
        integer(kind=C_INTPTR_T) :: address_distance

        ! Allocate the target data array members
        allocate(shp_tgt(da_src%get_dimension()))
        allocate(shp_s_tgt(da_src%get_dimension()))
        allocate(lb_tgt(da_src%get_dimension()))
        allocate(ub_tgt(da_src%get_dimension()))
        allocate(lb_s_tgt(da_src%get_dimension()))
        allocate(ub_s_tgt(da_src%get_dimension()))

        ! Initialize da data and assign the C pointer to the target da members
        data_tgt%array_dim            = 0
        data_tgt%array_size           = 0
        data_tgt%array_size_stripped  = 0
        data_tgt%is_distributed_array = 1
        data_tgt%array_shape_ptr          = c_loc(shp_tgt)
        data_tgt%array_shape_stripped_ptr = c_loc(shp_s_tgt)
        data_tgt%array_lb_ptr             = c_loc(lb_tgt)
        data_tgt%array_ub_ptr             = c_loc(ub_tgt)
        data_tgt%array_lb_stripped_ptr    = c_loc(lb_s_tgt)
        data_tgt%array_ub_stripped_ptr    = c_loc(ub_s_tgt)

        ! Copy the da class members from the source class to the target class
        ! via C++
        ierr = 1

        select type(da_src)
            type is(data_array_2d_t)
                ierr = cbind_data_array_2d_copy(da_src%get_cxx_pointer(), &
                                                data_tgt)
            type is(data_array_3d_t)
                ierr = cbind_data_array_3d_copy(da_src%get_cxx_pointer(), &
                                                data_tgt)
            type is(data_array_4d_t)
                ierr = cbind_data_array_4d_copy(da_src%get_cxx_pointer(), &
                                                data_tgt)
            type is(data_array_5d_t)
                ierr = cbind_data_array_5d_copy(da_src%get_cxx_pointer(), &
                                                data_tgt)
        end select

        @assertEqual(0, ierr)

        ! Assert class member
        @assertEqual(da_src%get_dimension(), data_tgt%array_dim)
        @assertEqual(da_src%get_size(), data_tgt%array_size)
        @assertEqual(da_src%get_size_stripped(), data_tgt%array_size_stripped)
        @assertEqual(0, data_tgt%is_distributed_array)

        @assertEqual(da_src%get_shape(), shp_tgt)
        @assertEqual(da_src%get_shape_stripped(), shp_s_tgt)
        @assertEqual(da_src%get_lbound(), lb_tgt)
        @assertEqual(da_src%get_ubound(), ub_tgt)
        @assertEqual(da_src%get_lbound_stripped(), lb_s_tgt)
        @assertEqual(da_src%get_ubound_stripped(), ub_s_tgt)

        ! Deallocate memory
        Deallocate(shp_tgt, shp_s_tgt, lb_tgt, ub_tgt, lb_s_tgt, ub_s_tgt)

        ! Assert device pointer getter by calculating the distance in memory
        address_distance = assert_device_pointer(da_src)
        @assertEqual(0, address_distance)

        ! Test pointer getters and C++/GPU array access of data array
        call test_pointer_getters(da_src)
        call test_readonly_pointer_getters(da_src)
        call test_array_cxx_access(da_src)

    contains

        subroutine test_pointer_getters(da)
            !! Test pointer getters of data array by checking the bounds
            class(data_array_t), intent(inout) :: da

            real(kind=GP), contiguous, pointer, dimension(:,:) :: h2d, d2d
            real(kind=GP), contiguous, pointer, dimension(:,:,:) :: h3d, d3d
            real(kind=GP), contiguous, pointer, dimension(:,:,:,:) :: h4d, d4d
            real(kind=GP), contiguous, pointer, dimension(:,:,:,:,:) :: h5d, d5d

            select type(da)
                type is(data_array_2d_t)
                    h2d => da%get_pointer()
                    d2d => da%get_device_pointer()
                    @assertEqual(lbound(h2d), lbound(d2d))
                    @assertEqual(ubound(h2d), ubound(d2d))

                type is(data_array_3d_t)
                    h3d => da%get_pointer()
                    d3d => da%get_device_pointer()
                    @assertEqual(lbound(h3d), lbound(d3d))
                    @assertEqual(ubound(h3d), ubound(d3d))

                type is(data_array_4d_t)
                    h4d => da%get_pointer()
                    d4d => da%get_device_pointer()
                    @assertEqual(lbound(h4d), lbound(d4d))
                    @assertEqual(ubound(h4d), ubound(d4d))

                type is(data_array_5d_t)
                    h5d => da%get_pointer()
                    d5d => da%get_device_pointer()
                    @assertEqual(lbound(h5d), lbound(d5d))
                    @assertEqual(ubound(h5d), ubound(d5d))

            end select
        end subroutine

        subroutine test_readonly_pointer_getters(da)
            !! Test readonly pointer getters of data array by checking
            !! the bounds
            class(data_array_t), intent(in) :: da

            real(kind=GP), contiguous, pointer, dimension(:,:) :: h2d, d2d
            real(kind=GP), contiguous, pointer, dimension(:,:,:) :: h3d, d3d
            real(kind=GP), contiguous, pointer, dimension(:,:,:,:) :: h4d, d4d
            real(kind=GP), contiguous, pointer, dimension(:,:,:,:,:) :: h5d, d5d

            select type(da)
                type is(data_array_2d_t)
                    h2d => da%get_readonly_pointer()
                    d2d => da%get_readonly_device_pointer()
                    @assertEqual(lbound(h2d), lbound(d2d))
                    @assertEqual(ubound(h2d), ubound(d2d))

                type is(data_array_3d_t)
                    h3d => da%get_readonly_pointer()
                    d3d => da%get_readonly_device_pointer()
                    @assertEqual(lbound(h3d), lbound(d3d))
                    @assertEqual(ubound(h3d), ubound(d3d))

                type is(data_array_4d_t)
                    h4d => da%get_readonly_pointer()
                    d4d => da%get_readonly_device_pointer()
                    @assertEqual(lbound(h4d), lbound(d4d))
                    @assertEqual(ubound(h4d), ubound(d4d))

                type is(data_array_5d_t)
                    h5d => da%get_readonly_pointer()
                    d5d => da%get_readonly_device_pointer()
                    @assertEqual(lbound(h5d), lbound(d5d))
                    @assertEqual(ubound(h5d), ubound(d5d))

            end select
        end subroutine

        subroutine test_array_cxx_access(da)
            !! Test array reading and writing in data array by performing
            !! some operations
            class(data_array_t), intent(inout) :: da

            integer :: ierr = 1
            real(kind=GP), contiguous, pointer, dimension(:,:) :: h2d, d2d
            real(kind=GP), contiguous, pointer, dimension(:,:,:) :: h3d, d3d
            real(kind=GP), contiguous, pointer, dimension(:,:,:,:) :: h4d, d4d
            real(kind=GP), contiguous, pointer, dimension(:,:,:,:,:) :: h5d, d5d

            select type(da)
                type is(data_array_2d_t)
                    h2d => da%get_pointer()
                    d2d => da%get_device_pointer()
                    ierr = cbind_data_array_2d_add( &
                           add_value, da%get_cxx_pointer())
                    @assertEqual(0, ierr)
                    call da%update_host()
                    @assertEqual(init_value + add_value, h2d, tolerance=GP_EPS)

                    ierr = cbind_data_array_set_uniform( &
                           dev_value, da%get_size(), d2d)
                    @assertEqual(0, ierr)
                    call da%update_host()
                    @assertEqual(dev_value, h2d, tolerance=GP_EPS)

                type is(data_array_3d_t)
                    h3d => da%get_pointer()
                    d3d => da%get_device_pointer()
                    ierr = cbind_data_array_3d_add( &
                           add_value, da%get_cxx_pointer())
                    @assertEqual(0, ierr)
                    call da%update_host()
                    @assertEqual(init_value + add_value, h3d, tolerance=GP_EPS)

                    ierr = cbind_data_array_set_uniform( &
                           dev_value, da%get_size(), d3d)
                    @assertEqual(0, ierr)
                    call da%update_host()
                    @assertEqual(dev_value, h3d, tolerance=GP_EPS)

                type is(data_array_4d_t)
                    h4d => da%get_pointer()
                    d4d => da%get_device_pointer()
                    ierr = cbind_data_array_4d_add( &
                           add_value, da%get_cxx_pointer())
                    @assertEqual(0, ierr)
                    call da%update_host()
                    @assertEqual(init_value + add_value, h4d, tolerance=GP_EPS)

                    ierr = cbind_data_array_set_uniform( &
                           dev_value, da%get_size(), d4d)
                    @assertEqual(0, ierr)
                    call da%update_host()
                    @assertEqual(dev_value, h4d, tolerance=GP_EPS)

                type is(data_array_5d_t)
                    h5d => da%get_pointer()
                    d5d => da%get_device_pointer()
                    ierr = cbind_data_array_5d_add( &
                           add_value, da%get_cxx_pointer())
                    @assertEqual(0, ierr)
                    call da%update_host()
                    @assertEqual(init_value + add_value, h5d, tolerance=GP_EPS)

                    ierr = cbind_data_array_set_uniform( &
                           dev_value, da%get_size(), d5d)
                    @assertEqual(0, ierr)
                    call da%update_host()
                    @assertEqual(dev_value, h5d, tolerance=GP_EPS)

            end select
        end subroutine

    end subroutine

end module
