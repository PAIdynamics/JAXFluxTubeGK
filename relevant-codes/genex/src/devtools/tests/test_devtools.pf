module test_devtools
    !! Contains tests for the developer tools
    use pfunit
    use devtools_m, only: initialize_devtools, finalize_devtools
    use file_handling_m, only: file_exists
    ! Unit test helpers
    use test_params_m

    implicit none

contains

    @before
    subroutine setup(this)
        ! Flush out all the default parameters
        class(MpiTestMethod), intent(inout) :: this
        call setup_test_params(this%getMpiCommunicator(), &
                               this%getProcessRank())
    end subroutine

    @after
    subroutine teardown(this)
        ! Read all the default parameters
        class(MpiTestMethod), intent(inout) :: this
        call teardown_test_params(this%getMpiCommunicator(), &
                                  this%getProcessRank())
    end subroutine

    @test(npes = [8])
    subroutine test_devmem_tracer(this)
        !! Tests the device memory tracer
        class(MpiTestMethod), intent(inout) :: this

        integer :: comm, istat

        comm = this%getMpiCommunicator()

        ! Initial cleanup
        call execute_command_line("rm -rf traces_dmem")

        ! Set parameters
        call setup_test_devtools(comm, this%getProcessRank(), &
                                 trace_device_memory=.true.)

        ! Check if APIs do nothing when the C++ layer is not used
        call initialize_devtools(comm, "./")
        call finalize_devtools(comm)

        ! The device memory tracer report folder should not exist
        call execute_command_line("[ -d traces_dmem ]", exitstat=istat)
        @assertTrue(istat /= 0)
    end subroutine

    @test(npes = [8])
    subroutine test_runtime_tracer(this)
        !! Tests the runtime tracer
        class(MpiTestMethod), intent(inout) :: this

        integer :: comm, istat

        comm = this%getMpiCommunicator()

        ! Initial cleanup
        call execute_command_line("rm -rf traces_rt")

        ! Set parameters
        call setup_test_devtools(comm, this%getProcessRank(), &
                                 trace_runtime=.true.)

        ! Check for the creation of traces_rt during the tracer initialization
        call initialize_devtools(comm, "./")

#ifdef ENABLE_GPU
        ! Check if the runtime tracer report folder exists even if
        !use_gpu_offload is .false. because the C++ layer is still built
        call execute_command_line("[ -d traces_rt ]", exitstat=istat)
        @assertTrue(istat == 0)

        call finalize_devtools(comm)

        ! Check if the folder is removed upon finalization
        call execute_command_line("[ -d traces_rt ]", exitstat=istat)
        @assertTrue(istat /= 0)

        ! Check if the aggregated trace file exists
        @assertTrue(file_exists("traces_runtime.csv"))
#else
        ! Check if APIs do nothing when the C++ layer is not built
        ! and the runtime tracer report folder should not exist
        call execute_command_line("[ -d traces_rt ]", exitstat=istat)
        @assertTrue(istat /= 0)

        call finalize_devtools(comm)
#endif
    end subroutine

end module
