module test_data_storage
    !! Contains tests for the data_storage_cpu_5d_t, data_storage_cpu_2d_t,
    !! data_storage_gpu_5d_t and data_storage_gpu_2d_t types
    !! including data_array_5d_t and data_array_2d_t
    use mpi
    use pfunit
    use genex_fortran_env_m, only: GP
    use, intrinsic :: iso_c_binding, only: c_loc
    use logger_m, only: logger_get_debug_channel
    use dcomm_handler_m, only: dcomm_handler_t
    use data_storage_m, only: data_storage_t, &
                              data_storage_5d_t, data_storage_cpu_5d_t, &
                              data_storage_4d_t, data_storage_cpu_4d_t, &
                              data_storage_2d_t, data_storage_cpu_2d_t
    use data_array_m, only: data_array_t, data_array_5d_t, &
                            data_array_4d_t, data_array_2d_t
    use helpers_data_storage_m, only: test_exchange_2d, test_exchange_4d, &
                                      test_exchange_5d, set_ranks_for_ex_dims, &
                                      test_exchange_5d_vspec, &
                                      test_exchange_5d_vpmu_vspec

    use params_gpu_offload_m, only: get_use_gpu_offload
    ! Unit test helpers
    use test_params_m

    ! From PARALLAX
    use equilibrium_factory_m, only: SLAB

#ifdef ENABLE_GPU
    use data_storage_m, only: data_storage_data_t, data_storage_gpu_5d_t, &
                              data_storage_gpu_4d_t, data_storage_gpu_2d_t
    use data_array_gpu_m, only: data_array_data_t
    use helpers_data_storage_gpu_m, only: cbind_data_storage_2d_copy, &
                                          cbind_data_storage_4d_copy, &
                                          cbind_data_storage_5d_copy
#endif

    implicit none

contains

    @before
    subroutine setup(this)
        class(MpiTestMethod), intent(inout) :: this
        call setup_test_params(this%getMpiCommunicator(), &
                               this%getProcessRank())
    end subroutine

    @after
    subroutine teardown(this)
        class(MpiTestMethod), intent(inout) :: this
        call teardown_test_params(this%getMpiCommunicator(), &
                                  this%getProcessRank())
    end subroutine

    @test(npes = [1])
    subroutine ds_get_pointer_5d(this)
        !! Tests the get_pointer_5d function data_storage_cpu_5d_t and
        !! data_storage_gpu_5d_t types
        class (MpiTestMethod), intent(inout) :: this

        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), target :: dcomm_handler
        class(data_storage_5d_t), allocatable :: ds
        class(data_array_5d_t), pointer :: da_ptr
        integer, parameter :: array_dim = 5
        integer :: number_of_points(array_dim)
        integer :: lb_ref(array_dim), ub_ref(array_dim)
        integer :: shp_ref(array_dim), shp_stripped_ref(array_dim)
        integer :: lb_stripped_ref(array_dim), ub_stripped_ref(array_dim)
        real(kind=GP), dimension(:,:,:,:,:), pointer :: arr_ptr

        number_of_points = [1, 2, 3, 4, 2]
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=SLAB, &
                             spacing_RZ=64.0_GP/number_of_points(1), &
                             n_levels=1, &
                             n_points_phi=number_of_points(2), &
                             n_points_vp=number_of_points(3), &
                             n_points_mu=number_of_points(4))
        ! NOTE: We setup the coll type to LBD since this enables
        !       ghost exchange in mu
        call setup_test_coll(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             coll_type="lbd")

        dcomm_handler_ptr => dcomm_handler
        call dcomm_handler_ptr%initialize(this%getMpiCommunicator(), 1, 1, 1, 1)
        call dcomm_handler_ptr%initialize_RZ_domain(number_of_points(1))

        lb_ref           = [1, -1, -1, 0, 1]
        ub_ref           = [1,  4,  5, 5, 2]
        lb_stripped_ref  = [1,  1,  1, 1, 1]
        ub_stripped_ref  = [1,  2,  3, 4, 2]
        shp_ref          = (ub_ref - lb_ref) + 1
        shp_stripped_ref = (ub_stripped_ref - lb_stripped_ref) + 1

        if(get_use_gpu_offload()) then
#ifdef ENABLE_GPU
            allocate(data_storage_gpu_5d_t :: ds)
#endif
        else
            allocate(data_storage_cpu_5d_t :: ds)
        endif

        call ds%initialize(dcomm_handler_ptr)

        ! Assert array properties from data_storage_t getters
        @assertEqual(shp_ref, ds%shape())
        @assertEqual(shp_stripped_ref, ds%shape_stripped())
        @assertEqual(lb_ref, ds%lbound())
        @assertEqual(ub_ref, ds%ubound())
        @assertEqual(lb_stripped_ref, ds%lbound_stripped())
        @assertEqual(ub_stripped_ref, ds%ubound_stripped())

        ! Assert array properties from data_storage_t array pointer
        arr_ptr => ds%get_pointer()
        @assertEqual(shp_ref, shape(arr_ptr))
        @assertEqual(lb_ref, lbound(arr_ptr))
        @assertEqual(ub_ref, ubound(arr_ptr))

        arr_ptr => ds%get_pointer_stripped()
        @assertEqual(shp_stripped_ref, shape(arr_ptr))
        @assertEqual(lb_stripped_ref, lbound(arr_ptr))
        @assertEqual(ub_stripped_ref, ubound(arr_ptr))

        ! Assert array properties from data_array_t getters
        da_ptr => ds%get_data_pointer()
        @assertTrue(da_ptr%is_distributed())
        @assertEqual(array_dim, da_ptr%get_dimension())
        @assertEqual(product(shp_ref), da_ptr%get_size())
        @assertEqual(product(shp_stripped_ref), da_ptr%get_size_stripped())
        @assertEqual(shp_ref, da_ptr%get_shape())
        @assertEqual(shp_stripped_ref, da_ptr%get_shape_stripped())
        @assertEqual(lb_ref, da_ptr%get_lbound())
        @assertEqual(ub_ref, da_ptr%get_ubound())
        @assertEqual(lb_stripped_ref, da_ptr%get_lbound_stripped())
        @assertEqual(ub_stripped_ref, da_ptr%get_ubound_stripped())

        ! Assert array properties from data_array_t array pointer
        arr_ptr => da_ptr%get_pointer()
        @assertEqual(shp_ref, shape(arr_ptr))
        @assertEqual(lb_ref, lbound(arr_ptr))
        @assertEqual(ub_ref, ubound(arr_ptr))

        arr_ptr => da_ptr%get_pointer_stripped()
        @assertEqual(shp_stripped_ref, shape(arr_ptr))
        @assertEqual(lb_stripped_ref, lbound(arr_ptr))
        @assertEqual(ub_stripped_ref, ubound(arr_ptr))

        ! Assert array properties from data_array_t readonly pointer
        arr_ptr => da_ptr%get_readonly_pointer()
        @assertEqual(shp_ref, shape(arr_ptr))
        @assertEqual(lb_ref, lbound(arr_ptr))
        @assertEqual(ub_ref, ubound(arr_ptr))

        arr_ptr => da_ptr%get_readonly_pointer_stripped()
        @assertEqual(shp_stripped_ref, shape(arr_ptr))
        @assertEqual(lb_stripped_ref, lbound(arr_ptr))
        @assertEqual(ub_stripped_ref, ubound(arr_ptr))

#ifdef ENABLE_GPU
        if(get_use_gpu_offload()) then
            call test_data_storage_cxx_access(dcomm_handler_ptr, ds)
        endif
#endif

        deallocate(ds)
    end subroutine

    @test(npes = [1])
    subroutine ds_get_pointer_4d(this)
        !! Tests the get_pointer_4d function data_storage_cpu_4d_t and
        !! data_storage_gpu_4d_t types
        class (MpiTestMethod), intent(inout) :: this

        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), target :: dcomm_handler
        class(data_storage_4d_t), allocatable :: ds
        class(data_array_4d_t), pointer :: da_ptr
        integer, parameter :: array_dim = 4
        integer :: number_of_points(array_dim)
        integer :: lb_ref(array_dim), ub_ref(array_dim)
        integer :: shp_ref(array_dim), shp_stripped_ref(array_dim)
        integer :: lb_stripped_ref(array_dim), ub_stripped_ref(array_dim)
        real(kind=GP), dimension(:,:,:,:), pointer :: arr_ptr

        number_of_points = [1, 2, 3, 1]
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=SLAB, &
                             spacing_RZ=64.0_GP/number_of_points(1), &
                             n_levels=1, &
                             n_points_phi=number_of_points(2), &
                             n_points_vp=number_of_points(3), &
                             n_points_mu=number_of_points(4))
        ! NOTE: We setup the coll type to LBD since this enables
        !       ghost exchange in mu
        call setup_test_coll(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             coll_type="lbd")

        dcomm_handler_ptr => dcomm_handler
        call dcomm_handler_ptr%initialize(this%getMpiCommunicator(), 1, 1, 1, 1)
        call dcomm_handler_ptr%initialize_RZ_domain(number_of_points(1))

        lb_ref           = [1, -1, 1, 1]
        ub_ref           = [1,  4, 3, 1]
        lb_stripped_ref  = [1,  1, 1, 1]
        ub_stripped_ref  = [1,  2, 3, 1]
        shp_ref          = (ub_ref - lb_ref) + 1
        shp_stripped_ref = (ub_stripped_ref - lb_stripped_ref) + 1

        if(get_use_gpu_offload()) then
#ifdef ENABLE_GPU
            allocate(data_storage_gpu_4d_t :: ds)
#endif
        else
            allocate(data_storage_cpu_4d_t :: ds)
        endif

        call ds%initialize(dcomm_handler_ptr, 3, 1)

        ! Assert array properties from data_storage_t getters
        @assertEqual(shp_ref, ds%shape())
        @assertEqual(shp_stripped_ref, ds%shape_stripped())
        @assertEqual(lb_ref, ds%lbound())
        @assertEqual(ub_ref, ds%ubound())
        @assertEqual(lb_stripped_ref, ds%lbound_stripped())
        @assertEqual(ub_stripped_ref, ds%ubound_stripped())

        ! Assert array properties from data_storage_t array pointer
        arr_ptr => ds%get_pointer()
        @assertEqual(shp_ref, shape(arr_ptr))
        @assertEqual(lb_ref, lbound(arr_ptr))
        @assertEqual(ub_ref, ubound(arr_ptr))

        arr_ptr => ds%get_pointer_stripped()
        @assertEqual(shp_stripped_ref, shape(arr_ptr))
        @assertEqual(lb_stripped_ref, lbound(arr_ptr))
        @assertEqual(ub_stripped_ref, ubound(arr_ptr))

        ! Assert array properties from data_array_t getters
        da_ptr => ds%get_data_pointer()
        @assertTrue(da_ptr%is_distributed())
        @assertEqual(array_dim, da_ptr%get_dimension())
        @assertEqual(product(shp_ref), da_ptr%get_size())
        @assertEqual(product(shp_stripped_ref), da_ptr%get_size_stripped())
        @assertEqual(shp_ref, da_ptr%get_shape())
        @assertEqual(shp_stripped_ref, da_ptr%get_shape_stripped())
        @assertEqual(lb_ref, da_ptr%get_lbound())
        @assertEqual(ub_ref, da_ptr%get_ubound())
        @assertEqual(lb_stripped_ref, da_ptr%get_lbound_stripped())
        @assertEqual(ub_stripped_ref, da_ptr%get_ubound_stripped())

        ! Assert array properties from data_array_t array pointer
        arr_ptr => da_ptr%get_pointer()
        @assertEqual(shp_ref, shape(arr_ptr))
        @assertEqual(lb_ref, lbound(arr_ptr))
        @assertEqual(ub_ref, ubound(arr_ptr))

        arr_ptr => da_ptr%get_pointer_stripped()
        @assertEqual(shp_stripped_ref, shape(arr_ptr))
        @assertEqual(lb_stripped_ref, lbound(arr_ptr))
        @assertEqual(ub_stripped_ref, ubound(arr_ptr))

        ! Assert array properties from data_array_t readonly pointer
        arr_ptr => da_ptr%get_readonly_pointer()
        @assertEqual(shp_ref, shape(arr_ptr))
        @assertEqual(lb_ref, lbound(arr_ptr))
        @assertEqual(ub_ref, ubound(arr_ptr))

        arr_ptr => da_ptr%get_readonly_pointer_stripped()
        @assertEqual(shp_stripped_ref, shape(arr_ptr))
        @assertEqual(lb_stripped_ref, lbound(arr_ptr))
        @assertEqual(ub_stripped_ref, ubound(arr_ptr))

#ifdef ENABLE_GPU
       if(get_use_gpu_offload()) then
           call test_data_storage_cxx_access(dcomm_handler_ptr, ds)
       endif
#endif

        deallocate(ds)
    end subroutine

    @test(npes = [1])
    subroutine ds_get_pointer_2d(this)
        !! Tests the get_pointer_2d function data_storage_cpu_2d_t and
        !! data_storage_gpu_2d_t types
        class (MpiTestMethod), intent(inout) :: this

        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), target :: dcomm_handler
        class(data_storage_2d_t), allocatable :: ds
        class(data_array_2d_t), pointer :: da_ptr
        integer, parameter :: array_dim = 2
        integer :: number_of_points(array_dim)
        integer :: lb_ref(array_dim), ub_ref(array_dim)
        integer :: shp_ref(array_dim), shp_stripped_ref(array_dim)
        integer :: lb_stripped_ref(array_dim), ub_stripped_ref(array_dim)
        real(kind=GP), dimension(:,:), pointer :: arr_ptr

        number_of_points = [2, 3]
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=SLAB, &
                             spacing_RZ=64.0_GP/number_of_points(1), &
                             n_levels=1, &
                             n_points_phi=number_of_points(2))

        dcomm_handler_ptr => dcomm_handler
        call dcomm_handler_ptr%initialize(this%getMpiCommunicator(), 1, 1, 1, 1)
        call dcomm_handler_ptr%initialize_RZ_domain(number_of_points(1))

        lb_ref           = [1, -1]
        ub_ref           = [2,  5]
        lb_stripped_ref  = [1,  1]
        ub_stripped_ref  = [2,  3]
        shp_ref          = (ub_ref - lb_ref) + 1
        shp_stripped_ref = (ub_stripped_ref - lb_stripped_ref) + 1

        if(get_use_gpu_offload()) then
#ifdef ENABLE_GPU
            allocate(data_storage_gpu_2d_t :: ds)
#endif
        else
            allocate(data_storage_cpu_2d_t :: ds)
        endif

        call ds%initialize(dcomm_handler_ptr)

        ! Assert array properties from data_storage_t getters
        @assertEqual(shp_ref, ds%shape())
        @assertEqual(shp_stripped_ref, ds%shape_stripped())
        @assertEqual(lb_ref, ds%lbound())
        @assertEqual(ub_ref, ds%ubound())
        @assertEqual(lb_stripped_ref, ds%lbound_stripped())
        @assertEqual(ub_stripped_ref, ds%ubound_stripped())

        ! Assert array properties from data_storage_t array pointer
        arr_ptr => ds%get_pointer()
        @assertEqual(shp_ref, shape(arr_ptr))
        @assertEqual(lb_ref, lbound(arr_ptr))
        @assertEqual(ub_ref, ubound(arr_ptr))

        arr_ptr => ds%get_pointer_stripped()
        @assertEqual(shp_stripped_ref, shape(arr_ptr))
        @assertEqual(lb_stripped_ref, lbound(arr_ptr))
        @assertEqual(ub_stripped_ref, ubound(arr_ptr))

        ! Assert array properties from data_array_t getters
        da_ptr => ds%get_data_pointer()
        @assertTrue(da_ptr%is_distributed())
        @assertEqual(array_dim, da_ptr%get_dimension())
        @assertEqual(product(shp_ref), da_ptr%get_size())
        @assertEqual(product(shp_stripped_ref), da_ptr%get_size_stripped())
        @assertEqual(shp_ref, da_ptr%get_shape())
        @assertEqual(shp_stripped_ref, da_ptr%get_shape_stripped())
        @assertEqual(lb_ref, da_ptr%get_lbound())
        @assertEqual(ub_ref, da_ptr%get_ubound())
        @assertEqual(lb_stripped_ref, da_ptr%get_lbound_stripped())
        @assertEqual(ub_stripped_ref, da_ptr%get_ubound_stripped())

        ! Assert array properties from data_array_t array pointer
        arr_ptr => da_ptr%get_pointer()
        @assertEqual(shp_ref, shape(arr_ptr))
        @assertEqual(lb_ref, lbound(arr_ptr))
        @assertEqual(ub_ref, ubound(arr_ptr))

        arr_ptr => da_ptr%get_pointer_stripped()
        @assertEqual(shp_stripped_ref, shape(arr_ptr))
        @assertEqual(lb_stripped_ref, lbound(arr_ptr))
        @assertEqual(ub_stripped_ref, ubound(arr_ptr))

        ! Assert array properties from data_array_t readonly pointer
        arr_ptr => da_ptr%get_readonly_pointer()
        @assertEqual(shp_ref, shape(arr_ptr))
        @assertEqual(lb_ref, lbound(arr_ptr))
        @assertEqual(ub_ref, ubound(arr_ptr))

        arr_ptr => da_ptr%get_readonly_pointer_stripped()
        @assertEqual(shp_stripped_ref, shape(arr_ptr))
        @assertEqual(lb_stripped_ref, lbound(arr_ptr))
        @assertEqual(ub_stripped_ref, ubound(arr_ptr))

#ifdef ENABLE_GPU
        if(get_use_gpu_offload()) then
            call test_data_storage_cxx_access(dcomm_handler_ptr, ds)
        endif
#endif

        deallocate(ds)
    end subroutine

    @test(npes = [1, 4])
    subroutine test_2d_exchange(this)
        !! Tests the halo exchange function of the data_storage_cpu_2d_t and
        !! data_storage_cpu_2d_t types
        class (MpiTestMethod), intent(inout) :: this

        integer :: n_ranks, comm_world, n_ranks_phi, n_ranks_vp, &
            n_ranks_mu, n_ranks_sp, rank, n_points, i
        integer, parameter :: n_dim_permuts = 2
        integer :: dim_permuts(2, n_dim_permuts)
        logical :: fine

        ! all possible dimension permutations
        dim_permuts = reshape( &
            (/ 1, 2, &
               2, 1 /), (/ 2, n_dim_permuts /))

        rank = this%getProcessRank()
        n_ranks = this%getNumProcesses()
        comm_world = this%getMpiCommunicator()

        do i = 1, n_dim_permuts
            n_ranks_phi = n_ranks
            n_ranks_vp = 1
            n_ranks_mu = 1
            n_ranks_sp = 1
            n_points = 4
            fine = test_exchange_2d(this, n_ranks_phi, n_ranks_vp, &
                                    n_ranks_mu, n_ranks_sp, &
                                    n_points, dim_permuts(:, i))
            @assertTrue(fine)

            n_ranks_phi = n_ranks
            n_ranks_vp = 1
            n_ranks_mu = 1
            n_ranks_sp = 1
            n_points = 8
            fine = test_exchange_2d(this, n_ranks_phi, n_ranks_vp, &
                                    n_ranks_mu, n_ranks_sp, &
                                    n_points, dim_permuts(:, i))
            @assertTrue(fine)

            n_ranks_phi = n_ranks
            n_ranks_vp = 1
            n_ranks_mu = 1
            n_ranks_sp = 1
            n_points = 16
            fine = test_exchange_2d(this, n_ranks_phi, n_ranks_vp, &
                                    n_ranks_mu, n_ranks_sp, &
                                    n_points, dim_permuts(:, i))
            @assertTrue(fine)

            n_ranks_phi = n_ranks
            n_ranks_vp = 1
            n_ranks_mu = 1
            n_ranks_sp = 1
            n_points = 36
            fine = test_exchange_2d(this, n_ranks_phi, n_ranks_vp, &
                                    n_ranks_mu, n_ranks_sp, &
                                    n_points, dim_permuts(:, i))
            @assertTrue(fine)
        enddo
    end subroutine

    @test(npes = [1, 4])
    subroutine test_4d_exchange(this)
        !! Tests the halo exchange function of the data_storage_cpu_4d_t and
        !! data_storage_cpu_4d_t types
        class (MpiTestMethod), intent(inout) :: this

        integer :: n_ranks, comm_world, n_ranks_phi, n_ranks_vp, &
            n_ranks_mu, n_ranks_sp, rank, n_points, i
        integer, parameter :: n_dim_permuts = 2
        integer :: dim_permuts(4, n_dim_permuts)
        integer :: n_mom = 3, n_spec = 1
        logical :: fine

        ! All possible dimension permutations
        dim_permuts = reshape( &
            (/ 1, 2, 3, 4, &
               2, 1, 3, 4 /), (/ 4, n_dim_permuts /))

        rank = this%getProcessRank()
        n_ranks = this%getNumProcesses()
        comm_world = this%getMpiCommunicator()

        do i = 1, n_dim_permuts
            n_ranks_phi = n_ranks
            n_ranks_vp = 1
            n_ranks_mu = 1
            n_ranks_sp = 1
            n_points = 4
            fine = test_exchange_4d(this, n_ranks_phi, n_ranks_vp, &
                                    n_ranks_mu, n_ranks_sp, n_mom, n_spec, &
                                    n_points, dim_permuts(:, i))
            @assertTrue(fine)

            n_ranks_phi = n_ranks
            n_ranks_vp = 1
            n_ranks_mu = 1
            n_ranks_sp = 1
            n_points = 8
            fine = test_exchange_4d(this, n_ranks_phi, n_ranks_vp, &
                                    n_ranks_mu, n_ranks_sp, n_mom, n_spec, &
                                    n_points, dim_permuts(:, i))
            @assertTrue(fine)

            n_ranks_phi = n_ranks
            n_ranks_vp = 1
            n_ranks_mu = 1
            n_ranks_sp = 1
            n_points = 16
            fine = test_exchange_4d(this, n_ranks_phi, n_ranks_vp, &
                                    n_ranks_mu, n_ranks_sp, n_mom, n_spec, &
                                    n_points, dim_permuts(:, i))
            @assertTrue(fine)

            n_ranks_phi = n_ranks
            n_ranks_vp = 1
            n_ranks_mu = 1
            n_ranks_sp = 1
            n_points = 36
            fine = test_exchange_4d(this, n_ranks_phi, n_ranks_vp, &
                                    n_ranks_mu, n_ranks_sp, n_mom, n_spec, &
                                    n_points, dim_permuts(:, i))
            @assertTrue(fine)
        enddo
    end subroutine

    @test(npes = [1, 4])
    subroutine test_5d_exchange(this)
        !! Tests the halo exchange function of the data_storage_cpu_5d_t and
        !! data_storage_cpu_5d_t types
        class (MpiTestMethod), intent(inout) :: this

        integer :: n_ranks, comm_world, n_ranks_phi, n_ranks_vp, &
            n_ranks_mu, n_ranks_sp, rank, n_points, ex_dim, i, j
        integer, parameter :: n_dim_permuts = 6
        integer :: dim_permuts(5, n_dim_permuts)
        logical :: fine

        ! All possible dimension permutations
        dim_permuts = reshape( &
            (/ 1, 2, 3, 4, 5, &
               1, 4, 2, 3, 5, &
               1, 3, 4, 2, 5, &
               1, 2, 4, 3, 5, &
               1, 3, 2, 4, 5, &
               1, 4, 3, 2, 5 /), (/ 5, n_dim_permuts /))

        rank = this%getProcessRank()
        n_ranks = this%getNumProcesses()
        comm_world = this%getMpiCommunicator()
        n_ranks_sp = 1

        ! Loop over all possible dim_permuts
        do i = 1, n_dim_permuts
            ! Loop over all possible exchange dimensions phi, vp and mu
            ! represented by 2, 3 and 4 respectively
            do j = 2, 4
                ex_dim = dim_permuts(j, i)

                call set_ranks_for_ex_dims(n_ranks_phi, n_ranks_vp, &
                                           n_ranks_mu, n_ranks, j)
                n_points = 4
                fine = test_exchange_5d(this, n_ranks_phi, &
                                        n_ranks_vp, n_ranks_mu, n_ranks_sp, &
                                        n_points, ex_dim, &
                                        dim_permuts(:, i))
                @assertTrue(fine)

                call set_ranks_for_ex_dims(n_ranks_phi, n_ranks_vp, &
                                           n_ranks_mu, n_ranks, j)
                n_points = 8
                fine = test_exchange_5d(this, n_ranks_phi, &
                                        n_ranks_vp, n_ranks_mu, n_ranks_sp, &
                                        n_points, ex_dim, &
                                        dim_permuts(:, i))
                @assertTrue(fine)

                call set_ranks_for_ex_dims(n_ranks_phi, n_ranks_vp, &
                                           n_ranks_mu, n_ranks, j)
                n_points = 12
                fine = test_exchange_5d(this, n_ranks_phi, &
                                        n_ranks_vp, n_ranks_mu, n_ranks_sp, &
                                        n_points, ex_dim, &
                                        dim_permuts(:, i))
                @assertTrue(fine)

                call set_ranks_for_ex_dims(n_ranks_phi, n_ranks_vp, &
                                           n_ranks_mu, n_ranks, j)
                n_points = 36
                fine = test_exchange_5d(this, n_ranks_phi, &
                                        n_ranks_vp, n_ranks_mu, n_ranks_sp, &
                                        n_points, ex_dim, &
                                        dim_permuts(:, i))
                @assertTrue(fine)
            end do
        end do
    end subroutine

    @test(npes= [4])
    subroutine test_5d_exchange_vspec(this)
        !! Tests the halo exchange function of the data_storage_cpu_5d_t and
        !! data_storage_cpu_5d_t types for the spectral approach.
        !! The ghost exchange along vp, mu, and phi are tested. Due to the
        !! spectral stencils, different cases are tested:
        !!
        !!  1) In the case of the vp exchange, the ghost cells in mu
        !!     are not included in the mailboxes.
        !!  2) In the case of the mu exchange, the ghost cells in vp
        !!     are included in the mailboxes.
        !!  3) In the case of the phi exchange, the ghost cells in
        !!     both vp and mu are included in the mailboxes.
        !!
        class (MpiTestMethod), intent(inout) :: this

        integer :: n_ranks, comm_world, n_ranks_phi, n_ranks_vp, &
                   n_ranks_mu, n_ranks_sp, n_points, ex_dim, &
                   rank, j
        integer :: dim_permut(5), ex_dims(3)
        logical :: fine

        ! Consider identity permutation
        dim_permut = [1, 2, 3, 4, 5]

        rank = this%getProcessRank()
        n_ranks = this%getNumProcesses()
        comm_world = this%getMpiCommunicator()
        n_ranks_sp = 1

        ! Exchange dimensions
        ex_dims = [2, 3, 4]

        ! Test all exchange dimensions
        do j = 1, 3
            ex_dim = ex_dims(j)

            ! Set the number of ranks in each direction
            call set_ranks_for_ex_dims(n_ranks_phi, n_ranks_vp, &
                                       n_ranks_mu, n_ranks, ex_dim)

            n_points = 16
            fine = test_exchange_5d_vspec(this, &
                                      n_ranks_phi, &
                                      n_ranks_vp, &
                                      n_ranks_mu, &
                                      n_ranks_sp, &
                                      n_points, &
                                      ex_dim, &
                                      dim_permut)

            @assertTrue(fine)
        enddo
    end subroutine

    @test(npes = [2, 4, 8])
    subroutine test_5d_exchange_vpmu_vspec(this)
        !! Tests the exchange of edge function of the data_storage_cpu_5d_t and
        !! data_storage_cpu_5d_t types for the spectral approach.
        class (MpiTestMethod), intent(inout) :: this
        integer :: rank, n_ranks, comm_world, n_ranks_phi, n_ranks_vp, &
                   n_ranks_mu, n_ranks_sp, n_points, dim_permut(5)
        logical :: fine

        fine = .true.

        ! Consider identity permutation
        dim_permut = [1, 2, 3, 4, 5]

        rank = this%getProcessRank()
        n_ranks = this%getNumProcesses()
        comm_world = this%getMpiCommunicator()

        ! Setup MPI decomposition
        n_points  = 32

        ! Set ranks for 2d exchange
        n_ranks_phi = 1
        n_ranks_vp = 1
        n_ranks_mu = 1
        n_ranks_sp = 1
        select case(n_ranks)
        case(2)
            n_ranks_vp = 1
            n_ranks_mu = 2
        case(4)
            n_ranks_vp = 2
            n_ranks_mu = 2
        case(8)
            n_ranks_vp = 2
            n_ranks_mu = 4
        end select

        fine = test_exchange_5d_vpmu_vspec(this, &
                                           n_ranks_phi, &
                                           n_ranks_vp, &
                                           n_ranks_mu, &
                                           n_ranks_sp, &
                                           n_points, &
                                           dim_permut)
        @assertTrue(fine)

    end subroutine

#ifdef ENABLE_GPU
    subroutine test_data_storage_cxx_access(dcomm_handler, ds_src)
        !! Test the data exposure of data storage to C++ including
        !! the multidimensional array access from C++ class methods
        type(dcomm_handler_t), pointer, intent(in) :: dcomm_handler
        class(data_storage_t), intent(inout) :: ds_src

        type(data_storage_data_t) :: ds_data_tgt
        type(data_array_data_t) :: da_data_tgt
        integer, dimension(5) :: &
            num_elements_src, &
            num_ghost_cells_src, &
            num_data_cells_src, &
            num_mail_partners_src, &
            dim_permut_src
        integer, contiguous, pointer, dimension(:) :: &
            num_elements_tgt, &
            num_ghost_cells_tgt, &
            num_data_cells_tgt, &
            num_mail_partners_tgt, &
            dim_permut_tgt
        integer, contiguous, pointer, dimension(:) :: shp_tgt, shp_s_tgt, &
            lb_tgt, ub_tgt, lb_s_tgt, ub_s_tgt
        integer :: i, dim, n_ex_dims, ierr, shp_4d(4)

        ! Allocate the target data storage members
        dim = ds_src%get_dimension()
        allocate(num_elements_tgt(dim))
        allocate(num_ghost_cells_tgt(dim))
        allocate(num_data_cells_tgt(dim))
        allocate(num_mail_partners_tgt(dim))
        allocate(dim_permut_tgt(dim))

        ! Initialize da data and assign the C pointer to the target da members
        ds_data_tgt%array_dim = 0
        ds_data_tgt%n_ex_dims = 0
        ds_data_tgt%number_of_elements_ptr      = c_loc(num_elements_tgt)
        ds_data_tgt%number_of_ghost_cells_ptr   = c_loc(num_ghost_cells_tgt)
        ds_data_tgt%number_of_data_cells_ptr    = c_loc(num_data_cells_tgt)
        ds_data_tgt%number_of_mail_partners_ptr = c_loc(num_mail_partners_tgt)
        ds_data_tgt%dim_permut_ptr              = c_loc(dim_permut_tgt)

        ! Allocate the target data array members
        allocate(shp_tgt(dim))
        allocate(shp_s_tgt(dim))
        allocate(lb_tgt(dim))
        allocate(ub_tgt(dim))
        allocate(lb_s_tgt(dim))
        allocate(ub_s_tgt(dim))

        ! Initialize da data and assign the C pointer to the target da members
        da_data_tgt%array_size               = 0
        da_data_tgt%array_shape_ptr          = c_loc(shp_tgt)
        da_data_tgt%array_shape_stripped_ptr = c_loc(shp_s_tgt)
        da_data_tgt%array_lb_ptr             = c_loc(lb_tgt)
        da_data_tgt%array_ub_ptr             = c_loc(ub_tgt)
        da_data_tgt%array_lb_stripped_ptr    = c_loc(lb_s_tgt)
        da_data_tgt%array_ub_stripped_ptr    = c_loc(ub_s_tgt)

        ! Assign the source data storage members
        do i = 1, dim
            num_elements_src(i)   = dcomm_handler%get_number_of_elements(i)
            num_ghost_cells_src(i) = dcomm_handler%get_number_of_ghosts(i)
            num_data_cells_src(i) = dcomm_handler%get_number_of_data_elements(i)
            dim_permut_src(i)     = dcomm_handler%get_dim_permut(i)
        enddo
        num_mail_partners_src = ds_src%get_num_mail_partners()

        ! Copy the da class members from the source class to the target class
        ! via C++
        ierr = 1

        select type(ds_src)
            type is(data_storage_gpu_5d_t)
                n_ex_dims = 3
                ierr = cbind_data_storage_5d_copy(ds_src%get_cxx_pointer(), &
                                                  ds_data_tgt, da_data_tgt)
            type is(data_storage_gpu_2d_t)
                n_ex_dims = 1
                ierr = cbind_data_storage_2d_copy(ds_src%get_cxx_pointer(), &
                                                  ds_data_tgt, da_data_tgt)
            type is(data_storage_gpu_4d_t)
                n_ex_dims = 1
                ierr = cbind_data_storage_4d_copy(ds_src%get_cxx_pointer(), &
                                                  ds_data_tgt, da_data_tgt)
                ! Special case redifinition for data_storage_4d_t
                shp_4d = ds_src%shape()
                do i = 3, 4
                    num_elements_src(i)    = shp_4d(i)
                    num_ghost_cells_src(i) = 0
                    num_data_cells_src(i)  = num_elements_src(i)
                    dim_permut_src(i)      = i
                enddo
        end select

        @assertEqual(0, ierr)

        ! Assert class member
        @assertEqual(dim, ds_data_tgt%array_dim)
        @assertEqual(n_ex_dims, ds_data_tgt%n_ex_dims)

        @assertEqual(num_elements_src(:dim), num_elements_tgt)
        @assertEqual(num_ghost_cells_src(:dim), num_ghost_cells_tgt)
        @assertEqual(num_data_cells_src(:dim), num_data_cells_tgt)
        @assertEqual(num_mail_partners_src(:dim), num_mail_partners_tgt)
        @assertEqual(dim_permut_src(:dim), dim_permut_tgt)

        @assertEqual(ds_src%get_size(), da_data_tgt%array_size)

        select type(ds_src)
            type is(data_storage_gpu_5d_t)
                @assertEqual(ds_src%shape(), shp_tgt)
                @assertEqual(ds_src%shape_stripped(), shp_s_tgt)
                @assertEqual(ds_src%lbound(), lb_tgt)
                @assertEqual(ds_src%ubound(), ub_tgt)
                @assertEqual(ds_src%lbound_stripped(), lb_s_tgt)
                @assertEqual(ds_src%ubound_stripped(), ub_s_tgt)
            type is(data_storage_gpu_2d_t)
                @assertEqual(ds_src%shape(), shp_tgt)
                @assertEqual(ds_src%shape_stripped(), shp_s_tgt)
                @assertEqual(ds_src%lbound(), lb_tgt)
                @assertEqual(ds_src%ubound(), ub_tgt)
                @assertEqual(ds_src%lbound_stripped(), lb_s_tgt)
                @assertEqual(ds_src%ubound_stripped(), ub_s_tgt)
        end select

        write(logger_get_debug_channel(), "(A,I1,A)") &
        "Testing C++ access of data storage ", dim, "D class members: OK!"

        ! Deallocate memory
        Deallocate(num_elements_tgt, num_ghost_cells_tgt, num_data_cells_tgt)
        Deallocate(num_mail_partners_tgt, dim_permut_tgt)
        Deallocate(shp_tgt, shp_s_tgt, lb_tgt, ub_tgt, lb_s_tgt, ub_s_tgt)
    end subroutine
#endif
end module
