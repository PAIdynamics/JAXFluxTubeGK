module test_lagrange_interpolator
    !! Contains tests for the lagrange_interpolator_m module
    use funit
    use genex_fortran_env_m, only: GP, GP_EPS
    use lagrange_interpolator_m, only: monomials_first_derivative, &
                                    monomials_second_derivative, &
                                    monomials_fourth_derivative, &
                                    monomials_first_derivative_backward_2pts, &
                                    monomials_first_derivative_forward_2pts

    ! From PARALLAX
    use polynomials_m, only: polyval, polyder

    implicit none

    real(kind=GP), parameter :: prec = 100 * GP_EPS

    type :: test_case
        real(GP), dimension(:), allocatable :: y
        ! Grid points
        real(GP), dimension(:), allocatable :: precs
        ! Precisions
    end type

    abstract interface
        real(kind=GP) function scalar_function(x)
            import :: GP
            real(kind=GP), intent(in) :: x
        end function scalar_function
    end interface

    real(kind=GP), dimension(5), parameter :: poly4_coeffs = [ 4.0_GP, &
                                                               2.0_GP, &
                                                              -0.7_GP, &
                                                              -1.5_GP, &
                                                               3.1_GP]
    real(kind=GP), dimension(4), parameter :: poly3_coeffs = [ 4.0_GP, &
                                                               2.0_GP, &
                                                              -0.5_GP, &
                                                              -1.5_GP]
    real(kind=GP), dimension(2), parameter :: poly1_coeffs = [ 4.0_GP, &
                                                               2.0_GP]
contains

    real(kind=GP) function poly4(y)
        !! Fourth order test polynomial
        real(kind=GP), intent(in) :: y
        poly4 = polyval(poly4_coeffs, y)
    end function

    real(kind=GP) function poly3(y)
        !! Third order test polynomial
        real(kind=GP), intent(in) :: y
        poly3 = polyval(poly3_coeffs, y)
    end function

    real(kind=GP) function poly1(y)
        !! First order test polynomial (straight line)
        real(kind=GP), intent(in) :: y
        poly1 = polyval(poly1_coeffs, y)
    end function

    subroutine get_derivatives_from_5_pts_interpolation(y, results, f)
        !! Get first, second and fourth order derivativs from
        !! fourth order langrange polynomial
        real(kind=GP), dimension(5), intent(in) :: y
        !! Grid points
        real(kind=GP), dimension(3), intent(out) :: results
        !! First, second and fourth derivatives obtained
        !! from the Langrange polynomial
        procedure(scalar_function), pointer, intent(in) :: f
        !! functions to be interpolated

        real(kind=GP), dimension(5) :: p, m
        integer :: i
        real(kind=GP) :: derivative

        do i = 1, size(y)
            p(i) = f(y(i))
        enddo

        ! Test first derivative (4th order centered scheme)
        ! (5 points)
        call monomials_first_derivative(y(1), y(2), y(3), y(4), y(5), &
                                        m(1), m(2), m(3), m(4), m(5))
        derivative = 0.0_GP
        do i = 1, size(y)
            derivative = derivative + m(i) * p(i)
        enddo
        results(1) = derivative

        ! Test second derivative (4th order centered scheme)
        ! (5 points)
        call monomials_second_derivative(y(1), y(2), y(3), y(4), y(5), &
                                         m(1), m(2), m(3), m(4), m(5))
        derivative = 0.0_GP
        do i = 1, size(y)
            derivative = derivative + m(i) * p(i)
        enddo
        results(2) = derivative

        ! Test fourth derivative (4th order centered scheme)
        ! (5 points)
        call monomials_fourth_derivative(y(1), y(2), y(3), y(4), y(5), &
                                         m(1), m(2), m(3), m(4), m(5))
        derivative = 0.0_GP
        do i = 1, size(y)
            derivative = derivative + m(i) * p(i)
        enddo
        results(3) = derivative
    end subroutine

    subroutine get_derivatives_from_2_pts_interpolation(y, results, f)
        !! Get first order derivativs from first order
        !! backward and forward scheme
        real(kind=GP), dimension(2), intent(in) :: y
        !! Grid points
        real(kind=GP), dimension(2), intent(out) :: results
        !! First derivatives obtained from first order
        !! backward and forward schemes
        procedure(scalar_function), pointer, intent(in) :: f
        !! Functions to be interpolated

        real(kind=GP), dimension(2) :: p, m
        integer :: i
        real(kind=GP) :: derivative

        do i = 1, size(y)
            p(i) = f(y(i))
        enddo

        ! Test first derivative (1st order backward scheme)
        ! (5 points)
        call monomials_first_derivative_backward_2pts(y(1), y(2), &
                                                      m(1), m(2))
        derivative = 0.0_GP
        do i = 1, size(y)
            derivative = derivative + m(i) * p(i)
        enddo
        results(1) = derivative

        ! Test first derivative (1st order forward scheme)
        ! (5 points)
        call monomials_first_derivative_forward_2pts(y(1), y(2), &
                                                     m(1), m(2))
        derivative = 0.0_GP
        do i = 1, size(y)
            derivative = derivative + m(i) * p(i)
        enddo
        results(2) = derivative
    end subroutine

    @test
    subroutine test_cartesian_grid
        !! Tests the values of the monomials of the first and fourth
        !! derivative of the lagrange polynomial against the well known finite
        !! difference stencils on a cartesian grid.
        real(kind=GP), dimension(5) :: y
        real(kind=GP), dimension(5) :: m

        ! Set up cartesian grid
        y = [-2.0_GP, -1.0_GP, 0.0_GP, 1.0_GP, 2.0_GP]

        ! Test first derivative (4th order precision centered)
        call monomials_first_derivative(y(1), y(2), y(3), y(4), y(5), &
                                        m(1), m(2), m(3), m(4), m(5))
        @assertEqual( 1.0_GP / 12.0_GP, m(1), prec)
        @assertEqual(-2.0_GP / 3.0_GP , m(2), prec)
        @assertEqual( 0.0_GP          , m(3), prec)
        @assertEqual( 2.0_GP / 3.0_GP , m(4), prec)
        @assertEqual(-1.0_GP / 12.0_GP, m(5), prec)

        ! Test second derivative (4th order precision centered)
        call monomials_second_derivative(y(1), y(2), y(3), y(4), y(5), &
                                         m(1), m(2), m(3), m(4), m(5))
        @assertEqual(-1.0_GP / 12.0_GP,   m(1), prec)
        @assertEqual( 16.0_GP / 12.0_GP , m(2), prec)
        @assertEqual(-30.0_GP / 12.0_GP , m(3), prec)
        @assertEqual( 16.0_GP / 12.0_GP , m(4), prec)
        @assertEqual(-1.0_GP / 12.0_GP,   m(5), prec)

        ! Test fourth derivative (4th order precision centered)
        call monomials_fourth_derivative(y(1), y(2), y(3), y(4), y(5), &
                                         m(1), m(2), m(3), m(4), m(5))
        @assertEqual( 1.0_GP, m(1), prec)
        @assertEqual(-4.0_GP, m(2), prec)
        @assertEqual( 6.0_GP, m(3), prec)
        @assertEqual(-4.0_GP, m(4), prec)
        @assertEqual( 1.0_GP, m(5), prec)

        ! Test first derivative (1th order precision backward)
        call monomials_first_derivative_backward_2pts(y(1), y(2), &
                                                      m(1), m(2))
        @assertEqual(-1.0_GP, m(1), prec)
        @assertEqual( 1.0_GP, m(2), prec)

        ! Test first derivative (1th order precision backward)
        call monomials_first_derivative_forward_2pts(y(1), y(2), &
                                                     m(1), m(2))
        @assertEqual(-1.0_GP, m(1), prec)
        @assertEqual( 1.0_GP, m(2), prec)
    end subroutine

    @test
    subroutine test_fourth_order_lagrange_interpolation_coarse_grid()
        !! Tests whether the first, second and fourth derivatives of a fourth
        !! order polynomial are evaluated to machine precision by the
        !! fourth order lagrange interpolation on a coarse grid.
        !!
        !! Coarse grid tests are mainly for testing the coefficients of the
        !! interpolation polynomials. Since the derivatives (or finite
        !! difference) have a ~ 1/h^n dependency on a discrete grid, by choosing
        !! a grid of space step around 1, the error caused by small denominators
        !! (especially for higher order derivatives) can be avoided, so the
        !! precision on the coefficients can be tested.
        real(kind=GP), dimension(5) :: y
        real(kind=GP), dimension(3) :: results, expected, precs, precs_ad_hoc
        integer :: n_cases, n_ypoints, n_results, case_idx, ind
        type(test_case), dimension(:), allocatable :: cases
        procedure(scalar_function), pointer :: f_ptr => null()
        real(kind=GP), dimension(:), allocatable :: dpoly, d2poly, d4poly

        n_cases = 1
        n_ypoints = 5
        n_results = 3

        allocate(cases(n_cases))
        do case_idx = 1, n_cases
            allocate(cases(case_idx)%y(n_ypoints))
            allocate(cases(case_idx)%precs(n_results))
        enddo

        ! Set up unstructured y grid (coarse, h approx 1)
        cases(1)%y = [-2.1_GP, -1.0_GP, 0.2_GP, 1.0_GP, 1.9_GP]
        ! the expected errors are respectively of order prec
        cases(1)%precs = [prec, prec, prec]

        precs_ad_hoc = [prec, prec, 2 * prec]

        do case_idx = 1, size(cases)
            y     = cases(case_idx)%y
            precs = cases(case_idx)%precs

            ! Fourth order polynomial test
            f_ptr => poly4
            dpoly = polyder(poly4_coeffs)
            d2poly = polyder(dpoly)
            d4poly = polyder(polyder(d2poly))

            expected = [polyval(dpoly, y(3)), &
                        polyval(d2poly, y(3)), &
                        polyval(d4poly, y(3))]
            call get_derivatives_from_5_pts_interpolation(y, results, f_ptr)

            do ind = 1, size(results)
                ! For this specific case, use ad hoc precision.
                ! The factor 2 for the fourth derivative precision is set for
                ! some machinefor some machine, but it doesn't change the
                ! order of magnitude of the error
                @assertEqual(expected(ind), results(ind), precs_ad_hoc(ind))
            enddo

            ! Third order polynomial test
            f_ptr => poly3
            dpoly = polyder(poly3_coeffs)
            d2poly = polyder(dpoly)
            d4poly = polyder(polyder(d2poly))
            expected = [polyval(dpoly, y(3)), &
                        polyval(d2poly, y(3)), &
                        polyval(d4poly, y(3))]
            call get_derivatives_from_5_pts_interpolation(y, results, f_ptr)

            do ind = 1, size(results)
                @assertEqual(expected(ind), results(ind), precs(ind))
            enddo

            ! First order polynomial test
            f_ptr => poly1
            dpoly = polyder(poly1_coeffs)
            d2poly = polyder(dpoly)
            d4poly = polyder(polyder(d2poly))
            expected = [polyval(dpoly, y(3)), &
                        polyval(d2poly, y(3)), &
                        polyval(d4poly, y(3))]
            call get_derivatives_from_5_pts_interpolation(y, results, f_ptr)

            do ind = 1, size(results)
                @assertEqual(expected(ind), results(ind), precs(ind))
            enddo
        enddo
    end subroutine

    @test
    subroutine test_fourth_order_lagrange_interpolation_dense_grid()
        !! Tests whether the first, second and fourth derivatives of a fourth
        !! order polynomial are evaluated to machine precision by the
        !! fourth order lagrange interpolation on a dense grid.
        !!
        !! Dense grid tests are mainly for testing the round-off error.
        !! In floating point arithmetic, e.g. double precision with ~ 16 digits
        !! of accuracy, the presence of the 1/h^n factor in the
        !! derivative (finite difference) expression acts as a numerical
        !! amplifier: it magnifies round-off errors in the derivative.
        !! As a result, even though the theoretical truncation error may be
        !! negligible (especiallly for low order polynomial test functions),
        !! the final numerical result can suffer from significant round-off
        !! error that is h^n larger than the machine precision.
        real(kind=GP), dimension(5) :: y
        real(kind=GP), dimension(3) :: results, expected, precs
        integer :: n_cases, n_ypoints, n_results, case_idx, ind
        type(test_case), dimension(:), allocatable :: cases
        procedure(scalar_function), pointer :: f_ptr => null()
        real(kind=GP), dimension(:), allocatable :: dpoly, d2poly, d4poly

        n_cases = 2
        n_ypoints = 5
        n_results = 3

        allocate(cases(n_cases))
        do case_idx = 1, n_cases
            allocate(cases(case_idx)%y(n_ypoints))
            allocate(cases(case_idx)%precs(n_results))
        enddo

        ! Set up grids with different sizes h,
        ! the expected errors are respectively of order
        ! prec * (1/h^1, 1/h^2, 1/h^4) for first, second and fourth derivatives

        ! h approx 0.1
        cases(1)%y = [-0.25_GP, -0.12_GP, -0.05_GP, 0.118_GP, 0.2_GP]
        cases(1)%precs = [1e1 * prec, 1e2 * prec, 1e4 * prec]
        ! h approx 0.01
        cases(2)%y = [-0.023_GP, -0.011_GP, -0.003_GP, 0.008_GP, 0.018_GP]
        cases(2)%precs = [1e2 * prec, 1e4 * prec, 1e8 * prec]

        do case_idx = 1, size(cases)
            y     = cases(case_idx)%y
            precs = cases(case_idx)%precs

            ! Fourth order polynomial test
            f_ptr => poly4
            dpoly = polyder(poly4_coeffs)
            d2poly = polyder(dpoly)
            d4poly = polyder(polyder(d2poly))

            expected = [polyval(dpoly, y(3)), &
                        polyval(d2poly, y(3)), &
                        polyval(d4poly, y(3))]
            call get_derivatives_from_5_pts_interpolation(y, results, f_ptr)

            do ind = 1, size(results)
                @assertEqual(expected(ind), results(ind), precs(ind))
            enddo

            ! Third order polynomial test
            f_ptr => poly3
            dpoly = polyder(poly3_coeffs)
            d2poly = polyder(dpoly)
            d4poly = polyder(polyder(d2poly))
            expected = [polyval(dpoly, y(3)), &
                        polyval(d2poly, y(3)), &
                        polyval(d4poly, y(3))]
            call get_derivatives_from_5_pts_interpolation(y, results, f_ptr)

            do ind = 1, size(results)
                @assertEqual(expected(ind), results(ind), precs(ind))
            enddo

            ! First order polynomial test
            f_ptr => poly1
            dpoly = polyder(poly1_coeffs)
            d2poly = polyder(dpoly)
            d4poly = polyder(polyder(d2poly))
            expected = [polyval(dpoly, y(3)), &
                        polyval(d2poly, y(3)), &
                        polyval(d4poly, y(3))]
            call get_derivatives_from_5_pts_interpolation(y, results, f_ptr)

            do ind = 1, size(results)
                @assertEqual(expected(ind), results(ind), precs(ind))
            enddo
        enddo
    end subroutine

    @test
    subroutine test_first_order_scheme()
        !! Tests whether the first derivatives of a first order polynomial (
        !! first order scheme) are evaluated to machine precision by the
        !! second order (2-point) lagrange interpolation.
        real(kind=GP), dimension(2) :: y
        real(kind=GP), dimension(2) :: results, expected, precs
        integer :: n_cases, n_ypoints, n_results, case_idx, ind
        type(test_case), dimension(:), allocatable :: cases
        procedure(scalar_function), pointer :: f_ptr => null()
        real(kind=GP), dimension(:), allocatable :: dpoly

        n_cases = 5
        n_ypoints = 2
        n_results = 2

        allocate(cases(n_cases))
        do case_idx = 1, n_cases
            allocate(cases(case_idx)%y(n_ypoints))
            allocate(cases(case_idx)%precs(n_results))
        enddo

        ! Set up grids with different sizes h,
        ! the expected errors are respectively of order 1/h^1 * prec
        ! h = 1
        cases(1)%y = [-2_GP, -1_GP]
        cases(1)%precs = [prec, prec]
        ! h = 1e-1
        cases(2)%y = [-0.2_GP, -0.1_GP]
        cases(2)%precs = [1e1 * prec, 1e1 * prec]
        ! h = 1e-2
        cases(3)%y = [1.3_GP - 6e-2_GP, 1.3_GP - 5e-2_GP]
        cases(3)%precs = [1e2 * prec, 1e2 * prec]
        ! h = 1e-3
        cases(4)%y = [2e-3_GP, 3e-3_GP]
        cases(4)%precs = [1e3 * prec, 1e3 * prec]
        ! h = 1e-4
        cases(5)%y = [-6e-4_GP, -5e-4_GP]
        cases(5)%precs = [1e4 * prec, 1e4 * prec]

        do case_idx = 1, size(cases)
            y     = cases(case_idx)%y
            precs = cases(case_idx)%precs

            ! First order polynomial test
            f_ptr => poly1
            dpoly = polyder(poly1_coeffs)
            expected = [polyval(dpoly, y(2)), &
                        polyval(dpoly, y(1))]
            call get_derivatives_from_2_pts_interpolation(y, results, f_ptr)

            do ind = 1, size(results)
                @assertEqual(expected(ind), results(ind), precs(ind))
            enddo
        enddo
    end subroutine
end module
