module test_mesh_5d
    !! Contains tests for the mesh_5d_t type
    use mpi
    use pfunit
    use math_m, only: PI, almost_equal
    use genex_fortran_env_m, only: GP, GP_EPS, DP
    use mesh_5d_m, only: mesh_5d_t, FILLER_VALUE_REAL
    use dcomm_handler_m, only: dcomm_handler_t
    use params_m, only: set_parameter_file
    use params_mesh_m, only: get_n_levels
    use bsg_types_m, only: unpack_bflag
    ! Unit test helpers
    use test_params_m
    use equilibrium_reference_m, only: equilibrium_reference_t, &
                                       slab_reference_t, &
                                       circular_reference_t, &
                                       salpha_reference_t, &
                                       dommaschk_reference_t
    ! From PARALLAX
    use array_generation_m, only: linspace
    use equilibrium_factory_m, only: SLAB, CIRCULAR, SALPHA, DOMMASCHK, &
                                     CIRCULAR_TOROIDAL
    use equilibrium_m, only: equilibrium_t
    use circular_toroidal_equilibrium_m, only: circular_toroidal_t
    use equilibrium_factory_m, only: create_equilibrium
    use mesh_cart_m, only: mesh_cart_t
    use multigrid_m, only: multigrid_t
    use csrmat_m, only: csrmat_t, csr_times_vec
    use polar_map_factory_m, only: create_cart_map_matrix
    use polar_grid_m, only : polar_grid_t

    implicit none

    integer, parameter :: size_neighbor = 2
    integer, parameter :: size_ghost_layer = 3

    integer, parameter :: n_points_phi_ref = 4, &
                          n_points_vp_ref  = 1, &
                          n_points_mu_ref  = 1

contains

    @before
    subroutine setup(this)
        ! Flush out all the default parameters
        class(MpiTestMethod), intent(inout) :: this
        call write_default_params(this%getMpiCommunicator(), &
                                  this%getProcessRank())
    end subroutine

    @after
    subroutine teardown(this)
        ! Read all the default parameters
        class(MpiTestMethod), intent(inout) :: this
        call read_default_params(this%getMpiCommunicator(), &
                                 this%getProcessRank())
    end subroutine

    @test(npes = [2])
    subroutine test_mesh_slab(this)
        !! Tests for the SLAB equilibrium mesh
        class (MpiTestMethod), intent(inout) :: this

        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), allocatable, target :: dcomm_handler
        type(mesh_5d_t), allocatable :: mesh
        class(equilibrium_reference_t), allocatable :: equilibrium_reference
        real(kind=GP) :: spacing_RZ

        spacing_RZ = 1.0_GP

        allocate(mesh)
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=SLAB, &
                             spacing_RZ=spacing_RZ, &
                             n_points_phi=n_points_phi_ref, &
                             n_points_vp=n_points_vp_ref, &
                             n_points_mu=n_points_mu_ref, &
                             quad_type_vp="trapezoidal", &
                             grid_type_mu="quadratic")

        allocate(dcomm_handler)
        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                      this%getNumProcesses(), 1, 1, 1)
        dcomm_handler_ptr => dcomm_handler

        call mesh%initialize(dcomm_handler_ptr)

        call test_mesh_ghosts_core (mesh, spacing_RZ)
        call test_mesh_fillers_core(mesh, spacing_RZ)
        call test_mesh_buffers_core(mesh)
        call test_mesh_size_core(mesh)

        allocate(slab_reference_t :: equilibrium_reference)
        call test_equilibrium_core(mesh, equilibrium_reference)
        deallocate(equilibrium_reference)

        deallocate(mesh)

        allocate(mesh)
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=SLAB, &
                             spacing_RZ=16.00_GP, &
                             n_points_phi=4, &
                             n_points_vp=8, &
                             n_points_mu=4, &
                             quad_type_vp="trapezoidal", &
                             grid_type_mu="quadratic", &
                             use_vspectral=.true.)

        call mesh%initialize(dcomm_handler_ptr)

        call test_mesh_size_core(mesh)

        deallocate(mesh)

        allocate(mesh)
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=SLAB, &
                             spacing_RZ=16.00_GP, &
                             n_points_phi=n_points_phi_ref, &
                             n_points_vp=n_points_vp_ref, &
                             n_points_mu=n_points_mu_ref, &
                             quad_type_vp="trapezoidal", &
                             grid_type_mu="quadratic", &
                             use_vspectral=.false.)

        call mesh%initialize(dcomm_handler_ptr)

        call test_mesh_size_core(mesh)

        deallocate(mesh)
        deallocate(dcomm_handler)
    end subroutine

    @test(npes = [2])
    subroutine test_mesh_salpha(this)
        !! Tests for the SALPHA equilibrium mesh
        class (MpiTestMethod), intent(inout) :: this

        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), allocatable, target :: dcomm_handler
        type(mesh_5d_t), allocatable :: mesh
        class(equilibrium_reference_t), allocatable :: equilibrium_reference
        real(kind=GP) :: spacing_RZ

        spacing_RZ = 0.02_GP

        allocate(mesh)
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=SALPHA, &
                             spacing_RZ=spacing_RZ, &
                             n_points_phi=n_points_phi_ref, &
                             n_points_vp=n_points_vp_ref, &
                             n_points_mu=n_points_mu_ref, &
                             quad_type_vp="trapezoidal")

        allocate(dcomm_handler)
        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                      this%getNumProcesses(), 1, 1, 1)
        dcomm_handler_ptr => dcomm_handler

        call mesh%initialize(dcomm_handler_ptr)

        call test_mesh_neighbors_core(mesh)

        allocate(salpha_reference_t :: equilibrium_reference)
        call test_equilibrium_core(mesh, equilibrium_reference)
        deallocate(equilibrium_reference)

        deallocate(mesh)
        deallocate(dcomm_handler)
    end subroutine

    @test(npes = [2])
    subroutine test_mesh_circular(this)
        !! Tests for the CIRCULAR equilibrium mesh
        class (MpiTestMethod), intent(inout) :: this

        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), allocatable, target :: dcomm_handler
        type(mesh_5d_t), allocatable :: mesh
        class(equilibrium_reference_t), allocatable :: equilibrium_reference
        real(kind=GP) :: spacing_RZ

        spacing_RZ = 0.05_GP

        allocate(mesh)
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=CIRCULAR, &
                             spacing_RZ=spacing_RZ, &
                             n_points_phi=n_points_phi_ref, &
                             n_points_vp=n_points_vp_ref, &
                             n_points_mu=n_points_mu_ref, &
                             quad_type_vp="trapezoidal")

        allocate(dcomm_handler)
        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                      this%getNumProcesses(), 1, 1, 1)
        dcomm_handler_ptr => dcomm_handler

        call mesh%initialize(dcomm_handler_ptr)

        allocate(circular_reference_t :: equilibrium_reference)
        call test_equilibrium_core(mesh, equilibrium_reference)
        deallocate(equilibrium_reference)
        deallocate(mesh)

        allocate(mesh)
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=CIRCULAR, &
                             spacing_RZ=spacing_RZ, &
                             n_points_phi=n_points_phi_ref, &
                             n_points_vp=2, &
                             n_points_mu=2, &
                             quad_type_vp="trapezoidal")

        call mesh%initialize(dcomm_handler_ptr)

        call test_mesh_size_core(mesh)

        deallocate(mesh)
        deallocate(dcomm_handler)

        allocate(mesh)
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=CIRCULAR, &
                             spacing_RZ=spacing_RZ, &
                             n_points_phi=2, &
                             n_levels=1)

        allocate(dcomm_handler)
        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                      this%getNumProcesses(), 1, 1, 1)
        dcomm_handler_ptr => dcomm_handler

        call mesh%initialize(dcomm_handler_ptr)

        call test_RZ_quadrature_core(mesh)

        deallocate(mesh)
        deallocate(dcomm_handler)
    end subroutine

    @test(npes = [2])
    subroutine test_mesh_dommaschk(this)
        !! Tests for the DOMMASCHK equilibrium mesh
        class (MpiTestMethod), intent(inout) :: this

        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), allocatable, target :: dcomm_handler
        type(mesh_5d_t), allocatable :: mesh
        class(equilibrium_reference_t), allocatable :: equilibrium_reference
        real(kind=GP), dimension(1:4, 0:1, 0:2) :: fitting_coef_test
        real(kind=GP) :: spacing_RZ

        spacing_RZ = 0.012_GP
        ! NOTE: This spacing_RZ ensures a minimum of variety
        !       in each point category of the mesh, as the first plane k=1
        !       has 124 points, 102 ghosts, and 9 fillers.

        allocate(dcomm_handler)
        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                      this%getNumProcesses(), 1, 1, 1)
        dcomm_handler_ptr => dcomm_handler

        fitting_coef_test = 0.0_GP
        fitting_coef_test(2:3, 1, 2) = 1.489_GP
        call setup_test_equi_dommaschk(this%getMpiCommunicator(), &
                                       this%getProcessRank(), &
                                       l_pol=2, &
                                       fitting_coef=fitting_coef_test)
        allocate(mesh)
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=DOMMASCHK, &
                             spacing_RZ=spacing_RZ, &
                             n_points_phi=n_points_phi_ref, &
                             n_points_vp=n_points_vp_ref, &
                             n_points_mu=n_points_mu_ref, &
                             quad_type_vp="trapezoidal")

        call mesh%initialize(dcomm_handler_ptr)

        allocate(dommaschk_reference_t :: equilibrium_reference)
        call test_equilibrium_core(mesh, equilibrium_reference)
        deallocate(equilibrium_reference)

        call test_mesh_ghosts_core      (mesh, spacing_RZ)
        call test_mesh_compute_mask_core(mesh)
        call test_mesh_fillers_core     (mesh, spacing_RZ)
        call test_mesh_neighbors_core   (mesh)
        call test_mesh_buffers_core     (mesh)

        deallocate(mesh)
        deallocate(dcomm_handler)

        allocate(mesh)
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=DOMMASCHK, &
                             spacing_RZ=spacing_RZ, &
                             n_points_phi=5, &
                             n_points_vp=2, &
                             n_points_mu=1, &
                             quad_type_vp="trapezoidal")

        allocate(dcomm_handler)
        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                      1, this%getNumProcesses(), 1, 1)
        dcomm_handler_ptr => dcomm_handler

        call mesh%initialize(dcomm_handler_ptr)

        call test_mesh_buffers_core(mesh)

        deallocate(mesh)
        deallocate(dcomm_handler)
    end subroutine

    subroutine test_mesh_ghosts_core(mesh_5d, spacing_RZ)
        !! Tests the correct init of the ghost indices in the mesh
        type(mesh_5d_t), intent(inout) :: mesh_5d
        real(kind=GP), intent(inout) :: spacing_RZ

        type(multigrid_t), allocatable :: multigrid_2d
        type(mesh_cart_t), allocatable :: mesh_2d
        class(equilibrium_t), target, allocatable :: equilibrium_instance
        integer :: size_total, size_bound, size_ghost, size_inner
        real(kind=GP) :: size_RZ_plane
        integer :: multigrid_levels
        integer, dimension(:), allocatable :: multigrid_reorder_size
        logical :: all_fine
        real(kind=GP), dimension(:,:), pointer :: not_ghost, not_filler
        real(kind=GP), dimension(:), pointer :: phi
        integer :: i, k

        multigrid_levels = get_n_levels()
        allocate(multigrid_reorder_size(multigrid_levels))
        multigrid_reorder_size = 0

        if(mesh_5d%equi_type() == SLAB) then
            ! SLAB

            not_ghost => mesh_5d%get_not_ghost_pointer()

            ! Build reference 2d mesh and get boundaries and ghosts
            call create_equilibrium(equilibrium_instance, SLAB, dbgout = 0)
            allocate(multigrid_2d)
            allocate(mesh_2d)
            call multigrid_2d%init(equilibrium_instance, &
                                   phi=0.0_GP, &
                                   spacing_f=spacing_RZ, &
                                   nlvls=multigrid_levels, &
                                   size_neighbor=size_neighbor, &
                                   size_ghost_layer=size_ghost_layer, &
                                   mesh_finest=mesh_2d, &
                                   reorder_size=multigrid_reorder_size, &
                                   extend_beyond_wall=.false., &
                                   dbgout=0)

            size_total = mesh_2d%get_n_points()
            size_inner = mesh_2d%get_n_points_inner()
            size_bound = mesh_2d%get_n_points_boundary()
            size_ghost = mesh_2d%get_n_points_ghost()

            ! Check expected size of arrays (no fillers for SLAB)
            do k = 1, mesh_5d%size_phi()
                @assertEqual(mesh_5d%size_RZ_plane(k), mesh_5d%size_RZ())
            enddo
            @assertEqual(size_inner + size_bound + size_ghost,mesh_5d%size_RZ())

            ! For SLAB, all planes should be the same
            do k = 2, mesh_5d%size_phi()
                all_fine = all(almost_equal(not_ghost(:, 1), &
                                            not_ghost(:, k), GP_EPS))
                @assertTrue(all_fine)
            enddo

            k = 1
            ! Check that ghost points in GENE-X are set correctly by looking at
            ! the PARALLAX masks in mesh_2d
            do i = 1, size_total
                if (mesh_2d%is_ghost_point(i) &
                    .or. mesh_2d%is_boundary_point(i)) then
                    @assertTrue(not_ghost(i, k) == 0.0_GP)
                else
                    @assertTrue(not_ghost(i, k) == 1.0_GP)
                end if
            end do

            deallocate(multigrid_2d)
            deallocate(mesh_2d)
            deallocate(equilibrium_instance)

        else if(mesh_5d%equi_type() == DOMMASCHK) then
            ! DOMMASCHK

            not_ghost  => mesh_5d%get_not_ghost_pointer()
            not_filler => mesh_5d%get_not_filler_pointer()
            phi        => mesh_5d%get_phi_pointer()

            call create_equilibrium(equilibrium_instance, DOMMASCHK, dbgout=0)

            do k = 1, mesh_5d%size_phi()
                allocate(multigrid_2d)
                allocate(mesh_2d)
                call multigrid_2d%init(equilibrium_instance, &
                                       phi=phi(k), &
                                       spacing_f=spacing_RZ, &
                                       nlvls=multigrid_levels, &
                                       size_neighbor=size_neighbor, &
                                       size_ghost_layer=size_ghost_layer, &
                                       mesh_finest=mesh_2d, &
                                       reorder_size=multigrid_reorder_size, &
                                       extend_beyond_wall=.false., &
                                       dbgout=0)

                size_total = mesh_2d%get_n_points()
                size_inner = mesh_2d%get_n_points_inner()
                size_bound = mesh_2d%get_n_points_boundary()
                size_ghost = mesh_2d%get_n_points_ghost()

                size_RZ_plane = mesh_5d%size_RZ_plane(k)

                ! Check that the number of mesh points are consistent
                @assertTrue(size_RZ_plane <= mesh_5d%size_RZ())
                @assertTrue(size_RZ_plane==size_inner + size_bound + size_ghost)

                ! Check ghost and compute points
                do i = 1, size_total
                    if (mesh_2d%is_ghost_point(i) &
                        .or. mesh_2d%is_boundary_point(i)) then
                        @assertTrue(not_ghost(i, k) == 0.0_GP)
                    else
                        @assertTrue(not_ghost(i, k) == 1.0_GP)
                    endif
                enddo
                ! The remaining points should be fillers
                do i = (size_total + 1), mesh_5d%size_RZ()
                    @assertTrue(not_ghost(i, k) == FILLER_VALUE_REAL)
                enddo

                deallocate(multigrid_2d)
                deallocate(mesh_2d)
            enddo

            deallocate(equilibrium_instance)
        endif
    end subroutine

    subroutine test_mesh_fillers_core(mesh_5d, spacing_RZ)
        !! Tests the correct init of the filler mask
        type(mesh_5d_t), intent(inout) :: mesh_5d
        real(kind=GP), intent(inout) :: spacing_RZ

        type(mesh_cart_t), allocatable :: mesh_2d
        class(equilibrium_t), target, allocatable :: equilibrium_instance
        real(kind=GP), dimension(:,:), pointer :: not_filler, R
        real(kind=GP), dimension(:), pointer :: phi
        integer :: i, k, mesh_2d_size
        logical :: equal

        if(mesh_5d%equi_type() == SLAB) then
            ! SLAB

            not_filler => mesh_5d%get_not_filler_pointer()
            R => mesh_5d%get_R_pointer()

            ! Check expected array shape
            equal = all(shape(not_filler) &
                        == [mesh_5d%size_RZ(), mesh_5d%size_phi()])
            @assertTrue(equal)
            equal = all(shape(R) == [mesh_5d%size_RZ(), mesh_5d%size_phi()])
            @assertTrue(equal)

            ! For 2D, all meshes are the same, so there should be
            ! no filler points
            do k = 1, mesh_5d%size_phi()
            do i = 1, mesh_5d%size_RZ()
                @assertTrue(not_filler(i, k) == 1.0_GP)
                @assertTrue(R(i, k) /= FILLER_VALUE_REAL)
            enddo
            enddo
            equal = almost_equal(sum(not_filler), &
                                 1.0_GP * size(not_filler), &
                                 GP_EPS)
            @assertTrue(equal)

        else if(mesh_5d%equi_type() == DOMMASCHK) then
            ! DOMMASCHK

            call create_equilibrium(equilibrium_instance, DOMMASCHK, dbgout=0)

            not_filler => mesh_5d%get_not_filler_pointer()
            R          => mesh_5d%get_R_pointer()
            phi        => mesh_5d%get_phi_pointer()

            ! Check expected array shape
            equal = all(shape(not_filler) &
                        == [mesh_5d%size_RZ(), mesh_5d%size_phi()])
            @assertTrue(equal)
            equal = all(shape(R) == [mesh_5d%size_RZ(), mesh_5d%size_phi()])
            @assertTrue(equal)

            ! Check that filler points are identified correctly
            ! for a 3D equilibrium
            do k = 1, mesh_5d%size_phi()
                allocate(mesh_2d)
                call mesh_2d%init(equilibrium_instance, phi(k), lvl=1, &
                                  spacing_f=spacing_RZ, &
                                  size_neighbor=size_neighbor, &
                                  size_ghost_layer=size_ghost_layer, &
                                  extend_beyond_wall=.false., dbgout=0)
                mesh_2d_size = mesh_2d%get_n_points()

                @assertTrue(mesh_2d_size == mesh_5d%size_RZ_plane(k))
                equal = almost_equal(1.0_GP * mesh_2d_size, &
                                     sum(not_filler(:, k)), GP_EPS)
                @assertTrue(equal)

                do i = 1, mesh_5d%size_RZ()
                    if(i <= mesh_2d_size) then
                        @assertTrue(not_filler(i, k) == 1.0_GP)
                        @assertTrue(R(i, k) /= FILLER_VALUE_REAL)
                    else
                        @assertTrue(not_filler(i, k) == 0.0_GP)
                        @assertTrue(R(i, k) == FILLER_VALUE_REAL)
                    endif
                enddo

                deallocate(mesh_2d)
            enddo
        endif
    end subroutine

    subroutine test_mesh_buffers_core(mesh)
        !! Tests that buffers from 2D equilibria do not depend on phi, while
        !! buffers from 3D equilibria do depend on phi
        type(mesh_5d_t), intent(inout) :: mesh

        real(kind=GP), dimension(:,:), pointer :: R, Z, jacobian, absB, &
                        normb_R, normb_Z, normb_tor, rho, theta, psi, inv_g, &
                        curl_normb_y, dgyxdy, dgyzdy, dgyxdz, dgyzdx, &
                        dabsBdx, dabsBdz, dabsBdy, not_filler
        integer, dimension(2) :: array_shp
        integer :: i, k
        logical :: all_equal, single_equal
        real(kind=GP) :: thresh, thresh_dperp, thresh_dpar, thresh_different
        real(kind=GP) :: ratio, h_perp, h_par

        ! Base threshold for comparing identical quantities
        thresh = 10 * GP_EPS
        ! These values are used to compute the derivatives of the magnetic field
        if(GP == DP) then
            h_perp = 1e-5_GP
            h_par  = 1e-6_GP
        else
            h_perp = 1e-4_GP
            h_par  = 1e-3_GP
        endif
        ! Due to floating point arithmetics, we expect the error to depend on
        ! the small value used to calculate the derivative. Thus we adjust the
        ! threshold for derivatives in the parallel and perpendicular direction.
        thresh_dperp = thresh / (2 * h_perp)
        thresh_dpar  = thresh / (2 * h_par)

        if (mesh%equi_type() == SLAB) then
            ! SLAB

            R            => mesh%get_R_pointer()
            Z            => mesh%get_Z_pointer()
            jacobian     => mesh%get_jacobian_pointer()
            absB         => mesh%get_absB_pointer()
            normb_R      => mesh%get_normb_R_pointer()
            normb_Z      => mesh%get_normb_Z_pointer()
            normb_tor    => mesh%get_normb_tor_pointer()
            rho          => mesh%get_rho_pointer()
            theta        => mesh%get_theta_pointer()
            psi          => mesh%get_psi_pointer()
            curl_normb_y => mesh%get_curl_normb_y_pointer()
            inv_g        => mesh%get_inv_g_pointer()
            dgyxdy       => mesh%get_dgyxdy_over_g_pointer()
            dgyzdy       => mesh%get_dgyzdy_over_g_pointer()
            dgyxdz       => mesh%get_dgyxdz_over_g_pointer()
            dgyzdx       => mesh%get_dgyzdx_over_g_pointer()
            dabsBdx      => mesh%get_dabsBdx_pointer()
            dabsBdz      => mesh%get_dabsBdz_pointer()
            dabsBdy      => mesh%get_dabsBdy_pointer()

            ! Check expected array shape
            array_shp = [mesh%size_RZ(), mesh%size_phi()]
            @assertTrue(all(shape(R)            == array_shp))
            @assertTrue(all(shape(Z)            == array_shp))
            @assertTrue(all(shape(jacobian)     == array_shp))
            @assertTrue(all(shape(absB)         == array_shp))
            @assertTrue(all(shape(normb_R)      == array_shp))
            @assertTrue(all(shape(normb_Z)      == array_shp))
            @assertTrue(all(shape(normb_tor)    == array_shp))
            @assertTrue(all(shape(rho)          == array_shp))
            @assertTrue(all(shape(theta)        == array_shp))
            @assertTrue(all(shape(psi)          == array_shp))
            @assertTrue(all(shape(curl_normb_y) == array_shp))
            @assertTrue(all(shape(inv_g)        == array_shp))
            @assertTrue(all(shape(dgyxdy)       == array_shp))
            @assertTrue(all(shape(dgyzdy)       == array_shp))
            @assertTrue(all(shape(dgyxdz)       == array_shp))
            @assertTrue(all(shape(dgyzdx)       == array_shp))
            @assertTrue(all(shape(dabsBdx)      == array_shp))
            @assertTrue(all(shape(dabsBdz)      == array_shp))
            @assertTrue(all(shape(dabsBdy)      == array_shp))

            ! Since SLAB is 2D, the buffers should be the same on every plane.
            ! We expect no difference in magnetic field quantities and
            ! derivatives in the plane because the field is 0 (R, Z components)
            ! or 1 (phi component). For parallel derivatives a deviation
            ! is possible due to the inexact trace routine and the
            ! floating point accuracy in calculating the derivative.
            do k = 2, mesh%size_phi()
                all_equal = all(almost_equal(R(:, 1), R(:, k), GP_EPS))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(Z(:, 1), Z(:, k), GP_EPS))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(jacobian(:, 1), &
                                             jacobian(:, k), GP_EPS))
                @assertTrue(all_equal)

                all_equal = all(almost_equal(absB(:, 1), absB(:, k), GP_EPS))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(normb_R(:, 1), &
                                             normb_R(:, k), GP_EPS))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(normb_Z(:, 1), &
                                             normb_Z(:, k), GP_EPS))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(normb_tor(:, 1), &
                                             normb_tor(:, k), GP_EPS))
                @assertTrue(all_equal)

                all_equal = all(almost_equal(rho(:, 1), rho(:, k), GP_EPS))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(theta(:, 1), theta(:, k), GP_EPS))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(psi(:, 1), psi(:, k), GP_EPS))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(curl_normb_y(:, 1), &
                                             curl_normb_y(:, k), thresh_dpar))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(inv_g(:, 1), inv_g(:, k), GP_EPS))
                @assertTrue(all_equal)

                all_equal = all(almost_equal(dgyxdy(:, 1), &
                                             dgyxdy(:, k), thresh_dpar))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(dgyzdy(:, 1), &
                                             dgyzdy(:, k), thresh_dpar))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(dgyxdz(:, 1), &
                                             dgyxdz(:, k), GP_EPS))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(dgyzdx(:, 1), &
                                             dgyzdx(:, k), GP_EPS))
                @assertTrue(all_equal)

                all_equal = all(almost_equal(dabsBdz(:, 1), &
                                             dabsBdz(:, k), GP_EPS))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(dabsBdx(:, 1), &
                                             dabsBdx(:, k), GP_EPS))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(dabsBdy(:, 1), &
                                             dabsBdy(:, k), thresh_dpar))
                @assertTrue(all_equal)

            enddo

        else if(mesh%equi_type() == DOMMASCHK &
                .and. mod(mesh%size_phi(), 5) /= 0) then
            ! DOMMASCHK
            ! When n_points_phi is not a multiple of the number of field periods
            ! the buffers should be different on every plane

            ! NOTE: We do not test psi or theta here since they are not
            !       implemented for Dommaschk, nor rho since it is disabled
            !       by default
            R            => mesh%get_R_pointer()
            Z            => mesh%get_Z_pointer()
            jacobian     => mesh%get_jacobian_pointer()
            absB         => mesh%get_absB_pointer()
            normb_R      => mesh%get_normb_R_pointer()
            normb_Z      => mesh%get_normb_Z_pointer()
            normb_tor    => mesh%get_normb_tor_pointer()
            curl_normb_y => mesh%get_curl_normb_y_pointer()
            inv_g        => mesh%get_inv_g_pointer()
            dgyxdy       => mesh%get_dgyxdy_over_g_pointer()
            dgyzdy       => mesh%get_dgyzdy_over_g_pointer()
            dgyxdz       => mesh%get_dgyxdz_over_g_pointer()
            dgyzdx       => mesh%get_dgyzdx_over_g_pointer()
            dabsBdx      => mesh%get_dabsBdx_pointer()
            dabsBdz      => mesh%get_dabsBdz_pointer()
            dabsBdy      => mesh%get_dabsBdy_pointer()
            not_filler   => mesh%get_not_filler_pointer()

            ! Threshold that values are different
            thresh_different = 1e-3_GP
            ! NOTE: Since we are testing that each buffer is different on every
            !       plane, a larger threshold implies a more strict test
            do k = 2, mesh%size_phi()
                all_equal = all(almost_equal(R(:, 1), &
                                             R(:, k), thresh_different))
                @assertFalse(all_equal)
                all_equal = all(almost_equal(Z(:, 1), &
                                             Z(:, k), thresh_different))
                @assertFalse(all_equal)
                all_equal = all(almost_equal(jacobian(:, 1), &
                                             jacobian(:, k), thresh_different))
                @assertFalse(all_equal)

                all_equal = all(almost_equal(absB(:, 1), &
                                             absB(:, k), thresh_different))
                @assertFalse(all_equal)
                all_equal = all(almost_equal(normb_R(:, 1), &
                                             normb_R(:, k), thresh_different))
                @assertFalse(all_equal)
                all_equal = all(almost_equal(normb_Z(:, 1), &
                                             normb_Z(:, k), thresh_different))
                @assertFalse(all_equal)
                all_equal = all(almost_equal(normb_tor(:, 1), &
                                             normb_tor(:, k), thresh_different))
                @assertFalse(all_equal)

                ! Test curl_normb_y in relative terms since it tends to be very
                ! small for the default Dommaschk equilibrium. The test enforces
                ! that somewhere on the k /= 1 mesh the value of curl_normb_y
                ! should be different than on the k = 1 mesh by more than 25%.
                all_equal = .true.
                do i = 1, mesh%size_RZ()
                    if (not_filler(i, k) == 1.0_GP .and. &
                        abs(curl_normb_y(i, 1)) > GP_EPS) then

                        ratio = curl_normb_y(i, k) / curl_normb_y(i, 1)
                        single_equal = almost_equal(ratio, 1.0_GP, 0.25_GP)
                        all_equal = all_equal .and. single_equal
                    endif
                enddo
                @assertFalse(all_equal)
                all_equal = all(almost_equal(inv_g(:, 1), &
                                             inv_g(:, k), thresh_different))
                @assertFalse(all_equal)

                all_equal = all(almost_equal(dgyxdy(:, 1), &
                                             dgyxdy(:, k), thresh_different))
                @assertFalse(all_equal)
                all_equal = all(almost_equal(dgyzdy(:, 1), &
                                             dgyzdy(:, k), thresh_different))
                @assertFalse(all_equal)
                all_equal = all(almost_equal(dgyxdz(:, 1), &
                                             dgyxdz(:, k), thresh_different))
                @assertFalse(all_equal)
                all_equal = all(almost_equal(dgyzdx(:, 1), &
                                             dgyzdx(:, k), thresh_different))
                @assertFalse(all_equal)

                all_equal = all(almost_equal(dabsBdz(:, 1), &
                                             dabsBdz(:, k), thresh_different))
                @assertFalse(all_equal)
                all_equal = all(almost_equal(dabsBdx(:, 1), &
                                             dabsBdx(:, k), thresh_different))
                @assertFalse(all_equal)
                all_equal = all(almost_equal(dabsBdy(:, 1), &
                                             dabsBdy(:, k), thresh_different))
                @assertFalse(all_equal)
            enddo

        else if(mesh%equi_type() == DOMMASCHK .and. mesh%size_phi() == 5) then
            ! DOMMASCHK
            ! Check that the mesh is the same when n_points_phi is equal to the
            ! number of field periods

            R            => mesh%get_R_pointer()
            Z            => mesh%get_Z_pointer()
            jacobian     => mesh%get_jacobian_pointer()
            absB         => mesh%get_absB_pointer()
            normb_R      => mesh%get_normb_R_pointer()
            normb_Z      => mesh%get_normb_Z_pointer()
            normb_tor    => mesh%get_normb_tor_pointer()
            rho          => mesh%get_rho_pointer()
            theta        => mesh%get_theta_pointer()
            psi          => mesh%get_psi_pointer()
            curl_normb_y => mesh%get_curl_normb_y_pointer()
            inv_g        => mesh%get_inv_g_pointer()
            dgyxdy       => mesh%get_dgyxdy_over_g_pointer()
            dgyzdy       => mesh%get_dgyzdy_over_g_pointer()
            dgyxdz       => mesh%get_dgyxdz_over_g_pointer()
            dgyzdx       => mesh%get_dgyzdx_over_g_pointer()
            dabsBdx      => mesh%get_dabsBdx_pointer()
            dabsBdz      => mesh%get_dabsBdz_pointer()
            dabsBdy      => mesh%get_dabsBdy_pointer()

            do k = 2, mesh%size_phi()
                all_equal = all(almost_equal(R(:, 1), R(:, k), thresh))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(Z(:, 1), Z(:, k), thresh))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(jacobian(:, 1), &
                                             jacobian(:, k), thresh))
                @assertTrue(all_equal)

                all_equal = all(almost_equal(absB(:, 1), absB(:, k), thresh))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(normb_R(:, 1), &
                                             normb_R(:, k), thresh))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(normb_Z(:, 1), &
                                             normb_Z(:, k), thresh))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(normb_tor(:, 1), &
                                             normb_tor(:, k), thresh))
                @assertTrue(all_equal)

                all_equal = all(almost_equal(rho(:, 1), &
                                             rho(:, k), thresh))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(theta(:, 1), &
                                             theta(:, k), thresh))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(psi(:, 1), &
                                             psi(:, k), thresh))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(curl_normb_y(:, 1), &
                                             curl_normb_y(:, k), thresh_dpar))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(inv_g(:, 1), inv_g(:, k), thresh))
                @assertTrue(all_equal)

                all_equal = all(almost_equal(dgyxdy(:, 1), &
                                             dgyxdy(:, k), thresh_dpar))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(dgyzdy(:, 1), &
                                             dgyzdy(:, k), thresh_dpar))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(dgyxdz(:, 1), &
                                             dgyxdz(:, k), thresh_dperp))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(dgyzdx(:, 1), &
                                             dgyzdx(:, k), thresh_dperp))
                @assertTrue(all_equal)

                all_equal = all(almost_equal(dabsBdz(:, 1), &
                                             dabsBdz(:, k), thresh_dperp))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(dabsBdx(:, 1), &
                                             dabsBdx(:, k), thresh_dperp))
                @assertTrue(all_equal)
                all_equal = all(almost_equal(dabsBdy(:, 1), &
                                             dabsBdy(:, k), thresh_dpar))
                @assertTrue(all_equal)
            enddo
        endif
    end subroutine

    subroutine test_equilibrium_core(mesh, equilibrium_reference)
        type(mesh_5d_t), target, intent(inout) :: mesh
        class(equilibrium_reference_t), intent(inout) :: equilibrium_reference

        real(kind=GP) :: x, z, phi, prec, inv_g, theta_tol
        real(kind=GP), dimension(:,:), pointer :: dgyxdz_over_g, &
            dgyzdx_over_g, dgyxdy_over_g, dgyzdy_over_g, dabsBdx, dabsBdy, &
            dabsBdz, curl_normb_y, absB, bR, bZ, btor, psi, jacobian, rho, &
            theta, not_filler
        integer :: i, k

        prec = 1e-8_GP
        theta_tol = GP_EPS

        dgyxdz_over_g => mesh%get_dgyxdz_over_g_pointer()
        dgyzdx_over_g => mesh%get_dgyzdx_over_g_pointer()
        dgyxdy_over_g => mesh%get_dgyxdy_over_g_pointer()
        dgyzdy_over_g => mesh%get_dgyzdy_over_g_pointer()
        dabsBdx => mesh%get_dabsBdx_pointer()
        dabsBdy => mesh%get_dabsBdy_pointer()
        dabsBdz => mesh%get_dabsBdz_pointer()
        curl_normb_y => mesh%get_curl_normb_y_pointer()
        absB => mesh%get_absB_pointer()
        bR => mesh%get_normb_R_pointer()
        bZ => mesh%get_normb_Z_pointer()
        btor => mesh%get_normb_tor_pointer()
        psi => mesh%get_psi_pointer()
        jacobian => mesh%get_jacobian_pointer()
        rho => mesh%get_rho_pointer()
        theta => mesh%get_theta_pointer()
        not_filler => mesh%get_not_filler_pointer()

        select type(equilibrium_reference)
        class is(slab_reference_t)
            @assertEqual(mesh%equi_type(), SLAB)
            @assertEqual(mesh%rho_min(), 0.0_GP, GP_EPS)
            @assertEqual(mesh%rho_max(), 64.0_GP, GP_EPS)
            @assertTrue(mesh%is_axisymmetric())
        class is(circular_reference_t)
            call equilibrium_reference%initialize(q_ref = 4.0_GP, &
                                                  shear = 3.71_GP, &
                                                  rho_ref = 0.305_GP)
            @assertEqual(mesh%equi_type(), CIRCULAR)
            @assertEqual(mesh%rho_min(), 0.2412_GP, GP_EPS)
            @assertEqual(mesh%rho_max(), 0.3685_GP, GP_EPS)
            @assertTrue(mesh%is_axisymmetric())
        class is(salpha_reference_t)
            call equilibrium_reference%initialize(q_ref = 0.854_GP, &
                                                  shear = 2.184_GP, &
                                                  minor_r = 0.365_GP, &
                                                  L_ref = 1.0_GP, &
                                                  B_ref = 1.0_GP)
            @assertEqual(mesh%equi_type(), SALPHA)
            @assertEqual(mesh%rho_min(), 0.1_GP, GP_EPS)
            @assertEqual(mesh%rho_max(), 0.7_GP, GP_EPS)
            @assertTrue(mesh%is_axisymmetric())
        class is(dommaschk_reference_t)
            @assertEqual(mesh%equi_type(), DOMMASCHK)
            @assertFalse(mesh%is_axisymmetric())
            ! NOTE: Tolerance for theta in Dommaschk equilibrium needs to be
            !       larger to accomodate the interpolation of the axis location
            theta_tol = GP_EPS * 1000
        end select

        do k = 1, mesh%size_phi()
        do i = 1, mesh%size_RZ()
            if(not_filler(i, k) == 0.0_GP) cycle
            call mesh%RZphi(i, k, x, z, phi)

            associate(er => equilibrium_reference)
            @assertEqual(jacobian(i, k), er%jacobian(x, z, phi), GP_EPS)
            @assertEqual(psi(i, k), er%psi(x, z, phi), GP_EPS)
            @assertEqual(rho(i, k), er%rho(x, z, phi), GP_EPS)
            @assertEqual(theta(i, k), er%theta(x, z, phi), theta_tol)

            ! absB, bR, bZ, btor
            @assertEqual(absB(i, k), er%absB(x, z, phi), prec)
            @assertEqual(bR(i, k), er%normb_x(x, z, phi), prec)
            @assertEqual(bZ(i, k), er%normb_z(x, z, phi), prec)
            @assertEqual(btor(i, k), er%normb_y(x, z, phi), prec)

            ! b_R, b_z derivatives
            inv_g = 1.0_GP / btor(i, k)
            @assertEqual(dgyxdz_over_g(i, k), er%dgyxdz(x, z, phi)*inv_g, prec)
            @assertEqual(dgyzdx_over_g(i, k), er%dgyzdx(x, z, phi)*inv_g, prec)
            @assertEqual(dgyxdy_over_g(i, k), er%dgyxdy(x, z, phi)*inv_g, prec)
            @assertEqual(dgyzdy_over_g(i, k), er%dgyzdy(x, z, phi)*inv_g, prec)

            ! |B| derivatives
            @assertEqual(dabsBdx(i, k), er%dabsBdx(x, z, phi), prec)
            @assertEqual(dabsBdz(i, k), er%dabsBdz(x, z, phi), prec)
            @assertEqual(dabsBdy(i, k), er%dabsBdy(x, z, phi), prec)

            @assertEqual(curl_normb_y(i, k), er%curl_normb_y(x, z, phi), prec)

            end associate
        enddo
        enddo
    end subroutine

    subroutine test_mesh_size_core(mesh)
        !! Tests the correct init and the interface of the mesh_5d_t type
        type(mesh_5d_t), intent(inout) :: mesh

        logical :: equal
        real(kind=GP), dimension(:), contiguous, pointer :: vp, mu, &
                                                            phi_array, vpw, muw
        real(kind=GP), dimension(:,:), contiguous, pointer :: R, Z
        real(kind=GP), dimension(:,:,:), contiguous, pointer :: &
                                                              mom_weights_vspec
        integer :: i, k
        real(kind=GP) :: x, y, phi
        real(kind=GP) :: expected

        if(mesh%equi_type() == CIRCULAR) then
            equal = almost_equal(mesh%delta_vp(), 6.0_GP / 1.0_GP, GP_EPS)
            @assertTrue(equal)

            equal = almost_equal(mesh%delta_mu(1), 4.2537738_GP, &
                                 1.0E-05_GP)
            @assertTrue(equal)

            equal = almost_equal(mesh%delta_phi(), 2.0_GP * PI / 4.0_GP, GP_EPS)
            @assertTrue(equal)

            equal = almost_equal(mesh%delta_RZ(), 0.05_GP, GP_EPS)
            @assertTrue(equal)

            vp => mesh%get_vp_pointer()
            mu => mesh%get_mu_pointer()

            phi_array => mesh%get_phi_pointer()
            equal = almost_equal(phi_array(3), 4.0_GP * PI / 4.0_GP, GP_EPS)
            @assertTrue(equal)

            vpw => mesh%get_vpw_pointer()
            muw => mesh%get_muw_pointer()

            @assertEqual(4, mesh%size_phi())
            @assertEqual(2, mesh%size_vp())
            @assertEqual(2, mesh%size_mu())
            @assertEqual(2, mesh%size_sp())

            R => mesh%get_R_pointer()
            Z => mesh%get_Z_pointer()

            i = 4
            do k = 1, mesh%size_phi()
                call mesh%RZphi(i, k, x, y, phi)

                equal = almost_equal(x, R(i, k), GP_EPS)
                @assertTrue(equal)

                equal = almost_equal(y, Z(i, k), GP_EPS)
                @assertTrue(equal)

                equal = almost_equal(phi, phi_array(k), GP_EPS)
                @assertTrue(equal)
            enddo

        else if(mesh%equi_type() == SLAB &
                .and. &
                (.not. (mesh%is_vspectral_vp() .or. mesh%is_vspectral_mu()))) &
            then
            ! Test quad/grid types

            equal = mesh%grid_type_phi() == "uniform"
            @assertTrue(equal)
            equal = mesh%quad_type_phi() == "midpoint"
            @assertTrue(equal)

            equal = mesh%grid_type_vp() == "uniform"
            @assertTrue(equal)
            equal = mesh%quad_type_vp() == "trapezoidal"
            @assertTrue(equal)

            equal = mesh%grid_type_mu() == "quadratic"
            @assertTrue(equal)
            equal = mesh%quad_type_mu() == "midpoint"
            @assertTrue(equal)

            @assertFalse(mesh%is_vspectral_vp())
            @assertFalse(mesh%is_vspectral_mu())

        else if(mesh%equi_type() == SLAB &
                .and. (mesh%is_vspectral_vp() .and. mesh%is_vspectral_mu())) &
            then
            ! Test use spectral grid

            equal = mesh%grid_type_phi() == "uniform"
            @assertTrue(equal)
            equal = mesh%quad_type_phi() == "midpoint"
            @assertTrue(equal)

            ! NOTE: Specified quad and grid type for vp and mu gets overriden by
            !       use_vspectral
            equal = mesh%grid_type_vp() == "spectral_hermite"
            @assertTrue(equal)
            equal = mesh%quad_type_vp() == "spectral_hermite"
            @assertTrue(equal)

            equal = mesh%grid_type_mu() == "spectral_laguerre"
            @assertTrue(equal)
            equal = mesh%quad_type_mu() == "spectral_laguerre"
            @assertTrue(equal)

            @assertTrue(mesh%is_vspectral_vp())
            @assertTrue(mesh%is_vspectral_mu())

            ! Test mom vspec grid
            mom_weights_vspec => mesh%get_mom_weights_vspec_pointer()
            equal = almost_equal(mom_weights_vspec(1, 1, 1), 1.0_GP, GP_EPS)
            @assertTrue(equal)

            ! Parallel velocity weights
            expected = 1.0_GP / sqrt(2.0_GP)
            equal = almost_equal(mom_weights_vspec(2, 1, 2), expected, GP_EPS)
            @AssertTrue(equal)

            ! Parallel energy weights
            expected = 1.0_GP / 2.0_GP
            equal = almost_equal(mom_weights_vspec(1, 1, 3), expected, GP_EPS)
            @AssertTrue(equal)

            expected = 1.0_GP / sqrt(2.0_GP)
            equal = almost_equal(mom_weights_vspec(3, 1, 3), expected, GP_EPS)
            @AssertTrue(equal)

            ! Perpendicular energy weights
            expected = 1.0_GP
            equal = almost_equal(mom_weights_vspec(1, 1, 4), expected, GP_EPS)
            @AssertTrue(equal)

            expected = -1.0_GP
            equal = almost_equal(mom_weights_vspec(1, 2, 4), expected, GP_EPS)
            @AssertTrue(equal)

            ! Parallel heat flux weights
            expected = 3.0_GP / (2.0_GP * sqrt(2.0_GP))
            equal = almost_equal(mom_weights_vspec(2, 1, 5), expected, GP_EPS)
            @AssertTrue(equal)

            expected = sqrt(3.0_GP) / 2.0_GP
            equal = almost_equal(mom_weights_vspec(4, 1, 5), expected, GP_EPS)
            @AssertTrue(equal)

            ! Perpendicular heat flux weights
            expected = 1.0_GP / sqrt(2.0_GP)
            equal = almost_equal(mom_weights_vspec(2, 1, 6), expected, GP_EPS)
            @AssertTrue(equal)

            expected = -1.0_GP / sqrt(2.0_GP)
            equal = almost_equal(mom_weights_vspec(2, 2, 6), expected, GP_EPS)
            @AssertTrue(equal)

            ! Parallel diamagnetic drift heat flux
            expected = sqrt(6.0_GP)
            equal = almost_equal(mom_weights_vspec(5, 1, 7), expected, GP_EPS)
            @AssertTrue(equal)

            expected = 3.0_GP * sqrt(2.0_GP)
            equal = almost_equal(mom_weights_vspec(3, 1, 7), expected, GP_EPS)
            @AssertTrue(equal)

            expected = 3.0_GP / 2.0_GP
            equal = almost_equal(mom_weights_vspec(1, 1, 7), expected, GP_EPS)
            @AssertTrue(equal)

            ! Perpendicular diamagnetic heat flux
            expected = 1.0_GP / 2.0_GP
            equal = almost_equal(mom_weights_vspec(1, 1, 8), expected, GP_EPS)
            @AssertTrue(equal)

            expected = 1.0_GP / sqrt(2.0_GP)
            equal = almost_equal(mom_weights_vspec(3, 1, 8), expected, GP_EPS)
            @AssertTrue(equal)

            expected = - 1.0_GP / sqrt(2.0_GP)
            equal = almost_equal(mom_weights_vspec(3, 2, 8), expected, GP_EPS)
            @AssertTrue(equal)

            expected = - 1.0_GP / 2.0_GP
            equal = almost_equal(mom_weights_vspec(1, 2, 8), expected, GP_EPS)
            @AssertTrue(equal)

            expected = 2.0_GP
            equal = almost_equal(mom_weights_vspec(1, 1, 9), expected, GP_EPS)
            @AssertTrue(equal)

            expected = - 4.0_GP
            equal = almost_equal(mom_weights_vspec(1, 2, 9), expected, GP_EPS)
            @AssertTrue(equal)

            expected = 2.0_GP
            equal = almost_equal(mom_weights_vspec(1, 3, 9), expected, GP_EPS)
            @AssertTrue(equal)
        endif
    end subroutine

    subroutine test_mesh_neighbors_core(mesh)
        type(mesh_5d_t), target, intent(inout) :: mesh

        integer, contiguous, pointer, dimension(:,:,:,:) :: neighbors
        real(kind=GP), pointer, dimension(:,:) :: is_compute
        integer :: n_points_RZ, n_points_phi, i, k, nbr_R, nbr_Z
        logical :: all_equal

        n_points_RZ = mesh%size_RZ()
        n_points_phi = mesh%size_phi()
        neighbors => mesh%get_neighbor_indices_pointer()
        is_compute => mesh%get_is_compute_pointer()

        all_equal = all(lbound(neighbors) == &
                                        [-size_neighbor, -size_neighbor, 1, 1])
        @assertTrue(all_equal)
        all_equal = all(ubound(neighbors) == &
                     [size_neighbor, size_neighbor, n_points_RZ, n_points_phi])
        @assertTrue(all_equal)

        do k = 1, n_points_phi
        do i = 1, n_points_RZ
            ! Test that the PARALLAX behavior of returning 0 for non-existing
            ! neighbors is overwritten
            if(any(neighbors(:, :, i, k) == 0)) then
                @assertTrue(.false.)
            endif
            ! Test that the only points which list themselves as their own
            ! neighbor are non-compute points (ghosts and fillers)
            do nbr_Z = -size_neighbor, size_neighbor
            do nbr_R = -size_neighbor, size_neighbor
                if(nbr_R == 0 .and. nbr_Z == 0) then
                    ! Skip the middle of the stencil, which is the point itself
                    cycle
                elseif(neighbors(nbr_R, nbr_Z, i, k) == i) then
                    @assertEqual(0.0_GP, is_compute(i, k))
                endif
            enddo
            enddo
        enddo
        enddo
    end subroutine

    subroutine test_RZ_quadrature_core(mesh)
        type(mesh_5d_t), intent(inout) :: mesh

        real(kind=GP) :: RZw_to_check, integral, expected
        real(kind=GP), contiguous, pointer, dimension(:,:) :: RZw
        real(kind=GP), contiguous, pointer, dimension(:,:) :: is_compute, &
                                                              not_ghost, &
                                                              not_filler

        integer :: i, k
        logical :: fine

        RZw        => mesh%get_RZw_pointer()
        is_compute => mesh%get_is_compute_pointer()
        not_ghost  => mesh%get_not_ghost_pointer()
        not_filler => mesh%get_not_filler_pointer()

        ! Check weights themselves if they have reasonable values. This means
        ! that inner points are either 1 or 0.875 (normalized) and ghosts
        ! one of the values given below (boundaries are non-zeros, actual
        ! ghosts are zero).
        k = 1
        do i = 1, mesh%size_RZ()
            RZw_to_check = RZw(i, k) / mesh%delta_RZ()**2

            if(is_compute(i, k) == 1.0_GP) then
                fine = almost_equal(RZw_to_check, 1.000_GP, GP_EPS) &
                  .or. almost_equal(RZw_to_check, 0.875_GP, GP_EPS)

            else if(not_ghost(i, k) == 0.0_GP) then
                fine = almost_equal(RZw_to_check, 0.750_GP, GP_EPS) &
                  .or. almost_equal(RZw_to_check, 0.625_GP, GP_EPS) &
                  .or. almost_equal(RZw_to_check, 0.500_GP, GP_EPS) &
                  .or. almost_equal(RZw_to_check, 0.375_GP, GP_EPS) &
                  .or. almost_equal(RZw_to_check, 0.250_GP, GP_EPS) &
                  .or. almost_equal(RZw_to_check, 0.000_GP, GP_EPS)

            else
                fine = (RZw_to_check == 0.0_GP)
            endif
            @assertTrue(fine)
        enddo

        ! Check area of circular annulus. Number of polygons with certain weight
        ! has been counted.
        integral = sum(RZw(:, k))
        expected = 16 * 0.375_GP + 36 * 0.5_GP + 16 * 0.625_GP &
                 + 28 * 0.875_GP + 40 * 1.0_GP
        expected = expected * mesh%delta_RZ()**2

        fine = almost_equal(integral, expected, GP_EPS)
        @assertTrue(fine)
    end subroutine

    subroutine test_mesh_compute_mask_core(mesh_5d)
        !! Tests the correct init of the compute mask in the mesh
        type (mesh_5d_t), intent(inout) :: mesh_5d

        integer, dimension(:,:), pointer :: not_in_target
        real (kind=GP), dimension(:,:), pointer :: not_ghost, &
                                                   not_filler, is_compute
        integer :: i, k

        not_in_target => mesh_5d%get_not_in_target_pointer()
        not_ghost => mesh_5d%get_not_ghost_pointer()
        not_filler => mesh_5d%get_not_filler_pointer()
        is_compute => mesh_5d%get_is_compute_pointer()

        ! Check that the compute mask correctly combines the target, ghost, and
        ! filler masks, and that the only values are 0 and 1 (i.e.
        ! FILLER_VALUE_REAL never appears)
        do k = 1, mesh_5d%size_phi()
        do i = 1, mesh_5d%size_RZ()
            if(not_in_target(i, k) == 0 .or. &
               not_ghost(i, k) == 0.0_GP .or. &
               not_filler(i, k) == 0.0_GP) then
                @assertEqual(is_compute(i, k), 0.0_GP)
            else
                @assertEqual(is_compute(i, k), 1.0_GP)
            end if
        enddo
        enddo
    end subroutine

    @test(npes = [2])
    subroutine test_mesh_read(this)
        !! Tests the file writing and reading of the mesh
        ! NOTE: This test is kept independent from the meshes test subroutines
        !       because the initialization of the meshes for reading and
        !       writing is different from the shared meshes.
        class (MpiTestMethod), intent(inout) :: this
        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), target, allocatable :: dcomm_handler
        type(mesh_5d_t), allocatable :: mesh

        integer :: ierr
        integer :: equi_type
        real(kind=GP) :: spacing_RZ
        character(len=24) :: quad_type_vp, grid_type_mu

        integer :: n_points_RZ_orig, n_points_phi_orig, n_points_vp_orig, &
            n_points_mu_orig, n_points_sp_orig, equi_type_orig
        real(kind=GP) :: delta_RZ_orig, delta_vp_orig, delta_sqrt_mu_orig, &
            delta_phi_orig, rho_min_orig, rho_max_orig
        logical :: is_axisymmetric_orig
        character(len=24) :: grid_type_vp_orig, quad_type_vp_orig, &
            grid_type_mu_orig, quad_type_mu_orig, grid_type_phi_orig, &
            quad_type_phi_orig
        real(kind=GP), dimension(:), allocatable :: vp_orig, mu_orig, &
            sqrt_mu_orig, vpw_orig, muw_orig, phi_orig
        real(kind=GP), dimension(:,:), allocatable :: R_orig, Z_orig, &
            jacobian_orig, not_ghost_orig, not_filler_orig, absB_orig, &
            normb_tor_orig, normb_R_orig, normb_Z_orig, curl_normb_y_orig, &
            rho_orig, psi_orig, dgyxdy_over_g_orig, dgyzdy_over_g_orig, &
            dgyxdz_over_g_orig, dgyzdx_over_g_orig, inv_g_orig, &
            dabsBdx_orig, dabsBdz_orig, dabsBdy_orig, &
            is_compute_orig, is_core_orig, &
            fll_positive1_orig, fll_positive2_orig, &
            fll_negative1_orig, fll_negative2_orig, &
            theta_orig, maps_on_mesh_orig
        integer, dimension(:,:), allocatable :: not_in_target_orig
        integer, dimension(:,:,:,:), allocatable :: neighbors_orig
        type(csrmat_t), dimension(:), allocatable :: map_p_orig, map_pp_orig, &
            map_m_orig, map_mm_orig
        integer, dimension(:,:), allocatable :: parcon_positive1_orig, &
            parcon_positive2_orig, parcon_negative1_orig, &
            parcon_negative2_orig, buf_zone_orig, RZ_indices_orig
        integer, dimension(:), allocatable :: bsg_flags_orig

        ! Test that mesh reading and writing does not depend on number of
        ! processes
        allocate(mesh)
        equi_type = SLAB
        spacing_RZ = 1.00_GP
        quad_type_vp = "trapezoidal"
        grid_type_mu = "quadratic"

        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=equi_type, &
                             spacing_RZ=spacing_RZ, &
                             n_points_phi=n_points_phi_ref, &
                             n_points_vp=n_points_vp_ref, &
                             n_points_mu=n_points_mu_ref, &
                             quad_type_vp=quad_type_vp, &
                             grid_type_mu=grid_type_mu)

        allocate(dcomm_handler)
        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                      this%getNumProcesses(), 1, 1, 1)
        dcomm_handler_ptr => dcomm_handler

        call mesh%initialize(dcomm_handler_ptr, &
                             read_mesh_from_file=.false., &
                             mesh_filename="mesh.nc")

        call copy_mesh_data(mesh)
        deallocate(mesh)

        ! Create an MPI barrier since only the master rank writes the mesh
        ! file, whereas all ranks read from the file
        call MPI_barrier(this%getMpiCommunicator(), ierr)
        deallocate(dcomm_handler)
        allocate(dcomm_handler)
        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                      this%getNumProcesses(), 1, 1, 1)
        dcomm_handler_ptr => dcomm_handler

        allocate(mesh)
        call mesh%initialize(dcomm_handler_ptr, &
                             read_mesh_from_file=.true., &
                             mesh_filename="mesh.nc")

        call test_mesh_read_core(mesh)
        deallocate(mesh)
        deallocate(dcomm_handler)

        allocate(mesh)
        equi_type = DOMMASCHK
        spacing_RZ = 0.012_GP

        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=equi_type, &
                             spacing_RZ=spacing_RZ, &
                             n_points_phi=n_points_phi_ref, &
                             n_points_vp=n_points_vp_ref, &
                             n_points_mu=n_points_mu_ref, &
                             quad_type_vp=quad_type_vp, &
                             grid_type_mu=grid_type_mu)

        allocate(dcomm_handler)
        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                      this%getNumProcesses(), 1, 1, 1)
        dcomm_handler_ptr => dcomm_handler

        call mesh%initialize(dcomm_handler_ptr, &
                             read_mesh_from_file=.false., &
                             mesh_filename="mesh.nc")

        call copy_mesh_data(mesh)
        deallocate(mesh)

        call MPI_barrier(this%getMpiCommunicator(), ierr)

        allocate(mesh)
        call mesh%initialize(dcomm_handler_ptr, &
                             read_mesh_from_file=.true., &
                             mesh_filename="mesh.nc")

        call test_mesh_read_core(mesh)
        deallocate(mesh)

    contains

        subroutine copy_mesh_data(mesh_orig)
            type(mesh_5d_t), target, intent(inout) :: mesh_orig

            if(allocated(vp_orig)) deallocate(vp_orig)
            if(allocated(mu_orig)) deallocate(mu_orig)
            if(allocated(sqrt_mu_orig)) deallocate(sqrt_mu_orig)
            if(allocated(vpw_orig)) deallocate(vpw_orig)
            if(allocated(muw_orig)) deallocate(muw_orig)
            if(allocated(phi_orig)) deallocate(phi_orig)
            if(allocated(R_orig)) deallocate(R_orig)
            if(allocated(Z_orig)) deallocate(Z_orig)
            if(allocated(jacobian_orig)) deallocate(jacobian_orig)
            if(allocated(not_ghost_orig)) deallocate(not_ghost_orig)
            if(allocated(not_filler_orig)) deallocate(not_filler_orig)
            if(allocated(buf_zone_orig)) deallocate(buf_zone_orig)
            if(allocated(RZ_indices_orig)) deallocate(RZ_indices_orig)
            if(allocated(absB_orig)) deallocate(absB_orig)
            if(allocated(normb_tor_orig)) deallocate(normb_tor_orig)
            if(allocated(normb_R_orig)) deallocate(normb_R_orig)
            if(allocated(normb_Z_orig)) deallocate(normb_Z_orig)
            if(allocated(curl_normb_y_orig)) deallocate(curl_normb_y_orig)
            if(allocated(rho_orig)) deallocate(rho_orig)
            if(allocated(theta_orig)) deallocate(theta_orig)
            if(allocated(psi_orig)) deallocate(psi_orig)
            if(allocated(dgyxdy_over_g_orig)) deallocate(dgyxdy_over_g_orig)
            if(allocated(dgyzdy_over_g_orig)) deallocate(dgyzdy_over_g_orig)
            if(allocated(dgyxdz_over_g_orig)) deallocate(dgyxdz_over_g_orig)
            if(allocated(dgyzdx_over_g_orig)) deallocate(dgyzdx_over_g_orig)
            if(allocated(inv_g_orig)) deallocate(inv_g_orig)
            if(allocated(dabsBdx_orig)) deallocate(dabsBdx_orig)
            if(allocated(dabsBdz_orig)) deallocate(dabsBdz_orig)
            if(allocated(dabsBdy_orig)) deallocate(dabsBdy_orig)
            if(allocated(is_compute_orig)) deallocate(is_compute_orig)
            if(allocated(is_core_orig)) deallocate(is_core_orig)
            if(allocated(not_in_target_orig)) deallocate(not_in_target_orig)
            if(allocated(maps_on_mesh_orig)) deallocate(maps_on_mesh_orig)
            if(allocated(fll_positive1_orig)) deallocate(fll_positive1_orig)
            if(allocated(fll_positive2_orig)) deallocate(fll_positive2_orig)
            if(allocated(fll_negative1_orig)) deallocate(fll_negative1_orig)
            if(allocated(fll_negative2_orig)) deallocate(fll_negative2_orig)
            if(allocated(neighbors_orig)) deallocate(neighbors_orig)
            if(allocated(map_p_orig)) deallocate(map_p_orig)
            if(allocated(map_pp_orig)) deallocate(map_pp_orig)
            if(allocated(map_m_orig)) deallocate(map_m_orig)
            if(allocated(map_mm_orig)) deallocate(map_mm_orig)
            if(allocated(parcon_positive1_orig)) &
                deallocate(parcon_positive1_orig)
            if(allocated(parcon_positive2_orig)) &
                deallocate(parcon_positive2_orig)
            if(allocated(parcon_negative1_orig)) &
                deallocate(parcon_negative1_orig)
            if(allocated(parcon_negative2_orig)) &
                deallocate(parcon_negative2_orig)
            if(allocated(bsg_flags_orig)) deallocate(bsg_flags_orig)

            ! Copy mesh properties
            n_points_RZ_orig = mesh_orig%size_RZ()
            n_points_phi_orig = mesh_orig%size_phi()
            n_points_vp_orig = mesh_orig%size_vp()
            n_points_mu_orig = mesh_orig%size_mu()
            n_points_sp_orig = mesh_orig%size_sp()
            equi_type_orig = mesh_orig%equi_type()
            delta_RZ_orig = mesh_orig%delta_RZ()
            delta_vp_orig = mesh_orig%delta_vp()
            delta_sqrt_mu_orig = mesh_orig%delta_sqrt_mu()
            delta_phi_orig = mesh_orig%delta_phi()
            rho_min_orig = mesh_orig%rho_min()
            rho_max_orig = mesh_orig%rho_max()
            is_axisymmetric_orig = mesh_orig%is_axisymmetric()
            grid_type_vp_orig = mesh_orig%grid_type_vp()
            quad_type_vp_orig = mesh_orig%quad_type_vp()
            grid_type_mu_orig = mesh_orig%grid_type_mu()
            quad_type_mu_orig = mesh_orig%quad_type_mu()
            grid_type_phi_orig = mesh_orig%grid_type_phi()
            quad_type_phi_orig = mesh_orig%quad_type_phi()

            ! Copy all mesh pointers
            vp_orig = mesh_orig%get_vp_pointer()
            mu_orig = mesh_orig%get_mu_pointer()
            sqrt_mu_orig = mesh_orig%get_sqrt_mu_pointer()
            vpw_orig = mesh_orig%get_vpw_pointer()
            muw_orig = mesh_orig%get_muw_pointer()
            phi_orig = mesh_orig%get_phi_pointer()
            R_orig = mesh_orig%get_R_pointer()
            Z_orig = mesh_orig%get_Z_pointer()
            jacobian_orig = mesh_orig%get_jacobian_pointer()
            not_ghost_orig = mesh_orig%get_not_ghost_pointer()
            not_filler_orig = mesh_orig%get_not_filler_pointer()
            buf_zone_orig = mesh_orig%get_buf_zone_pointer()
            RZ_indices_orig = mesh_orig%get_RZ_indices_pointer()
            absB_orig = mesh_orig%get_absB_pointer()
            normb_tor_orig = mesh_orig%get_normb_tor_pointer()
            normb_R_orig = mesh_orig%get_normb_R_pointer()
            normb_Z_orig = mesh_orig%get_normb_Z_pointer()
            curl_normb_y_orig = mesh_orig%get_curl_normb_y_pointer()
            rho_orig = mesh_orig%get_rho_pointer()
            theta_orig = mesh_orig%get_theta_pointer()
            psi_orig = mesh_orig%get_psi_pointer()
            dgyxdy_over_g_orig = mesh_orig%get_dgyxdy_over_g_pointer()
            dgyzdy_over_g_orig = mesh_orig%get_dgyzdy_over_g_pointer()
            dgyxdz_over_g_orig = mesh_orig%get_dgyxdz_over_g_pointer()
            dgyzdx_over_g_orig = mesh_orig%get_dgyzdx_over_g_pointer()
            inv_g_orig = mesh_orig%get_inv_g_pointer()
            dabsBdx_orig = mesh_orig%get_dabsBdx_pointer()
            dabsBdz_orig = mesh_orig%get_dabsBdz_pointer()
            dabsBdy_orig = mesh_orig%get_dabsBdy_pointer()
            is_compute_orig = mesh_orig%get_is_compute_pointer()
            is_core_orig = mesh_orig%get_is_core_pointer()
            not_in_target_orig = mesh_orig%get_not_in_target_pointer()
            maps_on_mesh_orig = mesh_orig%get_maps_on_mesh_pointer()
            fll_positive1_orig = mesh_orig%get_fll_positive1_pointer()
            fll_positive2_orig = mesh_orig%get_fll_positive2_pointer()
            fll_negative1_orig = mesh_orig%get_fll_negative1_pointer()
            fll_negative2_orig = mesh_orig%get_fll_negative2_pointer()
            neighbors_orig = mesh_orig%get_neighbor_indices_pointer()
            map_p_orig = mesh_orig%get_map_positive1_pointer()
            map_pp_orig = mesh_orig%get_map_positive2_pointer()
            map_m_orig = mesh_orig%get_map_negative1_pointer()
            map_mm_orig = mesh_orig%get_map_negative2_pointer()
            parcon_positive1_orig = mesh_orig%get_parcon_positive1_pointer()
            parcon_positive2_orig = mesh_orig%get_parcon_positive2_pointer()
            parcon_negative1_orig = mesh_orig%get_parcon_negative1_pointer()
            parcon_negative2_orig = mesh_orig%get_parcon_negative2_pointer()
            bsg_flags_orig = mesh_orig%get_bsg_flags_pointer()

        end subroutine

        subroutine test_mesh_read_core(mesh_read)
            type(mesh_5d_t), target, intent(inout) :: mesh_read

            real(kind=GP), pointer, dimension(:) :: vp_read, mu_read, &
                sqrt_mu_read, vpw_read, muw_read, phi_read
            real(kind=GP), pointer, dimension(:,:) :: R_read, Z_read, &
                jacobian_read, not_ghost_read, not_filler_read, absB_read, &
                normb_tor_read, normb_R_read, normb_Z_read, curl_normb_y_read, &
                rho_read, psi_read, dgyxdy_over_g_read, dgyzdy_over_g_read, &
                dgyxdz_over_g_read, dgyzdx_over_g_read, inv_g_read, &
                dabsBdx_read, dabsBdz_read, dabsBdy_read, &
                is_compute_read, is_core_read, &
                fll_positive1_read, fll_positive2_read, &
                fll_negative1_read, fll_negative2_read, &
                theta_read, maps_on_mesh_read
            integer, pointer, dimension(:,:) :: not_in_target_read
            integer, pointer, dimension(:) :: bsg_flags_read
            integer, pointer, dimension(:,:,:,:) :: neighbors_read
            type(csrmat_t), pointer, dimension(:) :: map_p_read, &
                map_pp_read, map_m_read, map_mm_read
            integer, pointer, dimension(:,:) :: parcon_positive1_read, &
                parcon_positive2_read, parcon_negative1_read, &
                parcon_negative2_read, buf_zone_read, RZ_indices_read
            integer :: i, k, nnz
            logical :: equal

            ! Get all mesh pointers for read mesh
            vp_read => mesh_read%get_vp_pointer()
            mu_read => mesh_read%get_mu_pointer()
            sqrt_mu_read => mesh_read%get_sqrt_mu_pointer()
            vpw_read => mesh_read%get_vpw_pointer()
            muw_read => mesh_read%get_muw_pointer()
            phi_read => mesh_read%get_phi_pointer()
            R_read => mesh_read%get_R_pointer()
            Z_read => mesh_read%get_Z_pointer()
            jacobian_read => mesh_read%get_jacobian_pointer()
            not_ghost_read => mesh_read%get_not_ghost_pointer()
            not_filler_read => mesh_read%get_not_filler_pointer()
            buf_zone_read => mesh_read%get_buf_zone_pointer()
            RZ_indices_read => mesh_read%get_RZ_indices_pointer()
            absB_read => mesh_read%get_absB_pointer()
            normb_tor_read => mesh_read%get_normb_tor_pointer()
            normb_R_read => mesh_read%get_normb_R_pointer()
            normb_Z_read => mesh_read%get_normb_Z_pointer()
            curl_normb_y_read => mesh_read%get_curl_normb_y_pointer()
            rho_read => mesh_read%get_rho_pointer()
            theta_read => mesh_read%get_theta_pointer()
            psi_read => mesh_read%get_psi_pointer()
            dgyxdy_over_g_read => mesh_read%get_dgyxdy_over_g_pointer()
            dgyzdy_over_g_read => mesh_read%get_dgyzdy_over_g_pointer()
            dgyxdz_over_g_read => mesh_read%get_dgyxdz_over_g_pointer()
            dgyzdx_over_g_read => mesh_read%get_dgyzdx_over_g_pointer()
            inv_g_read => mesh_read%get_inv_g_pointer()
            dabsBdx_read => mesh_read%get_dabsBdx_pointer()
            dabsBdz_read => mesh_read%get_dabsBdz_pointer()
            dabsBdy_read => mesh_read%get_dabsBdy_pointer()
            is_compute_read => mesh_read%get_is_compute_pointer()
            is_core_read => mesh_read%get_is_core_pointer()
            not_in_target_read => mesh_read%get_not_in_target_pointer()
            maps_on_mesh_read => mesh_read%get_maps_on_mesh_pointer()
            fll_positive1_read => mesh_read%get_fll_positive1_pointer()
            fll_positive2_read => mesh_read%get_fll_positive2_pointer()
            fll_negative1_read => mesh_read%get_fll_negative1_pointer()
            fll_negative2_read => mesh_read%get_fll_negative2_pointer()
            neighbors_read => mesh_read%get_neighbor_indices_pointer()
            map_p_read => mesh_read%get_map_positive1_pointer()
            map_pp_read => mesh_read%get_map_positive2_pointer()
            map_m_read => mesh_read%get_map_negative1_pointer()
            map_mm_read => mesh_read%get_map_negative2_pointer()
            parcon_positive1_read => mesh_read%get_parcon_positive1_pointer()
            parcon_positive2_read => mesh_read%get_parcon_positive2_pointer()
            parcon_negative1_read => mesh_read%get_parcon_negative1_pointer()
            parcon_negative2_read => mesh_read%get_parcon_negative2_pointer()
            bsg_flags_read => mesh_read%get_bsg_flags_pointer()

            ! Check properties
            @assertEqual(n_points_RZ_orig, mesh_read%size_RZ())
            @assertEqual(delta_RZ_orig, mesh_read%delta_RZ(), GP_EPS)
            @assertEqual(delta_vp_orig, mesh_read%delta_vp(), GP_EPS)
            @assertEqual(delta_sqrt_mu_orig, mesh_read%delta_sqrt_mu(), GP_EPS)
            @assertEqual(delta_phi_orig, mesh_read%delta_phi(), GP_EPS)
            @assertEqual(n_points_vp_orig, mesh_read%size_vp())
            @assertEqual(n_points_mu_orig, mesh_read%size_mu())
            @assertEqual(n_points_phi_orig, mesh_read%size_phi())
            @assertEqual(n_points_sp_orig, mesh_read%size_sp())
            @assertEqual(rho_min_orig, mesh_read%rho_min(), GP_EPS)
            @assertEqual(rho_max_orig, mesh_read%rho_max(), GP_EPS)
            @assertEqual(equi_type_orig, mesh_read%equi_type())
            @assertTrue(is_axisymmetric_orig .eqv. mesh_read%is_axisymmetric())
            @assertTrue(grid_type_vp_orig == mesh_read%grid_type_vp())
            @assertTrue(quad_type_vp_orig == mesh_read%quad_type_vp())
            @assertTrue(grid_type_mu_orig == mesh_read%grid_type_mu())
            @assertTrue(quad_type_mu_orig == mesh_read%quad_type_mu())
            @assertTrue(grid_type_phi_orig == mesh_read%grid_type_phi())
            @assertTrue(quad_type_phi_orig == mesh_read%quad_type_phi())

            ! Check bsg flags
            @assertEqual(n_points_RZ_orig, size(bsg_flags_read))
            @assertEqual(size(bsg_flags_orig), size(bsg_flags_read))
            do i = 1, n_points_RZ_orig
                equal = unpack_bflag(bsg_flags_orig(i)) == &
                        unpack_bflag(bsg_flags_read(i))
                @assertTrue(equal)
            end do

            ! Check vp grid
            @assertTrue(all(almost_equal(vp_orig, vp_read, GP_EPS)))
            @assertTrue(all(almost_equal(vpw_orig, vpw_read, GP_EPS)))

            ! Check mu grid
            @assertTrue(all(almost_equal(mu_orig, mu_read, GP_EPS)))
            @assertTrue(all(almost_equal(sqrt_mu_orig, sqrt_mu_read, GP_EPS)))
            @assertTrue(all(almost_equal(muw_orig, muw_read, GP_EPS)))

            ! Check phi grid
            @assertTrue(all(almost_equal(phi_orig, phi_read, GP_EPS)))

            ! Check map matrices
            do k = 1, n_points_phi_orig
                ! All the map matrix ndims should be the same since they are
                ! determined by the number of base mesh points
                @assertEqual(map_p_orig(k)%ndim, map_p_read(k)%ndim)
                @assertEqual(map_p_orig(k)%ndim, map_pp_orig(k)%ndim)
                @assertEqual(map_p_orig(k)%ndim, map_pp_read(k)%ndim)
                @assertEqual(map_p_orig(k)%ndim, map_m_orig(k)%ndim)
                @assertEqual(map_p_orig(k)%ndim, map_m_read(k)%ndim)
                @assertEqual(map_p_orig(k)%ndim, map_mm_orig(k)%ndim)
                @assertEqual(map_p_orig(k)%ndim, map_mm_read(k)%ndim)

                @assertEqual(map_p_orig(k)%nnz, map_p_read(k)%nnz)
                @assertEqual(map_pp_orig(k)%nnz, map_pp_read(k)%nnz)
                @assertEqual(map_m_orig(k)%nnz, map_m_read(k)%nnz)
                @assertEqual(map_mm_orig(k)%nnz, map_mm_read(k)%nnz)

                @assertTrue(all(map_p_orig(k)%i == map_p_read(k)%i))
                @assertTrue(all(map_pp_orig(k)%i == map_pp_read(k)%i))
                @assertTrue(all(map_m_orig(k)%i == map_m_read(k)%i))
                @assertTrue(all(map_mm_orig(k)%i == map_mm_read(k)%i))

                nnz = map_p_orig(k)%nnz
                equal = all(map_p_orig(k)%j(:nnz) == map_p_read(k)%j(:nnz))
                @assertTrue(equal)
                equal = all(almost_equal(map_p_orig(k)%val(:nnz), &
                                         map_p_read(k)%val(:nnz), GP_EPS))
                @assertTrue(equal)

                nnz = map_pp_orig(k)%nnz
                equal = all(map_pp_orig(k)%j(:nnz) == map_pp_read(k)%j(:nnz))
                @assertTrue(equal)
                equal = all(almost_equal(map_pp_orig(k)%val(:nnz), &
                                         map_pp_read(k)%val(:nnz), GP_EPS))
                @assertTrue(equal)

                nnz = map_m_orig(k)%nnz
                equal = all(map_m_orig(k)%j(:nnz) == map_m_read(k)%j(:nnz))
                @assertTrue(equal)
                equal = all(almost_equal(map_m_orig(k)%val(:nnz), &
                                         map_m_read(k)%val(:nnz), GP_EPS))
                @assertTrue(equal)

                nnz = map_mm_orig(k)%nnz
                equal = all(map_mm_orig(k)%j(:nnz) == map_mm_read(k)%j(:nnz))
                @assertTrue(equal)
                equal = all(almost_equal(map_mm_orig(k)%val(:nnz), &
                                         map_mm_read(k)%val(:nnz), GP_EPS))
                @assertTrue(equal)
            enddo

            ! Check buffers
            equal = all(almost_equal(R_orig, R_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(Z_orig, Z_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(jacobian_orig, jacobian_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(not_ghost_orig, not_ghost_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(not_filler_orig, not_filler_read, GP_EPS))
            @assertTrue(equal)
            equal = all(buf_zone_orig == buf_zone_read)
            @assertTrue(equal)
            equal = all(RZ_indices_orig == RZ_indices_read)
            @assertTrue(equal)
            equal = all(almost_equal(absB_orig, absB_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(normb_tor_orig, normb_tor_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(normb_R_orig, normb_R_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(normb_Z_orig, normb_Z_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(curl_normb_y_orig, &
                                     curl_normb_y_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(rho_orig, rho_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(theta_orig, theta_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(psi_orig, psi_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(dgyxdy_over_g_orig, &
                                     dgyxdy_over_g_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(dgyzdy_over_g_orig, &
                                     dgyzdy_over_g_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(dgyxdz_over_g_orig, &
                                     dgyxdz_over_g_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(dgyzdx_over_g_orig, &
                                     dgyzdx_over_g_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(inv_g_orig, inv_g_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(dabsBdx_orig, dabsBdx_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(dabsBdz_orig, dabsBdz_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(dabsBdy_orig, dabsBdy_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(is_compute_orig, &
                                     is_compute_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(is_core_orig, &
                                     is_core_read, GP_EPS))
            @assertTrue(equal)
            equal = all(not_in_target_orig == not_in_target_read)
            @assertTrue(equal)
            equal = all(almost_equal(maps_on_mesh_orig, &
                                     maps_on_mesh_read, GP_EPS))
            @assertTrue(equal)
            equal = all(neighbors_orig == neighbors_read)
            @assertTrue(equal)
            equal = all(almost_equal(fll_positive1_orig, &
                                     fll_positive1_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(fll_positive2_orig, &
                                     fll_positive2_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(fll_negative1_orig, &
                                     fll_negative1_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(fll_negative2_orig, &
                                     fll_negative2_read, GP_EPS))
            @assertTrue(equal)
            equal = all(parcon_positive1_orig == parcon_positive1_read)
            @assertTrue(equal)
            equal = all(parcon_positive2_orig == parcon_positive2_read)
            @assertTrue(equal)
            equal = all(parcon_negative1_orig == parcon_negative1_read)
            @assertTrue(equal)
            equal = all(parcon_negative2_orig == parcon_negative2_read)
            @assertTrue(equal)
        end subroutine

    end subroutine

    @test(npes = [2])
    subroutine test_mesh_polar_read(this)
        !! Tests the file writing and reading of the polar mesh
        ! NOTE: This test is kept independent from the meshes test subroutines
        !       because the initialization of the meshes for reading and
        !       writing is different from the shared meshes.
        class (MpiTestMethod), intent(inout) :: this
        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), target, allocatable :: dcomm_handler
        type(mesh_5d_t), allocatable :: mesh

        integer :: ierr
        integer :: equi_type, n_points_phi, n_points_vp, n_points_mu
        real(kind=GP) :: spacing_RZ
        character(len=24) :: quad_type_vp, grid_type_mu

        real(kind=GP), dimension(:,:),   allocatable :: polar_theta_orig, &
                                                        polar_rho_orig, &
                                                        loss_cone_orig
        real(kind=GP), dimension(:,:,:), allocatable :: polar_absB_orig

        call setup_test_diagnostics(this%getMpiCommunicator(), &
                                    this%getProcessRank(), &
                                    diagnose_tpc=.true.)

        ! Test that mesh reading and writing does not depend on number of
        ! processes
        allocate(mesh)
        equi_type = SLAB
        spacing_RZ = 1.00_GP
        n_points_phi = 2
        n_points_vp = 1
        n_points_mu = 1
        quad_type_vp = "trapezoidal"
        grid_type_mu = "quadratic"

        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=equi_type, &
                             spacing_RZ=spacing_RZ, &
                             n_points_phi=n_points_phi, &
                             n_points_vp=n_points_vp, &
                             n_points_mu=n_points_mu, &
                             quad_type_vp=quad_type_vp, &
                             grid_type_mu=grid_type_mu)

        allocate(dcomm_handler)
        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                      this%getNumProcesses(), 1, 1, 1)
        dcomm_handler_ptr => dcomm_handler

        call mesh%initialize(dcomm_handler_ptr, &
                             read_mesh_from_file=.false., &
                             mesh_filename="mesh.nc")

        call copy_mesh_data(mesh)
        deallocate(mesh)

        ! Create an MPI barrier since only the master rank writes the mesh
        ! file, whereas all ranks read from the file
        call MPI_barrier(this%getMpiCommunicator(), ierr)
        deallocate(dcomm_handler)
        allocate(dcomm_handler)
        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                      this%getNumProcesses(), 1, 1, 1)
        dcomm_handler_ptr => dcomm_handler

        allocate(mesh)
        call mesh%initialize(dcomm_handler_ptr, &
                             read_mesh_from_file=.true., &
                             mesh_filename="mesh.nc")

        call test_mesh_read_core(mesh)
        deallocate(mesh)
        deallocate(dcomm_handler)

    contains

        subroutine copy_mesh_data(mesh_orig)
            type(mesh_5d_t), target, intent(inout) :: mesh_orig

            if(allocated(polar_theta_orig)) deallocate(polar_theta_orig)
            if(allocated(polar_rho_orig))   deallocate(polar_rho_orig)
            if(allocated(polar_absB_orig))  deallocate(polar_absB_orig)
            if(allocated(loss_cone_orig))   deallocate(loss_cone_orig)

            ! Copy mesh properties
            ! polar_n_theta_orig = mesh_orig%size_polar_theta(1)
            ! polar_n_rho_orig   = mesh_orig%size_polar_rho(1)
            !! NOTE: This check will not work because mesh_3d_pol is only
            !!       initialized in the initialize_B_pol subroutine and
            !!       not when reading from a file. It has been commented out.

            ! Copy all mesh pointers
            polar_theta_orig = mesh_orig%get_polar_theta_pointer()
            polar_rho_orig   = mesh_orig%get_polar_rho_pointer()
            polar_absB_orig  = mesh_orig%get_polar_absB_pointer()
            loss_cone_orig   = mesh_orig%get_loss_cone_pointer()

        end subroutine

        subroutine test_mesh_read_core(mesh_read)
            type(mesh_5d_t), target, intent(inout) :: mesh_read

            real(kind=GP), pointer, dimension(:,:)   :: polar_theta_read, &
                                                        polar_rho_read, &
                                                        loss_cone_read
            real(kind=GP), pointer, dimension(:,:,:) :: polar_absB_read
            logical :: equal

            ! Get all mesh pointers for read mesh
            polar_theta_read => mesh_read%get_polar_theta_pointer()
            polar_rho_read   => mesh_read%get_polar_rho_pointer()
            polar_absB_read  => mesh_read%get_polar_absB_pointer()
            loss_cone_read   => mesh_read%get_loss_cone_pointer()

            ! Check properties
            ! @assertEqual(polar_n_theta_orig, mesh_read%size_polar_theta(1))
            ! @assertEqual(polar_n_rho_orig,   mesh_read%size_polar_rho(1))

            ! Check buffers
            equal = all(almost_equal(polar_theta_orig, polar_theta_read, &
                                     GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(polar_rho_orig, polar_rho_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(polar_absB_orig, polar_absB_read, GP_EPS))
            @assertTrue(equal)
            equal = all(almost_equal(loss_cone_orig, loss_cone_read, GP_EPS))
            @assertTrue(equal)
        end subroutine

    end subroutine

    @test(npes = [1])
    subroutine test_polar(this)
        !! Tests for the polar mesh
        class (MpiTestMethod), intent(inout) :: this

        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), target, allocatable :: dcomm_handler
        type(mesh_5d_t), allocatable :: mesh
        real(kind=GP), parameter :: spacing_RZ = 0.02_GP
        integer :: eq_type
        integer, parameter :: equilibrium_types(*) = &
                                                   [CIRCULAR, CIRCULAR_TOROIDAL]
        integer, parameter :: n_points_phi = 1, &
                              n_points_vp  = 1, &
                              n_points_mu  = 1

        call setup_test_diagnostics(this%getMpiCommunicator(), &
                                    this%getProcessRank(), &
                                    diagnose_tpc=.true.)

        do eq_type = lbound(equilibrium_types, 1), ubound(equilibrium_types, 1)
            allocate(mesh)
            call setup_test_mesh(this%getMpiCommunicator(), &
                                 this%getProcessRank(), &
                                 equilibrium_type=equilibrium_types(eq_type), &
                                 spacing_RZ=spacing_RZ, &
                                 n_points_phi=n_points_phi, &
                                 n_points_vp=n_points_vp, &
                                 n_points_mu=n_points_mu, &
                                 quad_type_vp="trapezoidal", &
                                 grid_type_mu="uniform")

            allocate(dcomm_handler)
            call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                          this%getNumProcesses(), 1, 1, 1)
            dcomm_handler_ptr => dcomm_handler

            call mesh%initialize(dcomm_handler_ptr)

            call test_polar_B(mesh)
            call test_polar_loss_cone(mesh)

            deallocate(dcomm_handler, mesh)
        enddo

    contains

        subroutine test_polar_B(mesh)
            !! Tests the correct calculation of the magnetic field
            !! in the polar mesh
            type(mesh_5d_t), intent(inout) :: mesh

            class(equilibrium_t), target, allocatable :: equilibrium_instance
            type(csrmat_t), allocatable :: cart_map
            type(mesh_cart_t),  dimension(:), pointer :: mesh_Cart
            type(polar_grid_t), dimension(:), pointer :: mesh_pol

            integer :: i, k, n_points_RZ, n_points_phi
            integer, parameter :: intorder = 3
            real(kind=GP), dimension(:,:,:), pointer :: polar_absB
            real(kind=GP), dimension(:,:),   pointer :: is_core_ptr, absB_Cart
            real(kind=GP), dimension(:,:), allocatable :: absB_Cart_back
            real(kind=GP), parameter :: eps = 1e-4
            logical :: equal

            call create_equilibrium(equilibrium_instance, &
                                    mesh%equi_type(), &
                                    dbgout = 0)

            n_points_RZ  = mesh%size_RZ()
            n_points_phi = mesh%size_phi()

            mesh_Cart   => mesh%get_mesh_3d()
            mesh_pol    => mesh%get_mesh_3d_pol()
            is_core_ptr => mesh%get_is_core_pointer()
            absB_Cart   => mesh%get_absB_pointer()
            polar_absB  => mesh%get_polar_absB_pointer()

            allocate(absB_Cart_back(n_points_RZ, n_points_phi))

            do k = 1, n_points_phi
            do i = 1, n_points_RZ
                ! Get B in Cartesian grid back from the polar mesh
                call create_cart_map_matrix(cart_map, equilibrium_instance, &
                                            mesh_Cart(k), mesh_pol(k), &
                                            intorder)
                call csr_times_vec(cart_map, polar_absB, absB_Cart_back)

                ! In closed regions, check if the original B in Cartesian grid
                ! is the same as the one we got back from the polar mesh
                if (is_core_ptr(i, k) .ne. 0.0_GP) then
                    equal = (abs(absB_Cart(i, k) - absB_Cart_back(i, k)) < eps)
                    @assertTrue(equal)
                endif
            enddo
            enddo

            deallocate(absB_Cart_back)
        end subroutine

        subroutine test_polar_loss_cone(mesh)
            !! Tests the correct calculation of the loss cone
            type(mesh_5d_t), intent(inout) :: mesh

            type(circular_toroidal_t) :: tor_eq
            real(kind=GP) :: rho_it, qval_it, loss_cone_check, &
                             bx_val, by_val, bt_val, &
                             bx_max, by_max, bt_max
            real(kind=GP), parameter :: eps = 1e-3
            real(kind=GP), dimension(:,:), pointer :: mesh_loss_cone, &
                                                      x_arr, Z_arr, is_core_ptr
            real(kind=GP), dimension(:),   pointer :: phi_arr
            integer :: i, k, n_points_RZ, n_points_phi
            logical :: equal

            mesh_loss_cone => mesh%get_loss_cone_pointer()

            equal = .true.

            if (mesh%equi_type() == CIRCULAR) then
                ! Analytically, all the values of the loss cone are 0.0
                equal = .not. any(mesh_loss_cone > eps)

            else if (mesh%equi_type() == CIRCULAR_TOROIDAL) then
                n_points_RZ  = mesh%size_RZ()
                n_points_phi = mesh%size_phi()

                x_arr       => mesh%get_R_pointer()
                Z_arr       => mesh%get_Z_pointer()
                phi_arr     => mesh%get_phi_pointer()
                is_core_ptr => mesh%get_is_core_pointer()

                call tor_eq%init()

                do k = 1, n_points_phi
                do i = 1, n_points_RZ
                    bx_val = tor_eq%bx  (x_arr(i, k), Z_arr(i, k), phi_arr(k))
                    by_val = tor_eq%by  (x_arr(i, k), Z_arr(i, k), phi_arr(k))
                    bt_val = tor_eq%btor(x_arr(i, k), Z_arr(i, k), phi_arr(k))

                    ! Calculate rho for a given (x,Z)
                    rho_it  = sqrt((x_arr(i, k) - 1.0_GP)**2 + Z_arr(i, k)**2)
                    qval_it = tor_eq%qval(rho_it)

                    if (is_core_ptr(i, k) == 0.0_GP) then
                        ! The polar projection only maps closed regions
                        equal = (mesh_loss_cone(i, k) == 0.0_GP)

                    else
                        ! Analytical maximum B components for
                        ! circular_toroidal_t (at theta=pi, x=1-rho)
                        bx_max = 0.0_GP
                        by_max = -rho_it / ((1.0_GP - rho_it) &
                                           * qval_it * sqrt(1.0_GP - rho_it**2))
                        bt_max = 1.0_GP / (1.0_GP - rho_it)

                        loss_cone_check = &
                                     sqrt(bx_max**2 + by_max**2 + bt_max**2) - &
                                     sqrt(bx_val**2 + by_val**2 + bt_val**2)

                        equal = (mesh_loss_cone(i, k) - loss_cone_check < eps)
                    endif

                    @assertTrue(equal)
                enddo
                enddo
            endif
        end subroutine

    end subroutine

    @test(npes = [3])
    subroutine test_mesh_first_field_period(this)
        !! Tests the initialization of a mesh in the first field period
        ! NOTE: This test is kept independent from the meshes test subroutines
        !       because the initialization of the meshes is unique and
        !       different from the shared meshes.
        class (MpiTestMethod), intent(inout) :: this
        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), target :: dcomm_handler
        type(mesh_5d_t), allocatable :: mesh
        integer, parameter :: num_field_periods = 5
        integer, parameter :: n_phi = 3
        ! For variables, _fp1 stands for first field period, _ft stands for
        ! full torus
        integer :: n_points_RZ_fp1
        real(kind=GP) :: delta_phi_fp1
        real(kind=GP), dimension(n_phi) :: phi_fp1
        real(kind=GP), dimension(:,:), allocatable :: R_fp1, Z_fp1, &
            fll_p_fp1, fll_pp_fp1, fll_m_fp1, fll_mm_fp1
        type(csrmat_t), dimension(n_phi) :: map_p_fp1, map_pp_fp1, &
            map_m_fp1, map_mm_fp1
        real(kind=GP), dimension(:), pointer :: phi_ft
        real(kind=GP), dimension(:,:), pointer :: R_ft, Z_ft, &
            fll_p_ft, fll_pp_ft, fll_m_ft, fll_mm_ft
        type(csrmat_t), dimension(:), pointer :: map_p_ft, &
            map_pp_ft, map_m_ft, map_mm_ft
        integer :: p, k, k_p, nnz
        real(kind=GP), dimension(:), allocatable :: phi_expected
        logical :: equal
        real(kind=GP) :: thresh_fll = 1.0e-7_GP
        real(kind=GP) :: thresh_map = 1.0e-5_GP

        ! Create first mesh only in the first field period
        allocate(mesh)
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=DOMMASCHK, &
                             spacing_RZ=0.012_GP, &
                             n_points_phi=n_phi, &
                             n_levels=1, &
                             only_first_field_period=.true.)

        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                      this%getNumProcesses(), 1, 1, 1)
        dcomm_handler_ptr => dcomm_handler

        call mesh%initialize(dcomm_handler_ptr)

        ! Copy mesh data since only one instance of a mesh can be allocated
        ! at once
        n_points_RZ_fp1 = mesh%size_RZ()
        delta_phi_fp1 = mesh%delta_phi()
        phi_fp1 = mesh%get_phi_pointer()
        R_fp1 = mesh%get_R_pointer()
        Z_fp1 = mesh%get_Z_pointer()
        fll_p_fp1 = mesh%get_fll_positive1_pointer()
        fll_pp_fp1 = mesh%get_fll_positive2_pointer()
        fll_m_fp1 = mesh%get_fll_negative1_pointer()
        fll_mm_fp1 = mesh%get_fll_negative2_pointer()
        map_p_fp1 = mesh%get_map_positive1_pointer()
        map_pp_fp1 = mesh%get_map_positive2_pointer()
        map_m_fp1 = mesh%get_map_negative1_pointer()
        map_mm_fp1 = mesh%get_map_negative2_pointer()

        deallocate(mesh)

        ! Create second mesh in the full torus with num_field_period times
        ! as many planes
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=DOMMASCHK, &
                             spacing_RZ=0.012_GP, &
                             n_points_phi=n_phi*num_field_periods, &
                             n_levels=1, &
                             only_first_field_period=.false.)
        allocate(mesh)
        call mesh%initialize(dcomm_handler_ptr)

        phi_ft => mesh%get_phi_pointer()
        R_ft => mesh%get_R_pointer()
        Z_ft => mesh%get_Z_pointer()
        fll_p_ft => mesh%get_fll_positive1_pointer()
        fll_pp_ft => mesh%get_fll_positive2_pointer()
        fll_m_ft => mesh%get_fll_negative1_pointer()
        fll_mm_ft => mesh%get_fll_negative2_pointer()
        map_p_ft => mesh%get_map_positive1_pointer()
        map_pp_ft => mesh%get_map_positive2_pointer()
        map_m_ft => mesh%get_map_negative1_pointer()
        map_mm_ft => mesh%get_map_negative2_pointer()

        ! Check mesh attributes
        @assertEqual(mesh%size_RZ(), n_points_RZ_fp1)
        @assertEqual(mesh%delta_phi(), delta_phi_fp1, GP_EPS)

        ! Check phi grid
        @assertTrue(all(almost_equal(phi_fp1, phi_ft(1:n_phi), GP_EPS)))

        phi_expected = linspace(0.0_GP, 2.0_GP * PI / 5.0_GP, n_phi)
        @assertTrue(all(almost_equal(phi_fp1, phi_expected, GP_EPS)))

        phi_expected = linspace(0.0_GP, 2.0_GP * PI, n_phi * num_field_periods)
        @assertTrue(all(almost_equal(phi_ft, phi_expected, GP_EPS)))

        ! Check that planes have expected periodicity - the full torus mesh
        ! should essentially be the fp1 mesh copied num_field_periods times
        do k = 1, n_phi
            do p = 1, num_field_periods
                ! Phi index of the kth mesh in the pth field period in the full
                ! torus mesh
                k_p = (p - 1) * n_phi + k

                equal = all(almost_equal(R_fp1(:, k), &
                                         R_ft(:, k_p), &
                                         GP_EPS))
                @assertTrue(equal)
                equal = all(almost_equal(Z_fp1(:, k), &
                                         Z_ft(:, k_p), &
                                         GP_EPS))
                @assertTrue(equal)

                equal = all(almost_equal(fll_p_fp1(:, k), &
                                         fll_p_ft(:, k_p), &
                                         thresh_fll))
                @assertTrue(equal)
                equal = all(almost_equal(fll_pp_fp1(:, k), &
                                         fll_pp_ft(:, k_p), &
                                         thresh_fll))
                @assertTrue(equal)
                equal = all(almost_equal(fll_m_fp1(:, k), &
                                         fll_m_ft(:, k_p), &
                                         thresh_fll))
                @assertTrue(equal)
                equal = all(almost_equal(fll_mm_fp1(:, k), &
                                         fll_mm_ft(:, k_p), &
                                         thresh_fll))
                @assertTrue(equal)

                ! All the map matrix ndims should be the same since they are
                ! determined by the number of base mesh points
                @assertEqual(map_p_fp1(k)%ndim, map_p_ft(k_p)%ndim)
                @assertEqual(map_p_fp1(k)%ndim, map_pp_fp1(k)%ndim)
                @assertEqual(map_p_fp1(k)%ndim, map_pp_ft(k_p)%ndim)
                @assertEqual(map_p_fp1(k)%ndim, map_m_fp1(k)%ndim)
                @assertEqual(map_p_fp1(k)%ndim, map_m_ft(k_p)%ndim)
                @assertEqual(map_p_fp1(k)%ndim, map_mm_fp1(k)%ndim)
                @assertEqual(map_p_fp1(k)%ndim, map_mm_ft(k_p)%ndim)

                @assertEqual(map_p_fp1(k)%nnz, map_p_ft(k_p)%nnz)
                @assertEqual(map_pp_fp1(k)%nnz, map_pp_ft(k_p)%nnz)
                @assertEqual(map_m_fp1(k)%nnz, map_m_ft(k_p)%nnz)
                @assertEqual(map_mm_fp1(k)%nnz, map_mm_ft(k_p)%nnz)

                @assertTrue(all(map_p_fp1(k)%i == map_p_ft(k_p)%i))
                @assertTrue(all(map_pp_fp1(k)%i == map_pp_ft(k_p)%i))
                @assertTrue(all(map_m_fp1(k)%i == map_m_ft(k_p)%i))
                @assertTrue(all(map_mm_fp1(k)%i == map_mm_ft(k_p)%i))

                nnz = map_p_fp1(k)%nnz
                equal = all(map_p_fp1(k)%j(:nnz) == map_p_ft(k_p)%j(:nnz))
                @assertTrue(equal)
                equal = all(almost_equal(map_p_fp1(k)%val(:nnz), &
                                         map_p_ft(k_p)%val(:nnz), thresh_map))
                @assertTrue(equal)

                nnz = map_pp_fp1(k)%nnz
                equal = all(map_pp_fp1(k)%j(:nnz) == map_pp_ft(k_p)%j(:nnz))
                @assertTrue(equal)
                equal = all(almost_equal(map_pp_fp1(k)%val(:nnz), &
                                         map_pp_ft(k_p)%val(:nnz), thresh_map))
                @assertTrue(equal)

                nnz = map_m_fp1(k)%nnz
                equal = all(map_m_fp1(k)%j(:nnz) == map_m_ft(k_p)%j(:nnz))
                @assertTrue(equal)
                equal = all(almost_equal(map_m_fp1(k)%val(:nnz), &
                                         map_m_ft(k_p)%val(:nnz), thresh_map))
                @assertTrue(equal)

                nnz = map_mm_fp1(k)%nnz
                equal = all(map_mm_fp1(k)%j(:nnz) == map_mm_ft(k_p)%j(:nnz))
                @assertTrue(equal)
                equal = all(almost_equal(map_mm_fp1(k)%val(:nnz), &
                                         map_mm_ft(k_p)%val(:nnz), thresh_map))
                @assertTrue(equal)
            enddo
        enddo

    end subroutine

    @test(npes = [1])
    subroutine test_mesh_bsg(this)
        !! Tests the BSG instance in mesh_5d_t type
        ! NOTE: This test is kept independent from the meshes test subroutines
        !       because the initialization of the meshes is unique and
        !       different from the shared meshes.
        class (MpiTestMethod), intent(inout) :: this
        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), allocatable, target :: dcomm_handler
        type(mesh_5d_t), allocatable :: mesh
        real(kind=GP), dimension(:), contiguous, pointer :: vp, vpw
        integer, contiguous, pointer, dimension(:) :: bsg_flags

        integer :: nb
        real(kind=GP) :: vp_length
        integer :: num_blocks
        real(kind=GP), allocatable, dimension(:) :: vplen_markers, &
                                                    radial_markers

        ! CIRCULAR BSG TEST
        allocate(mesh)
        num_blocks = 2
        allocate(vplen_markers(num_blocks))
        allocate(radial_markers(num_blocks-1))
        vp_length = 3.5_GP
        vplen_markers = vp_length
        radial_markers = 0.3_GP
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=CIRCULAR, &
                             spacing_RZ=16.00_GP, &
                             n_points_phi=4, &
                             n_points_vp=2, &
                             length_vp=vp_length, &
                             n_points_mu=2, &
                             quad_type_vp="trapezoidal", &
                             grid_type_mu="quadratic", &
                             use_vspectral=.false., &
                             use_bsg=.true.)

        call setup_test_bsg(this%getMpiCommunicator(), &
                            this%getProcessRank(), &
                            num_blocks=num_blocks, &
                            vplen_markers=vplen_markers, &
                            radial_markers=radial_markers)

        allocate(dcomm_handler)
        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                      this%getNumProcesses(), 1, 1, 1)
        dcomm_handler_ptr => dcomm_handler

        call mesh%initialize(dcomm_handler_ptr)

        ! TODO_BSG: Remove this in the future
        @assertFalse(mesh%is_vspectral_vp())
        @assertFalse(mesh%is_vspectral_mu())

        do nb = 1, num_blocks
          vp => mesh%get_vp_pointer(nb)
          @assertTrue(associated(vp))

          vpw => mesh%get_vpw_pointer(nb)
          @assertTrue(associated(vpw))

          nullify(vp)
          nullify(vpw)
        end do

        do nb = 1, num_blocks
            vp => mesh%get_vp_pointer(nb)
            @assertEqual(vp(1), -vplen_markers(nb), GP_EPS)
            nullify(vp)
        end do

        bsg_flags => mesh%get_bsg_flags_pointer()
        @assertTrue(associated(bsg_flags))

        deallocate(vplen_markers, radial_markers)
        deallocate(mesh)
        deallocate(dcomm_handler)

        allocate(mesh)
        num_blocks = 3
        allocate(vplen_markers(num_blocks))
        allocate(radial_markers(num_blocks-1))
        vp_length = 3.5_GP
        vplen_markers = [vp_length, 2.5_GP, 1.5_GP]
        radial_markers = [0.2_GP, 0.3_GP]
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=CIRCULAR, &
                             spacing_RZ=16.00_GP, &
                             n_points_phi=4, &
                             n_points_vp=4, &
                             length_vp=vp_length, &
                             n_points_mu=2, &
                             quad_type_vp="trapezoidal", &
                             grid_type_mu="quadratic", &
                             use_vspectral=.false., &
                             use_bsg=.true.)

        call setup_test_bsg(this%getMpiCommunicator(), &
                            this%getProcessRank(), &
                            num_blocks=num_blocks, &
                            vplen_markers=vplen_markers, &
                            radial_markers=radial_markers)

        allocate(dcomm_handler)
        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                      this%getNumProcesses(), 1, 1, 1)
        dcomm_handler_ptr => dcomm_handler

        call mesh%initialize(dcomm_handler_ptr)

        do nb = 1, num_blocks
            vp => mesh%get_vp_pointer(nb)
            @assertEqual(vp(1), -vplen_markers(nb), GP_EPS)
            nullify(vp)
        end do

        deallocate(vplen_markers, radial_markers)
        deallocate(mesh)
        deallocate(dcomm_handler)

    end subroutine

end module
