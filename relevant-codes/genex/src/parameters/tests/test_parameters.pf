    @test
    subroutine test_species_parameters()
        !! Tests read and write of the species parameters
        integer, parameter :: n_spec = 2
        real(kind=GP), dimension(n_spec) :: masses, charges, temp_scalings
        character(len=24), dimension(n_spec) :: names
        integer :: i
        logical :: equal

        do i = 1, n_spec
            masses(i)        = get_mass(i)
            charges(i)       = get_charge(i)
            names(i)         = get_name(i)
            temp_scalings(i) = get_temp_scaling(i)
        enddo

        call write_params_species(filename)
        @assertTrue(file_contains("params_species"))
        @assertTrue(file_contains("masses"))
        @assertTrue(file_contains("charges"))
        @assertTrue(file_contains("names"))
        @assertTrue(file_contains("temp_scalings"))
        call read_params_species(filename)

        do i = 1, n_spec
            write(logger_get_debug_channel(), *) &
                "Test params species for "//trim(get_name(i))
            equal = (masses(i) == get_mass(i))
            @assertTrue(equal)
            equal = (charges(i) == get_charge(i))
            @assertTrue(equal)
            equal = (names(i) == get_name(i))
            @assertTrue(equal)
            equal = (temp_scalings(i) == get_temp_scaling(i))
            @assertTrue(equal)

            if(names(i) == "electrons") then
                @assertTrue(get_is_electrons(i))
            else
                @assertTrue(.not. get_is_electrons(i))
            endif
        enddo
    end subroutine

    @test
    subroutine test_species_config_parameters()
        !! Tests read and write of the species config parameters
        integer, parameter :: n_spec = 2
        type(params_species_config_t), dimension(n_spec) :: &
            spec_configs_old, spec_configs_new
        integer :: i
        logical :: equal
        character(len=64) :: fname

        do i = 1, n_spec
            write(logger_get_debug_channel(), *) &
                "Test params species config for "//trim(get_name(i))

            spec_configs_old(i) = get_params_species_config(i)

            fname = "test_params_"//trim(get_name(i))//".txt"

            call write_params_species_config(fname, i)
            @assertTrue(file_contains("params_species_config", fname))
            @assertTrue(file_contains("dist_initial_type", fname))
            @assertTrue(file_contains("is_isotropic", fname))
            @assertTrue(file_contains("profile_type_dens", fname))
            @assertTrue(file_contains("profile_type_temp", fname))
            @assertTrue(file_contains("profile_type_temp_par", fname))
            @assertTrue(file_contains("profile_type_temp_perp", fname))
            call read_params_species_config(fname, i)

            spec_configs_new(i) = get_params_species_config(i)

            equal = (spec_configs_new(i)%dist_initial_type &
                        == spec_configs_old(i)%dist_initial_type)
            @assertTrue(equal)
            equal = (spec_configs_new(i)%is_isotropic &
                        .eqv. spec_configs_old(i)%is_isotropic)
            @assertTrue(equal)
            equal = (spec_configs_new(i)%profile_type_dens &
                        == spec_configs_old(i)%profile_type_dens)
            @assertTrue(equal)
            equal = (spec_configs_new(i)%profile_type_temp &
                        == spec_configs_old(i)%profile_type_temp)
            @assertTrue(equal)
            equal = (spec_configs_new(i)%profile_type_temp_par &
                        == spec_configs_old(i)%profile_type_temp_par)
            @assertTrue(equal)
            equal = (spec_configs_new(i)%profile_type_temp_perp &
                        == spec_configs_old(i)%profile_type_temp_perp)
            @assertTrue(equal)
        enddo
    end subroutine

    @test
    subroutine test_neutrals_parameters()
        !! Tests read and write of the neutrals parameters
        integer, parameter :: n_neut = 1
        real(kind=GP), dimension(n_neut) :: masses
        character(len=24), dimension(n_neut) :: names
        character(len=24), dimension(n_neut) :: mapped_ions_names
        integer :: o
        logical :: equal

        do o = 1, n_neut
            masses(o) = get_neut_mass(o)
            names(o) = get_neut_name(o)
            mapped_ions_names(o) = get_neut_mapped_ion_name(o)
        enddo

        call write_params_neutrals(filename)
        @assertTrue(file_contains("params_neutrals"))
        @assertTrue(file_contains("masses"))
        @assertTrue(file_contains("names"))
        @assertTrue(file_contains("mapped_ions_names"))
        call read_params_neutrals(filename)

        do o = 1, n_neut
            write(logger_get_debug_channel(), *) &
                "Test params neutrals for "//trim(get_neut_name(o))
            equal = almost_equal(masses(o), get_neut_mass(o), GP_EPS)
            @assertTrue(equal)
            equal = (names(o) == get_neut_name(o))
            @assertTrue(equal)
            equal = (mapped_ions_names(o) == get_neut_mapped_ion_name(o))
            @assertTrue(equal)
        enddo
    end subroutine

    @test
    subroutine test_neutrals_config_parameters()
        !! Tests read and write of the neutrals config parameters
        integer, parameter :: n_spec = 1
        character(len=16) :: neutrals_evolve_type
        character(len=16) :: neutrals_coupling_type
        real(kind=GP) :: neutrals_dens_floor
        real(kind=GP) :: neutrals_temp_floor
        real(kind=GP) :: neutrals_gamma_u
        real(kind=GP) :: neutrals_gamma_T
        real(kind=GP) :: neutrals_gamma_W
        logical :: equal

        neutrals_evolve_type = get_neut_evolve_type()
        neutrals_coupling_type = get_neut_coupling_type()
        neutrals_dens_floor = get_neut_dens_floor()
        neutrals_temp_floor = get_neut_temp_floor()
        neutrals_gamma_u = get_neut_gamma_u()
        neutrals_gamma_T = get_neut_gamma_T()
        neutrals_gamma_W = get_neut_gamma_W()

        write(logger_get_debug_channel(), *) &
              "Test neutrals config params"

        call write_params_neutrals_config(filename)
        @assertTrue(file_contains("neutrals_evolve_type"))
        @assertTrue(file_contains("neutrals_coupling_type"))
        @assertTrue(file_contains("neutrals_dens_floor"))
        @assertTrue(file_contains("neutrals_temp_floor"))
        @assertTrue(file_contains("neutrals_gamma_u"))
        @assertTrue(file_contains("neutrals_gamma_T"))
        @assertTrue(file_contains("neutrals_gamma_W"))
        call read_params_neutrals(filename)

        equal = (neutrals_evolve_type == get_neut_evolve_type())
        @assertTrue(equal)
        equal = (neutrals_coupling_type == get_neut_coupling_type())
        @assertTrue(equal)
        equal = almost_equal(neutrals_dens_floor, get_neut_dens_floor(), GP_EPS)
        @assertTrue(equal)
        equal = almost_equal(neutrals_temp_floor, get_neut_temp_floor(), GP_EPS)
        @assertTrue(equal)
        equal = almost_equal(neutrals_gamma_u, get_neut_gamma_u(), GP_EPS)
        @assertTrue(equal)
        equal = almost_equal(neutrals_gamma_T, get_neut_gamma_T(), GP_EPS)
        @assertTrue(equal)
        equal = almost_equal(neutrals_gamma_W, get_neut_gamma_W(), GP_EPS)
        @assertTrue(equal)
    end subroutine

