module test_profiler
    !! Contains tests for the profiler module
    use pfunit
    use profiler_m, only: profiler_start, profiler_stop, profiler_set_path, &
                          profiler_reset, profiler_print, &
                          profiler_start_allreduce, profiler_stop_allreduce

    use, intrinsic :: iso_fortran_env
    use genex_fortran_env_m, only: GP, GP_EPS
    use genex_status_codes_m, only: GENEX_SUCCESS, GENEX_WRN_PROFILER
    use math_m, only: almost_equal
    use logger_m, only: logger_get_info_channel
    use dcomm_handler_m, only: dcomm_handler_t
    use op_set_uniform_m, only: op_set_uniform_cpu_t
    use type_converters_m, only: string
    use file_handling_m, only: delete_file_if_exists

    ! Unit test helpers
    use test_params_m

    implicit none

contains

    @before
    subroutine setup(this)
        ! Flush out all the default parameters
        class(MpiTestMethod), intent(inout) :: this
        call setup_test_params(this%getMpiCommunicator(), &
                               this%getProcessRank())
    end subroutine

    @after
    subroutine teardown(this)
        ! Read all the default parameters
        class(MpiTestMethod), intent(inout) :: this
        call teardown_test_params(this%getMpiCommunicator(), &
                                  this%getProcessRank())
    end subroutine

    @test(npes = [1, 8])
    subroutine test_profiler_core(this)
        !! Tests the profiler subroutines start, stop, set_path, print
        !! and reset. Creates a profiler tree in the test and checks the
        !! correct creation of the tree by writing the performance log to
        !! file, reading it and testing the indentation of the region names.
        class (MpiTestMethod), intent(inout) :: this
        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), target :: dcomm_handler
        type(op_set_uniform_cpu_t) :: op_set_uniform
        real(kind = GP), allocatable, dimension(:) :: test_data
        integer, parameter :: test_dim = 1000
        integer :: n_procs, channel, ierr
        character(len=128) :: lines

        n_procs = this%getNumProcesses()

        dcomm_handler_ptr => dcomm_handler
        call dcomm_handler_ptr%initialize(this%getMpiCommunicator(), &
                                          n_procs, 1, 1, 1)

        ! Create a fairly complicated profiler tree and test the execution of
        ! starts and stops. Further print the performance summary.
        call profiler_start("test", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)

        call profiler_start("set 1", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        allocate(test_data(test_dim))
        call op_set_uniform%apply(test_data, 1.0_GP)
        call profiler_stop("set 1", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)

        call profiler_start("set 2", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call op_set_uniform%apply(test_data, 2.0_GP)
        call profiler_stop("set 2", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)

        call profiler_set_path("set 2", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_start("set 3", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call op_set_uniform%apply(test_data, 3.0_GP)
        call profiler_stop("set 3", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)

        call profiler_set_path("test", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_start("set 4", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call op_set_uniform%apply(test_data, 4.0_GP)
        call profiler_stop("set 4", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)

        call profiler_set_path("test", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_start("set 5", ierr, set_path=.true.)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_start("set 6", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call op_set_uniform%apply(test_data, 4.0_GP)
        call profiler_stop("set 6", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_set_path("test", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_stop("set 5", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)

        call profiler_stop("test", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)

        ! Write performance summary to file
        open(newunit=channel, file='test_profiler.txt', action='write')
        call profiler_print(dcomm_handler_ptr, channel, "test", ierr, .true.)
        @assertEqual(ierr, GENEX_SUCCESS)
        close(unit=channel)

        ! Load file, read individual lines and check for substrings in each line
        if(dcomm_handler%is_master()) then
            open(newunit=channel, file='test_profiler.txt', action='read')
            read(channel, '(A)') lines
            @assertTrue( index(lines, "region")        /= 0)
            read(channel, '(A)') lines
            @assertTrue( index(lines, "------")        /= 0)
            read(channel, '(A)') lines
            @assertTrue( index(lines, "test")          /= 0)
            read(channel, '(A)') lines
            @assertTrue( index(lines, "  set 1")       /= 0)
            read(channel, '(A)') lines
            @assertTrue( index(lines, "  set 2")       /= 0)
            read(channel, '(A)') lines
            @assertTrue( index(lines, "    set 3")     /= 0)
            read(channel, '(A)') lines
            @assertTrue( index(lines, "  set 4")       /= 0)
            read(channel, '(A)') lines
            @assertTrue( index(lines, "  set 5")       /= 0)
            read(channel, '(A)') lines
            @assertTrue( index(lines, "    set 6")     /= 0)
            read(channel, '(A)') lines
            @assertTrue( index(lines, "------")        /= 0)
            close(unit=channel)
        endif

        ! Test profiler reset subroutine
        call profiler_reset()
    end subroutine

    @test(npes = [1, 8])
    subroutine test_profiler_mem(this)
        !! Tests profiler memory handling (no focus on the printed output).
        !! Creats lots of profiler regions and further test the extension
        !! of the children arrays of child elements. Checks if it is possible
        !! to have child regions with same name as parent.
        !! Should also test if the current_node pointer is dangling:
        !! if yes, the state machine was not correctly implemented.
        !! In that case we expect to get segfaults when running the test.
        class (MpiTestMethod), intent(inout) :: this
        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), target :: dcomm_handler
        integer :: n_procs, channel, i, ierr
        character(len=3) :: str_i ! For 3-digit integer numbers

        n_procs = this%getNumProcesses()

        dcomm_handler_ptr => dcomm_handler
        call dcomm_handler_ptr%initialize(this%getMpiCommunicator(), &
                                         n_procs, 1, 1, 1)
        ! Create many profiler regions
        call profiler_start("test", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        do i = 1, 23
            str_i = string(i)
            call profiler_start("rmax"//str_i, ierr)
            @assertEqual(ierr, GENEX_SUCCESS)
            call profiler_stop("rmax"//str_i, ierr)
            @assertEqual(ierr, GENEX_SUCCESS)
        enddo
        ! Create subregions in an arbitrary region
        call profiler_start("rmax5", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_set_path("rmax5", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        do i = 1, 12
            str_i = string(i)
            ! Contains same name as parent
            call profiler_start("rmax"//str_i, ierr)
            @assertEqual(ierr, GENEX_SUCCESS)
            call profiler_stop("rmax"//str_i, ierr)
            @assertEqual(ierr, GENEX_SUCCESS)
        enddo
        call profiler_set_path("test", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_stop("rmax5", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        ! Add more children to upper region
        do i = 24, 53
            str_i = string(i)
            call profiler_start("rmax"//str_i, ierr)
            @assertEqual(ierr, GENEX_SUCCESS)
            call profiler_stop("rmax"//str_i, ierr)
            @assertEqual(ierr, GENEX_SUCCESS)
        enddo
        ! Add more children to the subregion
        call profiler_start("rmax5", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_set_path("rmax5", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        do i = 13, 66
            str_i = string(i)
            call profiler_start("rmax"//str_i, ierr)
            @assertEqual(ierr, GENEX_SUCCESS)
            call profiler_stop("rmax"//str_i, ierr)
            @assertEqual(ierr, GENEX_SUCCESS)
        enddo
        call profiler_set_path("test", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_stop("rmax5", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        ! Create subregions in another arbitrary region
        call profiler_start("rmax27", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_set_path("rmax27", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        do i = 1, 33
            str_i = string(i)
            ! Contains same name as parent
            call profiler_start("rmax"//str_i, ierr)
            @assertEqual(ierr, GENEX_SUCCESS)
            call profiler_stop("rmax"//str_i, ierr)
            @assertEqual(ierr, GENEX_SUCCESS)
        enddo
        call profiler_set_path("test", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_stop("rmax27", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        ! Stop, print and reset
        call profiler_stop("test", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        open(newunit=channel, file='test_profiler_mem.txt', action='write')
        call profiler_print(dcomm_handler_ptr, channel, "test", ierr, .true.)
        @assertEqual(ierr, GENEX_SUCCESS)
        close(unit=channel)
        call profiler_reset()

    end subroutine

    @test(npes = [1, 8])
    subroutine test_profiler_path(this)
        !! Tests the use of absolute and relative mode of profiler_set_path.
        class (MpiTestMethod), intent(inout) :: this
        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), target :: dcomm_handler
        integer :: n_procs, channel, ierr

        n_procs = this%getNumProcesses()

        dcomm_handler_ptr => dcomm_handler
        call dcomm_handler_ptr%initialize(this%getMpiCommunicator(), &
                                         n_procs, 1, 1, 1)
        ! Create many profiler regions
        call profiler_start("test", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_set_path("test", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)

        call profiler_start("level_1a", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_stop("level_1a", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)

        ! Test start with set path optional
        call profiler_start("level_1aa", ierr, set_path=.true.)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_start("level_1aab", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_stop("level_1aab", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_set_path("../", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_stop("level_1aa", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)

        ! Set paths absolute
        call profiler_start("level_1b", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_set_path("test/level_1b", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_start("level_2b", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_set_path("test/level_1b/level_2b", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_start("level_3b", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_stop("level_3b", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_set_path("test/level_1b", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_stop("level_2b", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_set_path("test", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_stop("level_1b", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)

        ! Set paths relative
        call profiler_start("level_1c", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_set_path("./level_1c", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_start("level_2c", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_set_path("./level_2c", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_start("level_3c", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_stop("level_3c", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_set_path("../", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_stop("level_2c", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_set_path("../", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_stop("level_1c", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)

        ! Stop, print and reset
        call profiler_stop("test", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        open(newunit=channel, file='test_profiler_path.txt', action='write')
        call profiler_print(dcomm_handler_ptr, channel, "test", ierr, .true.)
        @assertEqual(ierr, GENEX_SUCCESS)
        close(unit=channel)
        call profiler_reset()
    end subroutine

    @test(npes = [1, 8])
    subroutine test_profiler_errors(this)
        !! Tests correct error handling of profiler routines
        class (MpiTestMethod), intent(inout) :: this
        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), target :: dcomm_handler
        integer :: n_procs, ierr

        n_procs = this%getNumProcesses()

        dcomm_handler_ptr => dcomm_handler
        call dcomm_handler_ptr%initialize(this%getMpiCommunicator(), &
                                         n_procs, 1, 1, 1)

        ! Print out a message to not confuse the messages of the tested errors
        ! with actual errors in the test.
        if(dcomm_handler_ptr%is_master()) &
            write(logger_get_info_channel(),*) &
                "Test profiler errors. Error messages will be triggered..."

        call profiler_start("root", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_set_path("root", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)

        call profiler_start("test", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)

        ! Start already started
        call profiler_start("test", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)

        ! Start illegal
        call profiler_start(".", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)
        call profiler_start("/", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)
        call profiler_start("./", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)
        call profiler_start("../", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)
        call profiler_start("/////", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)
        call profiler_start("./../...././", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)
        call profiler_start("test.", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)
        call profiler_start("test/", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)

        ! Set path to non-existent
        call profiler_set_path("1", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)
        call profiler_set_path("./", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)
        call profiler_set_path("..", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)
        call profiler_set_path("...", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)
        call profiler_set_path("/", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)
        call profiler_set_path("//", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)
        call profiler_set_path("/./", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)
        call profiler_set_path(".//", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)
        call profiler_set_path("..//", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)

        ! Stop non-existent region
        call profiler_stop("1", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)
        call profiler_stop("./", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)
        call profiler_stop("../", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)

        ! Print with non-existent reference region
        call profiler_print(dcomm_handler_ptr, logger_get_info_channel(), &
                            "1", ierr, .true.)
        @assertEqual(ierr, GENEX_WRN_PROFILER)

        call profiler_set_path("./test", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_start("test_child", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)

        ! Set path to non-existent
        call profiler_set_path("test_childs", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)
        call profiler_set_path("test_child", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)

        call profiler_set_path("./test_child", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_set_path("../", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)

        ! Start region with set_path option and try to stop it afterwards
        call profiler_start("test_start_set_path", ierr, set_path=.true.)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_stop("test_start_set_path", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)
        call profiler_set_path("../", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_stop("test_start_set_path", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)

        ! Stop region in wrong path
        call profiler_stop("test", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)

        call profiler_stop("test_child", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_set_path("../", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)

        call profiler_stop("test", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        ! Stop already stopped
        call profiler_stop("test", ierr)
        @assertEqual(ierr, GENEX_WRN_PROFILER)

        call profiler_stop("root", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)

        call profiler_reset()
    end subroutine

    @test(npes = [1, 8])
    subroutine test_profiler_tsync_isolation(this)
        !! Tests the isolation of synchronization time from communication time
        !! in the case of MPI_Allreduce profiling region
        class (MpiTestMethod), intent(inout) :: this
        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), target :: dcomm_handler
        integer :: comm, rank, n_procs, channel, ierr
        character(len=128) :: lines

        comm    = this%getMpiCommunicator()
        rank    = this%getProcessRank()
        n_procs = this%getNumProcesses()

        dcomm_handler_ptr => dcomm_handler
        call dcomm_handler_ptr%initialize(comm, n_procs, 1, 1, 1)

        call setup_test_params(comm, rank)

        call profiler_start("test", ierr, set_path=.true.)
        @assertEqual(ierr, GENEX_SUCCESS)

        ! Test the profiler without the synchronization time isolation (default)

        call profiler_start("default", ierr, set_path=.true.)
        @assertEqual(ierr, GENEX_SUCCESS)

        call profiler_start_allreduce(comm, ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_stop_allreduce(ierr)
        @assertEqual(ierr, GENEX_SUCCESS)

        call profiler_stop("default", ierr, set_path=.true.)
        @assertEqual(ierr, GENEX_SUCCESS)

        ! Test the profiler with the synchronization time isolation
        call setup_test_devtools(comm, rank, isolate_tsync=.true.)

        call profiler_start("isolated", ierr, set_path=.true.)
        @assertEqual(ierr, GENEX_SUCCESS)

        call profiler_start_allreduce(comm, ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call profiler_stop_allreduce(ierr)
        @assertEqual(ierr, GENEX_SUCCESS)

        call profiler_stop("isolated", ierr, set_path=.true.)
        @assertEqual(ierr, GENEX_SUCCESS)

        call profiler_stop("test", ierr, set_path=.true.)
        @assertEqual(ierr, GENEX_SUCCESS)

        ! Write performance summary to file
        open(newunit=channel, file='test_profiler.txt', action='write')
        call profiler_print(dcomm_handler_ptr, channel, "test", ierr, .true.)
        @assertEqual(ierr, GENEX_SUCCESS)
        close(unit=channel)

        ! Load file, read individual lines and check for substrings in each line
        if(dcomm_handler%is_master()) then
            open(newunit=channel, file='test_profiler.txt', action='read')
            read(channel, '(A)') lines
            @assertTrue(index(lines, "region")            /= 0)
            read(channel, '(A)') lines
            @assertTrue(index(lines, "------")            /= 0)
            read(channel, '(A)') lines
            @assertTrue(index(lines, "test")              /= 0)
            read(channel, '(A)') lines
            @assertTrue(index(lines, "  default")         /= 0)
            read(channel, '(A)') lines
            @assertTrue(index(lines, "    mpi_allreduce") /= 0)
            read(channel, '(A)') lines
            @assertTrue(index(lines, "  isolated")        /= 0)
            read(channel, '(A)') lines
            @assertTrue(index(lines, "    mpi_barrier")   /= 0)
            read(channel, '(A)') lines
            @assertTrue(index(lines, "    mpi_allreduce") /= 0)
            read(channel, '(A)') lines
            @assertTrue(index(lines, "------")            /= 0)
            close(unit=channel)
        endif

        ! Test profiler reset subroutine
        call profiler_reset()
    end subroutine

    @test(npes = [1])
    subroutine test_profiler_logger(this)
        !! Tests the logger feature for the last profiling region
        class (MpiTestMethod), intent(inout) :: this
        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), target :: dcomm_handler
        integer :: comm, rank, ierr
        logical :: stat

        call delete_file_if_exists("debug_region.txt")
        comm = this%getMpiCommunicator()
        rank = this%getProcessRank()

        dcomm_handler_ptr => dcomm_handler
        call dcomm_handler_ptr%initialize(comm, this%getNumProcesses(), 1, 1, 1)

        call profiler_start("test", ierr, set_path=.true.)
        @assertEqual(ierr, GENEX_SUCCESS)

        ! Check if the log file does not exist
        inquire(file="debug_region.txt", exist=stat)
        @assertFalse(stat)

        ! Activate the debug logger
        call setup_test_devtools(comm, rank, debug_profregion=.true.)

        call validate_debug_file("region_1")
        call validate_debug_file("region_2")

        call profiler_stop("test", ierr, set_path=.true.)
        @assertEqual(ierr, GENEX_SUCCESS)

        ! Test profiler reset subroutine
        call profiler_reset()

    contains

        subroutine validate_debug_file(region_name)
            ! Validate the existence and the contents of the debug logger file
            character(len=*), intent(in) :: region_name
            ! Name of the profiling region

            integer :: ierr, channel
            character(len=128) :: lines
            logical :: stat

            call profiler_start(region_name, ierr, set_path=.true.)
            @assertEqual(ierr, GENEX_SUCCESS)

            ! Check if the log file exists
            inquire(file="debug_region.txt", exist=stat)
            @assertTrue(stat)

            ! Check if the log is correct
            open(newunit=channel, file="debug_region.txt", action='read')
            read(channel, '(A)') lines
            @assertEqual("test/test/"//trim(region_name), trim(lines))
            close(unit=channel)

            call profiler_stop(region_name, ierr, set_path=.true.)
            @assertEqual(ierr, GENEX_SUCCESS)
        end subroutine

    end subroutine

end module
