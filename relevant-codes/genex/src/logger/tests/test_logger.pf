module test_logger
    !! Contains test for the logger
    use funit
    use logger_m, only: stdout, stderr
    use logger_m, only: logger_get_info_channel, logger_get_debug_channel, &
                        logger_get_error_channel
    use logger_m, only: logger_set_info_channel, logger_set_debug_channel, &
                        logger_set_error_channel
    use logger_m, only: logger_log_region

    implicit none

contains

    @test
    subroutine test_logger_initialization()
        !! Tests the default initialization and the getter routines
        @assertEqual(stdout, logger_get_info_channel())
        @assertEqual(stdout, logger_get_debug_channel())
        @assertEqual(stderr, logger_get_error_channel())
    end subroutine

    @test
    subroutine test_logger_setter()
        !! Tests the setter routines
        call logger_set_info_channel(1)
        call logger_set_debug_channel(2)
        call logger_set_error_channel(3)

        @assertEqual(1, logger_get_info_channel())
        @assertEqual(2, logger_get_debug_channel())
        @assertEqual(3, logger_get_error_channel())
    end subroutine

    @test
    subroutine test_logger_log_region()
        !! Tests the profiling region logger
        integer :: ierr, iunit
        logical :: stat
        character(len=128) :: log

        call logger_log_region("test_logger_log_region", ierr)
        @assertTrue(ierr == 0)

        ! Check if the log file exists
        inquire(file="debug_region.txt", exist=stat)
        @assertTrue(stat)

        ! Check if the log is correct
        open(newunit=iunit, file="debug_region.txt", action='read')
        read(iunit, '(A)') log
        @assertEqual("test_logger_log_region", trim(log))
        close(unit=iunit)
    end subroutine
end module
