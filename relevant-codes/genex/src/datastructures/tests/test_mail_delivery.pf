module test_mail_delivery
    !! Contains test for the mail_delivery_m module
    use pfunit
    use mpi
    implicit none

contains

    @test(npes = [1, 2, 4])
    subroutine test_deliver_outboxes(this)
        use helpers_mail_delivery_m, only : test_dimension
        use dimensions_m, only : DIM_PHI, DIM_VP, DIM_MU

        class (MpiTestMethod), intent(inout) :: this

        integer :: n_ranks, comm_world, n_ranks_phi, n_ranks_vp, &
            n_ranks_mu, n_ranks_sp, n_neighbors
        logical :: fine

        n_ranks = this%getNumProcesses()
        comm_world = this%getMpiCommunicator()

        n_ranks_phi = n_ranks
        n_ranks_vp = 1
        n_ranks_mu = 1
        n_ranks_sp = 1
        n_neighbors = 4
        fine = test_dimension(comm_world, n_ranks_phi, n_ranks_vp, &
                              n_ranks_mu, n_ranks_sp, DIM_PHI, n_neighbors)
        @assertTrue(fine)

        n_ranks_phi = 1
        n_ranks_vp = n_ranks
        n_ranks_mu = 1
        n_ranks_sp = 1
        n_neighbors = 4
        fine = test_dimension(comm_world, n_ranks_phi, n_ranks_vp, &
                              n_ranks_mu, n_ranks_sp, DIM_VP, n_neighbors)
        @assertTrue(fine)

        n_ranks_phi = 1
        n_ranks_vp = 1
        n_ranks_mu = n_ranks
        n_ranks_sp = 1
        n_neighbors = 4
        fine = test_dimension(comm_world, n_ranks_phi, n_ranks_vp, &
                              n_ranks_mu, n_ranks_sp, DIM_MU, n_neighbors)
        @assertTrue(fine)

        n_ranks_phi = n_ranks
        n_ranks_vp = 1
        n_ranks_mu = 1
        n_ranks_sp = 1
        n_neighbors = 2
        fine = test_dimension(comm_world, n_ranks_phi, n_ranks_vp, &
                              n_ranks_mu, n_ranks_sp, DIM_PHI, n_neighbors)
        @assertTrue(fine)

        n_ranks_phi = 1
        n_ranks_vp = n_ranks
        n_ranks_mu = 1
        n_ranks_sp = 1
        n_neighbors = 2
        fine = test_dimension(comm_world, n_ranks_phi, n_ranks_vp, &
                              n_ranks_mu, n_ranks_sp, DIM_VP, n_neighbors)
        @assertTrue(fine)

        n_ranks_phi = 1
        n_ranks_vp = 1
        n_ranks_mu = n_ranks
        n_ranks_sp = 1
        n_neighbors = 2
        fine = test_dimension(comm_world, n_ranks_phi, n_ranks_vp, &
                              n_ranks_mu, n_ranks_sp, DIM_MU, n_neighbors)
        @assertTrue(fine)
    end subroutine test_deliver_outboxes

end module
