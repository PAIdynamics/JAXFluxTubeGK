    @test
    subroutine test_mesh_parameters()
        !! Tests read and write of the mesh parameters
        integer :: n_levels
        real(kind=GP) :: spacing_RZ, length_vp, length_mu
        integer :: n_points_phi, n_points_vp, n_points_mu, n_points_sp
        integer :: equilibrium_type
        character(len=24) :: quad_type_vp, grid_type_mu
        logical :: equal
        logical :: use_vspectral
        logical :: only_first_field_period
        logical :: extend_beyond_wall
        logical :: use_bsg
        integer, dimension(:), allocatable :: reorder_size

        n_levels                = get_n_levels()
        spacing_RZ              = get_spacing_RZ()
        length_vp               = get_length_vp()
        length_mu               = get_length_mu()
        n_points_phi            = get_n_points_phi()
        n_points_vp             = get_n_points_vp()
        n_points_mu             = get_n_points_mu()
        n_points_sp             = get_n_points_sp()
        equilibrium_type        = get_equilibrium_type()
        only_first_field_period = get_only_first_field_period()
        extend_beyond_wall      = get_extend_beyond_wall()
        quad_type_vp            = get_quad_type_vp()
        grid_type_mu            = get_grid_type_mu()
        use_vspectral           = get_use_vspectral()
        use_bsg                 = get_use_bsg()

        allocate(reorder_size(1:n_levels))
        reorder_size            = get_reorder_size()

        call write_params_mesh(filename)
        @assertTrue(file_contains("params_mesh"))
        @assertTrue(file_contains("n_levels"))
        @assertTrue(file_contains("spacing_RZ"))
        @assertTrue(file_contains("length_vp"))
        @assertTrue(file_contains("length_mu"))
        @assertTrue(file_contains("n_points_phi"))
        @assertTrue(file_contains("n_points_vp"))
        @assertTrue(file_contains("n_points_mu"))
        @assertTrue(file_contains("n_points_sp"))
        @assertTrue(file_contains("equilibrium_type"))
        @assertTrue(file_contains("only_first_field_period"))
        @assertTrue(file_contains("extend_beyond_wall"))
        @assertTrue(file_contains("quad_type_vp"))
        @assertTrue(file_contains("grid_type_mu"))
        @assertTrue(file_contains("use_vspectral"))
        @assertTrue(file_contains("use_bsg"))
        @assertTrue(file_contains("reorder_size"))
        call read_params_mesh(filename)

        equal = (n_levels == get_n_levels())
        @assertTrue(equal)
        equal = (spacing_RZ == get_spacing_RZ())
        @assertTrue(equal)
        equal = (length_vp == get_length_vp())
        @assertTrue(equal)
        equal = (length_mu == get_length_mu())
        @assertTrue(equal)
        equal = (n_points_phi == get_n_points_phi())
        @assertTrue(equal)
        equal = (n_points_vp == get_n_points_vp())
        @assertTrue(equal)
        equal = (n_points_mu == get_n_points_mu())
        @assertTrue(equal)
        equal = (n_points_sp == get_n_points_sp())
        @assertTrue(equal)
        equal = (equilibrium_type == get_equilibrium_type())
        @assertTrue(equal)
        equal = (only_first_field_period .eqv. get_only_first_field_period())
        @assertTrue(equal)
        equal = (extend_beyond_wall .eqv. get_extend_beyond_wall())
        @assertTrue(equal)
        equal = (quad_type_vp == get_quad_type_vp())
        @assertTrue(equal)
        equal = (grid_type_mu == get_grid_type_mu())
        @assertTrue(equal)
        equal = (use_vspectral .eqv. get_use_vspectral())
        @assertTrue(equal)
        equal = (use_bsg .eqv. get_use_bsg())
        @assertTrue(equal)
        equal = all(reorder_size == get_reorder_size())
        @assertTrue(equal)
    end subroutine

    @test
    subroutine test_bsg_parameters()
        !! Tests read and write of the BSG parameters
        integer :: num_blocks, bsg_interp_order
        logical :: equal
        real(kind=GP), dimension(MAX_BLOCKS) :: vplen_markers, radial_markers

        num_blocks       = get_num_bsg_blocks()
        vplen_markers    = get_vplen_markers()
        radial_markers   = get_radial_markers()
        bsg_interp_order = get_bsg_interp_order()

        call write_params_bsg(filename)
        @assertTrue(file_contains("num_blocks"))
        @assertTrue(file_contains("vplen_markers"))
        @assertTrue(file_contains("radial_markers"))
        @assertTrue(file_contains("bsg_interp_order"))
        call read_params_bsg(filename)

        equal = (num_blocks == get_num_bsg_blocks())
        @assertTrue(equal)
        equal = all(vplen_markers == get_vplen_markers())
        @assertTrue(equal)
        equal = all(radial_markers == get_radial_markers())
        @assertTrue(equal)
        equal = (bsg_interp_order == get_bsg_interp_order())
        @assertTrue(equal)
    end subroutine

    @test
    subroutine test_mms_parameters()
        !! Tests read and write of the MMS parameters
        integer :: npol, ntor, nrad
        real(kind=GP) :: omega, q, shear, minor_r, ell_ax1, ell_ax2
        logical :: equal

        npol    = get_npol()
        ntor    = get_ntor()
        nrad    = get_nrad()
        omega   = get_omega()
        q       = get_q()
        shear   = get_shear()
        minor_r = get_minor_r()
        ell_ax1 = get_ell_ax1()
        ell_ax2 = get_ell_ax2()

        call write_params_mms(filename)
        @assertTrue(file_contains("params_mms"))
        @assertTrue(file_contains("npol"))
        @assertTrue(file_contains("ntor"))
        @assertTrue(file_contains("nrad"))
        @assertTrue(file_contains("omega"))
        @assertTrue(file_contains("q"))
        @assertTrue(file_contains("shear"))
        @assertTrue(file_contains("minor_r"))
        @assertTrue(file_contains("ell_ax1"))
        @assertTrue(file_contains("ell_ax2"))
        call read_params_mms(filename)

        equal = (npol == get_npol())
        @assertTrue(equal)
        equal = (ntor == get_ntor())
        @assertTrue(equal)
        equal = (nrad == get_nrad())
        @assertTrue(equal)
        equal = almost_equal(omega, get_omega(), 100.0_GP*GP_EPS)
        @assertTrue(equal)
        equal = almost_equal(q, get_q(), GP_EPS)
        @assertTrue(equal)
        equal = almost_equal(shear, get_shear(), GP_EPS)
        @assertTrue(equal)
        equal = almost_equal(minor_r, get_minor_r(), GP_EPS)
        @assertTrue(equal)
        equal = almost_equal(ell_ax1, get_ell_ax1(), GP_EPS)
        @assertTrue(equal)
        equal = almost_equal(ell_ax2, get_ell_ax2(), GP_EPS)
        @assertTrue(equal)
    end subroutine

    @test
    subroutine test_normalization_parameters()
        !! Tests read and write of the normalization parameters
        real(kind=GP) :: m_ref, T_ref, n_ref, L_ref, B_ref, P_ref
        real(kind=GP) :: rho_ref, c_ref, coll_ref, beta_ref, diff_ref, &
                         rate_ref, xsec_ref, fuel_ref, heat_ref, &
                         torque_ref
        logical :: equal

        m_ref = get_m_ref()
        T_ref = get_T_ref()
        n_ref = get_n_ref()
        L_ref = get_L_ref()
        B_ref = get_B_ref()
        P_ref = get_P_ref()
        rho_ref  = get_rho_ref()
        c_ref    = get_c_ref()
        coll_ref = get_coll_ref()
        beta_ref = get_beta_ref()
        diff_ref = get_diff_ref()
        rate_ref = get_rate_ref()
        xsec_ref = get_xsec_ref()
        fuel_ref = get_fuel_ref()
        torque_ref = get_torque_ref()
        heat_ref = get_heat_ref()

        call check_derived_params()
        call write_params_normalization(filename)
        @assertTrue(file_contains("params_normalization"))
        @assertTrue(file_contains("m_ref"))
        @assertTrue(file_contains("T_ref"))
        @assertTrue(file_contains("n_ref"))
        @assertTrue(file_contains("L_ref"))
        @assertTrue(file_contains("B_ref"))
        @assertTrue(file_contains("P_ref"))
        call read_params_normalization(filename)
        call check_derived_params()

        equal = almost_equal(m_ref, get_m_ref(), 100.0_GP*GP_EPS)
        @assertTrue(equal)
        equal = almost_equal(T_ref, get_T_ref(), 100.0_GP*GP_EPS)
        @assertTrue(equal)
        equal = almost_equal(n_ref, get_n_ref(), 100.0_GP*GP_EPS)
        @assertTrue(equal)
        equal = almost_equal(L_ref, get_L_ref(), 100.0_GP*GP_EPS)
        @assertTrue(equal)
        equal = almost_equal(B_ref, get_B_ref(), 100.0_GP*GP_EPS)
        @assertTrue(equal)
        equal = almost_equal(P_ref, get_P_ref(), 100.0_GP*GP_EPS)
        @assertTrue(equal)

        equal = almost_equal(rho_ref, get_rho_ref(), 100.0_GP*GP_EPS)
        @assertTrue(equal)
        ! Check for rel tol since c_ref is around 1e5
        equal = almost_equal(1.0_GP, get_c_ref() / c_ref, 100.0_GP*GP_EPS)
        @assertTrue(equal)
        equal = almost_equal(coll_ref, get_coll_ref(), 100.0_GP*GP_EPS)
        @assertTrue(equal)
        equal = almost_equal(beta_ref, get_beta_ref(), 100.0_GP*GP_EPS)
        @assertTrue(equal)
        equal = almost_equal(diff_ref, get_diff_ref(), 100.0_GP*GP_EPS)
        @assertTrue(equal)
        equal = almost_equal(rate_ref, get_rate_ref(), 100.0_GP*GP_EPS)
        @assertTrue(equal)
        equal = almost_equal(xsec_ref, get_xsec_ref(), 100.0_GP*GP_EPS)
        @assertTrue(equal)
        equal = almost_equal(fuel_ref, get_fuel_ref(), 100.0_GP*GP_EPS)
        @assertTrue(equal)
        equal = almost_equal(torque_ref, get_torque_ref(), 100.0_GP*GP_EPS)
        @assertTrue(equal)
        equal = almost_equal(heat_ref, get_heat_ref(), 100.0_GP*GP_EPS)
        @assertTrue(equal)
    contains
        subroutine check_derived_params()
            real(kind=GP) :: T_eV, T_cgs, m_cgs, B_cgs, L_cgs, n_cgs
            real(kind=GP) :: c_si, omega, rho_si, beta, coll, diff, rate, &
                             xsec, fuel, heat

            real(kind=GP), parameter :: e_charge_si = 1.602176634e-019_GP
            ! Electron charge in C
            real(kind=GP), parameter :: e_charge_cgs = 4.80320425e-010_GP
            ! Electron charge in statC
            real(kind=GP), parameter :: m_proton = 1.67262192369e-024_GP
            ! Proton mass in g
            real(kind=GP), parameter :: sol = 2.99792458e10_GP
            ! Speed of light in cm / s

            T_eV  = get_T_ref() * 1e3_GP   ! to eV
            ! T in eV times e in C gives the energy in J which relates to
            ! erg by 1e7
            T_cgs = T_eV  * e_charge_si * 1e7_GP
            m_cgs = get_m_ref() * m_proton ! to g
            B_cgs = get_B_ref() * 1e4_GP   ! to G
            n_cgs = get_n_ref() * 1e13_GP  ! to cm^-3
            L_cgs = get_L_ref() * 1e2_GP   ! to cm

            ! Check ref velocity
            c_si = sqrt(T_cgs / m_cgs) / 100.0_GP
            equal = almost_equal(1.0_GP, get_c_ref() / c_si, 1e-8_GP)
            @assertTrue(equal)

            ! Check ref Larmor radius
            omega = (B_cgs * e_charge_cgs) / (m_cgs * sol)
            rho_si = c_si / omega
            equal = almost_equal(rho_si, get_rho_ref(), 1e-9_GP)
            @assertTrue(equal)

            ! Check ref beta
            beta = 8.0_GP * PI * n_cgs * T_cgs / B_cgs**2
            equal = almost_equal(beta, get_beta_ref(), 1e-5_GP)
            @assertTrue(equal)

            ! Check ref coll
            coll = (16.0_GP / 3.0_GP) * sqrt(2.0_GP * PI) * &
                   e_charge_cgs**4 * n_cgs * L_cgs / T_cgs**2
            equal = almost_equal(coll, get_coll_ref(), 1e-11_GP)
            @assertTrue(equal)

            ! Check ref diff
            ! 1e2: conversion m -> cm
            diff = c_si * L_cgs / 1e2_GP
            equal = almost_equal(1.0_GP, get_diff_ref() / diff, 1e-8_GP)
            @assertTrue(equal)

            ! Check ref rate
            ! 1e15: conversion 1e19 m^{-2} -> cm^{-2}
            rate = c_si * 1e15_GP / (L_cgs * n_cgs)
            equal = almost_equal(1.0_GP, get_rate_ref() / rate, 1e-8_GP)
            @assertTrue(equal)

            ! Check ref cross-section
            xsec = 1e15_GP / (L_cgs * n_cgs)
            equal = almost_equal(1.0_GP, get_xsec_ref() / xsec, 1e-8_GP)
            @assertTrue(equal)

            ! Check ref fuelling
            ! Does the check in SI units, except n which is in 1e19 m^{-3}
            fuel = (L_cgs / 1e2_GP)**2 * c_si * get_n_ref()
            equal = almost_equal(1.0_GP, get_fuel_ref() / fuel, 1e-8_GP)
            @assertTrue(equal)

            ! Check ref heat source
            ! Does the check in SI units and convert W to kW
            heat = (L_cgs / 1e2_GP)**2 * c_si * (T_cgs / 1e7_GP) &
                 * (n_cgs * 1e6_GP)
            heat = heat / 1e3_GP
            equal = almost_equal(1.0_GP, get_heat_ref() / heat, 1e-8_GP)
            @assertTrue(equal)
        end subroutine
    end subroutine

