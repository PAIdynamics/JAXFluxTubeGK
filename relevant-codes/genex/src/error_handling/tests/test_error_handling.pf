module test_error_handling
    !! Contains test for the error handling
    use mpi
    use pfunit
    use genex_fortran_env_m, only: GP
    use netcdf, only: nf90_emaxname, nf90_emaxdims
    use genex_error_handling_m, only: handle_error, &
                                      handle_error_netcdf, set_error_mode, &
                                      handle_error_gpu, handle_error_notimp, &
                                      GPU_ERR_NONE, GPU_ERR_INITIALIZE
    use genex_status_codes_m, only: GENEX_SUCCESS, GENEX_ERR_MAIN, &
                                    GENEX_WRN_GENERAL
    use logger_m, only: logger_get_info_channel

    ! From PARALLAX
    use error_handling_m, only: ERRORS_ARE_FATAL, ERRORS_RETURN, error_info_t
    use screen_io_m, only: set_parallax_stderr => set_stderr

    implicit none

contains

    subroutine setup()
        ! Print out a message to not confuse the messages of the tested errors
        ! with actual errors in the test.
        write(logger_get_info_channel(),*) &
                "Test error handling. Error messages will be triggered..."
        write(logger_get_info_channel(),*) ""

        call set_parallax_stderr(logger_get_info_channel())
    end subroutine

    @test(npes = [1, 2])
    subroutine test_handle_error(this)
        ! Checks if handle error can be executed properly.
        ! Does not check the format or content of the output.
        class(mpitestmethod), intent(inout) :: this

        call setup()

        ! Check that call with success works and does not terminate the program
        call handle_error("Test nothing should happen!", &
                          GENEX_SUCCESS, __LINE__, __FILE__)
        write(logger_get_info_channel(),*) ""
        ! Check that call with unknown warning code works and does
        ! not terminate the program
        call handle_error("Test warning message!", 99999, __LINE__, __FILE__)
        write(logger_get_info_channel(),*) ""

        ! Check that call with a warning code works and does
        ! not terminate the program
        call handle_error("Test warning message!", &
                          GENEX_WRN_GENERAL, __LINE__, __FILE__)
        write(logger_get_info_channel(),*) ""
        call handle_error("Test warning message!", &
                          GENEX_WRN_GENERAL, __LINE__, __FILE__, &
                          error_info_t(c_info="additional info", &
                                       i_info=[1, 2, 3], &
                                       r_info=[1.0_GP, 2.0_GP]))
        write(logger_get_info_channel(),*) ""

        ! Check that call with an error code works. We set the error mode to
        ! return to avoid the termination of the test program.
        call set_error_mode(ERRORS_RETURN)
        call handle_error("Test error message!", &
                          GENEX_ERR_MAIN, __LINE__, __FILE__)
        write(logger_get_info_channel(),*) ""
        call handle_error("Test error message!", &
                          GENEX_ERR_MAIN, __LINE__, __FILE__, &
                          error_info_t(c_info="additional info", &
                                       i_info=[1, 2, 3], &
                                       r_info=[1.0_GP, 2.0_GP]))
        write(logger_get_info_channel(),*) ""
        ! Check that call with unknown error code works.
        call handle_error("Test error message!", -99999, __LINE__, __FILE__)
        write(logger_get_info_channel(),*) ""

    end subroutine

    @test
    subroutine test_handle_error_netcdf()
        ! Checks the handle error netcdf wrapper for execution.
        ! Does not check the format or content of the output.

        call setup()
        call set_error_mode(ERRORS_RETURN)

        call handle_error_netcdf(nf90_emaxname, __LINE__, __FILE__)
        write(logger_get_info_channel(),*) ""
        call handle_error_netcdf(nf90_emaxdims, __LINE__, __FILE__)
        write(logger_get_info_channel(),*) ""
    end subroutine

    @test
    subroutine test_handle_error_gpu()
        ! Checks the handle error gpu wrapper for execution.
        ! Does not check the format or content of the output.

        call setup()
        call set_error_mode(ERRORS_RETURN)

        call handle_error_gpu(GPU_ERR_NONE, __LINE__, __FILE__)
        write(logger_get_info_channel(),*) ""
        call handle_error_gpu(GPU_ERR_INITIALIZE, __LINE__, __FILE__)
        write(logger_get_info_channel(),*) ""
    end subroutine

    @test
    subroutine test_handle_error_notimp()
        ! Checks the handle error not implemented wrapper for execution.
        ! Does not check the format or content of the output.

        call setup()
        call set_error_mode(ERRORS_RETURN)

        call handle_error_notimp("test", __LINE__, __FILE__)
        write(logger_get_info_channel(),*) ""
        call handle_error_notimp("collisions", __LINE__, __FILE__)
        write(logger_get_info_channel(),*) ""
    end subroutine

end module
