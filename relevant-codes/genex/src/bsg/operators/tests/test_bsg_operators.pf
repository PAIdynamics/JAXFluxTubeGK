module test_bsg_operators
    !! Contains tests for the BSG operators
    use mpi
    use pfunit
    use math_m, only: almost_equal
    use genex_fortran_env_m, only: GP, GP_EPS
    use mesh_5d_m, only: mesh_5d_t
    use dcomm_handler_m, only: dcomm_handler_t
    use bsg_operators_m, only: bsg_operators_t
    use bsg_types_m, only: vspace_bsg_t, MAX_BLOCKS

    ! Unit test helpers
    use test_params_m

    ! From PARALLAX
    use equilibrium_factory_m, only: CIRCULAR

    implicit none

contains

    @before
    subroutine setup(this)
        ! Flush out all the default parameters
        class(MpiTestMethod), intent(inout) :: this
        call setup_test_params(this%getMpiCommunicator(), &
                               this%getProcessRank())
    end subroutine

    @after
    subroutine teardown(this)
        ! Read all the default parameters
        class(MpiTestMethod), intent(inout) :: this
        call teardown_test_params(this%getMpiCommunicator(), &
                                  this%getProcessRank())
    end subroutine

    @test(npes=[1])
    subroutine test_initialization_same_vp(this)
        class (MpiTestMethod), intent(inout) :: this
        type(bsg_operators_t), allocatable :: bsg_op
        integer :: num_blocks, n_points_vp, nb, l, bsg_interp_order
        real(kind=GP) :: length
        type(mesh_5d_t), allocatable :: mesh
        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), allocatable, target :: dcomm_handler
        type(vspace_bsg_t), pointer, dimension(:) :: vp_bsg, vpw_bsg
        real(kind=GP), pointer, contiguous, dimension(:) :: vp, vpw
        logical :: equal
        real(kind=GP), pointer, contiguous, dimension(:) :: prefac_vp, vp_delta
        integer, pointer, contiguous, dimension(:,:,:) :: local_start_idx
        integer, pointer, contiguous, dimension(:,:,:) :: local_end_idx
        integer :: vp_index
        logical, pointer, contiguous, dimension(:,:,:) :: is_internal
        real(kind=GP), dimension(MAX_BLOCKS) :: vplen_markers, radial_markers

        allocate(mesh)
        num_blocks = 2
        length = 3.5_GP
        n_points_vp = 32
        bsg_interp_order = 4
        vplen_markers(1:2) = length
        radial_markers(1) = 0.3_GP
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=CIRCULAR, &
                             spacing_RZ=0.05_GP, &
                             n_points_phi=16, &
                             n_points_vp=32, &
                             n_points_mu=16, &
                             length_vp = length, &
                             use_bsg=.true.)
        call setup_test_bsg(this%getMpiCommunicator(), &
                            this%getProcessRank(), &
                            vplen_markers=vplen_markers, &
                            radial_markers=radial_markers, &
                            num_blocks=num_blocks)

        allocate(dcomm_handler)
        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                      this%getNumProcesses(), 1, 1, 1)
        dcomm_handler_ptr => dcomm_handler

        call mesh%initialize(dcomm_handler_ptr)

        allocate(bsg_op)
        call bsg_op%initialize(mesh, num_blocks, bsg_interp_order)

        @assertTrue(bsg_op%is_initialized())

        ! Test vp and vpw accessors
        vp_bsg => bsg_op%get_vp_pointer()
        vpw_bsg => bsg_op%get_vpw_pointer()
        do nb = 1, num_blocks
            vp => mesh%get_vp_pointer(nb)
            vpw => mesh%get_vpw_pointer(nb)
            do l = 1, mesh%size_vp()
                @assertEqual(vp(l), vp_bsg(nb)%array(l))
                @assertEqual(vpw(l), vpw_bsg(nb)%array(l))
            end do
            nullify(vp)
            nullify(vpw)
        end do

        ! Test vp_delta and vp_delta_inverse
        prefac_vp => bsg_op%get_prefac_vp_pointer()
        vp_delta => bsg_op%get_vp_delta_pointer()
        do nb = 1, num_blocks
            @assertEqual(vp_delta(nb), mesh%delta_vp(nb))
            equal = almost_equal(prefac_vp(nb), 1.0_GP &
                  / mesh%delta_vp(nb), GP_EPS)
            @assertTrue(equal)
        end do

        ! Test local start and end indices
        local_start_idx => bsg_op%get_local_start_idx_pointer()
        local_end_idx   => bsg_op%get_local_end_idx_pointer()
        vp_index = 1
        @assertEqual(local_start_idx(vp_index, 1, 2), 1)
        @assertEqual(local_end_idx(vp_index, 1, 2), 5)

        vp_index = 32
        @assertEqual(local_start_idx(vp_index, 1, 2), 28)
        @assertEqual(local_end_idx(vp_index, 1, 2), 32)

        ! Test is_internal
        is_internal => bsg_op%get_is_internal_pointer()
        do l = 1, mesh%size_vp()
            @assertTrue(is_internal(l, 1, 2))
            @assertTrue(is_internal(l, 2, 1))
        end do

        deallocate(bsg_op)
        deallocate(mesh)
        deallocate(dcomm_handler)
    end subroutine

    @test(npes=[1])
    subroutine test_initialization_diff_vp(this)
        class (MpiTestMethod), intent(inout) :: this
        type(bsg_operators_t), allocatable :: bsg_op
        integer :: num_blocks, n_points_vp, nb, l, bsg_interp_order
        real(kind=GP) :: length
        type(mesh_5d_t), allocatable :: mesh
        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), allocatable, target :: dcomm_handler
        type(vspace_bsg_t), pointer, dimension(:) :: vp_bsg, vpw_bsg
        real(kind=GP), pointer, contiguous, dimension(:) :: vp, vpw
        logical :: equal
        real(kind=GP), pointer, contiguous, dimension(:) :: prefac_vp, vp_delta
        integer, pointer, contiguous, dimension(:,:,:) :: local_start_idx
        integer, pointer, contiguous, dimension(:,:,:) :: local_end_idx
        integer :: vp_index, block_idx, neighbor_block_idx
        logical, pointer, contiguous, dimension(:,:,:) :: is_internal
        real(kind=GP), dimension(MAX_BLOCKS) :: vplen_markers, radial_markers

        allocate(mesh)
        num_blocks = 2
        length = 3.5_GP
        n_points_vp = 32
        bsg_interp_order = 4
        vplen_markers(1:2) = [length, 2.5_GP]
        radial_markers(1) = 0.3_GP
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=CIRCULAR, &
                             spacing_RZ=0.05_GP, &
                             n_points_phi=16, &
                             n_points_vp=32, &
                             n_points_mu=16, &
                             length_vp = length, &
                             use_bsg=.true.)
        call setup_test_bsg(this%getMpiCommunicator(), &
                            this%getProcessRank(), &
                            vplen_markers=vplen_markers, &
                            radial_markers=radial_markers, &
                            num_blocks=num_blocks, &
                            bsg_interp_order=bsg_interp_order)

        allocate(dcomm_handler)
        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                      this%getNumProcesses(), 1, 1, 1)
        dcomm_handler_ptr => dcomm_handler

        call mesh%initialize(dcomm_handler_ptr)

        allocate(bsg_op)
        call bsg_op%initialize(mesh, num_blocks, bsg_interp_order)

        @assertTrue(bsg_op%is_initialized())

        ! Test vp and vpw accessors
        vp_bsg => bsg_op%get_vp_pointer()
        vpw_bsg => bsg_op%get_vpw_pointer()
        do nb = 1, num_blocks
            vp => mesh%get_vp_pointer(nb)
            vpw => mesh%get_vpw_pointer(nb)
            do l = 1, mesh%size_vp()
                @assertEqual(vp(l), vp_bsg(nb)%array(l))
                @assertEqual(vpw(l), vpw_bsg(nb)%array(l))
            end do
            nullify(vp)
            nullify(vpw)
        end do

        ! Test vp_delta and vp_delta_inverse
        prefac_vp => bsg_op%get_prefac_vp_pointer()
        vp_delta => bsg_op%get_vp_delta_pointer()
        do nb = 1, num_blocks
            @assertEqual(vp_delta(nb), mesh%delta_vp(nb))
            equal = almost_equal(prefac_vp(nb), 1.0_GP &
                  / mesh%delta_vp(nb), GP_EPS)
            @assertTrue(equal)
        end do

        ! Test local start and end indices
        local_start_idx => bsg_op%get_local_start_idx_pointer()
        local_end_idx   => bsg_op%get_local_end_idx_pointer()
        is_internal => bsg_op%get_is_internal_pointer()
        vp_index = 1
        block_idx = 1
        neighbor_block_idx = 2
        @assertFalse(is_internal(vp_index, block_idx, neighbor_block_idx))

        vp_index = 32
        block_idx = 1
        neighbor_block_idx = 2
        @assertFalse(is_internal(vp_index, block_idx, neighbor_block_idx))

        do l = 1, mesh%size_vp()
            @assertTrue(is_internal(l, 2, 1))
        end do

        deallocate(bsg_op)
        deallocate(mesh)
        deallocate(dcomm_handler)
    end subroutine

end module
