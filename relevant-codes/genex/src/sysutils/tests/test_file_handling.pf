module test_file_handling
    !! Contains tests for file handling
    use funit
    use file_handling_m, only: file_exists, delete_file_if_exists
    implicit none

contains

    @test
    subroutine test_exists()
        integer :: iunit, ierr

        @assertFalse(file_exists("test_file_exists"))
        open(newunit=iunit, iostat=ierr, file="test_file_exists")
        close(iunit)
        @assertTrue(file_exists("test_file_exists"))

        call execute_command_line("rm -rf test_file_exists")
    end subroutine

    @test
    subroutine test_delete_if_exists()
        integer :: iunit, ierr

        open(newunit=iunit, iostat=ierr, file="test_file_delete_if_exists")
        close(iunit)

        @assertTrue(file_exists("test_file_delete_if_exists"))
        call delete_file_if_exists("test_file_delete_if_exists")
        @assertFalse(file_exists("test_file_delete_if_exists"))
    end subroutine

end module
