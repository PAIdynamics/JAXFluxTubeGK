    @test
    subroutine test_profile_plateau_parameters()
        !! Tests read and write of the profile plateau (neutrals) parameters
        integer, parameter :: n_spec = 1
        type(params_profile_plateau_t) :: plateau_dens_old, plateau_new
        integer :: i
        logical :: equal
        character(len=64) :: fname

        do i = 1, n_spec
            plateau_dens_old      = get_params_profile_plateau_dens(i)

            fname = "test_params_"//trim(get_neut_name(i))//".txt"

            call write_params_profile_plateau(fname, i)
            @assertTrue(file_contains("params_profile_plateau_dens", fname))
            @assertTrue(file_contains("rho_inner_foot", fname))
            @assertTrue(file_contains("rho_inner_top", fname))
            @assertTrue(file_contains("rho_outer_top", fname))
            @assertTrue(file_contains("rho_outer_foot", fname))
            @assertTrue(file_contains("amp_in", fname))
            @assertTrue(file_contains("amp_plateau", fname))
            @assertTrue(file_contains("amp_out", fname))
            call read_params_profile_plateau(fname, i)

            write(logger_get_debug_channel(), *) &
                "Test params profile plateau dens for "//trim(get_neut_name(i))
            plateau_new = get_params_profile_plateau_dens(i)
            call compare_plateau(plateau_dens_old, plateau_new)
        enddo
    contains
        subroutine compare_plateau(plateau_old, plateau_new)
            type(params_profile_plateau_t), intent(in) :: plateau_old, &
                                                          plateau_new

            equal = almost_equal(plateau_old%rho_inner_foot, &
                                 plateau_new%rho_inner_foot, 10.0_GP * GP_EPS)
            @assertTrue(equal)
            equal = almost_equal(plateau_old%rho_inner_top, &
                                 plateau_new%rho_inner_top, 10.0_GP * GP_EPS)
            @assertTrue(equal)
            equal = almost_equal(plateau_old%rho_outer_top, &
                                 plateau_new%rho_outer_top, 10.0_GP * GP_EPS)
            @assertTrue(equal)
            equal = almost_equal(plateau_old%rho_outer_foot, &
                                 plateau_new%rho_outer_foot, 10.0_GP * GP_EPS)
            @assertTrue(equal)
            equal = almost_equal(plateau_old%amp_in, &
                                 plateau_new%amp_in, 10.0_GP * GP_EPS)
            @assertTrue(equal)
            equal = almost_equal(plateau_old%amp_plateau, &
                                 plateau_new%amp_plateau, 10.0_GP * GP_EPS)
            @assertTrue(equal)
            equal = almost_equal(plateau_old%amp_out, &
                                 plateau_new%amp_out, 10.0_GP * GP_EPS)
            @assertTrue(equal)
        end subroutine
    end subroutine

    @test
    subroutine test_profile_cbc_parameters()
        !! Tests read and write of the profile cbc parameters
        integer, parameter :: n_spec = 2
        type(params_profile_cbc_t) :: cbc_dens_old, cbc_temp_old, &
            cbc_temp_par_old, cbc_temp_perp_old, cbc_new
        integer :: i
        logical :: equal
        character(len=64) :: fname

        do i = 1, n_spec
            cbc_dens_old      = get_params_profile_cbc_dens(i)
            cbc_temp_old      = get_params_profile_cbc_temp(i)
            cbc_temp_par_old  = get_params_profile_cbc_temp_par(i)
            cbc_temp_perp_old = get_params_profile_cbc_temp_perp(i)

            fname = "test_params_"//trim(get_name(i))//".txt"

            call write_params_profile_cbc(fname, i)
            @assertTrue(file_contains("params_profile_cbc_dens", fname))
            @assertTrue(file_contains("params_profile_cbc_temp", fname))
            @assertTrue(file_contains("params_profile_cbc_temp_par", fname))
            @assertTrue(file_contains("params_profile_cbc_temp_perp", fname))
            ! NOTE: We currently only check if the parameters have been written
            !       once for dens, temp, temp_par or temp_perp. To improve the
            !       test once could check if the file contains them multiple
            !       times.
            @assertTrue(file_contains("kappa", fname))
            @assertTrue(file_contains("prefac", fname))
            @assertTrue(file_contains("delta", fname))
            @assertTrue(file_contains("center", fname))
            call read_params_profile_cbc(fname, i)

            write(logger_get_debug_channel(), *) &
                "Test params profile cbc dens for "//trim(get_name(i))
            cbc_new = get_params_profile_cbc_dens(i)
            call compare_cbc(cbc_dens_old, cbc_new)

            write(logger_get_debug_channel(), *) &
                "Test params profile cbc temp for "//trim(get_name(i))
            cbc_new = get_params_profile_cbc_temp(i)
            call compare_cbc(cbc_temp_old, cbc_new)

            write(logger_get_debug_channel(), *) &
                "Test params profile cbc temp par for "//trim(get_name(i))
            cbc_new = get_params_profile_cbc_temp_par(i)
            call compare_cbc(cbc_temp_par_old, cbc_new)

            write(logger_get_debug_channel(), *) &
                "Test params profile cbc temp perp for "//trim(get_name(i))
            cbc_new = get_params_profile_cbc_temp_perp(i)
            call compare_cbc(cbc_temp_perp_old, cbc_new)
        enddo
    contains
        subroutine compare_cbc(cbc_old, cbc_new)
            type(params_profile_cbc_t), intent(in) :: cbc_old, cbc_new

            equal = (cbc_old%kappa  == cbc_new%kappa)
            @assertTrue(equal)
            equal = (cbc_old%prefac == cbc_new%prefac)
            @assertTrue(equal)
            equal = (cbc_old%delta  == cbc_new%delta)
            @assertTrue(equal)
            equal = (cbc_old%center == cbc_new%center)
            @assertTrue(equal)
        end subroutine
    end subroutine

    @test
    subroutine test_profile_sine_parameters()
        !! Tests read and write of the profile sine parameters
        integer, parameter :: n_spec = 2
        type(params_profile_sine_t) :: sine_dens_old, sine_temp_old, &
            sine_temp_par_old, sine_temp_perp_old, sine_new
        integer :: i
        logical :: equal
        character(len=64) :: fname

        do i = 1, n_spec
            sine_dens_old      = get_params_profile_sine_dens(i)
            sine_temp_old      = get_params_profile_sine_temp(i)
            sine_temp_par_old  = get_params_profile_sine_temp_par(i)
            sine_temp_perp_old = get_params_profile_sine_temp_perp(i)

            fname = "test_params_"//trim(get_name(i))//".txt"

            call write_params_profile_sine(fname, i)
            @assertTrue(file_contains("params_profile_sine_dens", fname))
            @assertTrue(file_contains("params_profile_sine_temp", fname))
            @assertTrue(file_contains("params_profile_sine_temp_par", fname))
            @assertTrue(file_contains("params_profile_sine_temp_perp", fname))
            ! NOTE: We currently only check if the parameters have been written
            !       once for dens, temp, temp_par or temp_perp. To improve the
            !       test once could check if the file contains them multiple
            !       times.
            @assertTrue(file_contains("rho_min", fname))
            @assertTrue(file_contains("rho_max", fname))
            @assertTrue(file_contains("amp_min", fname))
            @assertTrue(file_contains("amp_max", fname))
            call read_params_profile_sine(fname, i)

            write(logger_get_debug_channel(), *) &
                "Test params profile sine dens for "//trim(get_name(i))
            sine_new = get_params_profile_sine_dens(i)
            call compare_sine(sine_dens_old, sine_new)

            write(logger_get_debug_channel(), *) &
                "Test params profile sine temp for "//trim(get_name(i))
            sine_new = get_params_profile_sine_temp(i)
            call compare_sine(sine_temp_old, sine_new)

            write(logger_get_debug_channel(), *) &
                "Test params profile sine temp par for "//trim(get_name(i))
            sine_new = get_params_profile_sine_temp_par(i)
            call compare_sine(sine_temp_par_old, sine_new)

            write(logger_get_debug_channel(), *) &
                "Test params profile sine temp perp for "//trim(get_name(i))
            sine_new = get_params_profile_sine_temp_perp(i)
            call compare_sine(sine_temp_perp_old, sine_new)
        enddo
    contains
        subroutine compare_sine(sine_old, sine_new)
            type(params_profile_sine_t), intent(in) :: sine_old, sine_new

            equal = (sine_old%rho_min == sine_new%rho_min)
            @assertTrue(equal)
            equal = (sine_old%rho_max == sine_new%rho_max)
            @assertTrue(equal)
            equal = (sine_old%amp_min == sine_new%amp_min)
            @assertTrue(equal)
            equal = (sine_old%amp_max == sine_new%amp_max)
            @assertTrue(equal)
        end subroutine
    end subroutine

