module test_bsg_types
    !! Contains tests for bsg_flags_t and vspace_bsg_t
    use mpi
    use pfunit
    use bsg_types_m, only: vspace_bsg_t, MAX_BLOCKS, pack_flags, unpack_bflag, &
                           unpack_all_flags
    use genex_fortran_env_m, only: GP
    use mesh_5d_m, only: mesh_5d_t
    use structured_grids_m, only: vp_grid_t
    use dcomm_handler_m, only: dcomm_handler_t
    ! Unit test helpers
    use test_params_m

    implicit none

contains

    @before
    subroutine setup(this)
        ! Flush out all the default parameters
        class(MpiTestMethod), intent(inout) :: this
        call setup_test_params(this%getMpiCommunicator(), &
                               this%getProcessRank())
    end subroutine

    @after
    subroutine teardown(this)
        ! Read all the default parameters
        class(MpiTestMethod), intent(inout) :: this
        call teardown_test_params(this%getMpiCommunicator(), &
                                  this%getProcessRank())
    end subroutine

    @test(npes=[1])
    subroutine test_flags(this)
        !! Tests packing and unpacking of bsg_flags_t
        class (MpiTestMethod), intent(inout) :: this
        integer, allocatable, dimension(:) :: bsg_flags
        logical, dimension(5) :: all_flags_check
        integer :: bflag, flag_p, flag_pp, flag_m, flag_mm
        integer :: bflag_check
        integer :: i

        ! Allocate flags
        allocate(bsg_flags(MAX_BLOCKS))
        ! Test1: Varying block numbers and no map matrices flag
        flag_p = 0
        flag_pp = 0
        flag_m = 0
        flag_mm = 0
        do i = 1, MAX_BLOCKS
            bflag = i
            call pack_flags(bflag, flag_p, flag_pp, &
                            flag_m, flag_mm, bsg_flags(i))
            bflag_check = unpack_bflag(bsg_flags(i))
            all_flags_check = unpack_all_flags(bsg_flags(i))
            @assertEqual(bflag, bflag_check)
            @assertTrue(all_flags_check(1))
            @assertTrue(all_flags_check(2))
            @assertTrue(all_flags_check(3))
            @assertTrue(all_flags_check(4))
        end do

        ! Test2: Varying block numbers and map matrices flag = 1
        flag_p = 1
        flag_pp = 1
        flag_m = 1
        flag_mm = 1
        do i = 1, MAX_BLOCKS
            bflag = i
            call pack_flags(bflag, flag_p, flag_pp, &
                            flag_m, flag_mm, bsg_flags(i))
            bflag_check = unpack_bflag(bsg_flags(i))
            all_flags_check = unpack_all_flags(bsg_flags(i))
            @assertEqual(bflag, bflag_check)
            @assertFalse(all_flags_check(1))
            @assertFalse(all_flags_check(2))
            @assertFalse(all_flags_check(3))
            @assertFalse(all_flags_check(4))
        end do

        ! Test3: Varying map matrices flag
        bflag = 4
        do i = 1, MAX_BLOCKS
            if (mod(i, 2) == 0) then
                flag_p = 1
                flag_pp = 1
                flag_m = 0
                flag_mm = 0
            else
                flag_p = 0
                flag_pp = 0
                flag_m = 1
                flag_mm = 1
            end if
            call pack_flags(bflag, flag_p, flag_pp, flag_m, &
                            flag_mm, bsg_flags(i))
            all_flags_check = unpack_all_flags(bsg_flags(i))
            bflag_check = unpack_bflag(bsg_flags(i))
            @assertEqual(bflag, bflag_check)
            if (mod(i, 2) == 0) then
                @assertFalse(all_flags_check(1))
                @assertFalse(all_flags_check(2))
                @assertTrue(all_flags_check(3))
                @assertTrue(all_flags_check(4))
            else
                @assertTrue(all_flags_check(1))
                @assertTrue(all_flags_check(2))
                @assertFalse(all_flags_check(3))
                @assertFalse(all_flags_check(4))
            end if
        end do

        ! Test4: Varying block numbers (negative) and no map matrices flag
        flag_p = 0
        flag_pp = 0
        flag_m = 0
        flag_mm = 0
        do i = 1, MAX_BLOCKS
            if (mod(i, 2) == 0) then
                call pack_flags(bflag, flag_p, flag_pp, &
                                flag_m, flag_mm, bsg_flags(i))
                bsg_flags(i) = -bsg_flags(i)
            else
                call pack_flags(bflag, flag_p, flag_pp, &
                                flag_m, flag_mm, bsg_flags(i))
            end if
            all_flags_check = unpack_all_flags(bsg_flags(i))
            bflag_check = unpack_bflag(bsg_flags(i))
            @assertEqual(bflag, bflag_check)

            if (mod(i, 2) == 0) then
                @assertTrue(all_flags_check(5))
            else
                @assertFalse(all_flags_check(5))
            end if
        end do

        deallocate(bsg_flags)
    end subroutine

    @test(npes=[1])
    subroutine test_vspace_bsg(this)
        !! Tests for vspace_bsg_t accessor
        class (MpiTestMethod), intent(inout) :: this
        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), allocatable, target :: dcomm_handler
        type(mesh_5d_t), allocatable :: mesh
        real(kind=GP), dimension(:), contiguous, pointer :: vp, vpw
        type(vspace_bsg_t), allocatable, dimension(:) :: vp_array, vpw_array
        integer :: num_blocks, nb, l
        logical :: equal
        real(kind=GP), dimension(MAX_BLOCKS) :: radial_markers, vp_len_markers
        real(kind=GP) :: length_vp

        num_blocks = 2
        radial_markers = 0.3_GP
        length_vp = 3.5_GP
        vp_len_markers = length_vp
        allocate(mesh)
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             spacing_RZ=16.00_GP, &
                             n_points_phi=8, &
                             n_points_vp=10, &
                             n_points_mu=4, &
                             quad_type_vp="trapezoidal", &
                             grid_type_mu="quadratic", &
                             use_vspectral=.false., &
                             length_vp=length_vp, &
                             use_bsg=.true.)

        call setup_test_bsg(this%getMpiCommunicator(), &
                            this%getProcessRank(), &
                            num_blocks=num_blocks, &
                            vplen_markers=vp_len_markers, &
                            radial_markers=radial_markers)

        allocate(dcomm_handler)
        call dcomm_handler%initialize(this%getMpiCommunicator(), &
                                      this%getNumProcesses(), 1, 1, 1)

        dcomm_handler_ptr => dcomm_handler
        call mesh%initialize(dcomm_handler_ptr)

        allocate(vp_array(num_blocks))
        allocate(vpw_array(num_blocks))

        ! Point accessor to vp/vpw object
        do nb = 1, num_blocks
            vp_array(nb)%array(1:mesh%size_vp()) => mesh%get_vp_pointer(nb)
            vpw_array(nb)%array(1:mesh%size_vp()) => mesh%get_vpw_pointer(nb)
        end do

        ! Test if pointers are associated correctly
        do nb = 1, num_blocks
            equal = associated(vp_array(nb)%array)
            @assertTrue(equal)
            equal = associated(vpw_array(nb)%array)
            @assertTrue(equal)
        end do

        ! Test if the pointers are correctly assigned
        do nb = 1, num_blocks
            vp => mesh%get_vp_pointer(nb)
            vpw => mesh%get_vpw_pointer(nb)
            do l = 1, mesh%size_vp()
                @assertEqual(vp(l), vp_array(nb)%array(l))
                @assertEqual(vpw(l), vpw_array(nb)%array(l))
            end do
            nullify(vp)
            nullify(vpw)
        end do

        deallocate(vp_array)
        deallocate(vpw_array)
        deallocate(mesh)
        deallocate(dcomm_handler)

    end subroutine

end module
