    implicit none

    character(len=*), parameter :: filename = "test_params.txt"
    !! Filename for testing the parameter read and write
contains

    @before
    subroutine setup
        ! Delete filenames if exist.
        integer :: n
        integer, parameter :: n_spec = 2
        character(len=64) :: fname

        ! Make sure test parameters files do not already exist
        call delete_file_if_exists(filename)
        do n = 1, n_spec
            fname = "test_params_"//trim(get_name(n))//".txt"
            call delete_file_if_exists(fname)
        end do
        fname = "test_params_"//trim(get_neut_name(1))//".txt"
        call delete_file_if_exists(fname)
    end subroutine

    @after
    subroutine teardown
        ! Teardown test
    end subroutine

    function to_lower(string) result(lower_string)
        !! Returns a version of the given string where all letters are lowercase
        character(len=*), intent(in) :: string
        character(len=len(string)) :: lower_string
        integer :: i_cap, i
        character(len=26), parameter :: cap = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
        character(len=26), parameter :: low = 'abcdefghijklmnopqrstuvwxyz'

        lower_string = string
        ! Go through all characters and lower them if they are capitalized
        do i = 1, len_trim(string)
            i_cap = index(cap, string(i:i))
            if (i_cap > 0) lower_string(i:i) = low(i_cap:i_cap)
        end do
    end function

    logical function file_contains(string_to_check, fname)
        !! Checks that the file given by filename contains the string given to
        !! check. Can be used to check if a namelist or a parameter has been
        !! written.
        character(len=*), intent(in) :: string_to_check
        character(len=*), intent(in), optional :: fname
        !! Optionally specify the file that should be checked. If not present
        !! uses the default file in the module.

        character(len=32) :: file_to_check
        character(len=128) :: line_to_check
        integer :: iunit, io_status
        logical :: file_exists

        if(present(fname)) then
            file_to_check = fname
        else
            file_to_check = filename
        endif

        ! First check that file exists
        inquire(file=file_to_check, exist=file_exists)
        @assertTrue(file_exists)

        file_contains = .false.
        open(newunit=iunit, file=file_to_check, action='read')
        ! Go through all lines and check if the string is contained in the line
        do
            read(iunit, '(A)', iostat=io_status) line_to_check
            if(io_status == 0) then
                ! Read success
                file_contains = (index(to_lower(line_to_check), &
                                       to_lower(string_to_check)) /= 0)
                if(file_contains) exit
            else if(io_status < 0) then
                ! EOF
                exit
            else
                ! Read error
                @assertTrue(.false.)
            endif
        enddo
        close(unit=iunit)
    end function

    @test
    subroutine test_params_error_handling()
        !! Tests the error handling routines for the parameter file methods
        integer :: iunit, ierr, itest

        namelist / test_namelist / itest
        namelist / test_namelist2 / itest

        ! TODO: Add checks for proper error behaviour if non-fatal errors are
        !       implemented.

        ! Make sure a standard call works
        open(newunit=iunit, file=filename, status='unknown', &
             action='write', position='append', iostat=ierr)
        call handle_open_error(filename, ierr)
        itest = 42
        write(iunit, nml=test_namelist, iostat=ierr)
        call handle_write_error(filename, ierr, nml_name="test_namelist")
        close(iunit)

        open(newunit=iunit, file=filename, status='old', action='read', &
             iostat=ierr)
        call handle_open_error(filename, ierr)
        read(iunit, nml=test_namelist, iostat=ierr)
        call handle_read_error(filename, ierr, nml_name="test_namelist", &
                               iunit=iunit)

        ! Should pass without error for non-existing namelist
        read(iunit, nml=test_namelist2, iostat=ierr)
        call handle_read_error(filename, ierr, nml_name="test_namelist2", &
                               iunit=iunit)
        close(iunit)

    end subroutine

    @test
    subroutine test_params()
        !! Tests the general parameter file methods
        character(:), allocatable :: parameter_file
        logical :: equal
        integer :: ierr, istat

        parameter_file = get_parameter_file()
        call set_parameter_file("test_params.txt")

        equal = (get_parameter_file() == parameter_file)
        @assertFalse(equal)
        equal = (get_parameter_file() == "test_params.txt")
        @assertTrue(equal)

        ! Check if write and read work. Details on write and read will be
        ! checked by the individual tests
        call write_parameter_file("./")
        call execute_command_line("mv params_electrons_out.txt &
                                  &params_electrons.txt", &
                                  cmdstat=ierr, exitstat=istat)
        @assertEqual(ierr, 0)
        @assertEqual(istat, 0)
        call execute_command_line("mv params_protons_out.txt &
                                  &params_protons.txt", &
                                  cmdstat=ierr, exitstat=istat)
        @assertEqual(ierr, 0)
        @assertEqual(istat, 0)

        call set_parameter_file("params_out.txt")
        call read_parameter_file()
        call delete_file_if_exists("params_out.txt")
        call delete_file_if_exists("params_protons.txt")
        call delete_file_if_exists("params_electrons.txt")
    end subroutine

    @test
    subroutine test_collision_parameters()
        !! Tests read and write of the collision parameters
        real(kind=GP) :: dens_floor, temp_floor
        character(len=16) :: coll_type, relx_type
        logical :: equal

        coll_type  = get_coll_type()
        relx_type  = get_relx_type()
        dens_floor = get_dens_floor()
        temp_floor = get_temp_floor()

        call write_params_collisions(filename)
        @assertTrue(file_contains("params_collisions"))
        @assertTrue(file_contains("coll_type"))
        @assertTrue(file_contains("relx_type"))
        @assertTrue(file_contains("dens_floor"))
        @assertTrue(file_contains("temp_floor"))
        call read_params_collisions(filename)

        equal = (coll_type == get_coll_type())
        @assertTrue(equal)
        equal = (relx_type == get_relx_type())
        @assertTrue(equal)
        equal = (dens_floor == get_dens_floor())
        @assertTrue(equal)
        equal = (temp_floor == get_temp_floor())
        @assertTrue(equal)
    end subroutine

