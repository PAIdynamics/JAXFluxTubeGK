module test_collog
    !! Contains tests for Coulomb logarithm
!$  use omp_lib
    use mpi
    use pfunit
    use genex_fortran_env_m, only: GP
    use genex_error_handling_m, only: handle_error
    use genex_status_codes_m, only: GENEX_ERR_UTESTS
    use math_m, only: almost_equal
    use logger_m, only: logger_get_debug_channel
    use dcomm_handler_m, only: dcomm_handler_t
    use data_array_m, only: data_array_2d_t, data_array_4d_t
    use op_coll_m, only: calc_collog
    use params_mesh_m, only: get_n_points_sp
    use params_species_m, only: get_charge, get_temp_scaling
    use params_gpu_offload_m, only: get_use_gpu_offload

#ifdef ENABLE_GPU
    use helpers_collog_m, only: cbind_calc_collog
#endif

    ! Unit test helpers
    use test_params_m

    implicit none

    real(kind=GP), parameter :: test_tol = 1e-14_GP
    ! Tolerance used for tests: we give the reference only up to 14 digits
    ! so 1e-14 is the appropriate tolerance to use.

contains

    @before
    subroutine setup(this)
        ! Flush out all the default parameters
        class(MpiTestMethod), intent(inout) :: this
        call setup_test_params(this%getMpiCommunicator(), &
                              this%getProcessRank())
    end subroutine

    @after
    subroutine teardown(this)
        ! Read all the default parameters
        class(MpiTestMethod), intent(inout) :: this
        call teardown_test_params(this%getMpiCommunicator(), &
                                  this%getProcessRank())
    end subroutine

    subroutine init(test, dcomm_handler)
        class(MpiTestMethod), intent(inout) :: test
        !! Instance of the current test
        type(dcomm_handler_t), allocatable, intent(out) :: dcomm_handler
        !! Created dcomm_handler

        integer :: n_procs, n_procs_phi, n_procs_vp, n_procs_mu, n_procs_sp

        !! Created dcomm_handler
        n_procs = test%getNumProcesses()

        ! Setup dcomm_handler
        select case (n_procs)
        case (1)
          n_procs_phi = 1
          n_procs_vp  = 1
          n_procs_mu  = 1
          n_procs_sp  = 1
        case (2)
          n_procs_phi = 1
          n_procs_vp  = 1
          n_procs_mu  = 1
          n_procs_sp  = 2
        case default
            call handle_error("Unsupported n_procs in unit test!", &
                              GENEX_ERR_UTESTS, __LINE__, __FILE__)
        end select

        allocate(dcomm_handler)
        call dcomm_handler%initialize(test%getMpiCommunicator(), &
                                     n_procs_phi, n_procs_vp, n_procs_mu, &
                                     n_procs_sp)

    end subroutine

    subroutine test_collog_value(test, test_type, dens, temp, ref, tol, &
                                 use_rel_tol)
        class (mpitestmethod), intent(inout) :: test
        !! Test instance
        character(len=*), intent(in) :: test_type
        !! Type of the test (for debug log)
        real(kind=GP), dimension(:), intent(in) :: dens
        !! Density values
        real(kind=GP), dimension(:), intent(in) :: temp
        !! Temperature values
        real(kind=GP), dimension(:), intent(in) :: ref
        !! Reference value
        real(kind=GP), intent(in) :: tol
        !! Acceptable tolerance for the test
        logical, optional, intent(in) :: use_rel_tol
        !! If true, tol is taken as relative tolerance (default false)

        ! Local

        type(dcomm_handler_t), allocatable :: dcomm_handler

        class(data_array_4d_t), allocatable :: da_mom
        class(data_array_2d_t), allocatable :: da_collog
        real(kind=GP), contiguous, pointer, dimension(:,:,:,:):: mom
        real(kind=GP), contiguous, pointer, dimension(:,:):: collog

        integer :: i, n, n_sp, n_electrons, ierr
        integer, dimension(5) :: lb, ub
        logical :: all_fine, use_rel_tol_loc

        call init(test, dcomm_handler)

        if(present(use_rel_tol)) then
            use_rel_tol_loc = use_rel_tol
        else
            use_rel_tol_loc = .false.
        end if

        n_sp = get_n_points_sp()
        ! Get electron index
        do n = 1, n_sp
            if(get_charge(n) == -1.0_GP) then
                n_electrons = n
                exit
            end if
        end do

        ! Build bounds arrays
        lb = 1
        ub = 1
        lb(1) = lbound(dens, dim=1)
        ub(1) = ubound(temp, dim=1)
        ub(5) = n_sp

        allocate(da_mom, da_collog)
        call da_mom%initialize([lb(1), lb(2), 1, lb(5)], &
                               [ub(1), ub(2), 3, ub(5)])
        call da_collog%initialize(lb(1:2), ub(1:2))
        mom => da_mom%get_pointer()
        collog => da_collog%get_pointer()

        ! Initialize correct parts of the moments array
        do i = lb(1), ub(1)
            mom(i, 1, 1, n_electrons) = dens(i)
            mom(i, 1, 3, n_electrons) = temp(i) / get_temp_scaling(n_electrons)
        end do

        ! Debug log test announcement
        if(dcomm_handler%is_master()) &
            write(logger_get_debug_channel(), "(A, A, A, ES9.2)") &
            "Test of calc_collog (", test_type, ") with tolerance = ", tol

        if(get_use_gpu_offload()) then
#ifdef ENABLE_GPU
            call da_mom%update_device()
            ierr = cbind_calc_collog(da_mom%get_cxx_pointer(), &
                                     da_collog%get_cxx_pointer())
            @assertEqual(ierr, 0)
            call da_collog%update_host()
#endif
        else
            call calc_collog(da_mom, da_collog)
        endif

        ! Test all calculated values
        all_fine = .true.
        do i = lb(1), ub(1)

            ! Test with absolute or relative tolerance
            if(use_rel_tol_loc .eqv. .false.) then
                all_fine = almost_equal(collog(i, 1), ref(i), tol)
            else
                all_fine = almost_equal(collog(i, 1), ref(i), &
                                        tol * collog(i, 1))
            end if

            if(.not. all_fine) then
                ! Give diagnostic message that tells what is wrong
                if(dcomm_handler%is_master()) &
                    write(logger_get_debug_channel(), &
                        "(A,E16.9,A,E16.9,A,E16.9,A)") &
                        "Collog test failed! (was: ", collog(i, 1), &
                        ", expected: ", ref(i), &
                        ", diff: ", collog(i, 1) - ref(i), ")"

                all_fine = .false.
                exit
            end if
        end do

        @assertTrue(all_fine)

        deallocate(da_mom, da_collog)
    end subroutine

    @test(npes = [1, 2])
    subroutine test_collog_regular(this)
        !! Tests the Coulomb logarithm with regular temperatures and densities

        class (mpitestmethod), intent(inout) :: this

        real(kind=GP), parameter, &
            dimension(*) :: dens = [1.221_GP, 0.75_GP, 1.003_GP]
        real(kind=GP), parameter, &
            dimension(*) :: temp = [0.023_GP, 0.345e0_GP, 1.221e0_GP]
        real(kind=GP), parameter, &
            dimension(*) :: ref = [11.69453088523167_GP, &
                                   14.99875655322909_GP, &
                                   16.14424608395614_GP]

        call test_collog_value(this, "regular", dens, temp, ref, test_tol)
    end subroutine

    @test(npes = [1, 2])
    subroutine test_collog_highdens(this)
        !! Tests the Coulomb logarithm with high densities

        class (mpitestmethod), intent(inout) :: this

        real(kind=GP), parameter, &
            dimension(*) :: dens = [1e2_GP, 4.0e3_GP, 7.2e4_GP]
        real(kind=GP), parameter, &
            dimension(*) :: temp = [1e0_GP, 1.1e0_GP, 1.2e0_GP]
        real(kind=GP), parameter, &
            dimension(*) :: ref = [13.6410845579016_GP, &
                                   11.89316100100537_GP, &
                                   10.53599371811547_GP]

        call test_collog_value(this, "highdens", dens, temp, ref, test_tol)
    end subroutine

    @test(npes = [1, 2])
    subroutine test_collog_hightemp(this)
        !! Tests the Coulomb logarithm with high temperatures

        class (mpitestmethod), intent(inout) :: this

        real(kind=GP), parameter, &
            dimension(*) :: dens = [1.0_GP, 4.0_GP, 6.3_GP]
        real(kind=GP), parameter, &
            dimension(*) :: temp = [10.0_GP, 172.0_GP, 4210.0_GP]
        real(kind=GP), parameter, &
            dimension(*) :: ref = [18.2583241669804_GP, &
                                   20.4113664546625_GP, &
                                   23.38203816053175_GP]

        call test_collog_value(this, "hightemp", dens, temp, ref, test_tol)
    end subroutine

    @test(npes = [1, 2])
    subroutine test_collog_lowdens(this)
        !! Tests the Coulomb logarithm with low densities

        class (mpitestmethod), intent(inout) :: this

        real(kind=GP), parameter, &
            dimension(*) :: dens = [1e-3_GP, 2e-6_GP]
        real(kind=GP), parameter, &
            dimension(*) :: temp = [1.0_GP, 1.1_GP]
        real(kind=GP), parameter, &
            dimension(*) :: ref = [19.397547290386_GP, &
                                   22.60136750973518_GP]

        call test_collog_value(this, "lowdens", dens, temp, ref, test_tol)
    end subroutine

    @test(npes = [1, 2])
    subroutine test_collog_lowtemp(this)
        !! Tests the Coulomb logarithm with low temperatures

        class (mpitestmethod), intent(inout) :: this

        real(kind=GP), parameter, &
            dimension(*) :: dens = [1.23_GP, 1.43_GP]
        real(kind=GP), parameter, &
            dimension(*) :: temp = [1e-3_GP, 1e-5_GP]
        real(kind=GP), parameter, &
            dimension(*) :: ref = [7.275799920681731_GP, &
                                   0.5255936344465804_GP]

        call test_collog_value(this, "lowtemp", dens, temp, ref, test_tol)
    end subroutine

    @test(npes = [1, 2])
    subroutine test_collog_onpoint(this)
        !! Tests the Coulomb logarithm where we set the ref value of collog to
        !! nice numbers and solved for T, n

        class (mpitestmethod), intent(inout) :: this

        real(kind=GP), parameter, &
            dimension(*) :: dens = [1.111_GP, 11.06426809537686_GP, &
                                    0.5424092377813618_GP, 1.47_GP, 2.455_GP]
        real(kind=GP), parameter, &
            dimension(*) :: temp = [60.08489285677975_GP, 0.788_GP, &
                                    2.323_GP, 3.3114832772069e-5_GP, &
                                    3.192945934985698e12_GP]
        real(kind=GP), parameter, &
            dimension(*) :: ref = [20.0_GP, 14.5_GP, 17.1_GP, 2.1_GP, 44.3_GP]

        call test_collog_value(this, "onpoint", dens, temp, ref, test_tol)
    end subroutine

    @test(npes = [1])
    subroutine test_collog_spitzer(this)
        !! Tests the Coulomb logarithm with values given by Spitzer.
        !! (physics of fully ionized gases). These values are crude, therefore
        !! we can only test up to 10% accuracy (relative).
        !! This test is intended to test the absolute value with an independent
        !! source, since the reference values in the other tests are calculated
        !! using the same formula as in the code.

        class (mpitestmethod), intent(inout) :: this

        real(kind=GP), parameter, &
            dimension(*) :: dens = [1.0_GP, 1.0e3_GP, 1e6_GP, 1e9_GP, &
                                    1e13_GP, 1e15_GP]
        !! Density given by Spitzer in cgs
        real(kind=GP), parameter, &
            dimension(*) :: temp_K = [1e7_GP, 1e5_GP, 1e4_GP, 1e6_GP, &
                                      1e7_GP, 1e8_GP]
        !! Temperature given by Spitzer in K
        real(kind=GP), parameter, &
            dimension(*) :: ref = [32.0_GP, 23.2_GP, 16.3_GP, 19.3_GP, &
                                   15.9_GP, 17.0_GP]

        real(kind=GP), dimension(:), allocatable :: dens_norm, temp_norm

        allocate(dens_norm, mold=dens)
        ! Conversion to 10^13 cm^-3
        dens_norm = dens * 1e-13_GP
        allocate(temp_norm, mold=temp_K)
        ! Conversion of K to eV and then to keV
        temp_norm = temp_K * 8.61732814974056e-5_GP * 1e-3

        call test_collog_value(this, "spitzer", dens_norm, temp_norm, &
                               ref, 0.1_GP, use_rel_tol=.true.)
    end subroutine
end module
