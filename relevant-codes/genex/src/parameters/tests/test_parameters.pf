    @test
    subroutine test_gpu_offload_parameters()
        !! Tests read and write of the GPU offloading parameters
        integer :: gx_backend, px_backend, align
        logical :: use_gx_offload, use_px_offload, use_px_data, &
                   swap, equal

        use_gx_offload  = get_use_gpu_offload()
        use_px_offload  = get_use_parallax_gpu_offload()
        use_px_data     = get_use_parallax_gpu_data_explicit()
        gx_backend      = get_gpu_offload_backend()
        px_backend      = get_parallax_gpu_offload_backend()
        swap            = get_swap_mesh_members()
        align           = get_array_alignment()

        call write_params_gpu_offload(filename)
        @assertTrue(file_contains("use_gpu_offload"))
        @assertTrue(file_contains("gpu_offload_backend"))
        @assertTrue(file_contains("use_parallax_gpu_offload"))
        @assertTrue(file_contains("parallax_gpu_offload_backend"))
        @assertTrue(file_contains("use_parallax_gpu_data_explicit"))
        @assertTrue(file_contains("swap_mesh_members"))
        @assertTrue(file_contains("large_array_alignment"))
        call read_params_gpu_offload(filename)

        equal = (use_gx_offload .eqv. get_use_gpu_offload())
        @assertTrue(equal)
        equal = (use_px_offload .eqv. get_use_parallax_gpu_offload())
        @assertTrue(equal)
        equal = (use_px_data .eqv. get_use_parallax_gpu_data_explicit())
        @assertTrue(equal)
        equal = (gx_backend == get_gpu_offload_backend())
        @assertTrue(equal)
        equal = (px_backend == get_parallax_gpu_offload_backend())
        @assertTrue(equal)
        equal = (swap .eqv. get_swap_mesh_members())
        @assertTrue(equal)
        equal = (align == get_array_alignment())
        @assertTrue(equal)
    end subroutine

