module test_type_converters
    !! Contains tests for the type converters
    use funit
    use, intrinsic :: iso_c_binding, only : C_CHAR, C_NULL_CHAR
    use type_converters_m, only: string, string_f2c, string_c2f
    use genex_fortran_env_m, only: GP
    implicit none

contains

    @test
    subroutine test_string_integer()
        !! Tests the string function on integers

        @assertEqual("0", string(0))
        @assertEqual("1", string(1))
        @assertEqual("-1", string(-1))
        @assertEqual("2147483647", string(2147483647))
        @assertEqual("-2147483647", string(-2147483647))
        @assertFalse("+1" == string(1))
    end subroutine

    @test
    subroutine test_string_real()
        !! Tests the string function on reals
        integer :: n
        real(kind=GP) :: real_number
        character(len=64) :: real_string

        @assertEqual("0.0", string(0.0_GP, 1))
        @assertEqual("1.0", string(1.0_GP, 1))
        @assertEqual("1.0000", string(1.0_GP, 4))
        @assertEqual("-1.0", string(-1.0_GP, 1))
        @assertEqual("-1.0000", string(-1.0_GP, 4))
        @assertFalse("+1.0" == string(1.0_GP, 1))

        @assertEqual("2147.421", string(2147.421_GP, 3))
        @assertFalse("-2147.123" == string(-2147.123_GP, 2))
        @assertEqual("-2147.123", string(-2147.123_GP, 3))

        @assertFalse("-544123.043524000" == string(-544123.043524_GP, 9))
        @assertFalse("-544123.043524000000" == string(-544123.043524_GP, 12))
        @assertEqual("-544123.043524", string(-544123.043524_GP, 6))
        @assertEqual("-544123.0435240", string(-544123.043524_GP, 7))
        @assertEqual("-544123.04352400", string(-544123.043524_GP, 8))

        @assertEqual("1.19653720", string(1.196537200920_GP, 8))
        @assertEqual("1.1965372009", string(1.196537200920_GP, 10))
        @assertEqual("1.196537200920", string(1.196537200920_GP, 12))

        do n = 1, 100
            call random_number(real_number)
            write(real_string, "(f16.9)") real_number
            @assertEqual(trim(real_string), string(real_number, 9))
            write(real_string, "(f16.6)") real_number
            @assertEqual(trim(real_string), string(real_number, 6))
        enddo

    end subroutine

    @test
    subroutine test_string_fc_converter()
        !! Tests the string converter between Fortran and C char array formats
        character(len=64) :: f_string
        character(len=1, kind=C_CHAR), dimension(8) :: c_string

        ! Test with initialized Fortran string
        f_string = "this_is_the_string_we_are_testing_123_^%&#_"
        call convert_and_assert_f_string(f_string)

        f_string = "                   we_are_testing_123_^%&#_"
        call convert_and_assert_f_string(f_string)

        f_string = "this_is_the_string_                        "
        call convert_and_assert_f_string(f_string)

        ! Test with initialized C char array
        c_string = ["G", "e", "n", "e", "-", "X", "!", C_NULL_CHAR]
        call convert_and_assert_c_string(c_string)

        c_string = ["G", "e", "n", " ", " ", C_NULL_CHAR, " ", " "]
        call convert_and_assert_c_string(c_string)

        c_string = [" ", " ", "n", "e", "-", "X", C_NULL_CHAR, " "]
        call convert_and_assert_c_string(c_string)

    contains

        subroutine convert_and_assert_f_string(f_string)
            character(len=*), intent(in) :: f_string

            character(len=64) :: f_string_test
            character(len=10) :: f_short
            character(len=1, kind=C_CHAR), dimension(64) :: c_string
            character(len=1, kind=C_CHAR), dimension(10) :: c_short
            integer :: i, length, truncate

            length = len(trim(f_string))

            ! Test string conversion from Fortran to C format
            call string_f2c(f_string, c_string)
            do i = 1, length
                @assertEqual(f_string(i:i), c_string(i))
            enddo
            @assertEqual(C_NULL_CHAR, c_string(length+1))

            ! Test string conversion from C to Fortran format
            call string_c2f(c_string, f_string_test)
            @assertEqual(f_string, f_string_test)

            truncate = size(c_short)

            ! Test string conversion from Fortran to C format with truncation
            call string_f2c(f_string, c_short)
            do i = 1, truncate - 1
                @assertEqual(f_string(i:i), c_short(i))
            enddo
            @assertEqual(C_NULL_CHAR, c_short(truncate))

            ! Test string conversion from C to Fortran format
            call string_c2f(c_short, f_string_test)
            @assertEqual(f_string(1:truncate-1), f_string_test)
        end subroutine

        subroutine convert_and_assert_c_string(c_string)
            character(len=1, kind=C_CHAR), dimension(:) :: c_string

            character(len=64) :: f_string
            character(len=3) :: f_short
            character(len=1, kind=C_CHAR), dimension(32) :: c_string_test
            integer :: i, l, r, length, truncate

            ! Get C_NULL_CHAR termination point
            do i = 1, size(c_string)
                if(c_string(i) == C_NULL_CHAR) then
                    length = i
                endif
            enddo

            ! Test string conversion from C to Fortran format
            call string_c2f(c_string, f_string)
            do i = 1, len(f_string)
                if(i < length) then
                    @assertEqual(c_string(i), f_string(i:i))
                else
                    @assertEqual(" ", f_string(i:i))
                endif
            enddo

            ! Test string conversion from Fortran to C format
            call string_f2c(f_string, c_string_test)
            do i = 1, len(trim(f_string))
                @assertEqual(c_string(i), c_string_test(i))
            enddo
            @assertEqual(C_NULL_CHAR, c_string_test(i))

            ! Test string conversion from C to Fortran format with truncation
            call string_c2f(c_string, f_short)
            do i = 1, len(f_string)
                if(i < length) then
                    @assertEqual(c_string(i), f_string(i:i))
                else
                    @assertEqual(" ", f_string(i:i))
                endif
            enddo

            ! Test string conversion from Fortran to C format with trucation
            call string_f2c(f_short, c_string_test)
            do i = 1, len(f_short)
                @assertEqual(c_string(i), c_string_test(i))
            enddo
            @assertEqual(C_NULL_CHAR, c_string_test(len(f_short) + 1))
        end subroutine

    end subroutine

end module
