@article{Rossmanith2011,
  title = {A positivity-preserving high-order semi-{{Lagrangian}} discontinuous {{Galerkin}} scheme for the {{Vlasov-Poisson}} equations},
  author = {Rossmanith, J and Seal, D},
  year = {2011},
