module test_bsg_interpolation
    !! Contains tests for the bsg_interpolation_t type
    use mpi
    use pfunit
    use math_m, only: PI, almost_equal
    use genex_fortran_env_m, only: GP, GP_EPS, DP

    use bsg_interpolation_m, only: bsg_interpolation_t, &
                                   equidistant_interpolation_t

    ! Unit test helpers
    use test_params_m

    ! From PARALLAX
    use array_generation_m, only: linspace

contains
    @before
    subroutine setup(this)
        ! Flush out all the default parameters
        class(MpiTestMethod), intent(inout) :: this
        call setup_test_params(this%getMpiCommunicator(), &
                               this%getProcessRank())
    end subroutine

    @after
    subroutine teardown(this)
        ! Read all the default parameters
        class(MpiTestMethod), intent(inout) :: this
        call teardown_test_params(this%getMpiCommunicator(), &
                                  this%getProcessRank())
    end subroutine

    @test(npes=[1])
    subroutine test_eq_interpolation(this)
        class(MpiTestMethod), intent(inout) :: this

        class(bsg_interpolation_t), allocatable :: interpolator
        integer :: interp_order, get_interp_order

        interp_order = 4
        allocate(equidistant_interpolation_t :: interpolator)
        call interpolator%initialize(interp_order)
        get_interp_order = interpolator%get_interpolation_order()
        @assertEqual(interp_order, get_interp_order)

        ! test some functions
        call test_func(interpolator)

        ! test coefficients
        call test_coeff(interpolator)

    contains
        subroutine test_func(interp_instance)
            class(bsg_interpolation_t), intent(inout) :: interp_instance

            real(kind=GP), dimension(:), allocatable :: x_array, y_array
            real(kind=GP) :: x_value, y_interp
            real(kind=GP) :: amplitude, mean, std_dev, expected_value
            integer :: x_index
            integer :: start_idx, end_idx, iorder
            real(kind=GP), dimension(:), allocatable :: coeff

            iorder = interp_instance%get_interpolation_order()
            allocate(coeff(iorder+1))
            allocate(x_array(10),y_array(10))

            ! function: y=x
            x_array = linspace(1.0_GP, 10.0_GP, 10, endpoint=.true.)
            y_array = x_array
            x_value = 2.5_GP
            call interp_instance%eval_local_index(x_value, x_array, &
                                                  start_idx, end_idx)
            if (iorder == 4) then
                @assertEqual(start_idx,1)
                @assertEqual(end_idx,5)
            end if
            call interp_instance%eval_coeff(x_array(start_idx:end_idx), coeff)
            call interp_instance%interpolate(x_array(start_idx:end_idx), &
                                             y_array(start_idx:end_idx), &
                                             coeff, &
                                             x_value, &
                                             y_interp)
            @assertEqual(x_value, y_interp, GP_EPS)

            x_value = 1.0_GP
            call interp_instance%eval_local_index(x_value, x_array, &
                                                  start_idx, end_idx)
            if (iorder == 4) then
                @assertEqual(start_idx,1)
                @assertEqual(end_idx,5)
            end if
            call interp_instance%eval_coeff(x_array(start_idx:end_idx), coeff)
            call interp_instance%interpolate(x_array(start_idx:end_idx), &
                                             y_array(start_idx:end_idx), &
                                             coeff, &
                                             x_value, &
                                             y_interp)
            @assertEqual(x_value, y_interp, GP_EPS)

            x_value = 3.9_GP
            call interp_instance%eval_local_index(x_value, x_array, &
                                                  start_idx, end_idx)
            if (iorder == 4) then
                @assertEqual(start_idx,2)
                @assertEqual(end_idx,6)
            end if
            call interp_instance%eval_coeff(x_array(start_idx:end_idx), coeff)
            call interp_instance%interpolate(x_array(start_idx:end_idx), &
                                             y_array(start_idx:end_idx), &
                                             coeff, &
                                             x_value, &
                                             y_interp)
            @assertEqual(x_value, y_interp, 1E-10_GP)

            ! function: y=x^2
            y_array = x_array**2

            x_value = 2.5_GP
            call interp_instance%eval_local_index(x_value, x_array, &
                                                  start_idx, end_idx)
            call interp_instance%eval_coeff(x_array(start_idx:end_idx), coeff)
            call interp_instance%interpolate(x_array(start_idx:end_idx), &
                                             y_array(start_idx:end_idx), &
                                             coeff, &
                                             x_value, &
                                             y_interp)
            @assertEqual(x_value**2, y_interp, 1E-10_GP)

            ! function: y=sin(x)
            x_array = linspace(0.0_GP, 1.0_GP, 10, endpoint=.true.)
            y_array = sin(x_array)

            x_value = 0.5_GP
            call interp_instance%eval_local_index(x_value, x_array, &
                                                  start_idx, end_idx)
            call interp_instance%eval_coeff(x_array(start_idx:end_idx), coeff)
            call interp_instance%interpolate(x_array(start_idx:end_idx), &
                                             y_array(start_idx:end_idx), &
                                             coeff, &
                                             x_value, &
                                             y_interp)
            @assertEqual(y_interp, sin(x_value), 1E-6_GP)

            ! function: y = a * exp(-(x - b)^2 / (2 * c^2))
            amplitude = 1.0_GP
            mean = 0.5_GP
            std_dev = 0.1_GP
            x_array = linspace(0.0_GP, 0.05_GP, 10, endpoint=.true.)
            y_array = amplitude * exp(-(x_array - mean)**2 / (2 * std_dev**2))

            x_value = 0.001_GP
            call interp_instance%eval_local_index(x_value, x_array, &
                                                  start_idx, end_idx)
            call interp_instance%eval_coeff(x_array(start_idx:end_idx), coeff)
            call interp_instance%interpolate(x_array(start_idx:end_idx), &
                                             y_array(start_idx:end_idx), &
                                             coeff, &
                                             x_value, &
                                             y_interp)
            expected_value = amplitude * exp(-(x_value - mean)**2 &
                           / (2 * std_dev**2))
            @assertEqual(expected_value, y_interp, 1E-6_GP)

            ! function: y = amplitude * exp(-(x - mean)^2 / (2 * std_dev^2))
            amplitude = 1.0_GP
            mean = 0.5_GP
            std_dev = 0.1_GP
            x_array = linspace(-3.5_GP, 3.5_GP, 10, endpoint=.true.)
            y_array = amplitude * exp(-(x_array - mean)**2 / (2 * std_dev**2))

            x_value = -1.6_GP
            call interp_instance%eval_local_index(x_value, x_array, &
                                                  start_idx, end_idx)
            call interp_instance%eval_coeff(x_array(start_idx:end_idx), coeff)
            call interp_instance%interpolate(x_array(start_idx:end_idx), &
                                             y_array(start_idx:end_idx), &
                                             coeff, &
                                             x_value, &
                                             y_interp)
            expected_value = amplitude &
                           * exp(-(x_value - mean)**2 / (2 * std_dev**2))
            @assertEqual(expected_value, y_interp, 1E-6_GP)

            deallocate(x_array, y_array, coeff)
        end subroutine

        subroutine test_coeff(interp_instance)
            class(bsg_interpolation_t), intent(inout) :: interp_instance

            real(kind=GP), dimension(:), allocatable :: x_array
            integer :: iorder
            real(kind=GP), dimension(:), allocatable :: coeff, coeff_expected

            iorder = interp_instance%get_interpolation_order()
            allocate(coeff(iorder+1))
            allocate(coeff_expected(iorder+1))
            allocate(x_array(5))
            x_array = [1.0_GP, 2.0_GP, 3.0_GP, 4.0_GP, 5.0_GP]
            call interp_instance%eval_coeff(x_array, coeff)
            if (iorder == 4) then
                coeff_expected = [ 0.04166667_GP, -0.16666667_GP, 0.25_GP, &
                                  -0.16666667_GP,  0.04166667_GP]
                @assertEqual(coeff_expected(1), coeff(1), 1E-6)
                @assertEqual(coeff_expected(2), coeff(2), 1E-6)
                @assertEqual(coeff_expected(5), coeff(5), 1E-6)
            end if
        end subroutine

    end subroutine

end module
