        deallocate(da, da_mold)
    end subroutine

    @test
    subroutine test_data_array_5d()
        !! Tests the bounds and other class members of data_array_5d_t
        type(data_array_5d_t), allocatable :: da, da_mold
        integer, parameter :: array_dim = 5
        real(kind=GP), parameter :: initial_value = 2.71828_GP
        integer :: lb_ref(array_dim), ub_ref(array_dim), shp_ref(array_dim)
        real(kind=GP), dimension(:,:,:,:,:), pointer :: arr_ptr

        lb_ref  = [1, 2, 3, 4, 5]
        ub_ref  = [2, 3, 4, 5, 6]
        shp_ref = (ub_ref - lb_ref) + 1

        allocate(da)
        call da%initialize(lb_ref, ub_ref)

        call assert_data_array_interface(array_dim, lb_ref, ub_ref, da)

        ! Assert array properties from data_array_t array pointer
        arr_ptr => da%get_pointer()
        @assertEqual(shp_ref, shape(arr_ptr))
        @assertEqual(lb_ref, lbound(arr_ptr))
        @assertEqual(ub_ref, ubound(arr_ptr))

        ! NOTE: Stripped pointer is suppose to be same as the standard one here
        arr_ptr => da%get_pointer_stripped()
