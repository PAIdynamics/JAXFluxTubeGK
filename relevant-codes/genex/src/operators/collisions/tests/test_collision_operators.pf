module test_collision_operators
!$  use omp_lib
    use mpi
    use pfunit
    use, intrinsic :: iso_fortran_env
    use genex_fortran_env_m, only: GP
    use genex_error_handling_m, only: handle_error
    use genex_status_codes_m, only: GENEX_ERR_UTESTS
    use logger_m, only: logger_get_debug_channel
    use dcomm_handler_m, only: dcomm_handler_t
    use mesh_5d_m, only: mesh_5d_t
    use data_storage_m, only: data_storage_5d_t, data_storage_cpu_5d_t
    use op_coll_m, only: op_coll_t
    use profile_container_m, only: profile_container_t
    use dist_initial_container_m, only: dist_initial_container_t

    use test_params_m
    use helpers_collision_operators_m

    implicit none

    enum, bind(C)
        !! Enum defining the different types of tests settings
        enumerator :: UNI_SPEC, &   ! Use uniform species settings
                      CONS_ALL, &   ! Check for all conservation
                      CONS_N,   &   ! Check for density conservation
                      CONS_P,   &   ! Check for momentum conservation
                      CONS_E,   &   ! Check for energy conservation
                      H_THM,    &   ! Check for H-theorem (dHdt > 0)
                      DH_0,     &   ! Check for dHdt = 0
                      DF_0,     &   ! Check for dfdt = C_ab(f_a) = 0
                      EQUI,     &   ! Check for equilibrium (dHdt = dfdt = 0)
                      CONVG         ! Check for convergence
    end enum

    @testParameter
    type, extends(mpitestparameter) :: test_params_t
        !! Type describing the parameters for testing collision operators
        character(:), allocatable :: coll_type
        !! Collision type
        character(:), allocatable :: eq_type
        !! Equilibrium type
        character(:), allocatable :: dist_type
        !! Distribution type
        integer, allocatable :: settings(:)
        !! Array of settings enums
    contains
        procedure :: toString
    end type

    @testCase(constructor=new_test_case_t)
    type, extends(mpitestcase) :: test_case_t
        !! Type describing test case for testing collision operators.
        !! See test_params_t for description of parameters
        type(test_params_t) :: params
    contains
        procedure :: setup
        procedure :: teardown
    end type

contains

    subroutine setup(this)
        ! Flush out all the default parameters
        class(test_case_t), intent(inout) :: this
        call setup_test_params(this%getMpiCommunicator(), &
                               this%getProcessRank())
    end subroutine

    subroutine teardown(this)
        ! Read all the default parameters
        class(test_case_t), intent(inout) :: this
        call teardown_test_params(this%getMpiCommunicator(), &
                                  this%getProcessRank())
    end subroutine

    function toString(this) result(string)
        ! Outupts test_params_t as string for logging
        character(:), allocatable :: string
        class(test_params_t), intent(in) :: this
        string = "{" // this%coll_type &
               // "," // this%eq_type &
               // "," // this%dist_type // "}"
    end function

    function new_test_params_t(coll_type, eq_type, dist_type, settings) &
                                                                result(params)
        !! Constructor for test_params_t
        type(test_params_t) :: params
        character(len=*), intent(in) :: coll_type, eq_type, dist_type
        integer, intent(in) :: settings(:)

        params%coll_type = coll_type
        params%eq_type = eq_type
        params%dist_type = dist_type
        params%settings = settings
    end function

    function new_test_case_t(params) result(this)
        !! Constructor for test_case_t
        type(test_case_t), target :: this
        type(test_params_t), intent(in) :: params

        this%params = params
    end function

    subroutine init(this, dcomm_handler, mesh, data_storage, &
                    da_f_in, da_f_out, da_mom)
        !! Initializes dcomm_handler, mesh, and data storage.
        !! Sets initial distribution function based on test_case_t parameters.
        !! Calculates collision operator and its moments.
        class(test_case_t), intent(in) :: this
        type(dcomm_handler_t), allocatable, target, intent(out) :: dcomm_handler
        type(mesh_5d_t), allocatable, intent(out) :: mesh
        type(data_storage_cpu_5d_t), allocatable, intent(out) :: data_storage
        class(data_array_5d_t), pointer, intent(out) :: da_f_in
        class(data_array_5d_t), allocatable, intent(out) :: da_f_out
        class(data_array_4d_t), allocatable, intent(out) :: da_mom

        type(profile_container_t), allocatable :: profile_container(:)
        class(op_coll_t), allocatable :: op_coll
        character(:), allocatable :: coll_type, dist_type, eq_type
        integer :: comm, rank, n_procs, n_sp
        integer, dimension(5) :: lb_stripped, ub_stripped
        logical :: use_uni_spec

        comm = this%getMpiCommunicator()
        rank = this%getProcessRank()
        n_procs = this%getNumProcesses()
        coll_type = this%params%coll_type
        dist_type = this%params%dist_type
        eq_type = this%params%eq_type
        use_uni_spec = any(this%params%settings == UNI_SPEC)

        allocate(dcomm_handler, mesh, data_storage, da_f_out, da_mom)
        call setup_species_params(comm, rank, use_uni_spec)
        call setup_mesh(comm, rank, coll_type, dist_type, eq_type)
        call setup_coll(comm, rank, coll_type, op_coll)
        call setup_dcomm_handler(comm, n_procs, dcomm_handler)
        call mesh%initialize(dcomm_handler)
        call data_storage%initialize(dcomm_handler)
        call op_coll%initialize(dcomm_handler, mesh)
        call setup_profile_container(profile_container)
        call setup_dist_initial(comm, rank, dcomm_handler, mesh, dist_type, &
                                profile_container, data_storage)
        da_f_in => data_storage%get_data_pointer()
        call da_f_in%update_device()

        lb_stripped = da_f_in%get_lbound_stripped()
        ub_stripped = da_f_in%get_ubound_stripped()
        n_sp = mesh%size_sp()

        call da_f_out%initialize(lb_stripped, ub_stripped)
        call calc_coll(dcomm_handler, mesh, op_coll, da_f_in, da_f_out)
        call da_mom%initialize([lb_stripped(1), lb_stripped(2), 1, 1], &
                               [ub_stripped(1), ub_stripped(2), 4, n_sp])
        call calc_mom(dcomm_handler, mesh, da_f_in, da_f_out, da_mom)
    end subroutine

    function get_test_params() result(p)
        class(test_params_t), allocatable :: p(:)
        ! NOTE: 1) Current implementation of LBD does not preserve equilibrium
        !          so we do not test this.
        !       2) LBD test with poly2 fails H-theorem
        integer :: settings1(3), settings2(2), settings3(1)
        settings1 = [CONS_ALL, H_THM, EQUI]
        settings2 = [CONS_ALL, H_THM]
        settings3 = [CONS_ALL]

        p = [new_test_params_t("bgk", "slab", "corr_maxw", settings1), &
             new_test_params_t("bgk", "salpha", "double_maxw", settings1), &
             new_test_params_t("lbd", "slab", "corr_maxw", settings2), &
             new_test_params_t("lbd", "salpha", "double_maxw", settings2), &
             new_test_params_t("lbd", "slab", "poly2", settings3), &
             new_test_params_t("fpl", "slab", "corr_maxw", settings2), &
             new_test_params_t("fpl", "salpha", "bi_maxw", settings2)]
#undef TP
    end function

    @test(npes=[1, 4], testParameters={get_test_params()})
    subroutine test_coll_op(this)
        class(test_case_t), intent(inout) :: this

        type(dcomm_handler_t), allocatable :: dcomm_handler
        type(mesh_5d_t), allocatable :: mesh
        type(data_storage_cpu_5d_t), allocatable :: data_storage

        class(data_array_5d_t), pointer :: da_f_in
        class(data_array_5d_t), allocatable :: da_f_out
        class(data_array_4d_t), allocatable :: da_mom

        real(kind=GP), contiguous, pointer, dimension(:,:,:,:) :: mom
        real(kind=GP), contiguous, pointer, dimension(:,:,:,:,:) :: f_out

        integer :: i, k, l, m, n, n_sp
        integer, dimension(5) :: lb, ub, lb_stripped, ub_stripped
        real(kind=GP) :: dn, dptot, dWtot, dHtot, f_out_
        character(:), allocatable :: coll_type, dist_type, eq_type

        real(kind=GP), parameter :: tol = 10.0_GP * GP_EPS
        !! Tolerance

        coll_type = this%params%coll_type
        dist_type = this%params%dist_type
        eq_type   = this%params%eq_type

        ! We skip testing salpha and dommaschk for lower number of processes
        ! to save time.
        if(this%getNumProcesses() /= 8) then
        if(eq_type == "salpha" .or. eq_type == "dommaschk") then
            if(this%getProcessRank() == 0) &
                write(logger_get_debug_channel(), *) &
                    "Skipped testing " // coll_type // " with " &
                    // dist_type // ", " // eq_type &
                    // " (", this%getNumProcesses(), "procs)"
            return
        end if
        end if

        call init(this, dcomm_handler, mesh, data_storage, &
                  da_f_in, da_f_out, da_mom)

        if(dcomm_handler%is_master()) &
            write(logger_get_debug_channel(), *) &
                "Testing " // coll_type // " collision operator with " &
                // dist_type // ", " // eq_type &
                // " (", this%getNumProcesses(), "procs)"

        lb_stripped = da_f_in%get_lbound_stripped()
        ub_stripped = da_f_in%get_ubound_stripped()
        n_sp        = mesh%size_sp()
        mom         => da_mom%get_pointer()
        f_out       => da_f_out%get_pointer()

        do k = lb_stripped(2), ub_stripped(2)
        do i = lb_stripped(1), ub_stripped(1)
            dptot = 0.0_GP
            dWtot = 0.0_GP
            dHtot = 0.0_GP
            do n = 1, n_sp
                dn = mom(i, k, 1, n)
                dptot = dptot + mom(i, k, 2, n)
                dWtot = dWtot + mom(i, k, 3, n)
                dHtot = dHtot + mom(i, k, 4, n)

                if(any(this%params%settings == CONS_N) .or. &
                   any(this%params%settings == CONS_ALL)) &
                    @assertEqual(0.0_GP, dn, tol, "dndt /= 0")
            end do

            if(any(this%params%settings == CONS_P) .or. &
               any(this%params%settings == CONS_ALL)) &
                @assertEqual(0.0_GP, dptot, tol, "dpdt /= 0")

            if(any(this%params%settings == CONS_E) .or. &
               any(this%params%settings == CONS_ALL)) &
                @assertEqual(0.0_GP, dWtot, tol, "dWdt /= 0")

            if(any(this%params%settings == H_THM)) &
                @assertGreaterThan(dHtot, 0.0_GP, tol, "dHdt < 0")

            if(any(this%params%settings == DH_0)) &
                @assertEqual(0.0_GP, dHtot, tol, "dHdt /= 0")
        end do
        end do

        do n = lb_stripped(5), ub_stripped(5)
        do m = lb_stripped(4), ub_stripped(4)
        do l = lb_stripped(3), ub_stripped(3)
        do k = lb_stripped(2), ub_stripped(2)
        do i = lb_stripped(1), ub_stripped(1)
            f_out_ = f_out(i, k, l, m, n)

            if(any(this%params%settings == DF_0)) &
                @assertEqual(0.0_GP, f_out_, tol, "C_ab(f_a) /= 0")

            if(any(this%params%settings == CONVG)) then
                @assertEqual(f_exp(), f_out_, tol)
            end if
        end do
        end do
        end do
        end do
        end do

    contains

        pure function collog()
            use params_normalization_m, only: get_T_ref, get_n_ref

            real(kind=GP) :: collog
            real(kind=GP) :: sqlambda_D, sqlambda_dB, sqlambda_L

            sqlambda_D  = 5.52049e-5_GP * get_T_ref() / get_n_ref()
            sqlambda_dB = 7.6176e-19_GP / get_T_ref()
            sqlambda_L  = 2.0736e-20_GP / get_T_ref()**2.0_GP
            collog      = 0.5_GP &
                        * log(1.0_GP + sqlambda_D / (sqlambda_dB + sqlambda_L))
        end function

        function f_exp()
            use params_normalization_m, only: get_coll_ref

            real(kind=GP) :: f_exp

            real(kind=GP), contiguous, pointer, dimension(:,:) :: absB
            real(kind=GP), contiguous, pointer, dimension(:) :: vp, mu
            real(kind=GP) :: nu, maxw, coll_ref

            coll_ref = get_coll_ref()
            absB     => mesh%get_absB_pointer()
            vp       => mesh%get_vp_pointer()
            mu       => mesh%get_mu_pointer()

            @assertTrue(.false., "Analytical solution not implemented!")
            f_exp = 0.0_GP
        end function

    end subroutine

end module
