        call op_set_uniform%apply(b_3d, template)
        call op_copy%apply(a_3d, b_3d)
        call copy_array_host_integer(length, a_3d)
        call copy_array_host_integer(length, b_3d)
        @assertEqual(template, a_3d)
        deallocate(a_3d, b_3d)

        allocate(a_4d(n_rz * n_phi, n_vp, n_mu, n_sp))
        allocate(b_4d(n_rz * n_phi, n_vp, n_mu, n_sp))
        call copy_array_device_integer(length, a_4d)
        call copy_array_device_integer(length, b_4d)
        call op_set_uniform%apply(a_4d, 0)
