module test_sheath_operators
    ! Contains unit tests for sheath operators
!$  use omp_lib
    use mpi
    use pfunit
    use, intrinsic :: iso_fortran_env
    use genex_fortran_env_m, only: GP, GP_EPS
    use math_m, only: almost_equal
    use dcomm_handler_m, only: dcomm_handler_t
    use mesh_5d_m, only: mesh_5d_t
    use op_sheath_m, only: op_sheath_t, op_sheath_cpu_t
    use data_storage_m, only: data_storage_cpu_5d_t
    use params_species_m, only: get_charge, get_mass
    ! Unit test helpers
    use test_params_m
    ! From PARALLAX
    use equilibrium_factory_m, only: SLAB

    implicit none

contains

    @before
    subroutine setup(this)
        ! Flush out all the default parameters
        class(MpiTestMethod), intent(inout) :: this
        call setup_test_params(this%getMpiCommunicator(), &
                               this%getProcessRank())
    end subroutine

    @after
    subroutine teardown(this)
        ! Read all the default parameters
        class(MpiTestMethod), intent(inout) :: this
        call teardown_test_params(this%getMpiCommunicator(), &
                                  this%getProcessRank())
    end subroutine

    function test_cutoff_velocity(this, n_vp, comm, n_procs_phi, n_procs_vp, &
                                  n_procs_mu, n_procs_sp, f_ions, &
                                  f_electrons, expected_left, expected_right, &
                                  expected_electron_sheath) &
                                 result (all_fine)
        !! Tests the calculation of the cutoff velocity by the
        !! logical_sheath_t type for different initial electron and ion
        !! distributions
        class (MpiTestMethod), intent(inout) :: this
        !! Instance of the test type
        integer, intent(in) :: n_vp
        !! Number of points in vp direction
        integer, intent(in) :: comm
        !! MPI communicator
        integer, intent(in) :: n_procs_phi, n_procs_vp, n_procs_mu, n_procs_sp
        !! Number of processes
        real(kind = GP), intent(in) :: f_ions
        !! Value for the ion distribution function
        real(kind = GP), intent(in) :: f_electrons
        !! Value for the electron distribution function
        integer, intent(in) :: expected_left
        !! Expected cutoff velocity for the left sheath boundary
        integer, intent(in) :: expected_right
        !! Expected cutoff velocity for the right sheath
        logical, intent(in) :: expected_electron_sheath
        !! .true. if and electron sheath is expected .false. otherwise
        logical :: all_fine
        !! .true. if the cutoff velocity equals the expected values and
        !! .false. otherwise

        type(data_storage_cpu_5d_t), allocatable, target :: dist_func
        type(mesh_5d_t), allocatable, target :: mesh
        type(dcomm_handler_t), allocatable, target :: dcomm_handler
        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        class(op_sheath_t), allocatable :: op_sheath

        integer :: n, i, k, lb_stripped(5), ub_stripped(5), lb(5), ub(5), &
                   n_rz, n_phi, n_mu, n_sp
        integer, allocatable, dimension(:, :) :: cutoff_index
        real(kind = GP), allocatable, dimension(:, :) :: sheath_pot
        real(kind = GP), allocatable, dimension(:, :) :: cutoff_index_fraction
        logical, allocatable, dimension(:, :) :: is_electron_sheath
        integer, pointer, dimension(:, :) :: parcon_positive, parcon_negative
        integer, pointer, dimension(:, :) :: not_in_target
        real(kind = GP), pointer, dimension(:,:,:,:,:) :: dist_func_ptr
        real(kind = GP), pointer, dimension(:) :: vp

        allocate(mesh)
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=SLAB, &
                             spacing_RZ=1.0_GP, &
                             n_points_phi=4, &
                             n_points_vp=n_vp, &
                             n_points_mu=4, &
                             quad_type_vp="trapezoidal")

        allocate(dcomm_handler)
        call dcomm_handler%initialize(comm, n_procs_phi, n_procs_vp, &
                                     n_procs_mu, n_procs_sp)
        dcomm_handler_ptr => dcomm_handler

        call mesh%initialize(dcomm_handler_ptr)

        ! Init dimensions
        n_rz = mesh%size_RZ()
        n_phi = mesh%size_phi()
        n_mu = mesh%size_mu()
        n_sp = mesh%size_sp()

        allocate(dist_func)
        call dist_func%initialize(dcomm_handler_ptr)

        dist_func_ptr => dist_func%get_pointer()
        lb_stripped = dist_func%lbound_stripped()
        ub_stripped = dist_func%ubound_stripped()
        lb = dist_func%lbound()
        ub = dist_func%ubound()

        allocate(cutoff_index(lb(1)          : ub(1), &
                              lb_stripped(2) : ub_stripped(2)))
        allocate(cutoff_index_fraction(lb(1)          : ub(1), &
                                       lb_stripped(2) : ub_stripped(2)))
        allocate(sheath_pot(lb(1)          : ub(1), &
                            lb_stripped(2) : ub_stripped(2)))
        allocate(is_electron_sheath(lb(1)          : ub(1), &
                                    lb_stripped(2) : ub_stripped(2)))

        ! set distribution functions
        do n = lb(5), ub(5)
            if(get_charge(n) == -1) then
                ! electrons
                dist_func_ptr(:,:,:,:,n) = f_electrons
            else
                ! ions
                dist_func_ptr(:,:,:,:,n) = f_ions
            end if
        end do

        ! allocate and update the corresponding sheath
        allocate(op_sheath_cpu_t :: op_sheath)
        call op_sheath%initialize(dcomm_handler_ptr, mesh)
        call op_sheath%apply(lb, ub, lb_stripped, ub_stripped, dist_func_ptr, &
                             is_electron_sheath, cutoff_index, &
                             cutoff_index_fraction, sheath_pot)

        ! retrieve the pointer containing the sheath information
        parcon_positive => mesh%get_parcon_positive1_pointer()
        parcon_negative => mesh%get_parcon_negative1_pointer()
        not_in_target   => mesh%get_not_in_target_pointer()

        ! retrieve mesh information
        vp => mesh%get_vp_pointer()

        ! Check the cutoff_velocity, is_electron_sheath and sheath_pot arrays
        all_fine = .true.
        do k = lb_stripped(2), ub_stripped(2)
            do i = lb(1), ub(1)
                if(is_electron_sheath(i, k) &
                   .neqv. expected_electron_sheath) then
                    ! Check if the sheath is of the correct type
                    all_fine = .false.
                endif
                if(.not. almost_equal(0.0_GP, sheath_pot(i, k), GP_EPS)) then
                    all_fine = .false.
                endif
                if(not_in_target(i, k) == 1) then
                    ! For a point in the domain parcon_positive == 1 if the
                    ! the point is connected to the target via a field line.
                    ! Hence the sheath is in the direction of the connection.
                    if(parcon_positive(i, k) == 1 .and. &
                       parcon_negative(i, k) == 0) then
                        if(cutoff_index(i, k) .ne. expected_right) then
                            all_fine = .false.
                        end if
                    endif
                    if(parcon_positive(i, k) == 0 .and. &
                       parcon_negative(i, k) == 1) then
                        if(cutoff_index(i, k) .ne. expected_left) then
                            all_fine = .false.
                        end if
                    endif
                else
                    ! For a point in the target parcon_positive == 1 if the
                    ! the point is connected to the domain via a field line.
                    ! Hence the sheath is in the opposite direction of the
                    ! connection and the expected values are reversed.
                    if(parcon_positive(i, k) == 1 .and. &
                       parcon_negative(i, k) == 0) then
                        if(cutoff_index(i, k) .ne. expected_left) then
                            all_fine = .false.
                        end if
                    endif
                    if(parcon_positive(i, k) == 0 .and. &
                       parcon_negative(i, k) == 1) then
                        if(cutoff_index(i, k) .ne. expected_right) then
                            all_fine = .false.
                        end if
                    endif
                endif
            end do
        end do

    end function test_cutoff_velocity

    @test(npes = [1])
    subroutine equal_distributions(this)
        !! Tests the calculation of the cutoff velocity and the sheath
        !! potential for the case that the electron distribution function is
        !! exactly equal to the ion distribution function
        class (MpiTestMethod), intent(inout) :: this
        logical :: fine
        real(kind = GP) :: f_ions, f_electrons
        integer :: n_vp, n_vps(4), i

        f_ions = 1.0_GP
        f_electrons = 1.0_GP

        ! even n_vp
        n_vps = [3, 4, 63, 64]
        do i = 1, size(n_vps)
            n_vp = n_vps(i)
            fine = test_cutoff_velocity(this, n_vp, this%getMpiCommunicator(), &
                                        1, 1, 1, 1, f_ions, f_electrons, &
                                        0, 0, .true.)
            @assertTrue(fine)
        enddo
    end subroutine
end module
