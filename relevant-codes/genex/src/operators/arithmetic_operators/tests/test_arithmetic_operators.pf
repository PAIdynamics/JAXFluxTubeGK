    subroutine test_op_copy_logical(template)
        !! Tests the op_copy_cpu_t, op_copy_cpu_t operators
        logical, intent(in) :: template

        class(op_set_uniform_t), allocatable :: op_set_uniform
        class(op_copy_t), allocatable :: op_copy

        integer, parameter :: n_threads = 4
        logical, allocatable, dimension(:) :: a_1d, b_1d
        logical, allocatable, dimension(:, :) :: a_2d, b_2d
        logical, allocatable, dimension(:, :, :) :: a_3d, b_3d
        logical, allocatable, dimension(:, :, :, :) :: a_4d, b_4d
        logical, allocatable, dimension(:, :, :, :, :) :: a_5d, b_5d
        integer(kind=INT64) :: n_rz, n_phi, n_vp, n_mu, n_sp

        !$ call omp_set_dynamic(.true.)
        !$ call omp_set_num_threads(n_threads)
        !$ call omp_set_dynamic(.false.)

        if(get_use_gpu_offload()) then
#ifdef ENABLE_GPU
            allocate(op_set_uniform_gpu_t :: op_set_uniform)
            allocate(op_copy_gpu_t :: op_copy)
#endif
        else
            allocate(op_set_uniform_cpu_t :: op_set_uniform)
            allocate(op_copy_cpu_t :: op_copy)
        endif
        call op_set_uniform%initialize()
        call op_copy%initialize()

        ! allocate input data for the operator
        n_rz = 4
        n_phi = 4
        n_vp = 4
        n_mu = 4
        n_sp = 4

        allocate(a_1d(n_rz * n_phi * n_vp * n_mu * n_sp))
        allocate(b_1d(n_rz * n_phi * n_vp * n_mu * n_sp))
        call op_set_uniform%apply(a_1d, .false.)
        call op_set_uniform%apply(b_1d, template)
        call op_copy%apply(a_1d, b_1d)
        @assertEqual(template, a_1d)
        deallocate(a_1d, b_1d)

        allocate(a_2d(n_rz * n_phi * n_vp * n_mu, n_sp))
        allocate(b_2d(n_rz * n_phi * n_vp * n_mu, n_sp))
        call op_set_uniform%apply(a_2d, .false.)
        call op_set_uniform%apply(b_2d, template)
        call op_copy%apply(a_2d, b_2d)
        @assertEqual(template, a_2d)
        deallocate(a_2d, b_2d)

        allocate(a_3d(n_rz * n_phi * n_vp, n_mu, n_sp))
        allocate(b_3d(n_rz * n_phi * n_vp, n_mu, n_sp))
        call op_set_uniform%apply(a_3d, .false.)
        call op_set_uniform%apply(b_3d, template)
        call op_copy%apply(a_3d, b_3d)
        @assertEqual(template, a_3d)
        deallocate(a_3d, b_3d)

        allocate(a_4d(n_rz * n_phi, n_vp, n_mu, n_sp))
        allocate(b_4d(n_rz * n_phi, n_vp, n_mu, n_sp))
        call op_set_uniform%apply(a_4d, .false.)
        call op_set_uniform%apply(b_4d, template)
        call op_copy%apply(a_4d, b_4d)
        @assertEqual(template, a_4d)
        deallocate(a_4d, b_4d)

        allocate(a_5d(n_rz, n_phi, n_vp, n_mu, n_sp))
        allocate(b_5d(n_rz, n_phi, n_vp, n_mu, n_sp))
        call op_set_uniform%apply(a_5d, .false.)
        call op_set_uniform%apply(b_5d, template)
        call op_copy%apply(a_5d, b_5d)
        @assertEqual(template, a_5d)
        deallocate(a_5d, b_5d)

        deallocate(op_copy, op_set_uniform)

        !$ call omp_set_dynamic(.true.)
        !$ call omp_set_num_threads(1)
        !$ call omp_set_dynamic(.false.)
    end subroutine
