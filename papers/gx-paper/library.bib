@article{Fuchert2020,
  title = {Increasing the density in {{Wendelstein}} 7-{{X}}: {{Benefits}} and limitations},
  author = {Fuchert, G and Brunner, K and Rahbarnia, K and Stange, T and Zhang, D and Baldzuhn, J and Bozhenkov, S and Beidler, C and Beurskens, M and Brezinsek, S and Burhenn, R and Damm, H and Dinklage, A and Feng, Y and Hacker, P and Hirsch, M and Kazakov, Y and Knauer, J and Langenberg, A and Laqua, H and Lazerson, S and Pablant, N and Pasch, E and Reimold, F and Sunn Pedersen, T and Scott, E and Warmer, F and Winters, V and Wolf, R},
