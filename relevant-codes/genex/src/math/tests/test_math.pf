module test_math
    !! Contains test for some routines from math_m
    use funit
    use genex_fortran_env_m, only: GP, GP_EPS
    use math_m

    implicit none

contains

    @test
    subroutine test_random_int()
        ! Nothing to test
        integer :: i
        i = random_int()
        @assertTrue(.true.)
    end subroutine

    @test
    subroutine test_random_real()
        ! Nothing to test
        real(kind=GP) :: r
        r = random_real()
        @assertTrue(.true.)
    end subroutine

    @test
    subroutine test_random_positive_real()
        real(kind=GP) :: r
        r = random_positive_real()
        @assertGreaterThanOrEqual(r,0.0_GP)
    end subroutine

    @test
    subroutine test_almost_equal()
        real(kind=GP) :: a

        a = 2.71828_GP
        @assertTrue(almost_equal(a, a - 1e-3_GP, 1e-2_GP))
        @assertTrue(almost_equal(a, a + 1e-4_GP, 1e-3_GP))
        @assertTrue(almost_equal(a, a - 1e-5_GP, 1e-4_GP))
        @assertTrue(almost_equal(a, a + 1e-6_GP, 1e-5_GP))

        @assertTrue(almost_equal(a + 1e-3_GP, a, 1e-2_GP))
        @assertTrue(almost_equal(a - 1e-4_GP, a, 1e-3_GP))
        @assertTrue(almost_equal(a + 1e-5_GP, a, 1e-4_GP))
        @assertTrue(almost_equal(a - 1e-6_GP, a, 1e-5_GP))

        @assertTrue(.not. almost_equal(a, a + 1e-2_GP, 1e-3_GP))
        @assertTrue(.not. almost_equal(a, a - 1e-3_GP, 1e-4_GP))
        @assertTrue(.not. almost_equal(a, a + 1e-4_GP, 1e-5_GP))
        @assertTrue(.not. almost_equal(a, a - 1e-5_GP, 1e-6_GP))

        @assertTrue(.not. almost_equal(a - 1e-2_GP, a, 1e-3_GP))
        @assertTrue(.not. almost_equal(a + 1e-3_GP, a, 1e-4_GP))
        @assertTrue(.not. almost_equal(a - 1e-4_GP, a, 1e-5_GP))
        @assertTrue(.not. almost_equal(a + 1e-5_GP, a, 1e-6_GP))

    end subroutine

    @test
    subroutine test_kroneckerdelta()
        integer :: a, b

        a = 1
        b = 0
        @assertEqual(krond(a, b), 0.0_GP)
        a = 3
        b = 3
        @assertEqual(krond(a, b), 1.0_GP)
        a = -1
        b = -1
        @assertEqual(krond(a, b), 1.0_GP)

    end subroutine

    @test
    subroutine test_sqrthv()
        real(kind=GP) :: a
        integer :: i

        do i = 1, 100
            call random_number(a)
            a = a - 0.5_GP
            if(a >= 0.0_GP) then
                @assertEqual(sqrthv(a), sqrt(a))
            else
                @assertEqual(sqrthv(a), 0.0_GP)
            endif
        enddo

    end subroutine

end module
