    @test
    subroutine test_neutrals_set_blob()
        !! Tests read and write of the neutrals set blob parameters
        integer, parameter :: n_spec = 1
        type(params_neut_blob_t) :: blob_dens_old, blob_new
        integer :: i
        logical :: equal
        character(len=64) :: fname

        do i = 1, n_spec
            blob_dens_old = get_neut_params_blob_dens(i)

            fname = "test_params_"//trim(get_neut_name(i))//".txt"

            call write_params_neutrals_set_blob(fname, i)
            @assertTrue(file_contains("params_neutrals_blob_dens", fname))
            @assertTrue(file_contains("mean_R", fname))
            @assertTrue(file_contains("mean_Z", fname))
            @assertTrue(file_contains("mean_phi", fname))
            @assertTrue(file_contains("sigma_R", fname))
            @assertTrue(file_contains("sigma_Z", fname))
            @assertTrue(file_contains("sigma_phi", fname))
            @assertTrue(file_contains("strength", fname))
            call read_params_neutrals_set_blob(fname, i)

            write(logger_get_debug_channel(), *) &
                "Test params profile blob dens for "//trim(get_neut_name(i))
            blob_new = get_neut_params_blob_dens(i)
            call compare_blob(blob_dens_old, blob_new)
        end do
    contains
        subroutine compare_blob(blob_old, blob_new)
            type(params_neut_blob_t), intent(in) :: blob_old, &
                                                    blob_new

            equal = almost_equal(blob_old%mean_R, blob_new%mean_R, GP_EPS)
            @assertTrue(equal)
            equal = almost_equal(blob_old%mean_Z, blob_new%mean_Z, GP_EPS)
            @assertTrue(equal)
            equal = almost_equal(blob_old%mean_phi, blob_new%mean_phi, GP_EPS)
            @assertTrue(equal)
            equal = almost_equal(blob_old%sigma_R, blob_new%sigma_R, GP_EPS)
            @assertTrue(equal)
            equal = almost_equal(blob_old%sigma_Z, blob_new%sigma_Z, GP_EPS)
            @assertTrue(equal)
            equal = almost_equal(blob_old%sigma_phi, blob_new%sigma_phi, GP_EPS)
            @assertTrue(equal)
            equal = almost_equal(blob_old%strength, blob_new%strength, GP_EPS)
            @assertTrue(equal)
        end subroutine
    end subroutine

    @test
    subroutine test_profile_uniform_parameters()
        !! Tests read and write of the profile uniform (neutrals) parameters
        integer, parameter :: n_spec = 1
