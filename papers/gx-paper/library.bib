@article{Kuang2020,
  title = {Divertor heat flux challenge and mitigation in {{SPARC}}},
  author = {Kuang, A and Ballinger, S and Brunner, D and Canik, J and Creely, A and Gray, T and Greenwald, M and Hughes, J and Irby, J and Labombard, B and Lipschultz, B and Lore, J and Reinke, M and Terry, J and Umansky, M and Whyte, D and Wukitch, S},
