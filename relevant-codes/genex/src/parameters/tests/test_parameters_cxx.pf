module test_parameters_cxx
    !! Contains test for the parameters on C++ layers
    use funit
    use, intrinsic :: iso_c_binding, only: C_CHAR
    use genex_fortran_env_m, only: GP, GP_EPS
    use logger_m, only: logger_get_debug_channel
    use file_handling_m, only: delete_file_if_exists
    use type_converters_m, only: string_c2f

    use error_params_m
    use interop_params_m
    use params_m
    use params_collisions_m
    use params_gyrokinetic_system_m
    use params_gpu_offload_m
    use params_normalization_m
    use params_numerical_scheme_m
    use params_devtools_m
    use params_species_m
    use helpers_parameters_m

    implicit none

    character(len=*), parameter :: filename = "test_params.txt"
    !! Filename for testing the parameter read and write
contains

    @before
    subroutine setup
        ! Delete filenames if exist.
        integer :: n,iunit
        integer, parameter :: n_spec = 2
        character(len=64) :: fname

        ! Make sure file does not exist
        call delete_file_if_exists(filename)

        do n = 1, n_spec
            fname = "test_params_"//trim(get_name(n))//".txt"
            call delete_file_if_exists(fname)
        enddo

        ! Set the unit tests to run partially on the C++ layer
        open(newunit=iunit, file=filename, action='write', status="replace")
        write(iunit, *) "&params_gpu_offload"
        write(iunit, *) "use_gpu_offload =", .true., ","
        write(iunit, *) "/"
        close(iunit)
        call read_params_gpu_offload(filename)
        call delete_file_if_exists(filename)
    end subroutine

    @after
    subroutine teardown
        ! Teardown test
        integer :: iunit

        ! Reset the unit tests to run fully on the Fortran layer
        open(newunit=iunit, file=filename, action='write', status="replace")
        write(iunit, *) "&params_gpu_offload"
        write(iunit, *) "use_gpu_offload =", .false., ","
        write(iunit, *) "/"
        close(iunit)
        call read_params_gpu_offload(filename)
        call delete_file_if_exists(filename)
    end subroutine

    @test
    subroutine test_collision_parameters_cxx()
        !! Tests read and write of the collision parameters
        real(kind=GP) :: dens_floor, temp_floor
        character(len=16) :: coll_type, relx_type
        real(kind=GP), dimension(2) :: params_scalar
        character(len=16) :: coll_type_f, relx_type_f
        character(len=1, kind=C_CHAR), dimension(5) :: coll_type_c, relx_type_c

        coll_type  = get_coll_type()
        relx_type  = get_relx_type()
        dens_floor = get_dens_floor()
        temp_floor = get_temp_floor()
        call write_params_collisions(filename)
        call read_params_collisions(filename)

        call cbind_get_params_collisions(params_scalar, coll_type_c, &
                                         relx_type_c)

        call string_c2f(coll_type_c, coll_type_f)
        call string_c2f(relx_type_c, relx_type_f)

        @assertEqual(coll_type, coll_type_f)
        @assertEqual(relx_type, relx_type_f)
        @assertEqual(dens_floor, params_scalar(1))
        @assertEqual(temp_floor, params_scalar(2))
    end subroutine

    @test
    subroutine test_devtools_parameters_cxx()
        !! Tests read and write of the developer tool parameters
        integer :: isolate_tsync, trace_dmem
        integer, dimension(2) :: params_scalar

        isolate_tsync = merge(1, 0, get_isolate_tsync())
        trace_dmem    = merge(1, 0, get_trace_device_memory())

        call write_params_devtools(filename)
        call read_params_devtools(filename)

        call cbind_get_params_devtools(params_scalar)

        @assertEqual(isolate_tsync, params_scalar(1))
        @assertEqual(trace_dmem, params_scalar(2))
    end subroutine

    @test
    subroutine test_gyrokinetic_system_parameters_cxx()
        !! Tests read and write of the gyrokinetic system parameters
        integer :: with_rhs, with_em_flutter, with_nlin_polarization, with_bpar
        integer, dimension(4) :: params_scalar

        with_rhs               = merge(1, 0, get_with_rhs())
        with_em_flutter        = merge(1, 0, get_with_em_flutter())
        with_nlin_polarization = merge(1, 0, get_with_nlin_polarization())
        with_bpar              = merge(1, 0, get_with_bpar())

        call write_params_gyrokinetic_system(filename)
        call read_params_gyrokinetic_system(filename)

        call cbind_get_params_gyrokinetic_system(params_scalar)

        @assertEqual(with_rhs, params_scalar(1))
        @assertEqual(with_em_flutter, params_scalar(2))
        @assertEqual(with_nlin_polarization, params_scalar(3))
        @assertEqual(with_bpar, params_scalar(4))

    end subroutine

    @test
    subroutine test_gpu_offload_parameters_cxx()
        !! Tests the GPU offloading parameters on C++
        integer :: gx_backend, px_backend, use_gx_offload, &
                   use_px_offload, use_px_data, swap, align
        type(params_gpu_offload_data_t) :: params_data

        use_gx_offload  = merge(1, 0, get_use_gpu_offload())
        use_px_offload  = merge(1, 0, get_use_parallax_gpu_offload())
        use_px_data     = merge(1, 0, get_use_parallax_gpu_data_explicit())
        gx_backend      = get_gpu_offload_backend()
        px_backend      = get_parallax_gpu_offload_backend()
        swap            = merge(1, 0, get_swap_mesh_members())
        align           = get_array_alignment()
        call write_params_gpu_offload(filename)
        call read_params_gpu_offload(filename)

        call cbind_get_params_gpu_offload(params_data)

        @assertEqual(use_gx_offload, params_data%use_gpu_offload)
        @assertEqual(use_px_offload, params_data%use_parallax_gpu_offload)
        @assertEqual(use_px_data, params_data%use_parallax_gpu_data_explicit)
        @assertEqual(gx_backend, params_data%gpu_offload_backend)
        @assertEqual(px_backend, params_data%parallax_gpu_offload_backend)
        @assertEqual(swap, params_data%swap_mesh_members)
        @assertEqual(align, params_data%large_array_alignment)
    end subroutine

    @test
    subroutine test_normalization_parameters_cxx()
        !! Tests the normalization parameters on C++
        real(kind=GP) :: m_ref, T_ref, n_ref, L_ref, B_ref
        real(kind=GP) :: rho_ref, c_ref, coll_ref, beta_ref
        type(params_normalization_data_t) :: params_data

        m_ref = get_m_ref()
        T_ref = get_T_ref()
        n_ref = get_n_ref()
        L_ref = get_L_ref()
        B_ref = get_B_ref()
        rho_ref  = get_rho_ref()
        c_ref    = get_c_ref()
        coll_ref = get_coll_ref()
        beta_ref = get_beta_ref()
        call write_params_normalization(filename)
        call read_params_normalization(filename)

        call cbind_get_params_normalization(params_data)

        @assertEqual(m_ref, params_data%m_ref, 100.0_GP*GP_EPS)
        @assertEqual(T_ref, params_data%T_ref, 100.0_GP*GP_EPS)
        @assertEqual(n_ref, params_data%n_ref, 100.0_GP*GP_EPS)
        @assertEqual(L_ref, params_data%L_ref, 100.0_GP*GP_EPS)
        @assertEqual(B_ref, params_data%B_ref, 100.0_GP*GP_EPS)
        @assertEqual(1.0_GP, params_data%c_ref / c_ref, 100.0_GP*GP_EPS)
        @assertEqual(rho_ref, params_data%rho_ref, 100.0_GP*GP_EPS)
        @assertEqual(coll_ref, params_data%coll_ref, 100.0_GP*GP_EPS)
        @assertEqual(beta_ref, params_data%beta_ref, 100.0_GP*GP_EPS)
    end subroutine

    @test
    subroutine test_numerical_scheme_parameters_cxx()
        !! Tests the numerical_scheme parameters on C++
        integer :: int_order, buf_zone_size, buf_zone_size_axis
        real(kind=GP) :: hyp_y, hyp_xz, hyp_vp, buf_zone_strength, &
                         buf_zone_strength_axis
        type(params_numerical_scheme_data_t) :: params_data

        int_order = get_int_order()
        hyp_y  = get_hyp_y()
        hyp_xz = get_hyp_xz()
        hyp_vp = get_hyp_vp()
        buf_zone_size = get_buf_zone_size()
        buf_zone_strength = get_buf_zone_strength()
        buf_zone_size_axis = get_buf_zone_size_axis()
        buf_zone_strength_axis = get_buf_zone_strength_axis()
        call write_params_numerical_scheme(filename)
        call read_params_numerical_scheme(filename)

        call cbind_get_params_numerical_scheme(params_data)

        @assertEqual(int_order, params_data%int_order)
        @assertEqual(hyp_y, params_data%hyp_y)
        @assertEqual(hyp_xz, params_data%hyp_xz)
        @assertEqual(hyp_vp, params_data%hyp_vp)
        @assertEqual(buf_zone_size, params_data%buf_zone_size)
        @assertEqual(buf_zone_strength, params_data%buf_zone_strength)
        @assertEqual(buf_zone_size_axis, params_data%buf_zone_size_axis)
        @assertEqual(buf_zone_strength_axis, params_data%buf_zone_strength_axis)
    end subroutine

    @test
    subroutine test_species_parameters_cxx()
        !! Tests the species parameters on C++ layer
        integer, parameter :: n_spec = 2
        integer, dimension(1) :: electron_id_tgt
        real(kind=GP), dimension(n_spec) :: masses, charges, temp_scalings, &
                                            masses_tgt, charges_tgt, &
                                            temp_scalings_tgt
        character(len=24), dimension(n_spec) :: names
        integer :: n

        do n = 1, n_spec
            masses(n)        = get_mass(n)
            charges(n)       = get_charge(n)
            temp_scalings(n) = get_temp_scaling(n)
            names(n)         = get_name(n)
        enddo
        call write_params_species(filename)
        call read_params_species(filename)

        call cbind_get_params_species(n_spec, electron_id_tgt, &
                                      masses_tgt, charges_tgt, &
                                      temp_scalings_tgt)

        do n = 1, n_spec
            write(logger_get_debug_channel(), *) &
                "Test C++ params species for "//trim(get_name(n))
            @assertEqual(masses(n), masses_tgt(n))
            @assertEqual(charges(n), charges_tgt(n))
            @assertEqual(temp_scalings(n), temp_scalings_tgt(n))

            ! Assert C++ get_is_electron()
            if(names(n) == "electrons") then
                @assertEqual(n, electron_id_tgt(1))
            endif
        enddo
    end subroutine

end module
