module test_system_calls
    !! Contains tests for system calls
    use funit
    use logger_m, only: logger_get_info_channel
    use type_converters_m, only: string
    use system_calls_m, only: mkdir, rm_rf
    use genex_status_codes_m, only: GENEX_SUCCESS, GENEX_ERR_SYSTEM_CALL
    implicit none

contains

    @test
    subroutine test_mkdir()
        character(len=:), allocatable :: name1, name2
        integer :: ierr, istat

        name1 = "test1"
        name2 = "test2"

        ! To make sure check that those paths do not exist
        call execute_command_line("rm -rf "//name1)
        call execute_command_line("rm -rf "//name2)

        call mkdir(name1, ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        ! Check directory for existence
        call execute_command_line("[ -d "//name1//" ]", exitstat=istat)
        @assertTrue(istat == 0)

        call mkdir(name2, ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call execute_command_line("[ -d "//name2//" ]", exitstat=istat)
        @assertTrue(istat == 0)

        ! Print out a message to not confuse the messages of the tested errors
        ! with actual errors in the test.
        write(logger_get_info_channel(),*) &
                "Test mkdir errors. Error messages will be triggered..."

        ! Check for error when trying to create existing directory
        call mkdir(name2, ierr)
        @assertEqual(ierr, GENEX_ERR_SYSTEM_CALL)
        ! Check for error when trying to create directory in non-existent
        call mkdir("non-existent/test", ierr)
        @assertEqual(ierr, GENEX_ERR_SYSTEM_CALL)

        ! Check for no error when trying to create existing directory
        call mkdir(name2, ierr, parents=.true.)
        @assertEqual(ierr, GENEX_SUCCESS)
        ! Check for no error when trying to create directory in non-existent
        call mkdir("non-existent/test", ierr, parents=.true.)
        @assertEqual(ierr, GENEX_SUCCESS)
        call execute_command_line("[ -d non-existent/test ]", exitstat=istat)
        @assertTrue(istat == 0)

        call execute_command_line("rm -rf "//name1)
        call execute_command_line("rm -rf "//name2)
        call execute_command_line("rm -rf non-existent/test")
    end subroutine

    @test
    subroutine test_rm_rf()
        character(len=:), allocatable :: name1
        integer :: ierr, istat

        name1 = "test3"

        ! Prepare directory for deletion
        call execute_command_line("rm -rf "//name1)
        call execute_command_line("mkdir "//name1)
        call execute_command_line("[ -d "//name1//" ]", exitstat=istat)
        @assertTrue(istat == 0)

        call rm_rf(name1, ierr)
        @assertEqual(ierr, GENEX_SUCCESS)
        call execute_command_line("[ -d "//name1//" ]", exitstat=istat)
        @assertTrue(istat /= 0)

        ! Check non existent. Should not trigger an error.
        call rm_rf("non-existent/", ierr)
        @assertEqual(ierr, GENEX_SUCCESS)

        call execute_command_line("rm -rf "//name1)

    end subroutine

end module
