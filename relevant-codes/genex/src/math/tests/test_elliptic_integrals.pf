module test_elliptic_integrals
    !! Contains test for elliptic integrals
    use funit
    use genex_fortran_env_m, only: GP, GP_EPS, DP
    use elliptic_integrals_m, only: carlson_Rf, carlson_Rd, &
                                    fukushima_ceik, fukushima_ceie
    use type_converters_m, only: string
    use genex_error_handling_m, only: handle_error
    use genex_status_codes_m, only: GENEX_ERR_MATH

contains

    @test
    subroutine test_carlson_Rf()
        !! Tests Carlson symmetric elliptic integral of the first kind Rf
        integer, parameter :: nchecks = 100
        real(kind=GP), parameter :: tol = 10.0_GP * GP_EPS
        integer :: i
        real(kind=GP) :: x, y, mu, lambda
        real(kind=GP) :: res, expected, k

        ! Tests from Carlson 1994 paper
        expected = 1.3110287771461_GP
        res = carlson_Rf(1.0_GP, 2.0_GP, 0.0_GP)
        @assertEqual(res, expected, 1e-13_GP)
        expected = 0.58408284167715_GP
        res = carlson_Rf(2.0_GP, 3.0_GP, 4.0_GP)
        @assertEqual(res, expected, 1e-14_GP)

        ! Check symmetries for first value
        expected = 1.3110287771461_GP
        res = carlson_Rf(0.0_GP, 1.0_GP, 2.0_GP)
        @assertEqual(res, expected, 1e-13_GP)
        res = carlson_Rf(2.0_GP, 0.0_GP, 1.0_GP)
        @assertEqual(res, expected, 1e-13_GP)
        res = carlson_Rf(2.0_GP, 1.0_GP, 0.0_GP)
        @assertEqual(res, expected, 1e-13_GP)
        res = carlson_Rf(0.0_GP, 2.0_GP, 1.0_GP)
        @assertEqual(res, expected, 1e-13_GP)
        res = carlson_Rf(1.0_GP, 0.0_GP, 2.0_GP)
        @assertEqual(res, expected, 1e-13_GP)

        ! Check special values
        expected = 1.0_GP
        res = carlson_Rf(1.0_GP, 1.0_GP, 1.0_GP)
        @assertEqual(res, expected, tol)
        expected = 2.0_GP
        res = carlson_Rf(0.25_GP, 0.25_GP, 0.25_GP)
        @assertEqual(res, expected, tol)

        ! Check against values from python mpmath
        expected = 1.34839972492648411805573_GP
        res = carlson_Rf(0.55_GP, 0.55_GP, 0.55_GP) ! Same arguments check
        @assertEqual(res, expected, tol)
        expected = 1.485135463484458548688347_GP
        res = carlson_Rf(0.55_GP, 0.95_GP, 0.1115_GP)
        @assertEqual(res, expected, tol)
        expected = 1.58601080914647869025801_GP
        res = carlson_Rf(0.123_GP, 0.456_GP, 0.789_GP)
        @assertEqual(res, expected, tol)

        ! Check consistency by following relation
        do i = 1, nchecks
            call random_number(x)
            call random_number(y)
            call random_number(lambda)
            mu = x * y / lambda
            expected = carlson_Rf(x, y, 0.0_GP)
            res      = carlson_Rf(x + lambda, y + lambda, lambda) &
                     + carlson_Rf(x + mu, y + mu, mu)
            ! Random numbers may introduce arguments where Carlson Rf will
            ! give large values. In that case use relative error and higher
            ! tolerance.
            if(expected > 1.0_GP) then
                @assertEqual((res - expected) / expected, 0.0_GP, 10.0_GP*tol)
            else
                @assertEqual(res, expected, tol)
            endif
        enddo

        ! Check against values of Legendre elliptic integral K(k)
        ! Relation: K(k) = Rf(0, 1 - k**2, 1)
        k = 0.5_GP
        expected = 1.685750354812596042871_GP
        res = carlson_Rf(0.0_GP, 1.0_GP - k**2, 1.0_GP)
        @assertEqual(res, expected, tol)
        k = 0.1_GP
        expected = 1.574745561517355952669_GP
        res = carlson_Rf(0.0_GP, 1.0_GP - k**2, 1.0_GP)
        @assertEqual(res, expected, tol)
        k = 0.577215664901532_GP
        expected = 1.733820958045546709589_GP
        res = carlson_Rf(0.0_GP, 1.0_GP - k**2, 1.0_GP)
        @assertEqual(res, expected, tol)
        k = 0.0_GP
        expected = 1.570796326794896619231_GP
        res = carlson_Rf(0.0_GP, 1.0_GP - k**2, 1.0_GP)
        @assertEqual(res, expected, tol)

    end subroutine

    @test
    subroutine test_carlson_Rd()
        !! Tests Carlson symmetric elliptic integral of the second kind Rd
        integer, parameter :: nchecks = 100
        real(kind=GP), parameter :: tol = 10.0_GP * GP_EPS
        integer :: i
        real(kind=GP) :: x, y, mu, lambda
        real(kind=GP) :: res, expected, k, karg

        ! Tests from Carlson 1994 paper
        expected = 1.7972103521034_GP
        res = carlson_Rd(0.0_GP, 2.0_GP, 1.0_GP)
        @assertEqual(res, expected, 1e-13_GP)
        expected = 0.16510527294261_GP
        res = carlson_Rd(2.0_GP, 3.0_GP, 4.0_GP)
        @assertEqual(res, expected, 1e-14_GP)

        ! Check symmetries for first value
        expected = 1.7972103521034_GP
        res = carlson_Rd(2.0_GP, 0.0_GP, 1.0_GP)
        @assertEqual(res, expected, 1e-13_GP)

        ! Check special values
        expected = 1.0_GP
        res = carlson_Rd(1.0_GP, 1.0_GP, 1.0_GP)
        @assertEqual(res, expected, tol)
        expected = 8.0_GP
        res = carlson_Rd(0.25_GP, 0.25_GP, 0.25_GP)
        @assertEqual(res, expected, tol)

        ! Check against values from python mpmath
        expected = 2.828427124746190097603377_GP
        res = carlson_Rd(0.5_GP, 0.5_GP, 0.5_GP) ! Same arguments check
        @assertEqual(res, expected, tol)
        expected = 4.941391740058040912518415_GP
        res = carlson_Rd(0.125_GP, 0.25_GP, 0.5_GP)
        @assertEqual(res, expected, tol)
        expected = 3.028537346149067114919924_GP
        res = carlson_Rd(0.987_GP, 0.654_GP, 0.321_GP)
        @assertEqual(res, expected, tol)

        ! Check consistency by following relations
        do i = 1, nchecks
            call random_number(x)
            call random_number(y)
            call random_number(lambda)
            mu = x * y / lambda

            expected = carlson_Rd(0.0_GP, x, y) &
                     - 3.0_GP / (y * sqrt(x + y + mu + lambda))
            res      = carlson_Rd(lambda, x + lambda, y + lambda) &
                     + carlson_Rd(mu, x + mu, y + mu)
            ! Random numbers may introduce arguments where Carlson Rd will
            ! give large values. In that case use relative error and higher
            ! tolerance.
            if(expected > 1.0_GP) then
                @assertEqual((res - expected) / expected, 0.0_GP, 10.0_GP*tol)
            else
                @assertEqual(res, expected, tol)
            endif

            expected = 3.0_GP / sqrt(x * y * lambda)
            res      = carlson_Rd(x, y, lambda) &
                     + carlson_Rd(y, lambda, x) &
                     + carlson_Rd(lambda, x, y)
            if(expected > 1.0_GP) then
                @assertEqual((res - expected) / expected, 0.0_GP, 10.0_GP*tol)
            else
                @assertEqual(res, expected, tol)
            endif
        enddo

        ! Check against values of Legendre elliptic integral E(k)
        ! Relation: E(k) = (1 - k**2) / 3
        !                * (Rd(0, 1 - k**2, 1) + Rd(0, 1, 1 - k**2))
        k = 0.5_GP
        karg = 1.0_GP - k**2
        expected = 1.46746220933942715546_GP
        res = karg / 3.0_GP * ( carlson_Rd(0.0_GP, karg, 1.0_GP) &
                              + carlson_Rd(0.0_GP, 1.0_GP, karg))
        @assertEqual(res, expected, tol)
        k    = 0.1_GP
        karg = 1.0_GP - k**2
        expected = 1.566861942021668291221_GP
        res = karg / 3.0_GP * ( carlson_Rd(0.0_GP, karg, 1.0_GP) &
                              + carlson_Rd(0.0_GP, 1.0_GP, karg))
        @assertEqual(res, expected, tol)
        k = 0.577215664901532_GP
        karg = 1.0_GP - k**2
        expected = 1.430386028116749916789_GP
        res = karg / 3.0_GP * ( carlson_Rd(0.0_GP, karg, 1.0_GP) &
                              + carlson_Rd(0.0_GP, 1.0_GP, karg))
        @assertEqual(res, expected, tol)
        k = 0.0_GP
        karg = 1.0_GP - k**2
        expected = 1.570796326794896619231_GP
        res = karg / 3.0_GP * ( carlson_Rd(0.0_GP, karg, 1.0_GP) &
                              + carlson_Rd(0.0_GP, 1.0_GP, karg))
        @assertEqual(res, expected, tol)

        ! Check against values of Legendre elliptic integral E(k) and K(k)
        ! Relation: K(k) - E(k) = k**2 / 3 * Rd(0, 1 - k**2, 1)
        k = 0.75_GP
        expected = 1.910989780751829196553_GP - 1.318472107994620997372_GP
        res = k**2 / 3.0_GP * carlson_Rd(0.0_GP, 1.0_GP - k**2, 1.0_GP)
        @assertEqual(res, expected, tol)
        k = 0.1487_GP
        expected = 1.579589254756173652204_GP - 1.562076750482510789142_GP
        res = k**2 / 3.0_GP * carlson_Rd(0.0_GP, 1.0_GP - k**2, 1.0_GP)
        @assertEqual(res, expected, tol)

        ! Check against values of Legendre elliptic integral E(k) and K(k)
        ! Relation: E(k) - (1 - k**2) * K(k) = k**2 * (1 - k**2) / 3
        !                                    * Rd(0, 1, 1 - k**2)
        k    = 0.3231_GP
        karg = k**2 * (1.0_GP - k**2) / 3.0_GP
        expected = 1.528961581010808809524_GP &
                 - (1.0_GP - k**2) * 1.614388662148905080071_GP
        res = karg * carlson_Rd(0.0_GP, 1.0_GP, 1.0_GP - k**2)
        @assertEqual(res, expected, tol)
        k    = 0.7071067811865475244008_GP
        karg = k**2 * (1.0_GP - k**2) / 3.0_GP
        expected = 1.35064388104767550252_GP &
                 - (1.0_GP - k**2) * 1.854074677301371918434_GP
        res = karg * carlson_Rd(0.0_GP, 1.0_GP, 1.0_GP - k**2)
        @assertEqual(res, expected, tol)
    end subroutine

    @test
    subroutine test_carlson_relations()
        !! Tests Carlson symmetric elliptic integral relations between
        !! the different kinds of integrals
        real(kind=GP), parameter :: tol = 10.0_GP * GP_EPS
        real(kind=GP) :: res, expected, k

        ! Check against values of Legendre elliptic integral E(k)
        ! Relation: E(k) = Rf(O, 1 - k**2, 1) - k**2 / 3 * Rd(0, 1 - k**2, 1)
        k = 0.3678794411714423215955_GP
        expected = 1.516219480138089831237_GP
        res = carlson_Rf(0.0_GP, 1.0_GP - k**2, 1.0_GP) &
            - k**2 / 3.0_GP * carlson_Rd(0.0_GP, 1.0_GP - k**2, 1.0_GP)
        @assertEqual(res, expected, tol)
        k = 0.6931471805599453094172_GP
        expected = 1.360419762095350537335_GP
        res = carlson_Rf(0.0_GP, 1.0_GP - k**2, 1.0_GP) &
            - k**2 / 3.0_GP * carlson_Rd(0.0_GP, 1.0_GP - k**2, 1.0_GP)
        @assertEqual(res, expected, tol)

        ! Check against k=0 where Legendre elliptic integrals E(k) = K(k),
        ! thus Rf(0, 1, 1) = 2 / 3 * Rd(0, 1, 1)
        expected = carlson_Rf(0.0_GP, 1.0_GP, 1.0_GP)
        res = (2.0_GP / 3.0_GP) * carlson_Rd(0.0_GP, 1.0_GP, 1.0_GP)
        @assertEqual(res, expected, tol)
    end subroutine

    @test
    subroutine test_fukushima_ceik()
        !! Tests Fukushima elliptic integral of the first kind ceik
        real(kind=GP), parameter :: tol = 10.0_GP * GP_EPS
        real(kind=GP) :: res, expected, k

        ! Check against values of Legendre elliptic integral K(k)
        k = 0.5_GP
        expected = 1.685750354812596042871_GP
        res = fukushima_ceik(k**2)
        @assertEqual(res, expected, tol)
        k = 0.1_GP
        expected = 1.574745561517355952669_GP
        res = fukushima_ceik(k**2)
        @assertEqual(res, expected, tol)
        k = 0.577215664901532_GP
        expected = 1.733820958045546709589_GP
        res = fukushima_ceik(k**2)
        @assertEqual(res, expected, tol)
        k = 0.0_GP
        expected = 1.570796326794896619231_GP
        res = fukushima_ceik(k**2)
        @assertEqual(res, expected, tol)

        k = 0.26711910179315699474208331_GP
        expected = 1.6_GP
        res = fukushima_ceik(k**2)
        @assertEqual(res, expected, tol)
        k = 0.80240651738863303356974450_GP
        expected = 2.0_GP
        res = fukushima_ceik(k**2)
        @assertEqual(res, expected, tol)
        k = 0.97910484436276714560532353_GP
        expected = 3.0_GP
        res = fukushima_ceik(k**2)
        @assertEqual(res, expected, tol)
    end subroutine

    @test
    subroutine test_fukushima_ceie()
        !! Tests Fukushima elliptic integral of the second kind ceie
        real(kind=GP), parameter :: tol = 10.0_GP * GP_EPS
        real(kind=GP) :: res, expected, k

        ! Check against values of Legendre elliptic integral E(k)
        k = 0.5_GP
        expected = 1.46746220933942715546_GP
        res = fukushima_ceie(k**2)
        @assertEqual(res, expected, tol)
        k = 0.1_GP
        expected = 1.566861942021668291221_GP
        res = fukushima_ceie(k**2)
        @assertEqual(res, expected, tol)
        k = 0.577215664901532_GP
        expected = 1.430386028116749916789_GP
        res = fukushima_ceie(k**2)
        @assertEqual(res, expected, tol)
        k = 0.0_GP
        expected = 1.570796326794896619231_GP
        res = fukushima_ceie(k**2)
        @assertEqual(res, expected, tol)

        k = 0.41729943021563739450495905_GP
        expected = 1.5_GP
        res = fukushima_ceie(k**2)
        @assertEqual(res, expected, tol)
        k = 0.82819674021402467816076738_GP
        expected = 1.25_GP
        res = fukushima_ceie(k**2)
        @assertEqual(res, expected, tol)
        k = 0.94941341995269411826127507_GP
        expected = 3.0_GP / exp(1.0_GP)
        res = fukushima_ceie(k**2)
        @assertEqual(res, expected, tol)
    end subroutine

    @test
    subroutine test_fukushima_relations()
        !! Tests Fukushima elliptic integral relations against associated
        !! functions ceib and ceid
        real(kind=GP), parameter :: tol = 10.0_GP * GP_EPS
        real(kind=GP) :: res, expected, k

        integer, parameter :: nchecks = 100
        integer :: i
        real(kind=GP) :: K_m, E_m, m

        do i = 1, nchecks
            call random_number(k)
            m = k**2

            ! If m is very small the error could be quite large due to division
            if (m < 1e-8_GP) m = m + 1e-8_GP

            K_m = fukushima_ceik(m)
            E_m = fukushima_ceie(m)

            ! Check against B(m) = (E(m) - (1 - m) K(m)) / m
            ! NOTE: It is numerically better to not compare B(m) but the
            !       following linear combinations since these avoid subtration
            res = E_m
            expected = fukushima_ceib(m) * m + (1.0_GP - m) * K_m
            ! NOTE: B(m) should be smaller than (or equal to) 1.
            if(expected > 1.0_GP) then
                res = (res - expected) / expected
                @assertEqual(res, 0.0_GP, 10.0_GP * tol)
            else
                @assertEqual(res, expected, tol)
            endif

            ! Check against D(m) = (K(m) - E(m)) / m
            res = K_m
            expected = m * fukushima_ceid(m) + E_m
            ! Random numbers may introduce arguments where D(m) will
            ! give large values. In that case use relative error and higher
            ! tolerance.
            if(expected > 1.0_GP) then
                res = (res - expected) / expected
                @assertEqual(res, 0.0_GP, 10.0_GP * tol)
            else
                @assertEqual(res, expected, tol)
            endif
        enddo
    end subroutine

    function fukushima_ceib(m_arg) result(res)
        ! Double precision minimax rational approximation of
        ! B(m) = (E(m) - (1 - m) K(m)) / m,
        ! the first associate complete elliptic integral of the second kind
        !
        ! Author: Toshio Fukushima <Toshio.Fukushima@nao.ac.jp>
        !
        ! Reference: Fukushima (2015) J. Comp. Appl. Math., 282:71--76
        ! "Precise and fast computation of complete elliptic integrals
        !  by piecewise minimax rational function approximation"
        ! https://doi.org/10.1016/j.cam.2014.12.038
        real(kind=GP) :: m_arg
        real(kind=GP) :: res
        real(kind=DP) :: mc, ceib, t, t2

        mc = 1.0_DP - m_arg

        if(mc > 1.0_DP) then
            call handle_error("Fukushima ceib encountered negative values &
                              &for argument m! (was "//string(m_arg, 10)//")", &
                              GENEX_ERR_MATH, __LINE__, __FILE__)

        elseif(mc > 0.555073_DP) then
            t = 2.24755971204264969_DP * mc - 1.24755971204264969_DP
            t2 = t * t
            ceib = ((2030.25011505956379_DP &
                 + t2 * (1727.60635612511943_DP &
                 + t2 * 25.0715510300422010_DP)) &
                 + t * (3223.16236100954529_DP &
                 + t2 * (361.164121995173076_DP &
                 + t2 * 0.280355207707726826_DP))) / &
                ((2420.64907902774675_DP &
                 + t2 * (2327.48464880306840_DP &
                 + t2 * 47.9870997057202318_DP)) &
                 + t * (4034.28168313496638_DP &
                 + t2 * (549.234220839203960_DP &
                 + t2)))

        elseif(mc > 0.302367_DP) then
            t = 3.95716761770595079_DP * mc - 1.19651690106289522_DP
            t2 = t * t
            ceib = ((2209.26925068374373_DP &
                 + t2 * (1981.37862223307242_DP &
                 + t2 * 29.7612810087709299_DP)) &
                 + t * (3606.58475322372526_DP &
                 + t2 * (422.693774742063054_DP &
                 + t2 * 0.334623999861181980_DP))) / &
                ((2499.57898767250755_DP &
                 + t2 * (2467.63998386656941_DP &
                 + t2 * 50.0198090806651216_DP)) &
                 + t * (4236.30953048456334_DP &
                 + t2 * (581.879599221457589_DP &
                 + t2)))

        elseif(mc > 0.161052_DP) then
            t = 7.07638962601280827_DP * mc - 1.13966670204861480_DP
            t2 = t * t
            ceib = ((2359.14823394150129_DP &
                 + t2 * (2254.30785457761760_DP &
                 + t2 * 35.2259786264917876_DP)) &
                 + t * (3983.28520266051676_DP &
                 + t2 * (492.601686517364701_DP &
                 + t2 * 0.396605124984359783_DP))) / &
                ((2563.95563932625156_DP &
                 + t2 * (2633.23323959119935_DP &
                 + t2 * 52.6711647124832948_DP)) &
                 + t * (4450.19076667898892_DP &
                 + t2 * (622.983787815718489_DP &
                 + t2)))

        elseif(mc > 0.083522_DP) then
            t = 12.8982329420869341_DP * mc - 1.07728621178898491_DP
            t2 = t * t
            ceib = ((2464.65334987833736_DP &
                 + t2 * (2541.68516994216007_DP &
                 + t2 * 41.5832527504007778_DP)) &
                 + t * (4333.38639187691528_DP &
                 + t2 * (571.53606797524881_DP &
                 + t2 * 0.465975784547025267_DP))) / &
                ((2600.66956117247726_DP &
                 + t2 * (2823.69445052534842_DP &
                 + t2 * 56.136001230010910_DP)) &
                 + t * (4661.64381841490914_DP &
                 + t2 * (674.25435972414302_DP &
                 + t2)))

        elseif(mc > 0.041966_DP) then
            t = 24.0639137549331023_DP * mc - 1.00986620463952257_DP
            t2 = t * t
            ceib = ((2509.86724450741259_DP &
                 + t2 * (2835.27071287535469_DP &
                 + t2 * 48.9701196718008345_DP)) &
                 + t * (4631.12336462339975_DP &
                 + t2 * (659.86172161727281_DP &
                 + t2 * 0.54158304771955794_DP))) / &
                ((2594.15983397593723_DP &
                 + t2 * (3034.20118545214106_DP &
                 + t2 * 60.652838995496991_DP)) &
                 + t * (4848.17491604384532_DP &
                 + t2 * (737.15143838356850_DP &
                 + t2)))

        elseif(mc > 0.020313_DP) then
            t = 46.1829769546944996_DP * mc - 0.938114810880709371_DP
            t2 = t * t
            ceib = ((2480.58307884128017_DP &
                 + t2 * (3122.00900554841322_DP &
                 + t2 * 57.541132641218839_DP)) &
                 + t * (4845.57861173250699_DP &
                 + t2 * (757.31633816400643_DP &
                 + t2 * 0.62119950515996627_DP))) / &
                ((2528.85218300581396_DP &
                 + t2 * (3253.86151324157460_DP &
                 + t2 * 66.496093157522450_DP)) &
                 + t * (4979.31783250484768_DP &
                 + t2 * (812.40556572486862_DP &
                 + t2)))

        elseif(mc > 0.009408_DP) then
            t = 91.7010545621274645_DP * mc - 0.862723521320495186_DP
            t2 = t * t
            ceib = ((2365.25385348859592_DP &
                 + t2 * (3381.09304915246175_DP &
                 + t2 * 67.442026950538221_DP)) &
                 + t * (4939.53925884558687_DP &
                 + t2 * (862.16657576129841_DP &
                 + t2 * 0.70143698925710129_DP))) / &
                ((2390.48737882063755_DP &
                 + t2 * (3462.34808443022907_DP &
                 + t2 * 73.934680452209164_DP)) &
                 + t * (5015.4675579215077_DP &
                 + t2 * (898.99542983710459_DP &
                 + t2)))

        elseif(mc > 0.004136_DP) then
            t = 189.681335356600910_DP * mc - 0.784522003034901366_DP
            t2 = t * t
            ceib = ((2160.82916040868119_DP &
                 + t2 * (3584.53058926175721_DP &
                 + t2 * 78.769178005879162_DP)) &
                 + t * (4877.14832623847052_DP &
                 + t2 * (970.53716686804832_DP &
                 + t2 * 0.77797110431753920_DP))) / &
                ((2172.70451405048305_DP &
                 + t2 * (3630.52345460629336_DP &
                 + t2 * 83.173163222639080_DP)) &
                 + t * (4916.35263668839769_DP &
                 + t2 * (993.36676027886685_DP &
                 + t2)))

        elseif(mc > 0.0_DP) then
            t = 1.0_DP - 106.292517006802721_DP * mc
            ceib = mc * log(mc * 0.0625_DP) &
                 * (6607.46457640413908_DP &
                 + t * (19.0287633783211078_DP &
                 - t * 0.00625368946932704460_DP)) / &
                (26150.3443630974309_DP &
                 + t * (354.603981274536040_DP &
                 + t)) &
                 + (26251.5678902584870_DP &
                 + t * (168.788023807915689_DP &
                 + t * 0.352150236262724288_DP)) / &
                (26065.7912239203873_DP &
                 + t * (353.916840382280456_DP &
                 + t))
        elseif(mc == 0.0_DP) then
            ceib = 1.0_DP

        else
            call handle_error("Fukushima ceib encountered values for argument &
                              &m which are out of range! (was " &
                              //string(m_arg, 10)//")", &
                              GENEX_ERR_MATH, __LINE__, __FILE__)
        endif
        res = real(ceib, kind=GP)
    end function

    function fukushima_ceid(m_arg) result(res)
        ! Double precision minimax rational approximation of
        ! D(m) = (K(m) - E(m)) / m,
        ! the second associate complete elliptic integral of the second kind
        !
        ! Author: Toshio Fukushima <Toshio.Fukushima@nao.ac.jp>
        !
        ! Reference: Fukushima (2015) J. Comp. Appl. Math., 282:71--76
        ! "Precise and fast computation of complete elliptic integrals
        !  by piecewise minimax rational function approximation"
        ! https://doi.org/10.1016/j.cam.2014.12.038
        real(kind=GP) :: m_arg
        real(kind=GP) :: res
        real(kind=DP) :: mc, ceid, t, t2

        mc = 1.0_DP - m_arg

        if(mc > 1.0_DP) then
            call handle_error("Fukushima ceid encountered negative values &
                              &for argument m! (was "//string(m_arg, 10)//")", &
                              GENEX_ERR_MATH, __LINE__, __FILE__)

        elseif(mc > 0.599909_DP) then
            t = 2.49943137936119533_DP * mc - 1.49943137936119533_DP
            t2 = t * t
            ceid = ((1593.39813781813498_DP &
                 + t2 * (1058.56241259843217_DP &
                 + t2 * 11.7584241242587571_DP)) &
                 + t * (2233.25576544961714_DP &
                 + t2 * (195.247394601357872_DP &
                 + t2 * 0.101486443490307517_DP))) / &
                ((1685.47865546030468_DP &
                 + t2 * (1604.88100543517015_DP &
                 + t2 * 38.6743012128666717_DP)) &
                 + t * (2756.20968383181114_DP &
                 + t2 * (397.504162950935944_DP &
                 + t2)))

        elseif(mc > 0.359180_DP) then
            t = 4.15404874360795750_DP * mc - 1.49205122772910617_DP
            t2 = t * t
            ceid = ((1967.01442513777287_DP &
                 + t2 * (1329.30058268219177_DP &
                 + t2 * 15.0447805948342760_DP)) &
                 + t * (2779.87604145516343_DP &
                 + t2 * (247.475085945854673_DP &
                 + t2 * 0.130547566005491628_DP))) / &
                ((1749.70634057327467_DP &
                 + t2 * (1654.40804288486242_DP &
                 + t2 * 39.1895256017535337_DP)) &
                 + t * (2853.92630369567765_DP &
                 + t2 * (406.925098588378587_DP &
                 + t2)))

        elseif(mc > 0.214574_DP) then
            t = 6.91534237860116454_DP * mc - 1.48385267554596628_DP
            t2 = t * t
            ceid = ((2409.64196912091452_DP &
                 + t2 * (1659.30176823041376_DP &
                 + t2 * 19.1942111405094383_DP)) &
                 + t * (3436.40744503228691_DP &
                 + t2 * (312.186468430688790_DP &
                 + t2 * 0.167847673021897479_DP))) / &
                ((1824.89205701262525_DP &
                 + t2 * (1715.38574780156913_DP &
                 + t2 * 39.8798253173462218_DP)) &
                 + t * (2971.02216287936566_DP &
                 + t2 * (418.929791715319490_DP &
                 + t2)))

        elseif(mc > 0.127875_DP) then
            t = 11.5341584101316047_DP * mc - 1.47493050669557896_DP
            t2 = t * t
            ceid = ((2926.81143179637839_DP &
                 + t2 * (2056.45624281065334_DP &
                 + t2 * 24.3811986813439843_DP)) &
                 + t * (4214.52119721241319_DP &
                 + t2 * (391.420514384925370_DP &
                 + t2 * 0.215574280659075512_DP))) / &
                ((1910.33091918583314_DP &
                 + t2 * (1787.99942542734799_DP &
                 + t2 * 40.7663012893484449_DP)) &
                 + t * (3107.04531802441481_DP &
                 + t2 * (433.673494280825971_DP &
                 + t2)))

        elseif(mc > 0.076007_DP) then
            t = 19.2797100331611013_DP * mc - 1.46539292049047582_DP
            t2 = t * t
            ceid = ((3520.63614251102960_DP &
                 + t2 * (2526.67111759550923_DP &
                 + t2 * 30.7739877519417978_DP)) &
                 + t * (5121.2842239226937_DP &
                 + t2 * (486.926821696342529_DP &
                 + t2 * 0.276315678908126399_DP))) / &
                ((2003.81997889501324_DP &
                 + t2 * (1871.05914195570669_DP &
                 + t2 * 41.8489850490387023_DP)) &
                 + t * (3259.09205279874214_DP &
                 + t2 * (451.007555352632053_DP &
                 + t2)))

        elseif(mc > 0.045052_DP) then
            t = 32.3049588111775157_DP * mc - 1.45540300436116944_DP
            t2 = t * t
            ceid = ((4188.00087087025347_DP &
                 + t2 * (3072.05695847158556_DP &
                 + t2 * 38.5070211470790031_DP)) &
                 + t * (6156.0080960857764_DP &
                 + t2 * (599.76666155374012_DP &
                 + t2 * 0.352955925261363680_DP))) / &
                ((2101.60113938424690_DP &
                 + t2 * (1961.76794074710108_DP &
                 + t2 * 43.0997999502743622_DP)) &
                 + t * (3421.55151253792527_DP &
                 + t2 * (470.407158843118117_DP &
                 + t2)))

        elseif(mc > 0.026626_DP) then
            t = 54.2711386084880061_DP * mc - 1.44502333658960165_DP
            t2 = t * t
            ceid = ((4916.74442376570733_DP &
                 + t2 * (3688.12811638360551_DP &
                 + t2 * 47.6447145147811350_DP)) &
                 + t * (7304.6632479558695_DP &
                 + t2 * (729.75841970840314_DP &
                 + t2 * 0.448422756936257635_DP))) / &
                ((2197.49982676612397_DP &
                 + t2 * (2055.19657857622715_DP &
                 + t2 * 44.4576261146308645_DP)) &
                 + t * (3584.94502590860852_DP &
                 + t2 * (490.880160668822953_DP &
                 + t2)))

        elseif(mc > 0.015689_DP) then
            t = 91.4327512114839536_DP * mc - 1.43448843375697175_DP
            t2 = t * t
            ceid = ((5688.7542903989517_DP &
                 + t2 * (4364.21513060078954_DP &
                 + t2 * 58.159468141567195_DP)) &
                 + t * (8542.6096475195826_DP &
                 + t2 * (875.35992968472914_DP &
                 + t2 * 0.56528145509695951_DP))) / &
                ((2285.44062680812883_DP &
                 + t2 * (2145.80779422696555_DP &
                 + t2 * 45.8427480379028781_DP)) &
                 + t * (3739.30422133833258_DP &
                 + t2 * (511.23253971875808_DP &
                 + t2)))

        elseif(mc > 0.009216_DP) then
            t = 154.487872701992894_DP * mc - 1.42376023482156651_DP
            t2 = t * t
            ceid = ((6475.3392225234969_DP &
                 + t2 * (5081.2997108708577_DP &
                 + t2 * 69.910123337464043_DP)) &
                 + t * (9829.1138694605662_DP &
                 + t2 * (1033.32687775311981_DP &
                 + t2 * 0.70526087421186325_DP))) / &
                ((2357.74885505777295_DP &
                 + t2 * (2226.89527217032394_DP &
                 + t2 * 47.1609071069631012_DP)) &
                 + t * (3872.32565152553360_DP &
                 + t2 * (530.03943432061149_DP &
                 + t2)))

        elseif(mc > 0.0_DP) then
            t = 1.0_DP - 108.506944444444444_DP * mc
            ceid = -log(mc * 0.0625_DP) &
                 * (6.2904323649908115d6 &
                 + t * (58565.284164780476_DP &
                 + t * (131.176674599188545_DP &
                 + t * 0.0426826410911220304_DP))) / &
                (1.24937550257219890d7 &
                 + t * (203580.534005225410_DP &
                 + t * (921.17729845011868_DP &
                 + t))) &
                 - (27356.1090344387530_DP &
                 + t * (107.767403612304371_DP &
                 - t * 0.0827769227048233593_DP)) / &
                (27104.0854889805978_DP &
                 + t * (358.708172147752755_DP &
                 + t))

        else
            call handle_error("Fukushima ceid encountered values for argument &
                              &m which are out of range! (was " &
                              //string(m_arg, 10)//")", &
                              GENEX_ERR_MATH, __LINE__, __FILE__)
        endif
        res = real(ceid, kind=GP)
    end function

end module
