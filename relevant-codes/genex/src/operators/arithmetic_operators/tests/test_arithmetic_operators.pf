        allocate(a_3d(n_rz * n_phi * n_vp, n_mu, n_sp))
        allocate(b_3d(n_rz * n_phi * n_vp, n_mu, n_sp))
        call copy_array_device_integer(length, a_3d)
        call copy_array_device_integer(length, b_3d)
