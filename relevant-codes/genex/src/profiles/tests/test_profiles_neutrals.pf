module test_profiles_neutrals
    !! Contains tests for the different profile_t types used for the neutrals
    use mpi
    use pfunit
    use genex_fortran_env_m, only : GP, GP_EPS
    use math_m, only: almost_equal
    use params_mesh_m, only : get_n_points_sp
    use params_profile_uniform_m, only: params_profile_uniform_t, &
                                        get_params_profile_uniform_dens
    use params_profile_plateau_m, only: params_profile_plateau_t, &
                                        get_params_profile_plateau_dens
    use profiles_m, only : profile_t, &
                           profile_uniform_cpu_t, &
                           profile_plateau_sine_cpu_t
    use dcomm_handler_m, only : dcomm_handler_t
    use mesh_5d_m, only: mesh_5d_t
    ! Unit test helpers
    use test_params_m, only: setup_test_mesh
    ! From PARALLAX
    use equilibrium_factory_m, only: CIRCULAR

    implicit none

contains

    @test(npes = [1])
    subroutine test_profile_uniform(this)
        !! Tests the uniform profile
        class(MpiTestMethod), intent(inout) :: this
        type(profile_uniform_cpu_t) :: profile_uniform
        type(params_profile_uniform_t) :: params
        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), target :: dcomm_handler
        type(mesh_5d_t), target, allocatable :: mesh
        real(kind=GP) :: res
        logical :: equal

        call dcomm_handler%initialize(this%getMpiCommunicator(), 1, 1, 1, 1)
        dcomm_handler_ptr => dcomm_handler
        allocate(mesh)
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=CIRCULAR, &
                             spacing_RZ=0.05_GP, &
                             n_points_phi=8, &
                             n_points_vp=8, &
                             n_points_mu=8)
        call mesh%initialize(dcomm_handler_ptr)

        params = get_params_profile_uniform_dens(1)
        call profile_uniform%initialize(params)

        res = profile_uniform%eval(191.9_GP,  8.9_GP,  7.7_GP)
        equal = almost_equal(params%strength, res, GP_EPS)
        @assertTrue(equal)
        res = profile_uniform%eval(  1.8_GP,  0.0_GP,  3.7_GP)
        equal = almost_equal(params%strength, res, GP_EPS)
        @assertTrue(equal)
        res = profile_uniform%eval(  0.8_GP, -1.0_GP, -3.7_GP)
        equal = almost_equal(params%strength, res, GP_EPS)
        @assertTrue(equal)

        deallocate(mesh)
    end subroutine

    @test(npes = [1])
    subroutine test_profile_plateau_sine(this)
        !! Tests the plateau sine profile
        class(MpiTestMethod), intent(inout) :: this
        type(profile_plateau_sine_cpu_t) :: profile_plateau_sine
        type(params_profile_plateau_t) :: params
        type(dcomm_handler_t), pointer :: dcomm_handler_ptr
        type(dcomm_handler_t), target :: dcomm_handler
        type(mesh_5d_t), target, allocatable :: mesh
        real(kind=GP) :: res
        real(kind=GP), parameter :: prec = 10 * GP_EPS
        logical :: equal

        call dcomm_handler%initialize(this%getMpiCommunicator(), 1, 1, 1, 1)
        dcomm_handler_ptr => dcomm_handler
        allocate(mesh)
        call setup_test_mesh(this%getMpiCommunicator(), &
                             this%getProcessRank(), &
                             equilibrium_type=CIRCULAR, &
                             spacing_RZ=0.05_GP, &
                             n_points_phi=8, &
                             n_points_vp=8, &
                             n_points_mu=8)
        call mesh%initialize(dcomm_handler_ptr)

        ! Get density parameters of first species
        params = get_params_profile_plateau_dens(1)
        call profile_plateau_sine%initialize(params)

        ! NOTE: The profile is theta and phi independent
        res = profile_plateau_sine%eval(params%rho_inner_foot, -1.0_GP, 0.0_GP)
        equal = almost_equal(params%amp_in, res, prec)
        @assertTrue(equal)

        res = profile_plateau_sine%eval(params%rho_inner_top, 0.0_GP, 3.7_GP)
        equal = almost_equal(params%amp_plateau, res, prec)
        @assertTrue(equal)

        res = profile_plateau_sine%eval((params%rho_inner_foot &
                                         + params%rho_outer_top) / 2, &
                                        8.9_GP, 7.7_GP)
        equal = almost_equal(params%amp_plateau, res, prec)
        @assertTrue(equal)

        res = profile_plateau_sine%eval(params%rho_outer_top, 8.9_GP, 0.0_GP)
        equal = almost_equal(params%amp_plateau, res, prec)
        @assertTrue(equal)

        res = profile_plateau_sine%eval(params%rho_outer_foot, 0.0_GP, -3.7_GP)
        equal = almost_equal(params%amp_out, res, prec)
        @assertTrue(equal)

        deallocate(mesh)
    end subroutine

end module
