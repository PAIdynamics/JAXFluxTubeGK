        do i = 1, n_spec
            write(logger_get_debug_channel(), *) &
                "Test params dist initial double maxw for "&
                //trim(get_name(i))

            params_old = get_params_dist_initial_double_maxw(i)

            fname = "test_params_"//trim(get_name(i))//".txt"

            call write_params_dist_initial_double_maxw(fname, i)
            equal = file_contains("params_dist_initial_double_maxw", &
                                  fname)
            @assertTrue(equal)
            @assertTrue(file_contains("drift_par1", fname))
            @assertTrue(file_contains("drift_par2", fname))
            @assertTrue(file_contains("amp1", fname))
            @assertTrue(file_contains("amp2", fname))
            call read_params_dist_initial_double_maxw(fname, i)

            params_new = get_params_dist_initial_double_maxw(i)

            equal = (params_old%drift_par1 == params_new%drift_par1)
            @assertTrue(equal)
            equal = (params_old%drift_par2 == params_new%drift_par2)
            @assertTrue(equal)
            equal = (params_old%amp1 == params_new%amp1)
            @assertTrue(equal)
            equal = (params_old%amp2 == params_new%amp2)
            @assertTrue(equal)
        enddo
    end subroutine

    @test
    subroutine test_dist_initial_ring_parameters()
        !! Tests read and write of the dist initial ring parameters
        integer, parameter :: n_spec = 2
        type(params_dist_initial_ring_t) :: params_old, params_new
        integer :: i
        logical :: equal
        character(len=64) :: fname

        do i = 1, n_spec
            write(logger_get_debug_channel(), *) &
                "Test params dist initial ring for "//trim(get_name(i))

            params_old = get_params_dist_initial_ring(i)

            fname = "test_params_"//trim(get_name(i))//".txt"

            call write_params_dist_initial_ring(fname, i)
            equal = file_contains("params_dist_initial_ring", fname)
            @assertTrue(equal)
            @assertTrue(file_contains("drift_par", fname))
            @assertTrue(file_contains("drift_perp", fname))
            @assertTrue(file_contains("width_par", fname))
            @assertTrue(file_contains("width_perp", fname))
            call read_params_dist_initial_ring(fname, i)

            params_new = get_params_dist_initial_ring(i)

            equal = (params_old%drift_par  == params_new%drift_par)
            @assertTrue(equal)
            equal = (params_old%drift_perp == params_new%drift_perp)
            @assertTrue(equal)
            equal = (params_old%width_par  == params_new%width_par)
            @assertTrue(equal)
            equal = (params_old%width_perp == params_new%width_perp)
            @assertTrue(equal)
        enddo
    end subroutine

