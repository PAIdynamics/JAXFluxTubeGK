    @test
    subroutine test_time_loop_parameters()
        !! Tests read and write of the time loop parameters
        real(kind=GP) :: dt
        integer :: n_timesteps, wrap_up_time, steps_diagnostics, &
                   steps_checkpoint, n_stages_pirock
        character(len=16) :: time_stepping_scheme
        logical :: start_from_checkpoint, run_mms
        logical :: equal

        dt                    = get_dt()
        n_timesteps           = get_n_timesteps()
        n_stages_pirock       = get_n_stages_pirock()
        wrap_up_time          = get_wrap_up_time()
        steps_diagnostics     = get_steps_diagnostics()
        steps_checkpoint      = get_steps_checkpoint()
        time_stepping_scheme  = get_time_stepping_scheme()
        start_from_checkpoint = get_start_from_checkpoint()
        run_mms               = get_run_mms()

        call write_params_time_loop(filename)
        @assertTrue(file_contains("params_time_loop"))
        @assertTrue(file_contains("dt"))
        @assertTrue(file_contains("n_timesteps"))
        @assertTrue(file_contains("n_stages_pirock"))
        @assertTrue(file_contains("wrap_up_time"))
        @assertTrue(file_contains("steps_diagnostics"))
        @assertTrue(file_contains("steps_checkpoint"))
        @assertTrue(file_contains("time_stepping_scheme"))
        @assertTrue(file_contains("start_from_checkpoint"))
        @assertTrue(file_contains("run_mms"))
        call read_params_time_loop(filename)

        equal = (dt == get_dt())
        @assertTrue(equal)
        equal = (n_timesteps == get_n_timesteps())
        @assertTrue(equal)
        equal = (n_stages_pirock == get_n_stages_pirock())
        @assertTrue(equal)
        equal = (wrap_up_time == get_wrap_up_time())
        @assertTrue(equal)
        equal = (steps_diagnostics == get_steps_diagnostics())
        @assertTrue(equal)
        equal = (steps_checkpoint == get_steps_checkpoint())
        @assertTrue(equal)
        equal = (time_stepping_scheme == get_time_stepping_scheme())
        @assertTrue(equal)
        equal = (start_from_checkpoint .eqv. get_start_from_checkpoint())
        @assertTrue(equal)
        equal = (run_mms .eqv. get_run_mms())
        @assertTrue(equal)
    end subroutine

