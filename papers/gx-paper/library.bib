@article{SunnPedersen2017,
  title = {Key results from the first plasma operation phase and outlook for future performance in {{Wendelstein}} 7-{{X}}},
  author = {Sunn Pedersen, T and Dinklage, A and Turkin, Y and Wolf, R and Bozhenkov, S and Geiger, J and Fuchert, G and Bosch, H and Rahbarnia, K and Thomsen, H and Neuner, U and Klinger, T and Langenberg, A and Trimi{\~n}o Mora, H and Kornejew, P and Knauer, J and Hirsch, M and {the W7-X Team} and Pablant, N},
  year = {2017},
