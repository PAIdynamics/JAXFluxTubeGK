  author = {Labombard, B and Rice, J and Hubbard, A and Hughes, J and Greenwald, M and Granetz, R and Irby, J and Lin, Y and Lipschultz, B and Marmar, E and Marr, K and Mossessian, D and Parker, R and Rowan, W and Smick, N and Snipes, J and Terry, J and Wolfe, S and Wukitch, S},
