module test_structured_grids
!! Contains tests for the structured grids, i.e. the vp_grid_t, mu_grid_t and
!! phi_grid_t type
use funit
use genex_fortran_env_m, only: GP, GP_EPS
use math_m, only: PI, almost_equal
use structured_grids_m, only: vp_grid_t, mu_grid_t, phi_grid_t

implicit none

contains

    @test
    subroutine test_phi_grid()
        !! Tests the correct initialization of the phi grid
        integer, parameter :: npoints = 3
        type(phi_grid_t) :: phi_grid
        real(kind=GP), parameter :: lphi = 2.0_GP * PI
        real(kind=GP) :: delta
        real(kind=GP), dimension(:), pointer :: points, weights
        real(kind=GP), dimension(npoints) :: expected

        call phi_grid%initialize(lphi, npoints)
        @assertTrue(phi_grid%get_grid_type() == "uniform")
        @assertTrue(phi_grid%get_quad_type() == "midpoint")
        @assertTrue(phi_grid%get_size() == npoints)
        delta = phi_grid%get_spacing(1)
        @assertTrue(almost_equal(delta, 2.0_GP * PI / 3.0_GP, GP_EPS))
        points => phi_grid%get_pointer()
        expected = [0.0_GP, 2.0_GP * PI / 3.0_GP, 4.0_GP * PI / 3.0_GP]
        @assertTrue(all(almost_equal(points, expected, GP_EPS)))
        weights => phi_grid%get_weights_pointer()
        expected = 2.0_GP * PI / 3.0_GP
        @assertTrue(all(almost_equal(weights, expected, GP_EPS)))
    end subroutine

    @test
    subroutine test_vp_grid()
        !! Tests the correct initialization of the vp grid
        integer, parameter:: npoints = 3
        type(vp_grid_t), allocatable :: vp_grid
        real(kind=GP), parameter :: lv = 1.0_GP
        real(kind=GP) :: delta
        real(kind=GP), dimension(:), pointer :: points, weights
        real(kind=GP), dimension(:), allocatable :: expected

        allocate(expected(npoints))
        ! Test uniform grid, trapezoidal weights
        allocate(vp_grid)
        call vp_grid%initialize(npoints)
        call vp_grid%construct(lv, quad_type="trapezoidal")
        @assertTrue(vp_grid%get_grid_type() == "uniform")
        @assertTrue(vp_grid%get_quad_type() == "trapezoidal")
        @assertTrue(vp_grid%get_size() == npoints)
        @assertFalse(vp_grid%get_is_vspectral())
        delta = vp_grid%get_spacing(1)
        @assertTrue(almost_equal(delta, 1.0_GP, GP_EPS))
        points => vp_grid%get_pointer()
        expected = [-1.0_GP, 0.0_GP, 1.0_GP]
        @assertTrue(all(almost_equal(points, expected, GP_EPS)))
        weights => vp_grid%get_weights_pointer()
        expected = [0.5_GP, 1.0_GP, 0.5_GP]
        @assertTrue(all(almost_equal(weights, expected, GP_EPS)))
        deallocate(vp_grid)

        ! Test uniform grid, midpoint weights
        allocate(vp_grid)
        call vp_grid%initialize(npoints)
        call vp_grid%construct(lv, quad_type="midpoint")
        @assertTrue(vp_grid%get_grid_type() == "uniform")
        @assertTrue(vp_grid%get_quad_type() == "midpoint")
        @assertFalse(vp_grid%get_is_vspectral())
        @assertTrue(vp_grid%get_size() == npoints)
        delta = vp_grid%get_spacing(1)
        @assertTrue(almost_equal(delta, 1.0_GP, GP_EPS))
        points => vp_grid%get_pointer()
        expected = [-1.0_GP, 0.0_GP, 1.0_GP]
        @assertTrue(all(almost_equal(points, expected, GP_EPS)))
        weights => vp_grid%get_weights_pointer()
        expected = 1.0_GP
        @assertTrue(all(almost_equal(weights, expected, GP_EPS)))
        deallocate(vp_grid)

        ! Test uniform grid, simpson weights
        deallocate(expected)
        allocate(expected(9))
        allocate(vp_grid)
        ! Simpson needs at least 8 points
        call vp_grid%initialize(9)
        call vp_grid%construct(lv, quad_type="simpson")
        @assertTrue(vp_grid%get_grid_type() == "uniform")
        @assertTrue(vp_grid%get_quad_type() == "simpson")
        @assertFalse(vp_grid%get_is_vspectral())
        @assertTrue(vp_grid%get_size() == 9)
        delta = vp_grid%get_spacing(1)
        @assertTrue(almost_equal(delta, 0.25_GP, GP_EPS))
        points => vp_grid%get_pointer()
        expected = [-1.0_GP, -0.75_GP, -0.5_GP, -0.25_GP, 0.0_GP, &
                     0.25_GP, 0.5_GP, 0.75_GP, 1.0_GP]
        weights => vp_grid%get_weights_pointer()
        expected = [8.854166666666667e-2_GP, 0.307291666666667_GP, &
                    0.223958333333333_GP, 0.255208333333333_GP, 0.25_GP, &
                    0.255208333333333_GP, 0.223958333333333_GP, &
                    0.307291666666667_GP, 8.854166666666667e-2_GP]
        @assertTrue(all(almost_equal(weights, expected, 10.0_GP*GP_EPS)))
        deallocate(vp_grid)
        deallocate(expected)

        ! Test Hermite moment grid
        allocate(vp_grid)
        allocate(expected(npoints))
        call vp_grid%initialize(npoints, is_vspectral=.true.)
        call vp_grid%construct(lv, quad_type="")
        @assertTrue(vp_grid%get_grid_type() == 'spectral_hermite')
        @assertTrue(vp_grid%get_quad_type() == 'spectral_hermite')
        @assertTrue(vp_grid%get_is_vspectral())
        expected = [0.0_GP, 1.0_GP, 2.0_GP]
        points => vp_grid%get_pointer()
        @assertTrue(all(almost_equal(points, expected, GP_EPS)))
        weights => vp_grid%get_weights_pointer()
        expected = [1.0_GP, 0.0_GP, 0.0_GP]
        @assertTrue(all(almost_equal(weights, expected, GP_EPS)))
        deallocate(vp_grid)
        deallocate(expected)

    end subroutine

    @test
    subroutine test_mu_grid()
        !! Tests the correct initialization of the mu grid
        integer, parameter :: npoints = 3
        type(mu_grid_t), allocatable :: mu_grid
        real(kind=GP), parameter :: lm = 1.0_GP
        real(kind=GP) :: delta
        real(kind=GP), dimension(:), pointer :: points, weights
        real(kind=GP), dimension(npoints) :: expected

        ! Check quadratic grid and midpoint weights
        allocate(mu_grid)
        call mu_grid%initialize(lm, npoints, grid_type="quadratic")
        @assertTrue(mu_grid%get_grid_type() == "quadratic")
        @assertTrue(mu_grid%get_quad_type() == "midpoint")
        @assertTrue(mu_grid%get_size() == npoints)
        @assertFalse(mu_grid%get_is_vspectral())
        delta = mu_grid%get_spacing(1)
        @assertTrue(almost_equal(delta, 2.0_GP/9.0_GP, GP_EPS))
        points => mu_grid%get_pointer()
        expected = [1.0_GP/36.0_GP, 1.0_GP/4.0_GP, 25.0_GP/36.0_GP]
        @assertTrue(all(almost_equal(points, expected, GP_EPS)))
        weights => mu_grid%get_weights_pointer()
        expected = [1.0_GP / 9.0_GP, 1.0_GP / 3.0_GP, 5.0_GP / 9.0_GP]
        @assertTrue(all(almost_equal(weights, expected, 10.0_GP*GP_EPS)))
        deallocate(mu_grid)

        ! Check uniform grid and midpoint weights
        allocate(mu_grid)
        call mu_grid%initialize(lm, npoints, grid_type="uniform")
        @assertTrue(mu_grid%get_grid_type() == "uniform")
        @assertTrue(mu_grid%get_quad_type() == "midpoint")
        @assertTrue(mu_grid%get_size() == npoints)
        delta = mu_grid%get_spacing(1)
        @assertTrue(almost_equal(delta, 1.0_GP/3.0_GP, GP_EPS))
        points => mu_grid%get_pointer()
        expected = [1.0_GP/6.0_GP, 0.5_GP, 5.0_GP/6.0_GP]
        @assertTrue(all(almost_equal(points, expected, GP_EPS)))
        weights => mu_grid%get_weights_pointer()
        expected = 1.0_GP/3.0_GP
        @assertTrue(all(almost_equal(weights, expected, GP_EPS)))
        deallocate(mu_grid)

        ! Check Gauss-Laguerre
        allocate(mu_grid)
        call mu_grid%initialize(lm, npoints, grid_type="gauss-laguerre")
        @assertTrue(mu_grid%get_grid_type() == "gauss-laguerre")
        @assertTrue(mu_grid%get_quad_type() == "gauss-laguerre")
        @assertTrue(mu_grid%get_size() == npoints)
        @assertFalse(mu_grid%get_is_vspectral())
        delta = mu_grid%get_spacing(1)
        expected = [4.403957418549856e-2_GP, 0.243014221241679_GP, &
                    0.666242074180100_GP]
        @assertTrue(almost_equal(delta,expected(2)-expected(1),10.0_GP*GP_EPS))
        points => mu_grid%get_pointer()
        @assertTrue(all(almost_equal(points, expected, 10.0_GP*GP_EPS)))
        weights => mu_grid%get_weights_pointer()
        expected = [0.114151127938692_GP, 0.292571052982844_GP, &
                    0.593277819078464_GP]
        @assertTrue(all(almost_equal(weights, expected, 10.0_GP*GP_EPS)))
        deallocate(mu_grid)

        ! Check Laguerre moment grid
        allocate(mu_grid)
        call mu_grid%initialize(lm, npoints, grid_type="", &
                                is_vspectral=.true.)
        @assertTrue(mu_grid%get_grid_type() == "spectral_laguerre")
        @assertTrue(mu_grid%get_quad_type() == "spectral_laguerre")
        @assertTrue(mu_grid%get_is_vspectral())
        expected = [0.0_GP, 1.0_GP, 2.0_GP]
        points => mu_grid%get_pointer()
        @assertTrue(all(almost_equal(points, expected, GP_EPS)))
        weights => mu_grid%get_weights_pointer()
        expected = [1.0_GP, 0.0_GP, 0.0_GP]
        @assertTrue(all(almost_equal(weights, expected, GP_EPS)))
        deallocate(mu_grid)

    end subroutine

end module
