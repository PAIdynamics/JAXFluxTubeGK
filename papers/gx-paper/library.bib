}

@article{Labombard2008,
  title = {Critical gradients and plasma flows in the edge plasma of {{Alcator C-Mod}}},
  author = {Labombard, B and Hughes, J and Smick, N and Graf, A and Marr, K and McDermott, R and Reinke, M and Greenwald, M and Lipschultz, B and Terry, J and Whyte, D and Zweben, S},
