    @test
    subroutine test_source_dens_parameters()
        !! Tests read and write of the source density parameters
        integer, parameter :: n_spec = 2
        type(params_source_loc_t) :: params_old, &
                                     params_new
        logical :: equal
        integer :: i, s
        character(len=64) :: fname

        do i = 1, n_spec
            params_old = get_params_source_dens(i)
            fname = "test_params_"//trim(get_name(i))//".txt"
            call write_params_source_dens(fname, i)
            @assertTrue(file_contains("params_source_dens", fname))
            @assertTrue(file_contains("temp", fname))
            @assertTrue(file_contains("rho_mid", fname))
            @assertTrue(file_contains("width", fname))
            @assertTrue(file_contains("amp", fname))
            @assertTrue(file_contains("is_pure", fname))
            call read_params_source_dens(fname, i)
            write(logger_get_debug_channel(), *) &
            "Test params source dens for "//trim(get_name(i))
            params_new = get_params_source_dens(i)

            @assertTrue(get_n_source_loc_dens(i) == 1)

            do s = 1, n_source_loc_supported
                equal = (params_new%temp(s) == params_old%temp(s))
                @assertTrue(equal)
                equal = (params_new%rho_mid(s) == params_old%rho_mid(s))
                @assertTrue(equal)
                equal = (params_new%amp(s) == params_old%amp(s))
                @assertTrue(equal)
                equal = (params_new%width(s) == params_old%width(s))
                @assertTrue(equal)
                equal = (params_new%is_pure(s) .eqv. params_old%is_pure(s))
                @assertTrue(equal)
            enddo
        enddo

    end subroutine

